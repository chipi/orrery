#!/usr/bin/env bash
# Orrery workspace setup. Run through `wb-workspace setup` (the workstation's
# generic Model-B layer): by the Worktrunk pre-start hook for a new stream, by
# hand once in the primary checkout. Contract: .config/workspace/README.md.
#
#   wb-workspace setup              write this checkout's runtime files
#   wb-workspace setup --link-env   side stream only: also symlink the primary's .env
#
# Writes exactly two ignored, generated files and nothing else:
#   .env.workspace                runtime defaults (ports, URLs, identity) — never secrets
#   docker-compose.override.yml   this checkout's Compose project name (+ stream host port)
# The primary keeps today's ports (5273 / 4173 / 8080 / 8093 / 8091); a side
# stream gets its own from `wb-workspace port`. User files (.env, .env.local)
# are never written; secrets reach a side stream only through --link-env.
set -euo pipefail

die()  { echo "orrery setup: $*" >&2; exit 1; }
note() { echo "orrery setup: $*" >&2; }

for v in WORKSPACE_PROJECT WORKSPACE_STREAM WORKSPACE_ID WORKSPACE_PRIMARY WORKSPACE_PATH COMPOSE_PROJECT_NAME; do
  [ -n "${!v:-}" ] || die "$v is not set; run this through 'wb-workspace setup'"
done
WB="${WB_WORKSPACE:-wb-workspace}"   # override only for the tests

link_env=0
for a in "$@"; do
  case "$a" in
    --link-env) link_env=1 ;;
    *) die "unknown argument '$a' (usage: wb-workspace setup [--link-env])" ;;
  esac
done

cd "$WORKSPACE_PATH"
MARK='# Generated by .config/workspace/setup for'
ENV_FILE=.env.workspace
OVERRIDE=docker-compose.override.yml
side=1; [ "$WORKSPACE_STREAM" = main ] && side=0

# Only ever replace files this script generated (first line carries the mark).
owned_or_absent() {
  [ ! -e "$1" ] && [ ! -L "$1" ] && return 0
  [ -f "$1" ] && [ ! -L "$1" ] && head -n1 "$1" | grep -qF "$MARK"
}
for f in "$ENV_FILE" "$OVERRIDE"; do
  owned_or_absent "$f" || die "$f exists and was not generated by this script; move it aside, then rerun"
done

if [ "$side" = 1 ]; then
  # One call: wb-workspace fails (and prints nothing) on any collision.
  ports=$("$WB" port web e2e docker-web lab-api mcp) || die "could not derive ports for $WORKSPACE_ID"
  mapfile -t P <<<"$ports"
  [ "${#P[@]}" = 5 ] || die "expected 5 ports from '$WB port', got: $ports"
  WEB=${P[0]} E2E=${P[1]} DOCKER_WEB=${P[2]} LAB=${P[3]} MCP=${P[4]}
fi

env_body() {
  echo "$MARK $WORKSPACE_ID — rerun 'wb-workspace setup' instead of editing."
  echo "# Runtime defaults only: the shell and your own .env / .env.local override them."
  echo "WORKSPACE_PROJECT=$WORKSPACE_PROJECT"
  echo "WORKSPACE_STREAM=$WORKSPACE_STREAM"
  echo "WORKSPACE_ID=$WORKSPACE_ID"
  echo "WORKSPACE_PRIMARY=$WORKSPACE_PRIMARY"
  echo "WORKSPACE_PATH=$WORKSPACE_PATH"
  echo "COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME"
  if [ "$side" = 1 ]; then
    echo "VITE_DEV_PORT=$WEB"
    echo "E2E_PORT=$E2E"
    echo "ORRERY_WEB_PORT=$DOCKER_WEB"
    echo "LAB_PORT=$LAB"
    echo "LAB_ISSUER=http://localhost:$LAB"
    echo "VITE_LAB_API_URL=http://localhost:$LAB"
    echo "LAB_CORS_ORIGINS=http://localhost:$WEB"
    echo "LAB_WEB_REDIRECT_URIS=http://localhost:$WEB/lab/callback"
    echo "MCP_PORT=$MCP"
  else
    echo "# Primary checkout: no port values — today's defaults apply."
  fi
}

override_body() {
  echo "$MARK $WORKSPACE_ID — rerun 'wb-workspace setup' instead of editing."
  echo "# Merged automatically by 'docker compose' run in this checkout."
  echo "name: $COMPOSE_PROJECT_NAME"
  if [ "$side" = 1 ]; then
    echo "services:"
    echo "  web:"
    echo "    ports: !override"
    echo "      - '$DOCKER_WEB:80'"
  fi
}

# Write atomically; leave the file alone when nothing changed (idempotent).
put() {
  local f=$1 body=$2 tmp
  if [ -f "$f" ] && [ "$(cat "$f")" = "$body" ]; then echo "  unchanged $f"; return; fi
  tmp=$(mktemp "$f.XXXXXX")
  printf '%s\n' "$body" > "$tmp"
  mv -f "$tmp" "$f"
  echo "  wrote     $f"
}

echo "orrery workspace $WORKSPACE_ID ($([ "$side" = 1 ] && echo side stream || echo primary))"
put "$ENV_FILE" "$(env_body)"
put "$OVERRIDE" "$(override_body)"

# Secrets: never copied. A side stream gets the primary's .env only on request,
# as a symlink (one source of truth; removing the worktree removes only the link).
if [ "$link_env" = 1 ]; then
  [ "$side" = 1 ] || die "--link-env is for side streams; the primary owns .env"
  if [ -L .env ] && [ "$(readlink .env)" = "$WORKSPACE_PRIMARY/.env" ]; then
    echo "  unchanged .env -> $WORKSPACE_PRIMARY/.env"
  elif [ -e .env ] || [ -L .env ]; then
    die ".env already exists here; leaving it alone"
  elif [ ! -f "$WORKSPACE_PRIMARY/.env" ]; then
    die "the primary has no .env to link ($WORKSPACE_PRIMARY/.env)"
  else
    ln -s "$WORKSPACE_PRIMARY/.env" .env
    echo "  linked    .env -> $WORKSPACE_PRIMARY/.env"
  fi
elif [ "$side" = 1 ] && [ ! -e .env ]; then
  echo "  no .env:  secrets are not copied. If this stream needs them: wb-workspace setup --link-env"
fi

# A user .env file that pins a port this checkout derives would silently win
# over it (env files take precedence); say so.
if [ "$side" = 1 ]; then
  for f in .env .env.local; do
    [ -f "$f" ] || continue
    for k in VITE_DEV_PORT E2E_PORT ORRERY_WEB_PORT LAB_PORT MCP_PORT VITE_LAB_API_URL; do
      grep -qE "^[[:space:]]*$k=" "$f" && note "warning: $f sets $k, which overrides this stream's value from $ENV_FILE"
    done
  done
fi
exit 0
