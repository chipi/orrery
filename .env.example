# Orrery — local secrets (gitignored)
#
# Copy this file to `.env` in the repo root and fill in any secrets
# you need. `scripts/score-images.ts` and other tools that read
# `process.env` are wired (via Node 20.6+ `process.loadEnvFile`) to
# load this file automatically before any module reads env. The
# ambient shell environment still wins where it's set — `.env` only
# fills holes.
#
# DO NOT COMMIT `.env`. It is gitignored. Treat any leaked key as
# compromised and rotate immediately.

# Anthropic API key — required by the Image Pipeline v2 vision
# scorer (`npm run images:score`). The key is not covered by Claude
# Code subscriptions; this is the paid Anthropic API. See
# `docs/guides/image-pipeline-v2.md` §Prerequisite.
# ANTHROPIC_API_KEY=sk-ant-…

# Optional: pin a non-default Anthropic API base. Leave commented to
# use the production endpoint. Useful if you proxy through a local
# Claude Code router.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Patreon-tier LL2 API key for the 6-hourly launches
# refresh. Anonymous tier (no key) is fine — keys mostly just lift
# the rate cap. See `scripts/fetch-launches.ts`.
# LL2_PATREON_KEY=

# ─── Image source registry (issue #347 — agency-archive registry v2) ──
#
# Optional API keys for Tier 2 institutional image sources. Without
# them the resolver still works — it silently falls through to the
# next tier. With them, the Tier 2 lanes (Smithsonian / NARA) unlock
# their full rate.

# Smithsonian Open Access — CC0 imagery from NASM (Apollo / Mercury
# / Gemini / Skylab / Shuttle / Soviet hardware) + 18 other museums.
# Free key from https://api.data.gov/signup/ (30 seconds, instant).
# Without key: resolver uses DEMO_KEY, rate-limited to 30 req/hour
# globally — quickly throttles into Tier 3 fallback.
# SI_API_KEY=

# NARA (US National Archives) RG 255 — 1M+ NASA/NACA photos
# 1903-2011, PD-USGov. Free key by emailing Catalog_API@nara.gov
# with name + email. Rate: 10,000 req/month per key. Without key:
# resolver skips NARA tier entirely and falls through.
# NARA_API_KEY=

# ─── Audio narration (PRD-016 / RFC-019) ───────────────────────────
#
# Per-provider keys for the TTS pipeline (`npm run audio:generate`).
# `TTS_PROVIDER` selects which provider voices a given (locale,
# persona) when voices.json has rows under it. Free / paid mix per
# RFC-019 §4.3 — Google free tier for the bulk of the corpus,
# ElevenLabs for the 8 Atmospheric Moves anchor takes.
# Cost guard: `npm run audio:check-cost` enforces $50/mo soft warn,
# $200/mo hard halt (PRD-016 §resolved-decisions item 11).

# Active provider (default: google). One of: google, elevenlabs, openai, azure.
# TTS_PROVIDER=google

# Google Cloud Text-to-Speech — REST API auth. Get a key in GCP
# console → APIs & Services → Credentials → "Create credentials" →
# "API key". Then "Restrict key" → "API restrictions" → "Restrict key"
# → check ONLY "Cloud Text-to-Speech API" so a leak can't reach other
# Google APIs. Free tier covers ~1 M chars/mo Neural2/WaveNet for the
# first 12 months — more than the entire en-US v1 corpus.
# GOOGLE_TTS_API_KEY=

# ElevenLabs — voices the 8 Atmospheric Moves anchor episodes for
# the editorial-anchor takes. Paid (~$15 one-shot for the v0.7
# anchor set). https://elevenlabs.io/app/settings/api-keys.
# ELEVENLABS_API_KEY=

# OpenAI TTS — escape hatch if ElevenLabs pricing changes. ~$30 /
# 1M chars for tts-1-hd. Shares the `OPENAI_API_KEY` env var with
# any other OpenAI-based tooling.
# OPENAI_API_KEY=

# Azure Neural TTS — long-tail-locale fallback if Google doesn't
# carry a locale we need. 0.5 M chars/mo free for first 12 months.
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=eastus

# ─── Observability (RFC-025) ────────────────────────────────────────
#
# Every credential here is OPTIONAL. Empty / unset values mean the
# corresponding integration short-circuits and emits zero outbound
# traffic. This is what makes forks silent by default.
#
# DO NOT commit working DSNs / API keys to the repo. The
# `scripts/check-no-secrets.ts` preflight gate scans the staged diff
# for Sentry DSN + Grafana Cloud API key patterns and blocks commits
# that leak them.

# Sentry/GlitchTip — client-side JS error tracking. PUBLIC_ prefix means
# SvelteKit injects this into the client bundle at build time (the DSN is
# public-by-design — it identifies the project rather than authenticating).
# Leave empty for forks + local dev; set in GitHub Actions secrets for the
# prod build only. See `docs/adr/ADR-067.md`.
#
# Target = the self-hosted GlitchTip (project 4), via the public ingest-only
# vhost telemetry.orrerylearn.com on the shared Caddy edge — NOT the tailnet
# homelab:8090 (unreachable for public browsers), and NOT Sentry.io SaaS. https
# only (browsers block mixed-content POSTs). The public key ships in the bundle
# by design; it's kept in the prod GH secret only to keep the repo clean. The
# edge is live + validated; set the prod secret PUBLIC_SENTRY_DSN to the DSN
# below. See podcast_scraper-infra ORRERY-GLITCHTIP-CLIENT-ERRORS-BRIEF.
#
# GOTCHA — strip the dashes from the GlitchTip key. GlitchTip shows the project
# key as a dashed UUID (9b69bd79-85fa-...), but the @sentry SDK's DSN parser
# uses \w+ for the public key (NO dashes) and rejects the dashed form as
# "Invalid Sentry Dsn" → transport disabled → zero error reports, SILENTLY. Use
# the 32-hex dashless key; GlitchTip's ingest normalizes it and accepts both.
# PUBLIC_SENTRY_DSN=https://<project-4-key-NO-dashes>@telemetry.orrerylearn.com/4
# PUBLIC_SENTRY_ENVIRONMENT=prod              # dev | staging | prod
# PUBLIC_SENTRY_RELEASE=gha-<short-sha>       # optional release tag for grouping

# Log shipping — NO app-level env vars. The per-app Grafana Cloud Agent is
# retired; logs are shipped by the shared node Grafana Alloy (infra repo,
# ADR-121) to self-hosted VictoriaLogs. Orrery only contributes the config
# fragment ops/observability/orrery.alloy (dropped into /etc/alloy/config.d/
# on the box, tailnet-only). Nothing to set here. See docs/guides/observability.md
# + ADR-068 (superseded). Dashboard import uses GRAFANA_HTTP_URL +
# GRAFANA_API_TOKEN at runtime only (not baked) — see the import.sh header.

# ── MCP server (S4 · #462) ────────────────────────────────────────────────
# Dev bearer for the S4 private scaffold (OAuth 2.1 arrives with #533/#534).
# Unset in production = the server refuses to start. Staged on the VPS as
# ORRERY_MCP_DEV_BEARER (compose maps it to MCP_DEV_BEARER).
ORRERY_MCP_DEV_BEARER=
# Tuning (defaults shown): requests/min per token · concurrent computes.
ORRERY_MCP_RATE_LIMIT_PER_MIN=60
ORRERY_MCP_MAX_CONCURRENT=4
