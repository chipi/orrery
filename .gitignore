# Visual baselines are CI-platform (linux) only. Don't commit
# maintainer-machine snapshots (darwin / win32) — they drift from
# CI baselines and produce confusion (2026-05-22 lesson).
tests/e2e/visual.spec.ts-snapshots/*-darwin.png
tests/e2e/visual.spec.ts-snapshots/*-win32.png

# Vitest coverage (@vitest/coverage-v8, S1)
coverage/

# Image Pipeline v2 cache — per-image scoring + variant caches
# (PRD-018 / RFC-022 §5). Regenerated by `npm run images:score`.
.image-cache/

# Launches Calendar pipeline cache — per-source raw responses
# (PRD-020 / RFC-023 §6). Regenerated by `npm run fetch:launches`.
.launches-cache/

# Launches Calendar audit report — gitignored dev-only artefact
# (PRD-020 / RFC-023 §10). Regenerated by `npm run audit:launches`.
static/audit-report-launches.html

# Image Pipeline v2 audit report — gitignored dev-only artefact
# (RFC-022 §8). Regenerated on every scoring run.
static/data/audit-report.html
static/audit-report.html

# Claude Code local state (per-user; runtime locks etc.)
.claude/

# lean-ctx MCP server cache (per-session; not source)
.lean-ctx/

# Slice A v3 approval decisions — live state written by the dev
# /dev/slice-a-review route. Consumed by scripts/slice-a-apply.mjs
# via --approvals=…; not source of truth in git (regenerated per
# review session).
static/data/slice-a-approvals.json

