,472],9.4714,-7477,-4131,[474,475,68,476],9.5743,-6707,-4534,[478,479,68,480],9.6773,-5977,-4874,[482,483,68,484],9.7802,-5282,-5160,[486,487,68,488],9.8832,-4617,-5399,[490,491,68,492],9.9861,-3977,-5597,[494,495,68,496],10.192,-2758,-5884,[498,495,68,496],10.1921,{"entry_velocity_km_s":500,"edl_system":501,"edl_duration_s":502,"touchdown_velocity_ms":503},1.697,"powered",717,0.6,[505,510,515,520,525,530,535,540,544,549],{"met_days":68,"type":506,"label":507,"description":508,"label_en":509},"launch","الإطلاق","Saturn V (AS-507) من مركز كينيدي للفضاء LC-39A في 1969-11-14 16:22 UTC. ضربتا برق على الصاروخ (T+36 ث، T+52 ث) أوقفت خلايا الوقود؛ تم التعافي منهما عبر مكالمة «SCE to AUX».","Launch — Saturn V",{"met_days":76,"type":511,"label":512,"description":513,"label_en":514},"tli_or_tmi","TLI","الحقن نحو القمر — تم التحقق من التعافي من صواعق البرق؛ أُعطيت المهمة الضوء الأخضر للتوجه إلى القمر.","Trans-lunar injection",{"met_days":119,"type":516,"label":517,"description":518,"label_en":519},"tcm","MCC-2 — تصحيح منتصف المسار","إشعال محرك SPS عند GET 30:52:44 (1969-11-15 23:14 UTC)، 61.8 قدم/ث (18.8 م/ث)، نقل Apollo 12 من مسار العودة الحرة إلى المسار الهجين غير المضمون العودة الحرة اللازم للهبوط الدقيق.","MCC-2 — midcourse correction",{"met_days":203,"type":521,"label":522,"description":523,"label_en":524},"loi","LOI","الدخول في المدار القمري. SPS ∆v ≈0.89 km/s.","Lunar orbit insertion",{"met_days":257,"type":526,"label":527,"description":528,"label_en":529},"descent_start","الهبوط","Intrepid تهبط في محيط العواصف (محطة كوغنيتوم) في 1969-11-19 06:54 UTC — على بُعد 163 م فقط من Surveyor 3 (الهبوط القمري الأدق حتى ذلك الحين).","LM Intrepid powered descent",{"met_days":317,"type":531,"label":532,"description":533,"label_en":534},"ascent","الصعود","تقلع إنتريبد بعد 31 س 31 د على السطح. أُعيد 34 كغ من العينات.","LM Intrepid ascent",{"met_days":382,"type":536,"label":537,"description":538,"label_en":539},"tei","TEI","الحقن نحو الأرض. دلتا-في لمحرك SPS نحو 1.0 كم/ث.","Trans-earth injection",{"met_days":406,"type":516,"label":541,"description":542,"label_en":543},"تصحيح منتصف المسار أثناء العودة إلى الأرض 1","تصحيح صغير عند GET 188:27:16 (1969-11-22 12:49 UTC)؛ ويتبعه تصحيح ثانٍ عند GET 241:22:00.","Trans-earth midcourse correction 1",{"met_days":545,"type":516,"label":546,"description":547,"label_en":548},10.057,"تصحيح منتصف المسار أثناء العودة إلى الأرض 2","تعديل أخير لممر الدخول الجوي عند GET 241:22:00 (1969-11-24 17:44 UTC)، قبل نحو 3 ساعات من انفصال وحدة القيادة.","Trans-earth midcourse correction 2",{"met_days":494,"type":550,"label":551,"description":552,"label_en":553},"earth_return","الانزلاق","هبطت وحدة القيادة هبوطًا مائيًا في جنوب المحيط الهادئ في 1969-11-24 20:58 بالتوقيت العالمي. جرى الانتشال بواسطة USS Hornet.","Splashdown — Pacific Ocean","Apollo 12","هابط مأهول · أُطلقت","ثاني هبوط مأهول على القمر — هبوط دقيق على بعد 163 م من Surveyor 3","إن كانت Apollo 11 قد أثبتت أن بلوغ القمر ممكن، فقد أثبتت Apollo 12 أن بلوغ موضع بعينه عليه ممكن أيضًا. بعد 36 ثانية من الإقلاع ضرب البرق الصاروخ وأطفأ أجهزة المركبة؛ فاستحضر مراقب شاب يُدعى جون هارون من ذاكرته إصلاحًا غامضًا — «SCE to AUX» — واستمرت الرحلة. ثم هبط كونراد وبين بالوحدة القمرية على محيط العواصف على بُعد بضع مئات من الأقدام من مسبار كان قابعًا هناك منذ سنتين، ومشيا إليه وعادا بقطع منه إلى الوطن. كانت تلك الدقة هي النتيجة الحقيقية: لم يعد القمر وجهة، بل صار عنوانًا.","الهبوط الثاني المأهول على القمر. ضرب البرق Saturn V مرتين خلال الصعود (T+36 ث و T+52 ث) — فأعاد بين المركبة إلى العمل بفضل النداء الشهير «SCE to AUX» من مهندس EECOM جون هارون، ثم أعاد الطاقم محاذاة وحدة القياس بالقصور الذاتي في المدار القمري. ونفذ كونراد وبين هبوطًا بالغ الدقة على محيط العواصف على بعد 163 م من Surveyor 3 (الذي هبط هبوطًا ناعمًا في أبريل 1967)، ثم مشيا إلى Surveyor 3 وأزالا منه كاميرته وعينة من سطحه — قطعًا عادت إلى الأرض لتحليل أثر التعرض الطويل الأمد لسطح القمر. ونشرا ALSEP (حزمة تجارب سطح القمر الكاملة في برنامج Apollo — أول ALSEP، مقابل EASEP الأبسط في Apollo 11) التي أرسلت بياناتها 8 سنوات. وأعادت المهمة 34 كغ من العينات، منها بازلت بحار القمر الداكن.",[560,561,562],{"met":119,"label":517,"description":518},{"met":406,"label":541,"description":542},{"met":545,"label":546,"description":547},[564,566,568,569,571,576,577,581,582],{"met":68,"label":507,"note":508,"type":565},"warning",{"met":76,"label":512,"note":513,"type":567},"nominal",{"met":203,"label":522,"note":523,"type":567},{"met":570,"label":527,"note":528,"type":567},4.607,{"met":572,"label":573,"note":574,"type":575},5.58,"زيارة سوركفيور 3","كونراد + بين يمشيان إلى Surveyor 3 (على بُعد ~163 م)، ويزيلان كاميرته التلفزيونية + عينات لإعادتها إلى الأرض — المرة الأولى التي يزور فيها طاقم مركبة فضائية روبوتية سبق أن هبطت.","info",{"met":317,"label":532,"note":533,"type":567},{"met":578,"label":579,"note":580,"type":575},6.25,"تأثير وحدة الهبوط","تحطمت مرحلة صعود إنتريبد عمدًا على القمر لمعايرة مقاييس الزلازل ALSEP — وهي أول مرحلة مركبة فضائية من مهمة مأهولة تصطدم بالقمر عمدًا ويسجّل ارتطامها مقياس زلازل على السطح.",{"met":382,"label":537,"note":538,"type":567},{"met":494,"label":551,"note":552,"type":567},"/orrery/images/missions/apollo12/01.webp"],"uses":{"params":["id"]}}]}
