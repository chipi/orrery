نب البعيد. وتعمل المركبة الجوالة Yutu-2 منذ يناير 2019 وقد قطعت نحو 1.6 كم حتى عام 2024، ما يجعلها أطول مركبة جوالة قمرية عملًا في التاريخ.",[515,517,518,519],{"met":66,"label":68,"note":69,"type":516},"nominal",{"met":93,"label":95,"note":96,"type":516},{"met":12,"label":100,"note":101,"type":516},{"met":520,"label":521,"note":522,"type":523},27.01,"نُشِرَ YUTU-2","ينزلق الروفر من المنحدر.","info",[525,526,527,528],{"met":76,"label":78,"description":79},{"met":81,"label":82,"description":83},{"met":85,"label":86,"description":83},{"met":88,"label":89,"description":90},"/orrery/images/missions/change4/07.webp"],"uses":{"params":["id"]}}]}
