":74,"type":506},{"met":77,"label":79,"note":80,"type":506},{"met":87,"label":88,"note":89,"type":506},{"met":15,"label":97,"note":98,"type":506},{"met":101,"label":103,"note":104,"type":506},{"met":513,"label":514,"note":515,"type":516},254.01,"الصور الأولى","Hazcam ترجع أول صورة منخفضة الدقة للسطح.","info",[518,519],{"met":83,"label":84,"description":85},{"met":91,"label":92,"description":93},"/orrery/images/missions/curiosity/01.webp"],"uses":{"params":["id"]}}]}
