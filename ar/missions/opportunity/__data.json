69,470,61,471],197.1079,0.906815,1.222136,[473,474,61,475],199.2504,0.886187,1.238248,[95,477,61,478],0.859187,1.258307,[480,481,61,482],203.5353,0.853481,1.262185,[484,481,61,482],205.6778,[486,481,61,482],207.8203,[488,481,61,482],209.9628,[490,481,61,482],212.1053,"Opportunity","مركبة المريخ الجوالة · أُطلقت","حملت الرقم القياسي للمسافة على المريخ (45.16 كم) حتى تجاوزته Perseverance في أكتوبر 2026؛ عمر على السطح بلغ 14 سنة مقابل تصميم لـ 90 يومًا مريخيًا","قطعت Opportunity ماراثونًا عبر كوكب آخر. هي توأم Spirit، وهبطت عام 2004 في مهمة مدتها تسعون يومًا، فعملت أربع عشرة سنة وقطعت أكثر من خمسة وأربعين كيلومترًا — أطول مسافة قطعتها أي مركبة على أي عالم حتى تجاوزتها Perseverance في أكتوبر 2026. هبطت، بمحض الحظ، في فوهة صغيرة كشفت جدرانها بالضبط الصخور التي ترسبت في الماء والتي أُرسلت للعثور عليها، ثم واصلت المسير من فوهة إلى فوهة، تقرأ قصة مياه المريخ القديمة ميلًا بعد ميل. وفي النهاية أسكتتها عام 2018 عاصفة غبار غطت الكوكب كله.","أصابت Opportunity (MER-B) جائزة كوكبية كبرى — إذ ارتدّت مركبتها الهابطة المحاطة بشرنقة الوسائد الهوائية 26 مرة عبر سهل ميريديان ثم تدحرجت إلى فوهة قطرها 22 م (فوهة إيغل) بمحض الحظ، تحيط بها صخور القاعدة المكشوفة التي تستطيع مركبة جوالة قراءتها دون الحاجة إلى القيادة. أظهرت الصور الأولى الجاروسيت وتكتلات الهيماتيت المسماة «التوت الأزرق»، وهي أقوى دليل معدني حتى ذلك الحين على وجود ماء سائل راكد على المريخ المبكر. وعلى مدى 14 سنة و138 يومًا (5,111 يومًا مريخيًا) قطعت Opportunity مسافة 45.16 كم — الرقم القياسي لماراثون المركبات الجوالة على المريخ الذي صمد حتى تجاوزته Perseverance في أكتوبر 2026 — وزارت فوهات إندورانس وفكتوريا وإنديفور. وفي يونيو 2018 حجبت عاصفة غبار كوكبية ضوء الشمس عن ألواحها الشمسية؛ وكان آخر إرسال في 2018-06-10، وأعلنت NASA انتهاء المهمة في 2019-02-13.",[497,499,500,501,503,507,512],{"met":61,"label":63,"note":64,"type":498},"nominal",{"met":71,"label":73,"note":74,"type":498},{"met":85,"label":86,"note":87,"type":498},{"met":12,"label":91,"note":92,"type":502},"info",{"met":504,"label":505,"note":506,"type":502},202.01,"الهبوط — داخل فوهة إيغل","ارتدت 26 مرة. دخلت فوهة قطرها 22 مترًا مصادفةً، محاطة بصخر أساسي مكشوف.",{"met":508,"label":509,"note":510,"type":511},5452,"آخر إرسال","2018-06-10. عاصفة غبار كوكبية تقطع الطاقة الشمسية.","warning",{"met":513,"label":514,"note":515,"type":511},5700,"نهاية المهمة","تعلن NASA عن نهاية المهمة في 2019-02-13. قطعت مسافة 45.16 كم.",[517,518],{"met":77,"label":78,"description":79},{"met":81,"label":82,"description":83},"/orrery/images/missions/opportunity/06.webp"],"uses":{"params":["id"]}}]}
