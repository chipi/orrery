# orrery prod compose env — GH #260 / #261.
#
# Committed defaults for the prod deploy on the shared VPS. Loaded
# by docker compose via `--env-file compose/.env.prod` (deploy
# workflow) AND by `pipeline-runner.env_file` inside
# docker-compose.prod.yml.
#
# Per-deploy SHA tag is NOT pinned here — the deploy workflow sets
# ORRERY_PIPELINE_IMAGE_TAG inline on the docker compose CLI
# (shell env wins over --env-file), so a green workflow run rolls
# `:main` forward to `:sha-<7>`. This file's value is the safe
# fallback if someone runs compose manually on the VPS.
#
# Operator secrets (Sentry DSN, Grafana Cloud creds — ADR-067 /
# ADR-068) are intentionally NOT here. They are blank by default;
# wire them when needed via a separate untracked /srv/orrery/.env
# referenced as a second env_file in a future amendment.

COMPOSE_PROJECT_NAME=orrery
ORRERY_PORT=8090
ORRERY_PIPELINE_IMAGE_TAG=main
