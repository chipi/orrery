  "flight": {
    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Delta II 7925H",
        "description": "Cape Canaveral, 2007-09-27. First spacecraft designed to orbit two destinations — only possible because of NSTAR ion engines (xenon propellant) providing 10× the specific impulse of chemical thrust. The low-thrust trajectory takes years to build the velocity changes needed but uses 10× less propellant."
      },
      {
        "met_days": 510,
        "type": "flyby",
        "label": "Mars — gravity assist",
        "description": "Closest approach 542 km on 2009-02-18. The Mars assist added ~2.6 km/s — enough to reach asteroid Vesta after another 2 years of ion-thrust spiralling. Without the assist, Dawn would have needed twice the propellant load or twice the cruise time."
      },
      {
        "met_days": 1388,
        "type": "arrival",
        "label": "Vesta orbit insertion",
        "description": "Captured into Vesta orbit on 2011-07-16 via continuous ion-thrust gravitational capture — no chemical orbit-insertion burn was needed because the ion thrust handled the gradual approach. Spent 14 months in Vesta orbit, mapping the 530-km-diameter differentiated proto-planet and confirming the south-polar Rheasilvia impact basin as the source of HED meteorites that reach Earth."
      },
      {
        "met_days": 1805,
        "type": "tli_or_tmi",
        "label": "Vesta departure — ion-thrust spiral to Ceres",
        "description": "Departed Vesta on 2012-09-05. Ion engines spiralled outward over 2.5 years toward Ceres — the first interplanetary transfer ever executed under continuous low thrust between two bodies. The trajectory used ~112 kg of xenon."
      },
      {
        "met_days": 2717,
        "type": "arrival",
        "label": "Ceres approach",
        "description": "Approach phase begins ~2015-02. Dawn observed Ceres's bright spots in Occator crater for weeks before formal orbital capture, revealing them as briny salt deposits — evidence of a subsurface aqueous reservoir on the dwarf planet."
      },
      {
        "met_days": 2717.53,
        "type": "edl_or_oi",
        "label": "Ceres orbit insertion",
        "description": "Captured into Ceres orbit on 2015-03-06 — the first spacecraft to orbit a dwarf planet, and the first to orbit two extraterrestrial bodies. Spiralled down to a 35-km low-altitude mapping orbit by 2018. Ran out of hydrazine for attitude control on 2018-10-31; the spacecraft remains in stable Ceres orbit, a long-term protected planetary monument under planetary-protection rules."
      }
    ],
