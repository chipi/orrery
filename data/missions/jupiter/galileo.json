  "flight": {
    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — STS-34 Atlantis / IUS",
        "description": "Cape Canaveral, 1989-10-18. Deployed from the Space Shuttle bay above the Atlantic and boosted by the Inertial Upper Stage — the post-Challenger replacement for the originally-planned Centaur G upper stage, which had been banned from the Shuttle for safety reasons. The lower-energy IUS forced a 6-year VEEGA cruise instead of a direct 2-year transfer."
      },
      {
        "met_days": 115,
        "type": "flyby",
        "label": "Venus — gravity assist",
        "description": "Closest approach 16,000 km from Venus on 1990-02-10. The VEEGA (Venus-Earth-Earth Gravity Assist) profile starts here, stealing orbital energy from Venus to raise Galileo's aphelion outward. The thermal load near Venus exceeded the original mission spec; engineers added insulation on the antenna boom that later kept the high-gain antenna stuck closed."
      },
      {
        "met_days": 416,
        "type": "flyby",
        "label": "Earth #1 — gravity assist",
        "description": "Closest approach 960 km on 1990-12-08. First of two Earth flybys; combined they will bend the trajectory enough to reach Jupiter. Galileo also returned spectral observations of Earth as a test case for life-detection methods — analysing your own planet as if from afar."
      },
      {
        "met_days": 741,
        "type": "flyby",
        "label": "Gaspra — first asteroid encounter",
        "description": "Closest approach 1,600 km from asteroid 951 Gaspra on 1991-10-29. The first close-up images of an asteroid by any spacecraft. Gaspra's irregular shape, ~20 km long, suggested it was a collision fragment from a larger parent body — confirming early Solar System collision histories."
      },
      {
        "met_days": 1147,
        "type": "flyby",
        "label": "Earth #2 — gravity assist",
        "description": "Closest approach 304 km on 1992-12-08 — the final assist needed to reach Jupiter. Used the encounter to test the high-gain antenna deployment one more time (it would not fully open; the mission ran on the low-gain antenna for the rest of its life, requiring extensive data-compression workarounds)."
      },
      {
        "met_days": 1410,
        "type": "flyby",
        "label": "Ida + Dactyl — second asteroid encounter",
        "description": "Closest approach 2,400 km from asteroid 243 Ida on 1993-08-28. Discovered Ida's tiny moon Dactyl (1.4 km diameter) — the first confirmed binary asteroid system. Confirmed that asteroids could host satellites stably, reshaping models of asteroid dynamics."
      },
      {
        "met_days": 2242,
        "type": "arrival",
        "label": "Probe release",
        "description": "Galileo's atmospheric probe separated 5 months before Jupiter arrival, on 1995-07-13, on a slightly-different ballistic trajectory targeting the giant planet's atmosphere. The probe carried no propulsion — its arrival geometry was set entirely by the separation manoeuvre."
      },
      {
        "met_days": 2243,
        "type": "edl_or_oi",
        "label": "Jupiter orbit insertion + probe descent",
        "description": "1995-12-07. The probe entered Jupiter's atmosphere at 47.4 km/s, survived peak deceleration of 228 g, deployed a parachute, and transmitted for 58 minutes from 0.6 to 22 bar pressure before melting. Galileo simultaneously fired its main engine for 49 minutes to capture into Jupiter orbit — the first Jupiter orbiter, beginning an 8-year tour of the moons that confirmed liquid water under Europa's ice."
      }
    ],
