    },
    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Atlas SLV-3C / Centaur",
        "description": "Cape Canaveral LC-36B, 1971-05-30. Twin to Mariner 8 (lost in the Atlantic three weeks earlier when its Centaur failed). Mariner 9 alone carried the orbital science load originally split across the pair — a single spacecraft to map the entire planet from orbit, the first attempt of its kind."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "Centaur D-1A upper stage burn places Mariner 9 on a 167-day Type-I transfer to Mars."
      },
      {
        "met_days": 5,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First mid-course correction, removing the launch dispersion."
      },
      {
        "met_days": 98,
        "type": "tcm",
        "label": "TCM-2",
        "description": "Final approach trim. Pin-targeting the periapsis pass for the MOI burn."
      },
      {
        "met_days": 168,
        "type": "arrival",
        "label": "Mars approach",
        "description": "1971-11-14. Mariner 9 closed on Mars to find the entire planet shrouded in the largest global dust storm in recorded observation — only the four Tharsis volcano summits poked through the haze."
      },
      {
        "met_days": 168.005,
        "type": "edl_or_oi",
        "label": "Mars orbit insertion — first ever",
        "description": "15-minute solid-motor burn at 00:18 UT 1971-11-14 placed Mariner 9 into a 1398 × 17,917 km, 64.4°-inclination orbit — the first spacecraft of any nation to orbit another planet, beating Soviet Mars 2 by 13 days. The storm cleared by January; over the next 11 months Mariner 9 returned 7,329 images covering ~85% of the Martian surface, discovering Olympus Mons (the largest volcano in the solar system), Valles Marineris (the canyon system that bears its name), and the first close-ups of Phobos + Deimos."
      },
      {
        "met_days": 515,
        "type": "anomaly",
        "label": "End of mission",
        "description": "1972-10-27. Mariner 9 ran out of attitude-control gas. Powered down in a parking orbit it remains in today — expected atmospheric re-entry around 2050."
      }
    ],
