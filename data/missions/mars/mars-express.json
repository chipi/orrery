    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Soyuz-FG / Fregat",
        "description": "Baikonur Cosmodrome, 2003-06-02. ESA's first Mars mission, launched on a Russian Soyuz under a cooperative contract. Carried the Beagle 2 lander, designed by the UK's Beagle Project. Mars Express is still operational, one of the longest-running Mars orbiters (after Mars Odyssey)."
      },
      {
        "met_days": 0.064,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "Fregat upper stage burn at T+90 minutes sends Mars Express on a 6.5-month Hohmann-like transfer."
      },
      {
        "met_days": 2,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First post-TMI cleanup."
      },
      {
