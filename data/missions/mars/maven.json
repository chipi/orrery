    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Atlas V 401",
        "description": "Cape Canaveral, 2013-11-18. MAVEN (Mars Atmosphere and Volatile EvolutioN) was designed to characterise how Mars lost its atmosphere — measuring the present-day atmospheric-escape rates that scaled backward in time explain how the planet went from a wet, dense atmosphere ~3.8 Gyr ago to today's thin CO₂ shell."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "Centaur upper stage burn sets MAVEN on a 10-month transfer to Mars."
      },
      {
        "met_days": 30,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First post-TMI dispersion cleanup. ~30 days after launch is the standard for the first refinement burn."
      },
      {
        "met_days": 55,
        "type": "tcm",
        "label": "TCM-2",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 94.6,
        "type": "tcm",
