      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Delta II 7925",
        "description": "Cape Canaveral LC-17A, 2003-06-10. First of the twin Mars Exploration Rovers — Spirit (MER-A) leaves three weeks before its twin Opportunity (MER-B). Designed for a 90-Mars-sol primary mission; would survive 2,210 sols on the surface."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "PAM-D solid upper-stage burn sends Spirit on a 7-month Type-I transfer to Mars."
      },
      {
        "met_days": 15,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First mid-course correction. Removes launch dispersion."
      },
      {
        "met_days": 80,
        "type": "tcm",
        "label": "TCM-2",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 165,
        "type": "tcm",
        "label": "TCM-3",
        "description": "Approach-phase trim toward Gusev Crater target ellipse."
      },
      {
        "met_days": 200,
        "type": "tcm",
        "label": "TCM-4 — final pre-EDL",
        "description": "Final trim before the atmospheric entry interface."
      },
      {
        "met_days": 208,
        "type": "arrival",
        "label": "Mars approach + cruise-stage separation",
        "description": "2004-01-03. Cruise stage jettisoned 15 minutes before entry; backshell + heat shield + lander bounce-cushion entered Mars's atmosphere at 5.4 km/s."
      },
      {
        "met_days": 208.005,
        "type": "edl_or_oi",
        "label": "Mars EDL — airbag landing in Gusev Crater",
        "description": "\"Six minutes from hell.\" Heat shield braked from 5.4 km/s to Mach 1.8; parachute deployed at 8.5 km altitude; retrorockets fired 12 m up; airbag-cocooned lander dropped, bounced 28 times across the crater floor, and rolled to a stop 250 m from its first impact at 14.57°S, 175.47°E in Gusev Crater. Spirit rolled off the lander petals six sols later. Found hematite-bearing rocks in the Columbia Hills suggesting persistent water. Stuck in soft sulphate-rich soil at \"Troy\" 2009-04; mission declared ended 2011-05-25."
      }
    ],
