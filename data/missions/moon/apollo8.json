    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Saturn V",
        "description": "Kennedy Space Center, 1968-12-21 12:51:00 UTC (7:51 a.m. EST). Saturn V AS-503 lifts Borman, Lovell and Anders into a 98 x 103 nmi Earth parking orbit 11 min 35 s later,."
      },
      {
        "met_days": 0.118,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "S-IVB reignites at GET 2:50:37 (1968-12-21 15:41 UTC) for a 319-second burn that sends the first crew toward the Moon."
      },
      {
        "met_days": 0.458,
        "type": "tcm",
        "label": "Midcourse correction",
        "description": "SPS burn at GET 10:59:59 (1968-12-21 23:50 UTC), 24.8 ft/s (7.6 m/s), lowering the planned pericynthion from 459 to 66.3 nmi."
      },
      {
        "met_days": 2.542,
        "type": "tcm",
        "label": "Midcourse correction",
        "description": "RCS trim at GET 60:59:56 (1968-12-24 01:50 UTC), 1.4 ft/s (0.4 m/s), refining the lunar orbit insertion conditions."
      },
      {
        "met_days": 2.881,
        "type": "loi",
        "label": "Lunar orbit insertion",
        "description": "1968-12-24 09:59 UTC, GET 69:08:20. A 246.9-second SPS burn behind the Moon captures Apollo 8 into a 168.5 x 60.0 nmi lunar orbit; a circularization at GET 73:35:07 follows to 59.7 x 60.7 nmi."
      },
      {
        "met_days": 3.722,
        "type": "tei",
        "label": "Trans-earth injection",
        "description": "1968-12-25 06:10 UTC, GET 89:19:17. A 204-second SPS burn on the far side ends 20 h 11 min and ten revolutions in lunar orbit and sends the crew home."
      },
      {
        "met_days": 4.333,
        "type": "tcm",
        "label": "Trans-earth midcourse correction",
        "description": "The only trans-earth correction (the report calls it the third), 4.8 ft/s (1.5 m/s) at GET 103:59:54, 1968-12-25 20:50 UTC."
      },
      {
        "met_days": 6.125,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "1968-12-27 15:51 UTC, GET 147:00:42. The command module enters at 146:46:13 and lands under parachutes, closing the 6.1-day first crewed flight to the Moon."
      }
    ]
