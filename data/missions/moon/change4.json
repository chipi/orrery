      },
      {
        "met_days": 5,
        "type": "tcm",
        "label": "MCC-4 — final pre-LOI",
        "description": "Final approach targeting before lunar orbit insertion."
      },
      {
        "met_days": 5,
        "type": "arrival",
        "label": "Lunar orbit insertion",
        "description": "2018-12-12. Captured into a 100 × 400 km lunar orbit. CNSA spent ~22 days adjusting the orbit + waiting for sunlight conditions at the target landing site."
      },
      {
        "met_days": 27,
        "type": "edl_or_oi",
        "label": "Lunar far-side landing — Von Kármán crater",
        "description": "2019-01-03. Powered descent + landing at Von Kármán crater (45.5°S, 177.6°E) inside the South Pole-Aitken basin — first soft landing on the Moon's far side. Yutu-2 rover deployed and is still operating, the longest-lived lunar rover in history."
      }
