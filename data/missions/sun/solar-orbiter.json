    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Atlas V 411",
        "description": "Cape Canaveral SLC-41, 2020-02-10. ESA-led mission with NASA launch + one instrument contribution. Solar Orbiter is the first spacecraft designed to image the Sun's polar regions in detail — a view inaccessible from Earth or any prior ecliptic-bound observatory."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Venus injection",
        "description": "Centaur upper stage burn places Solar Orbiter onto a Venus-encounter trajectory for the inclination-shaping phase."
      },
      {
        "met_days": 60,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First mid-course correction."
      },
      {
        "met_days": 125,
        "type": "arrival",
        "label": "First perihelion (P1)",
        "description": "2020-06-15. First close approach: 0.51 AU (~109 R☉). Initial science observations during Mercury's neighbourhood."
      },
      {
        "met_days": 1000,
        "type": "flyby",
        "label": "Venus gravity assist 2",
        "description": "2022-09-04. Second VGA tilts the orbital plane upward, beginning the climb out of the ecliptic toward the polar viewing geometry."
      },
      {
        "met_days": 1075,
        "type": "edl_or_oi",
        "label": "Closest perihelion to date (P4)",
        "description": "2022-10-12. Reached 0.29 AU (~62 R☉) — within Mercury's perihelion distance. First close-approach observations using the full instrument suite."
      },
      {
        "met_days": 1750,
        "type": "flyby",
        "label": "Venus gravity assist 4",
        "description": "2025-02. Fourth VGA continues raising heliographic latitude toward ~17° (extended mission target ~33°)."
      },
      {
        "met_days": 2200,
        "type": "edl_or_oi",
        "label": "First high-latitude polar imaging",
        "description": "2025 onwards. Heliographic latitude exceeds 17° — the first close-up imaging of the Sun's polar magnetic field structures. The polar geometry is the unique scientific deliverable, complementary to Parker Solar Probe's in-corona measurements at low latitude."
      }
    ],
