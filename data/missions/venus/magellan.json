    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — STS-30 / Atlantis + IUS",
        "description": "Kennedy Space Center LC-39B, 1989-05-04. Magellan was the first planetary spacecraft launched from the Space Shuttle bay. Shuttle Atlantis released the stack at low Earth orbit; the Inertial Upper Stage solid motor then fired for trans-Venus injection — the first IUS use for a planetary mission."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Venus injection",
        "description": "IUS solid-motor burn places Magellan onto a Type-IV trajectory — 1.5 solar revolutions before Venus arrival, the unusual long-duration profile dictated by the IUS's modest energy and the launch-window constraints of the post-Challenger Shuttle manifest."
      },
      {
        "met_days": 60,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First mid-course correction."
      },
      {
        "met_days": 175,
        "type": "tcm",
        "label": "TCM-2",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 325,
        "type": "tcm",
        "label": "TCM-3",
        "description": "Approach-phase trim."
      },
      {
        "met_days": 455,
        "type": "tcm",
        "label": "TCM-4 — final pre-VOI",
        "description": "Final trim before Venus orbit insertion."
      },
      {
        "met_days": 463,
        "type": "arrival",
        "label": "Venus approach",
        "description": "1990-08-10. Magellan closes on Venus after 15 months and 1.5 solar revolutions on a Type-IV transfer."
      },
      {
        "met_days": 463.005,
        "type": "edl_or_oi",
        "label": "Venus orbit insertion",
        "description": "Solid-motor VOI burn placed Magellan into a highly elliptical 295 × 8543 km, 85.5°-inclination near-polar orbit. Over four mapping cycles + an aerobraking phase that lowered the orbit, Magellan's synthetic-aperture radar mapped 98% of Venus's surface at ~120-m resolution — the most complete planetary radar survey ever flown. Discovered tessera highlands, coronae, pancake domes, and confirmed the relative absence of impact craters (a young surface, repaved by global volcanism)."
      },
      {
        "met_days": 1988,
        "type": "anomaly",
        "label": "Termination Experiment",
        "description": "1994-10-13. Mission deliberately ended by lowering periapsis into the atmosphere — the first planned controlled atmospheric entry of a planetary spacecraft. Atmospheric drag data from the descent informed Venus atmosphere modelling. Final signal lost as the spacecraft burned."
      }
    ],
