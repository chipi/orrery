{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deep-sky-object.schema.json",
  "title": "Deep-sky object catalogue (PRD-030 / RFC-032, Slice 4)",
  "description": "Messier set + curated-gallery NGC/IC objects, joined from the vendored OpenNGC snapshot to static/data/deep-sky.json. Placement is a unit sky-sphere direction (RA/Dec → xyz, Local-Group billboard convention); real distance drives the panel, not xyz. photoKey is set when a curated gallery photo backs the object; catalogue-only objects render as labelled dots and keep dist_ly null rather than guess.",
  "type": "object",
  "required": ["_count", "objects"],
  "additionalProperties": false,
  "properties": {
    "_generated": { "type": "string" },
    "_source": { "type": "string" },
    "_count": { "type": "integer", "minimum": 1 },
    "_withPhoto": { "type": "integer", "minimum": 0 },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "designation",
          "name",
          "category",
          "ra",
          "dec",
          "x",
          "y",
          "z",
          "mag",
          "size_arcmin",
          "con",
          "dist_ly",
          "dist_label",
          "photoKey",
          "photoTitle",
          "gatewaySystem"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "designation": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "galaxy",
              "galaxy-cluster",
              "nebula",
              "planetary-nebula",
              "supernova-remnant",
              "star-forming-region",
              "dark-nebula",
              "star-cluster",
              "globular-cluster",
              "star",
              "other"
            ]
          },
          "ra": { "type": "number", "minimum": 0, "maximum": 360 },
          "dec": { "type": "number", "minimum": -90, "maximum": 90 },
          "x": { "type": "number", "minimum": -1, "maximum": 1 },
          "y": { "type": "number", "minimum": -1, "maximum": 1 },
          "z": { "type": "number", "minimum": -1, "maximum": 1 },
          "mag": { "type": ["number", "null"] },
          "size_arcmin": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "con": { "type": "string" },
          "dist_ly": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "dist_label": { "type": ["string", "null"] },
          "photoKey": { "type": ["string", "null"] },
          "photoTitle": { "type": ["string", "null"] },
          "gatewaySystem": { "type": ["string", "null"] }
        }
      }
    }
  }
}
