{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "moon-annotation-photos.schema.json",
  "title": "Photo shown when an Apollo hardware ring is tapped (moon-annotation-photos.json): site id, then annotation id",
  "type": "object",
  "minProperties": 1,
  "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]*$" },
  "additionalProperties": {
    "type": "object",
    "minProperties": 1,
    "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "additionalProperties": {
      "type": "object",
      "required": ["image", "thumb"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "pattern": "^/images/.+\\.webp$" },
        "thumb": { "type": "string", "pattern": "^/images/.+\\.webp$" },
        "nasa_id": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    }
  }
}
