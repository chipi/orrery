{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "museum.schema.json",
  "title": "Museums",
  "description": "Museums where real Orrery hardware is on public display: flown, a flight backup, a test article, a flown part or an unflown sister unit (never a replica or model). PRD-027. Text per locale lives in i18n-src/{locale}/museums/{id}.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "country", "lat", "lon", "website", "holds"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
      "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "lat": { "type": "number", "minimum": -90, "maximum": 90 },
      "lon": { "type": "number", "minimum": -180, "maximum": 180 },
      "website": { "type": "string", "pattern": "^https://" },
      "holds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "kind", "evidence", "checked"],
          "properties": {
            "ref": { "type": "string", "pattern": "^([a-z0-9][a-z0-9-]*[a-z0-9]|/science/history/[a-z0-9-]+)$" },
            "kind": { "type": "string", "enum": ["flown", "backup", "test-article", "flown-part", "sister-unit"] },
            "evidence": { "type": "string", "pattern": "^https://" },
            "checked": { "type": "string", "format": "date" },
            "from": { "type": "string", "format": "date" }
          }
        }
      }
    }
  }
}
