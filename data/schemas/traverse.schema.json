{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "traverse.schema.json",
  "title": "Rover traverse polyline (mars-traverses/ + moon-traverses/)",
  "description": "points are [lat, lon] pairs. stops is optional (absent on rovers without curated stops).",
  "type": "object",
  "required": [
    "rover_id",
    "agency",
    "status",
    "snapshot_date",
    "credit",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "rover_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "agency": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "ENDED"
      ]
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "credit": {
      "type": "string",
      "minLength": 1
    },
    "has_route_patches": {
      "type": "boolean"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": [
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        ],
        "additionalItems": false
      }
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "lat",
          "lon"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "drill",
              "feature",
              "panorama",
              "helicopter",
              "sample"
            ]
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "sol": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
