12],156282,349075,[514,515,65,516],19.2828,-38535,-241246,[518,519,65,520],19.5152,-857,-135808,[522,523,65,524],19.7475,11726,-79841,[526,527,65,528],19.9798,15399,-50150,[530,531,65,532],20.2121,15980,-33087,[534,535,65,536],20.4444,15443,-22477,[538,539,65,540],20.6768,14503,-15442,[542,543,65,544],20.9091,13437,-10530,[546,547,65,548],21.1414,12357,-6954,[550,551,65,552],21.3737,11305,-4262,[554,555,65,556],21.6061,10295,-2178,[558,559,65,560],21.8384,9328,-527,[562,563,65,564],22.0707,8401,806,[566,567,65,568],22.303,7508,1898,[570,571,65,572],22.5354,6640,2805,[118,574,65,575],4954,4205,[577,574,65,575],23.0001,"Chang'e 5","PROBENRÜCKGABE · GEFLOGEN","Erste Mondprobenrückgabe seit 44 Jahren (seit Luna 24, 1976)","Chang'e 5 war die erste Probenrückführung vom Mond seit Luna 24 der Sowjetunion im Jahr 1976 – eine Lücke von 44 Jahren. Die Architektur: Orbiter + Lander + Aufstiegsfahrzeug + Probenrückgabekapsel, alles in einem Start. Der Lander landete auf Mons Rümker, bohrte und schöpfte 1,731 kg Regolith, hob ab, traf sich mit dem Orbiter und koppelte an ihn an (das erste Roboter-Rendezvous auf dem Mond), und die Kapsel kehrte zur Erde zurück. Die Proben stammen aus einer Region, die nur 2 Milliarden Jahre alt ist – viel jünger als jede Apollo- oder Luna-Probe, und schreiben Modelle des Mondvulkanismus neu.",[583,585,586,587,592,593,597],{"met":65,"label":67,"note":68,"type":584},"nominal",{"met":48,"label":96,"note":97,"type":584},{"met":12,"label":101,"note":102,"type":584},{"met":588,"label":589,"note":590,"type":591},8.5,"PROBENAHME","1.731 kg mit Schaufel und Bohrer eingesammelt.","info",{"met":105,"label":107,"note":108,"type":584},{"met":594,"label":595,"note":596,"type":591},13,"RENDEZVOUS","Erstes robotisches Mond-Rendezvous; Probenbehälter zum Orbiter transportiert.",{"met":118,"label":120,"note":121,"type":591},[599,600,601,602,603,604],{"met":75,"label":77,"description":78},{"met":80,"label":81,"description":82},{"met":84,"label":85,"description":82}