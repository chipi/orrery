4,420],176.5353,0.973544,-1.074154,[422,423,54,424],178.8582,0.999305,-1.057321,[426,427,54,428],181.181,1.024584,-1.039977,[430,431,54,432],183.5038,1.049301,-1.022063,[434,435,54,436],185.8267,1.073492,-1.003637,[438,439,54,440],188.1495,1.097181,-0.984741,[442,443,54,444],190.4723,1.120265,-0.965301,[446,447,54,448],192.7952,1.142824,-0.94541,[450,451,54,452],195.118,1.16485,-0.925078,[454,455,54,456],197.4408,1.186253,-0.904251,[458,459,54,460],199.7637,1.207125,-0.88302,[462,463,54,464],202.0865,1.227426,-0.86137,[466,467,54,468],204.4093,1.247109,-0.839286,[470,471,54,472],206.7322,1.266246,-0.816836,[474,475,54,476],209.055,1.284774,-0.793992,[478,479,54,480],211.3778,1.302692,-0.770772,[482,483,54,484],213.7007,1.320053,-0.747221,[93,486,54,487],1.340113,-0.718353,[104,489,54,490],1.35741,-0.692082,[492,493,54,494],220.6692,1.360498,-0.685991,[496,493,54,494],222.992,[498,493,54,494],225.3148,[500,493,54,494],227.6377,[502,493,54,494],229.9605,"Schiaparelli EDM","DEMONSTRATOR FÜR EINTRITT, ABSTIEG UND LANDUNG · ABGESTÜRZT","Erster eigener Marslandeversuch der ESA; sollte EDL vor ExoMars Rosalind Franklin demonstrieren","Schiaparelli war die Landedemonstratoren-Sonde, die als Zusatzlast an Bord des ExoMars Trace Gas Orbiter (TGO) transportiert wurde. Benannt nach dem italienischen Astronomen Giovanni Schiaparelli, war die Sonde konzipiert, um das EDL-System zu erproben, das die ESA für den Rosalind Franklin-Rover hochfahren wollte. Schiaparelli trennte sich am 16. Oktober 2016 von TGO und trat drei Tage später in die Marsatmosphäre ein. Das Abstiegsprofil kollabierte: eine gesättigte Trägheitsmesseinheit ließ die Navigationssoftware denken, die Sonde sei bereits in der Höhe gelandet – der Fallschirm wurde vorzeitig abgeworfen und die Bremsantriebe schalteten sich ab, nachdem sie nur 3 Sekunden lang gezündet hatten. Schiaparelli schlug mit etwa 150 m/s auf der Oberfläche auf. TGO selbst führte das Orbit-Einschwenken erfolgreich durch und ist weiterhin in Betrieb.",[508,510,511,513,514,515,516,517],{"met":54,"label":67,"note":68,"type":509},"nominal",{"met":71,"label":73,"note":74,"type":509},{"met":77,"label":79,"note":80,"type":512},"info",{"met":83,"label":84,"note":85,"type":512},{"met":88,"label":89,"note":90,"type":512},{"met":93,"label":95,"note":96,"type":509},{"met":12,"label":100,"note":101,"type":509},{"met":104,"label":106,"note":107,"type":518},"warning","/orrery/images/missions/schiaparelli/06.webp"],"uses":{"params":["id"]}}]}
