4714,-7477,-4131,[474,475,68,476],9.5743,-6707,-4534,[478,479,68,480],9.6773,-5977,-4874,[482,483,68,484],9.7802,-5282,-5160,[486,487,68,488],9.8832,-4617,-5399,[490,491,68,492],9.9861,-3977,-5597,[494,495,68,496],10.192,-2758,-5884,[498,495,68,496],10.1921,{"entry_velocity_km_s":500,"edl_system":501,"edl_duration_s":502,"touchdown_velocity_ms":503},1.697,"powered",717,0.6,[505,510,515,520,525,530,535,540,544,549],{"met_days":68,"type":506,"label":507,"description":508,"label_en":509},"launch","लॉन्च","Saturn V (AS-507) कैनेडी स्पेस सेंटर LC-39A से 1969-11-14 16:22 UTC। स्टैक पर दो बिजली की चोटें (T+36 s, T+52 s) ने ईंधन कोशिकाओं को ऑफलाइन कर दिया; \"SCE to AUX\" कॉल के माध्यम से पुनः प्राप्त।","Launch — Saturn V",{"met_days":76,"type":511,"label":512,"description":513,"label_en":514},"tli_or_tmi","TLI","ट्रांस-लूनर इंजेक्शन — बिजली गिरने की घटनाओं से यान के उबरने की पुष्टि; चंद्रमा के लिए मिशन GO।","Trans-lunar injection",{"met_days":119,"type":516,"label":517,"description":518,"label_en":519},"tcm","MCC-2 — मध्य-पथ सुधार","GET 30:52:44 (1969-11-15 23:14 UTC) पर SPS इंजन का दहन, 61.8 ft/s (18.8 m/s), जिसने Apollo 12 को मुक्त-वापसी पथ से सटीक अवतरण के लिए आवश्यक हाइब्रिड गैर-मुक्त-वापसी पथ पर पहुँचाया।","MCC-2 — midcourse correction",{"met_days":203,"type":521,"label":522,"description":523,"label_en":524},"loi","LOI","चंद्र कक्षा-प्रवेश। SPS ∆v ≈0.89 किमी/s।","Lunar orbit insertion",{"met_days":257,"type":526,"label":527,"description":528,"label_en":529},"descent_start","टचडाउन","Intrepid तूफ़ानों का महासागर (स्टेशियो कॉग्निटम) पर 1969-11-19 06:54 UTC को लैंड करता है — Surveyor 3 के 163 मीटर के भीतर (अब तक की सबसे सटीक चंद्र लैंडिंग)।","LM Intrepid powered descent",{"met_days":317,"type":531,"label":532,"description":533,"label_en":534},"ascent","आरोहण","सतह पर 31 घंटे 31 मिनट रहने के बाद Intrepid उड़ान भरता है। 34 किग्रा नमूने लौटाए गए।","LM Intrepid ascent",{"met_days":382,"type":536,"label":537,"description":538,"label_en":539},"tei","TEI","ट्रांस-अर्थ इंजेक्शन। SPS डेल्टा-वी ~1.0 किमी/सेकंड।","Trans-earth injection",{"met_days":406,"type":516,"label":541,"description":542,"label_en":543},"पृथ्वी-वापसी मध्य-पथ सुधार 1","GET 188:27:16 (1969-11-22 12:49 UTC) पर छोटा सुधार; दूसरा GET 241:22:00 पर आता है।","Trans-earth midcourse correction 1",{"met_days":545,"type":516,"label":546,"description":547,"label_en":548},10.057,"पृथ्वी-वापसी मध्य-पथ सुधार 2","GET 241:22:00 (1969-11-24 17:44 UTC) पर पुनःप्रवेश गलियारे का अंतिम समायोजन, कमांड मॉड्यूल के पृथक्करण से लगभग 3 घंटे पहले।","Trans-earth midcourse correction 2",{"met_days":494,"type":550,"label":551,"description":552,"label_en":553},"earth_return","स्प्लैशडाउन","CM 1969-11-24 20:58 UTC को दक्षिण प्रशांत में उतरा। USS Hornet द्वारा पुनर्प्राप्ति।","Splashdown — Pacific Ocean","Apollo 12","क्रूड लैंडर · उड़ान पूर्ण","दूसरी मानवयुक्त चंद्र लैंडिंग — Surveyor 3 से 163 मीटर पर सटीक अवतरण","यदि Apollo 11 ने साबित किया कि चंद्रमा तक पहुँचा जा सकता है, तो Apollo 12 ने साबित किया कि उस पर किसी खास जगह तक भी पहुँचा जा सकता है। प्रक्षेपण के 36 सेकंड बाद रॉकेट पर बिजली गिरी और यान के उपकरण बंद हो गए; जॉन एरन नाम के युवा नियंत्रक ने स्मृति से एक अनजाना-सा उपाय — \"SCE to AUX\" — निकाला, और उड़ान जारी रही। फिर कॉनराड और बीन ने अपना Lunar Module तूफ़ानों के महासागर में उस प्रोब से कुछ सौ फ़ुट की दूरी पर उतारा जो दो साल से वहाँ पड़ा था, पैदल चलकर उसके पास गए, और उसके कुछ हिस्से घर ले आए। यही सटीकता असली नतीजा थी: चंद्रमा अब मंज़िल नहीं रहा, एक पता बन गया।","दूसरी मानवयुक्त चंद्र लैंडिंग। चढ़ाई के दौरान Saturn V पर दो बार बिजली गिरी (T+36 s और T+52 s) — EECOM जॉन एरन की मशहूर \"SCE to AUX\" कॉल पर बीन ने यान को बहाल किया, फिर दल ने चंद्र कक्षा में जड़त्वीय मापन इकाई को दोबारा संरेखित किया। कॉनराड और बीन ने तूफ़ानों के महासागर में Surveyor 3 (जो अप्रैल 1967 में सॉफ्ट-लैंड हुआ था) के 163 मीटर के भीतर सटीक लैंडिंग की, फिर Surveyor 3 तक पैदल गए और उसका कैमरा + उसकी सतह का नमूना निकाल लाए — ये टुकड़े चंद्र सतह पर लंबे समय तक रहने के असर के विश्लेषण के लिए पृथ्वी पर आए। उन्होंने ALSEP (पूरा Apollo Lunar Surface Experiments Package — पहला ALSEP, जबकि Apollo 11 का EASEP सरल था) तैनात किया, जिसने 8 साल तक डेटा भेजा। मिशन ने गहरे रंग के मारे बेसाल्ट सहित 34 किग्रा नमूने लौटाए।",[560,561,562],{"met":119,"label":517,"description":518},{"met":406,"label":541,"description":542},{"met":545,"label":546,"description":547},[564,566,568,569,571,576,577,581,582],{"met":68,"label":507,"note":508,"type":565},"warning",{"met":76,"label":512,"note":513,"type":567},"nominal",{"met":203,"label":522,"note":523,"type":567},{"met":570,"label":527,"note":528,"type":567},4.607,{"met":572,"label":573,"note":574,"type":575},5.58,"सर्वेयर 3 विज़िट","कॉनराड + बीन Surveyor 3 (~163 मीटर दूर) तक चलते हैं, इसके TV कैमरे + नमूने हटाते हैं पृथ्वी पर लौटने के लिए — पहली बार कोई चालक दल एक पहले से लैंड किए गए रोबोटिक अंतरिक्ष यान का दौरा करता है।","info",{"met":317,"label":532,"note":533,"type":567},{"met":578,"label":579,"note":580,"type":575},6.25,"LM प्रभाव","Intrepid का आरोही चरण ALSEP सीस्मोमीटरों को अंशांकित करने के लिए जानबूझकर चंद्रमा पर गिराया गया — मानवयुक्त मिशन के अंतरिक्ष यान का पहला चरण, जिसे जानबूझकर चंद्रमा से टकराया गया और जिसकी टक्कर सतह पर लगे सीस्मोमीटर ने दर्ज की।",{"met":382,"label":537,"note":538,"type":567},{"met":494,"label":551,"note":552,"type":567},"/orrery/images/missions/apollo12/01.webp"],"uses":{"params":["id"]}}]}
