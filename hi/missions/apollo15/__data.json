62,463,76,464],10.5606,-21432,-2028,[466,467,76,468],10.6848,-17962,-3710,[470,471,76,472],10.8091,-15116,-4893,[474,475,76,476],10.9333,-12738,-5726,[478,479,76,480],11.0576,-10719,-6307,[482,483,76,484],11.1818,-8979,-6702,[486,487,76,488],11.3061,-7460,-6958,[490,491,76,492],11.4303,-6119,-7107,[494,495,76,496],11.5545,-4923,-7173,[498,499,76,500],11.6788,-3844,-7171,[502,503,76,504],11.803,-2864,-7115,[506,507,76,508],11.9273,-1966,-7013,[510,511,76,512],12.0515,-1137,-6872,[514,515,76,516],12.3,356,-6488,[518,515,76,516],12.3001,{"entry_velocity_km_s":520,"edl_system":521,"edl_duration_s":522,"touchdown_velocity_ms":523},1.695,"powered",718,2.07,[525,530,535,540,542,547,552,557,562,567],{"met_days":76,"type":526,"label":527,"description":528,"label_en":529},"launch","प्रक्षेपण","Saturn V (AS-510) कैनेडी स्पेस सेंटर LC-39A से 1971-07-26 13:34 UTC।","Launch — Saturn V",{"met_days":79,"type":531,"label":532,"description":533,"label_en":534},"tli_or_tmi","TLI","अंतर-चंद्र इंजेक्शन।","Trans-lunar injection",{"met_days":114,"type":536,"label":537,"description":538,"label_en":539},"tcm","मध्य-पथ सुधार","GET 28:40:22 (1971-07-27 18:14 UTC) पर SPS इंजन का दहन, 0.8 सेकंड और 5.3 ft/s (1.6 m/s), साथ ही SPS इंजन का परीक्षण भी।","Midcourse correction",{"met_days":174,"type":536,"label":537,"description":541,"label_en":539},"GET 73:31:15 (1971-07-29 15:05 UTC) पर SPS इंजन का दहन, 0.9 सेकंड और 5.4 ft/s (1.6 m/s), चंद्र कक्षा-प्रवेश से पहले चंद्रमा की ओर यात्रा का अंतिम सुधार।",{"met_days":178,"type":543,"label":544,"description":545,"label_en":546},"loi","LOI","चंद्र कक्षा-प्रवेश। SPS ∆v ~0.91 km/s।","Lunar orbit insertion",{"met_days":222,"type":548,"label":549,"description":550,"label_en":551},"descent_start","स्पर्श-डाउन","Falcon Hadley-Apennine पर 1971-07-30 22:16 UTC पर उतरता है — Hadley रिल के पास, Apennine पर्वतों की तलहटी में लैंडिंग।","LM Falcon powered descent",{"met_days":337,"type":553,"label":554,"description":555,"label_en":556},"ascent","आरोहण","Falcon सतह पर 66 h 55 m के बाद उड़ता है। 77 kg नमूने + LRV-माउंटेड कैमरा से पहली तैनातीकृत (ह्यूस्टन द्वारा दूरस्थ रूप से संचालित)।","LM Falcon ascent",{"met_days":422,"type":558,"label":559,"description":560,"label_en":561},"tei","TEI","ट्रांस-अर्थ इंजेक्शन। SPS डेल्टा-वी ~1.0 किमी/सेकंड।","Trans-earth injection",{"met_days":563,"type":536,"label":564,"description":565,"label_en":566},12.164,"पृथ्वी-वापसी मध्य-पथ सुधार","GET 291:56:50 (1971-08-07 17:30 UTC) पर 22.3 सेकंड का RCS सुधार, 5.6 ft/s, पुनःप्रवेश से तीन घंटे पहले।","Trans-earth midcourse correction",{"met_days":514,"type":568,"label":569,"description":570,"label_en":571},"earth_return","स्प्लाशडाउन","CM 1971-08-07 20:46 UTC को उत्तरी प्रशांत में उतरा। तीन मुख्य पैराशूटों में से एक पूरी तरह नहीं खुला; कठोर लेकिन सुरक्षित अवतरण। USS Okinawa द्वारा पुनर्प्राप्ति।","Splashdown — Pacific Ocean","Apollo 15","क्रू वाले लैंडर · उड़ान पूर्ण","पहला J-मिशन — विस्तारित प्रवास, पहला चंद्र रोवर, \"Genesis Rock\"","Apollo 15 तक दौड़ बहुत पहले खत्म हो चुकी थी, और विज्ञान ने स्टीयरिंग सँभाल ली — शाब्दिक अर्थ में भी। यह Lunar Rover ले जाने वाली पहली उड़ान थी, जिसने दो मील की पैदल पहुँच को अठारह मील के पूरे क्षेत्र-अभियान में बदल दिया, और यह किसी सुरक्षित समतल मैदान पर नहीं, बल्कि एक पर्वत-श्रृंखला और एक घुमावदार रिल (खड्ड) के बीच की घाटी में उतरा। स्कॉट और इरविन \"Genesis Rock\" के साथ घर लौटे — चंद्रमा की मूल पर्पटी का चार अरब वर्ष पुराना टुकड़ा, जिसने पुष्टि की कि वह कैसे बना था। Apollo ने चंद्रमा पर सिर्फ़ जाना छोड़कर उसका अध्ययन शुरू कर दिया था — और रद्द किए जाने तक इसमें वह लगातार बेहतर होता गया।","पहला \"J-मिशन\" — नए Lunar Roving Vehicle वाला लंबे ठहराव का वैज्ञानिक Apollo। LRV ने स्कॉट + इरविन को 27.9 किमी की यात्रा-सीमा दी (केवल पैदल चलने वाले Apollo 14 के 3.5 किमी के मुकाबले), जिससे 4.5 किमी ऊँची पर्वत-श्रृंखला की तलहटी और घुमावदार हैडली रिल के किनारे पर बसा नाटकीय Hadley-Apennine स्थल खुल गया। कुल 18 घंटे 35 मिनट की तीन EVA, 77 किग्रा नमूने लौटे, जिनमें मशहूर \"Genesis Rock\" (नमूना 15415) शामिल है — 4.1 अरब वर्ष पुराना एनॉर्थोसाइट, जिसने चंद्र उच्चभूमि की पर्पटी के मैग्मा-महासागर से बनने की पुष्टि की। स्कॉट के टेलीविज़न पर दिखे \"हथौड़ा-पंख ड्रॉप\" ने गैलीलियो का गुरुत्वाकर्षण नियम सीधे प्रसारण में सत्यापित किया। चंद्र कक्षा में Worden ने दूर-संवेदन उपकरणों से भरे SIM-बे का संचालन किया (मानचित्रण कैमरे, गामा-किरण, एक्स-किरण, अल्फा-कण स्पेक्ट्रोमीटर) और घर लौटते समय पहली गहरे-अंतरिक्ष की EVA की (फ़िल्म के डिब्बे लाने के लिए पृथ्वी से ~317,000 किमी पर ~39 मिनट की EVA)। Apollo 15 की वापसी में तीन में से एक पैराशूट के न खुलने से बाधा आई — CM ज़ोर से समुद्र में गिरा, पर दल सुरक्षित रहा।",[578,579,580],{"met":114,"label":537,"description":538},{"met":174,"label":537,"description":541},{"met":563,"label":564,"description":565},[582,584,585,586,588,593,597,601,602,603,607],{"met":76,"label":527,"note":528,"type":583},"nominal",{"met":79,"label":532,"note":533,"type":583},{"met":178,"label":544,"note":545,"type":583},{"met":587,"label":549,"note":550,"type":583},4.363,{"met":589,"label":590,"note":591,"type":592},5,"पहला LRV ट्रैवर्स","EVA-1: पहला चंद्र Roving Vehicle तैनाती + Elbow Crater + हैडली रिल के रिम के लिए 10.3 km ट्रैवर्स।","info",{"met":594,"label":595,"note":596,"type":592},5.5,"जेनेसिस रॉक","EVA-2: Spur Crater पर, स्कॉट + इरविन नमूना 15415 प्राप्त करते हैं — मूल चंद्र परत का 4.1-अरब वर्ष पुराना एनॉर्थोसाइट।",{"met":598,"label":599,"note":600,"type":592},6.1,"हथौड़ा-पंख ड्रॉप","EVA-3 / आरोहण-पूर्व: स्कॉट एक हथौड़ा और एक पंख को साथ गिराते हुए टेलीविज़न पर दिखाते हैं; दोनों रेगोलिथ पर एक साथ गिरते हैं, और गैलीलियो की 1589 की भविष्यवाणी सीधे प्रसारण में सत्यापित होती है।",{"met":337,"label":554,"note":555,"type":583},{"met":422,"label":559,"note":560,"type":583},{"met":604,"label":605,"note":606,"type":592},9.5,"गहरी-अंतरिक्ष EVA","Worden सिस्लूनर अंतरिक्ष में पहली EVA करते हैं (पृथ्वी से ~317 000 km पर ~39 मिनट) ताकि SIM-bay के फ़िल्म कैनिस्टर वापस ला सकें।",{"met":514,"label":569,"note":570,"type":608},"warning","/orrery/images/missions/apollo15/02.webp"],"uses":{"params":["id"]}}]}
