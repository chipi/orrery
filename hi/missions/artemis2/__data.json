54,473],8.3279,-8081,-724,[475,476,54,266],8.4194,-7720,[478,479,54,480],8.5109,-7363,-1683,[482,483,54,484],8.6024,-7007,-2110,[486,487,54,488],8.6939,-6653,-2505,[490,491,54,492],8.7855,-6301,-2873,[494,495,54,496],8.877,-5950,-3216,[94,498,54,499],-5247,-3833,[501,498,54,499],9.0601,"Artemis II","यात्री फ्लाईबाई · उड़ान पूर्ण","Apollo 17 (1972) के बाद निम्न पृथ्वी कक्षा से परे पहली मानवयुक्त उड़ान — और वह मिशन जिसने इस परियोजना को प्रेरित किया","Artemis कार्यक्रम की पहली मानवयुक्त उड़ान, और वह चिंगारी जो Orrery बनी। 1 अप्रैल 2026 को NASA के SLS Block 1 ने चार अंतरिक्ष यात्रियों के साथ Orion यान — रीड वाइज़मैन (CDR), विक्टर ग्लोवर (PLT), क्रिस्टीना कुक (MS) और CSA के जेरेमी हैनसेन (MS) — को एक मुक्त-वापसी प्रक्षेपवक्र पर प्रक्षेपित किया, जिसने उन्हें चंद्रमा के दूर वाले पक्ष के चारों ओर सतह से लगभग 6,500 km ऊपर घुमाकर बिना किसी चंद्र कक्षा-प्रवेश दहन के घर लौटा दिया। पृथ्वी से 406,771 km दूर पहुँचकर वे अपने से पहले के किसी भी मनुष्य से अधिक दूर गए, और 1970 में Apollo 13 का बनाया रिकॉर्ड टूट गया। 9 दिन की उड़ान के बाद 10 अप्रैल को Orion सैन डिएगो के पास प्रशांत महासागर में स्प्लैशडाउन हुआ। इस उड़ान ने पहली लैंडिंग से पहले, जो अब Artemis IV के लिए नियोजित है, Orion की जीवन-समर्थन, नेविगेशन और हीट शील्ड प्रणालियों को मानवयुक्त मिशनों के लिए प्रमाणित किया।",[507,509,510,511,513,514],{"met":54,"label":63,"note":64,"type":508},"nominal",{"met":71,"label":73,"note":74,"type":508},{"met":77,"label":79,"note":80,"type":508},{"met":83,"label":85,"note":86,"type":512},"info",{"met":89,"label":90,"note":91,"type":508},{"met":94,"label":96,"note":97,"type":512},"/orrery/images/missions/artemis2/01.webp"],"uses":{"params":["id"]}}]}
