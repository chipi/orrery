# App Store Connect API key for TestFlight uploads (fastlane beta).
#
# Create at: App Store Connect → Users and Access → Integrations →
#            App Store Connect API → generate a key (role: App Manager).
# Download the AuthKey_XXXXXXXXXX.p8 (ONE download only) and store it OUTSIDE
# the repo (e.g. ~/secrets/).
#
# Then: copy this file to `.env.beta` (gitignored) and fill in the three values.
# NEVER commit .env.beta or the .p8 file.
#
# Fastlane loads this automatically when you run `fastlane beta --env beta`
# (which `npm run beta` does for you).

ASC_KEY_ID=<your-key-id>
ASC_ISSUER_ID=<your-issuer-id>
ASC_KEY_PATH=<absolute-path-to-your-AuthKey.p8>
