# Fastlane — Orrery iOS beta pipeline (TestFlight).
#
# Usage (from the repo root):  npm run beta
#   → runs `npm run sync:mobile` (web build + prune + cap sync) then this `beta`
#     lane. Export the telemetry tier env FIRST (see docs/guides/
#     mobile-build-and-deploy.md §5) so the bundle's Sentry/Umami point at prod.
#
# Or directly (from ios/App):  bundle exec fastlane beta --env beta
#
# Auth is an App Store Connect API key read from env (fastlane/.env.beta,
# gitignored) — no Apple-ID password or 2FA. The build number is derived from
# the latest TestFlight build so every upload is unique WITHOUT editing the
# Xcode project (Info.plist CFBundleVersion is already $(CURRENT_PROJECT_VERSION)).
#
# Prereq once: create the App Store Connect app record for the bundle id, and an
# API key (Users and Access → Integrations). See fastlane/.env.beta.example.

default_platform(:ios)

APP_IDENTIFIER = "io.github.chipi.orrery".freeze

platform :ios do
  desc "Archive the App target and upload it to TestFlight"
  lane :beta do
    asc_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    # +1 on the highest build already on TestFlight for this version. On the very
    # first upload there are none → initial_build_number 0, so this becomes 1.
    next_build = latest_testflight_build_number(
      api_key: asc_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0,
    ) + 1
    UI.message("Next TestFlight build number: #{next_build}")

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      # Account-based automatic signing: the machine is signed into Xcode with an
      # Apple ID on team 3P3PX275ZM, and an "Apple Distribution" cert exists in the
      # keychain. `-allowProvisioningUpdates` then creates/downloads the App Store
      # profile via that account. (The ASC API key stays for the upload only.)
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} -allowProvisioningUpdates",
      # NOT "build" — a `build/` dir next to the .xcodeproj makes `xcodebuild
      # clean` fail on the 2nd run ("not created by the build system"). "build"
      # is a reserved Xcode folder name; use a distinct output dir.
      output_directory: "ipa-output",
      output_name: "Orrery.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: asc_key,
      app_identifier: APP_IDENTIFIER,
      # Hand the build to the "Close Beta" external group (invite-by-email).
      # PREREQ: the group must already exist in App Store Connect → Orrery →
      # TestFlight → External Testing. The FIRST external build triggers a
      # one-time Beta App Review (~1 day); later builds to the same group go out
      # quickly. You (as an internal tester) get every build automatically,
      # independent of this — internal delivery isn't gated on review.
      distribute_external: true,
      groups: ["Close Beta"],
      changelog: ENV.fetch("BETA_CHANGELOG", "Orrery beta — latest build."),
      # Must WAIT for Apple to finish processing before it can distribute +
      # submit for review (a still-processing build can't be released). Adds
      # ~10-20 min to the lane. Override the notes with BETA_CHANGELOG=... .
      skip_waiting_for_build_processing: false,
    )

    UI.success("Uploaded Orrery build #{next_build} to TestFlight.")
  end
end
