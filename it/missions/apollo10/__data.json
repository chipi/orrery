70,470],7.4362,-8591,-1251,[472,473,70,474],7.517,-7967,-1932,[476,477,70,478],7.5979,-7362,-2532,[480,481,70,482],7.6787,-6774,-3062,[484,485,70,486],7.7595,-6200,-3532,[488,489,70,490],7.868,-5447,-4082,[492,493,70,494],8.002,-4538,-4651,[496,493,70,494],8.0021,[498,503,508,513,518,523,528,533,538,542],{"met_days":70,"type":499,"label":500,"description":501,"label_en":502},"launch","LANCIO","Saturn V (AS-505) dal Kennedy Space Center LC-39B 1969-05-18 16:49 UTC — primo lancio con equipaggio da LC-39B.","Launch — Saturn V",{"met_days":78,"type":504,"label":505,"description":506,"label_en":507},"tli_or_tmi","TLI","Iniezione translunare. S-IVB ∆v ~3,05 km/s.","Trans-lunar injection",{"met_days":125,"type":509,"label":510,"description":511,"label_en":512},"tcm","Correzione di traiettoria","L'unica correzione translunare, accensione dell'SPS a GET 26:32:57 (1969-05-19 19:21 UTC): 7,1 s, 49,2 ft/s (15,0 m/s), che allineò il percorso alla traiettoria dell'allunaggio di luglio.","Midcourse correction",{"met_days":225,"type":514,"label":515,"description":516,"label_en":517},"loi","LOI","Inserimento in orbita lunare. SPS ∆v ~0,91 km/s.","Lunar orbit insertion",{"met_days":284,"type":519,"label":520,"description":521,"label_en":522},"descent_start","SEPARAZIONE DEL LM","Snoopy si stacca da Charlie Brown. Equipaggio di due (Stafford + Cernan) scende verso Mare Tranquillitatis.","LM Snoopy descent orbit insertion",{"met_days":289,"type":524,"label":525,"description":526,"label_en":527},"flyby","MASSIMO AVVICINAMENTO","Snoopy raggiunge ~14,4 km sopra il sito bersaglio di Apollo 11 — senza allunaggio; tutto verificato tranne l'allunaggio stesso.","LM low pass over the lunar surface — 14.4 km",{"met_days":294,"type":529,"label":530,"description":531,"label_en":532},"ascent","RISALITA + RENDEZVOUS","Lo stadio di risalita di Snoopy esegue il rendezvous con Charlie Brown — primo riaggancio completo LM-CSM in orbita lunare.","LM ascent-stage insertion burn",{"met_days":384,"type":534,"label":535,"description":536,"label_en":537},"tei","TEI","Iniezione trans-Terra. SPS ∆v ~1,0 km/s.","Trans-earth injection",{"met_days":488,"type":509,"label":539,"description":540,"label_en":541},"Correzione di traiettoria sulla via del ritorno","Correzione a GET 188:49:58 (1969-05-26 13:38 UTC) per fissare il corridoio di rientro, tre ore prima della separazione del modulo di comando.","Trans-earth midcourse correction",{"met_days":492,"type":543,"label":544,"description":545,"label_en":546},"earth_return","AMMARAGGIO","Il CM ammara nel Pacifico meridionale il 1969-05-26 alle 16:52 UTC. Recupero a cura della USS Princeton.","Splashdown — Pacific Ocean","Apollo 10","Apollo 10 volò l'intero allunaggio — fino agli ultimi quindici chilometri — e poi, per progetto, invertì la rotta. Stafford e Cernan portarono il Modulo Lunare fino a un tiro di schioppo dalla superficie a Tranquility, eseguirono ogni fase della discesa e risalirono in orbita senza toccare il suolo. La NASA lasciò persino i serbatoi di risalita semivuoti, così che, per quanto allettante potesse diventare, tentare l'allunaggio non fu mai un'opzione. È il volo meno celebrato del programma e uno dei più disciplinati: una prova a piena velocità da parte di due uomini che volarono per un quarto di milione di miglia sapendo che l'allunaggio spettava a qualcun altro.","EQUIPAGGIATO ORBITA LUNARE · COMPLETATA","Prova generale completa dell'allunaggio — il LM è sceso a ~14,4 km di altitudine","La prova generale completa del primo allunaggio. Stafford e Cernan portarono il LM Snoopy fino a una quota di ~14,4 km sul sito di allunaggio previsto per l'Apollo 11 nel Mare Tranquillitatis — ogni fase dell'avvicinamento all'allunaggio tranne l'allunaggio vero e proprio. Confermarono il profilo di discesa, il radar di allunaggio, la traiettoria di salita e la procedura di rendezvous che l'Apollo 11 avrebbe usato due mesi dopo. I serbatoi di propellente dello stadio di salita del LM furono volutamente caricati solo a metà (~50 % del nominale) per evitare qualsiasi tentazione di tentare un allunaggio. Lo stadio di salita di Snoopy fu l'unico a lasciare l'orbita lunare con ∆v positivo — gettato in un'orbita eliocentrica dove si trova ancora oggi, rilevato a intermittenza da astronomi dilettanti (nel 2019 è stata annunciata una possibile riscoperta, il candidato 2018 AV2, ma non è confermata).",[553,555,556,557,558,560,561,562],{"met":70,"label":500,"note":501,"type":554},"nominal",{"met":78,"label":505,"note":506,"type":554},{"met":225,"label":515,"note":516,"type":554},{"met":284,"label":520,"note":521,"type":554},{"met":289,"label":525,"note":526,"type":559},"info",{"met":294,"label":530,"note":531,"type":554},{"met":384,"label":535,"note":536,"type":554},{"met":492,"label":544,"note":545,"type":554},[564,565],{"met":125,"label":510,"description":511},{"met":488,"label":539,"description":540},"/orrery/images/missions/apollo10/01.webp"],"uses":{"params":["id"]}}]}
