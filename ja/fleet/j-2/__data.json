{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":31,"alongside":32,"kin":33,"engines":58,"usedOn":59,"sites":68,"crewed":69,"museums":70,"hero":71},"https://www.orrerylearn.com/images/cards/fleet/j-2.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"last_flight":10,"status":11,"era":12,"epoch":13,"best_known_for":14,"specs":15,"science":21,"credit":23,"links":24,"tagline":29,"description":30},"j-2","J-2","engine","NASA","USA","Rocketdyne","1966-02-26","1975-07-15","RETIRED","1957-1969","lunar-era","Apolloを月遷移軌道へ送った、再点火可能な水素上段エンジン",{"cycle":16,"propellant":17,"thrust_kn_vac":18,"isp_vac_s":19,"mass_kg":20},"gas-generator","LOX / LH2",1033,421,1788,[22],"propulsion/specific-impulse","Engine registry (PRD-032). Public-source nominal specs; NASA imagery.",[25],{"l":26,"u":27,"t":28},"J-2 — Wikipedia","https://en.wikipedia.org/wiki/Rocketdyne_J-2","intro","Apollo を月へ送ったエンジン — 2度も","J-2は水素と酸素を燃焼させ、宇宙の真空中でも再点火できました。この能力によって、Saturn Vの月遷移軌道投入燃焼が可能になりました。RocketdyneのガスジェネレータのJ-2はSaturn Vの第2段と第3段、そしてSaturn IBに搭載され、高い性能と宇宙空間での再点火を兼ね備えて、打ち上げ機を真の出発段へと変えました。1966年2月に初飛行し、1975年7月のApollo-Soyuz Test Projectが最後の飛行でした。",[],[],[34,38,42,46,50,54],{"id":35,"name":36,"tagline":37},"f-1","F-1","かつて飛行した最も強力な単一燃焼室エンジン",{"id":39,"name":40,"tagline":41},"rl10","RL10","水素上段ステージ、60年以上の歴史",{"id":43,"name":44,"tagline":45},"h-1","H-1","8つのエンジン、8つのミッション — Saturn Iの主力エンジン",{"id":47,"name":48,"tagline":49},"rocketdyne-a7","Rocketdyne A-7","最初のアメリカ人を宇宙に打ち上げたエンジン",{"id":51,"name":52,"tagline":53},"lr87","LR87","すべてのGemini有人ミッションを打ち上げた、双燃焼室ハイパーゴリックの第1段エンジン",{"id":55,"name":56,"tagline":57},"rs-25","RS-25 (SSME)","再利用可能で水素燃料を使用し、現在もSLSで飛行中",[],[60,64],{"id":61,"name":62,"tagline":63},"saturn-v","Saturn V","人類を月に送った",{"id":65,"name":66,"tagline":67},"saturn-ib","Saturn IB","Apollo 7、Skylab の乗組員、ASTP を打ち上げた",[],[],[],"/orrery/images/fleet-galleries/j-2/01.webp"],"uses":{"params":["id"]}}]}
