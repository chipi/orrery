{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":35,"kin":36,"engines":61,"usedOn":62,"sites":71,"crewed":72,"museums":73,"hero":84},"https://www.orrerylearn.com/images/cards/fleet/merlin-1d.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":6,"first_flight":8,"status":9,"era":10,"epoch":11,"best_known_for":12,"specs":13,"science":20,"credit":22,"links":23,"tagline":32,"description":33},"merlin-1d","Merlin 1D","engine","SpaceX","USA","2013-09-29","ACTIVE","2011-now","commercial-era","再利用可能な主力エンジン — 9基でFalcon 9を持ち上げ、数十回の飛行と再利用を実現",{"cycle":14,"propellant":15,"thrust_kn_sl":16,"isp_vac_s":17,"isp_sl_s":18,"mass_kg":19},"gas-generator","LOX / RP-1",845,311,282,470,[21],"propulsion/thrust-and-twr","Engine registry (PRD-032). Public-source nominal specs.",[24,28],{"l":25,"u":26,"t":27},"Merlin — Wikipedia","https://en.wikipedia.org/wiki/SpaceX_Merlin","intro",{"l":29,"u":30,"t":31},"Falcon 9 (SpaceX)","https://www.spacex.com/vehicles/falcon-9/","core","9基のエンジン、1基のブースター、数十回の飛行と再利用","SpaceXのMerlin 1Dは、再使用可能なFalcon 9を実現したエンジンです。Falcon 9の第1段に9基が束ねられ、LOXとRP-1によるガスジェネレータサイクルで動作します。中央のエンジンは再突入燃焼と着陸燃焼にも使われます。2013年9月に初飛行して以来、Merlin 1Dは高頻度運用の主力へと成熟しました。個々のエンジンがそれぞれ20回を超える飛行を重ねており、この再使用の記録は、経済的に実現可能だと業界が信じていた水準を変えました。真空仕様のMerlin 1D Vacuumは、ほぼ真空の環境に最適化された大型ノズルを備え、Falcon 9の上段を駆動します。",[],[],[37,41,45,49,53,57],{"id":38,"name":39,"tagline":40},"raptor","Raptor","全流段燃焼サイクル — 最難関の燃焼方式、ついに飛行へ",{"id":42,"name":43,"tagline":44},"yf-100","YF-100","中国の二段燃焼ケロシン・液酸エンジン、新世代を推進",{"id":46,"name":47,"tagline":48},"yf-77","YF-77","中国初の大型水素エンジン — Long March 5の基盤",{"id":50,"name":51,"tagline":52},"ce-20","CE-20","インド初の国産極低温エンジン、必要に迫られて誕生",{"id":54,"name":55,"tagline":56},"le-9","LE-9","これまでに造られた最大のエキスパンダーブリードエンジン — H3を推進",{"id":58,"name":59,"tagline":60},"vulcain-2","Vulcain 2","欧州の水素主エンジン — Ariane 5のすべての打ち上げを支えた",[],[63,67],{"id":64,"name":65,"tagline":66},"falcon-9","Falcon 9 Block 5","再利用可能なブースターが商業打ち上げを一変させた",{"id":68,"name":69