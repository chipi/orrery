{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":31,"alongside":32,"kin":33,"engines":58,"usedOn":59,"sites":64,"crewed":65,"museums":66,"hero":67},"https://www.orrerylearn.com/images/cards/fleet/rd-180.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"science":21,"credit":23,"links":24,"tagline":29,"description":30},"rd-180","RD-180","engine","Roscosmos","Russia","NPO Energomash","2000-05-24","RETIRED","1981-2011","iss-assembly","米国が匹敵できなかった酸素リッチ段燃焼 — Atlas Vに搭載",{"cycle":15,"propellant":16,"thrust_kn_sl":17,"isp_vac_s":18,"isp_sl_s":19,"mass_kg":20},"staged-combustion (ox-rich)","LOX / RP-1",3830,338,311,5480,[22],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs.",[25],{"l":26,"u":27,"t":28},"RD-180 — Wikipedia","https://en.wikipedia.org/wiki/RD-180","intro","ロシアの酸素リッチ段燃焼 — 米国が再現できなかったエンジン","RD-180は、冷戦中に米国が事実上ソビエト連邦に譲っていた推進技術の一分野を象徴しています。酸素リッチ段燃焼 — 余剰の酸化剤をプリバーナーに通してターボポンプを駆動する方式 — には、米国の産業がまだ習得していなかった材料と製造公差が求められます。NPO Energomashの2室1ターボポンプの設計は、2000年5月からAtlas Vで飛行し、第1段に、当時の米国製ケロシン・液酸エンジンでは及ばない推力と効率の組み合わせをもたらしました。2023年にAtlas Vとともに退役しました。",[],[],[34,38,42,46,50,54],{"id":35,"name":36,"tagline":37},"rd-253","RD-253","Protonの全ての第1段を駆動した6基のハイパーゴリックエンジン",{"id":39,"name":40,"tagline":41},"rd-107-108","RD-107 / RD-108","Sputnikのエンジン — 65年後も人間を運び続けている",{"id":43,"name":44,"tagline":45},"le-5b","LE-5B","日本の再点火可能な上段エンジン、H-IIAからH3まで搭載",{"id":47,"name":48,"tagline":49},"le-7a","LE-7A","日本の段燃焼式水素エンジン、H-II運用20年の中核",{"id":51,"name":52,"tagline":53},"vulcain-2","Vulcain 2","欧州の水素主エンジン — Ariane 5のすべての打ち上げを支えた",{"id":55,"name":56,"tagline":57},"vikas","Vikas","インドがライセンス生産したViking — 30年にわたりPSLVとGSLVを駆動",[],[60],{"id":61,"name":62,"tagline":63},"atlas-v","Atlas V","United Launch Allianceの進化したAtlas",[],[],[],"/orrery/images/fleet-galleries/rd-180/01.webp"],"uses":{"params":["id"]}}]}
