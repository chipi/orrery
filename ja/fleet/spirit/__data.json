{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":39,"kin":44,"engines":69,"usedOn":70,"sites":71,"crewed":76,"museums":77,"hero":78},null,{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":29,"tagline":32,"description":33},"spirit","Spirit (MER-A)","rover","NASA","USA","NASA JPL","2004-01-04","RETIRED","1981-2011","iss-assembly","火星探査ローバー; 6年操作","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Spirit (rover) — Wikipedia","https://en.wikipedia.org/wiki/Spirit_(rover)","intro",{"l":21,"u":22,"t":23},"Mars Exploration Rover — NASA","https://mars.nasa.gov/mer/","core",{"l":25,"u":26,"t":27},"MER mission profile (NASA NTRS)","https://mars.nasa.gov/mer/mission/overview/","deep",[3],[30],{"type":31,"site_id":3},"mars","火星探査ローバー; 6年間の操作","Spirit（MER-A）は、アメリカのNASA JPLが製作した惑星探査ローバーです。火星探査ローバーで、6年間運用されました。2010年に最後の交信がありました。",[35],{"id":3,"name":36,"first":37,"year":38},"Spirit","火星探査ローバー・ツインズの最初の1台。Opportunityに抜かれるまで最長寿命のローバー",2003,[40],{"id":41,"name":42,"tagline":43},"delta-ii","Delta II","NASAの中型惑星科学の主力機 — 1989〜2018年に155回の打ち上げ",[45,49,53,57,61,65],{"id":46,"name":47,"tagline":48},"opportunity","Opportunity (MER-B)","Spiritの双子機；火星での15年近い運用",{"id":50,"name":51,"tagline":52},"sojourner","Sojourner","火星上初のローバー。Pathfinderミッション",{"id":54,"name":55,"tagline":56},"curiosity","Curiosity (MSL)","原子力駆動のMars Science Laboratoryローバー",{"id":58,"name":59,"tagline":60},"perseverance","Perseverance (Mars 2020)","Ingenuityを搭載；火星サンプル採集・保存",{"id":62,"name":63,"tagline":64},"lrv-apollo","月面車","最初の有人ローバー；Apollo 15、16、17",{"id":66,"name":67,"tagline":68},"promise","PROMISE","NASAが月の南極向けに提案した探査車",[],[],[72],{"type":31,"href":73,"name":36,"place":74,"text":75},"/mars/spirit","グセフ・クレーター","Mars Exploration Rover A。90ソルの主任務を想定して設計されましたが、2,208ソルもの間稼働しました。グセフ・クレーターがかつて火山活動と水の相互作用を経験したことを示す証拠を発見しました。2009年に「Troy」の柔らかい土壌に取り残されましたが、チームはSpiritを固定プラットフォームとして運用し続け、2010年3月の最後の通信まで稼働させました。",[],[],"/orrery/images/fleet-galleries/spirit/04.webp"],"uses":{"params":["id"]}}]}
