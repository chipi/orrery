{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":29,"alongside":30,"kin":31,"engines":56,"usedOn":57,"sites":62,"crewed":63,"museums":64,"hero":65},"https://www.orrerylearn.com/images/cards/fleet/yf-100.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"science":19,"credit":21,"links":22,"tagline":27,"description":28},"yf-100","YF-100","engine","CNSA","China","AALPT (Xi’an)","2015-09-20","ACTIVE","2011-now","commercial-era","中国の現代的な二段燃焼式ケロシン・液体酸素エンジン — Long March 5/6/7",{"cycle":15,"propellant":16,"thrust_kn_sl":17,"isp_sl_s":18},"staged-combustion (ox-rich)","LOX / RP-1",1200,300,[20],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs.",[23],{"l":24,"u":25,"t":26},"YF-100 — Wikipedia","https://en.wikipedia.org/wiki/YF-100","intro","中国の二段燃焼ケロシン・液酸エンジン、新世代を推進","YF-100は、中国の打ち上げ能力を、ロシアとアメリカが数十年にわたって占めてきた性能の領域へ押し上げたエンジンである。Xi'anのAALPTが開発し、液体酸素とRP-1に酸素リッチ二段燃焼サイクル——ケロシン系推進剤から最大のエネルギーを引き出す熱力学サイクル——を適用して、2015年9月20日に初飛行した。2基のYF-100が中国最大の現役ロケットLong March 5のコア段を駆動し、クラスター化した派生型がLong March 6とLong March 7に搭載されている。YF-100は、中国の月探査計画、宇宙ステーションへの補給、そして拡大する商業打ち上げの頻度を支えている。",[],[],[32,36,40,44,48,52],{"id":33,"name":34,"tagline":35},"yf-77","YF-77","中国初の大型水素エンジン — Long March 5の基盤",{"id":37,"name":38,"tagline":39},"ce-20","CE-20","インド初の国産極低温エンジン、必要に迫られて誕生",{"id":41,"name":42,"tagline":43},"merlin-1d","Merlin 1D","9基のエンジン、1基のブースター、数十回の飛行と再利用",{"id":45,"name":46,"tagline":47},"le-9","LE-9","これまでに造られた最大のエキスパンダーブリードエンジン — H3を推進",{"id":49,"name":50,"tagline":51},"raptor","Raptor","全流段燃焼サイクル — 最難関の燃焼方式、ついに飛行へ",{"id":53,"name":54,"tagline":55},"vulcain-2","Vulcain 2","欧州の水素主エンジン — Ariane 5のすべての打ち上げを支えた",[],[58],{"id":59,"name":60,"tagline":61},"long-march-5","Long March 5 / 5B","中国宇宙計画の大型ロケットの屋台骨",[],[],[],"/orrery/images/fleet-galleries/yf-100/01.webp"],"uses":{"params":["id"]}}]}
