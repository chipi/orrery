{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":25,"story":31,"illustration":31,"mission":32},{"id":3,"marker":4,"kind":5,"agency":6,"nation":7,"year":8,"altitude_km":9,"inclination_deg":10,"eccentricity":11,"status":12,"surface_status":13,"data_quality":14,"credit":15,"mission_id":3,"links":16},"maven","lander","orbiter","NASA","USA",2014,150,75,0.69,"ACTIVE","ongoing","good","© NASA/U. Colorado/LASP — Mars Atmosphere and Volatile EvolutioN; studies how Mars lost its atmosphere to space.",[17,21],{"l":18,"u":19,"t":20},"MAVEN — Wikipedia","https://en.wikipedia.org/wiki/MAVEN","intro",{"l":22,"u":23,"t":24},"MAVEN — NASA","https://science.nasa.gov/mission/maven/","core",{"name":26,"mission_type":27,"site_name":28,"fact":29,"capability":30},"MAVEN","稼働中の軌道周回機 · 2014年～現在","標準軌道 ~150 × 6,200 km、~75° 傾斜","火星大気・揮発性物質進化探査機（Mars Atmosphere and Volatile EvolutioN）。火星が宇宙に失う大気の速度を定量化し、太陽風によって奪われる酸素とCO₂が毎秒約100 gであることを明らかにした。火星の大気希薄化が、約40億年前の火星全体の磁場喪失によって駆動されたことを示した。","大気逃逸を専門とする最初のミッション。火星が初期大気をどのように失ったかを説明した。",null,{"id":3,"name":26,"first":33,"hardware":34},"火星が大気をどう失ったかを研究する初の専任ミッション",[35],{"id":36,"name":37,"tagline":38},"atlas-v","Atlas V","United Launch Allianceの進化したAtlas"],"uses":{"params":["id"]}}]}
