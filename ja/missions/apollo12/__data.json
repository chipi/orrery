131,[474,475,68,476],9.5743,-6707,-4534,[478,479,68,480],9.6773,-5977,-4874,[482,483,68,484],9.7802,-5282,-5160,[486,487,68,488],9.8832,-4617,-5399,[490,491,68,492],9.9861,-3977,-5597,[494,495,68,496],10.192,-2758,-5884,[498,495,68,496],10.1921,{"entry_velocity_km_s":500,"edl_system":501,"edl_duration_s":502,"touchdown_velocity_ms":503},1.697,"powered",717,0.6,[505,510,515,520,525,530,535,540,544,549],{"met_days":68,"type":506,"label":507,"description":508,"label_en":509},"launch","打ち上げ","Saturn V（AS-507）、ケネディ宇宙センターLC-39Aから1969-11-14 16:22 UTCに打ち上げ。機体に2度の落雷（T+36秒、T+52秒）があり、燃料電池が停止。「SCE to AUX」の指示で復旧。","Launch — Saturn V",{"met_days":76,"type":511,"label":512,"description":513,"label_en":514},"tli_or_tmi","TLI","月遷移軌道投入――落雷からの復旧を確認し、月へ向かうミッション継続を決定。","Trans-lunar injection",{"met_days":119,"type":516,"label":517,"description":518,"label_en":519},"tcm","MCC-2——中間軌道修正","GET 30:52:44（1969-11-15 23:14 UTC）にSPS エンジンを噴射、61.8 ft/s（18.8 m/s）。精密着陸に必要なハイブリッド非自由帰還軌道へ、Apollo 12を自由帰還軌道から移した。","MCC-2 — midcourse correction",{"met_days":203,"type":521,"label":522,"description":523,"label_en":524},"loi","LOI","月軌道投入。SPSのデルタVは約0.89 km/s。","Lunar orbit insertion",{"met_days":257,"type":526,"label":527,"description":528,"label_en":529},"descent_start","着陸","Intrepid が嵐の大洋（スタティオ・コグニトゥム）に着陸 1969-11-19 06:54 UTC — Surveyor 3 の 163 メートル以内（これまでで最も正確な月面着陸）。","LM Intrepid powered descent",{"met_days":317,"type":531,"label":532,"description":533,"label_en":534},"ascent","上昇","Intrepidは月面での31時間31分後に上昇を開始。34 kgのサンプルを持ち帰った。","LM Intrepid ascent",{"met_days":382,"type":536,"label":537,"description":538,"label_en":539},"tei","TEI","地球遷移軌道投入。SPSのデルタV：約1.0 km/s。","Trans-earth injection",{"met_days":406,"type":516,"label":541,"description":542,"label_en":543},"地球帰還中の中間軌道修正 1","GET 188:27:16（1969-11-22 12:49 UTC）の小さな修正。2回目はGET 241:22:00に続く。","Trans-earth midcourse correction 1",{"met_days":545,"type":516,"label":546,"description":547,"label_en":548},10.057,"地球帰還中の中間軌道修正 2","GET 241:22:00（1969-11-24 17:44 UTC）の最終的な再突入回廊の微調整。司令船分離の約3時間前。","Trans-earth midcourse correction 2",{"met_days":494,"type":550,"label":551,"description":552,"label_en":553},"earth_return","溅落","司令船は1969-11-24 20:58 UTCに南太平洋へ着水。回収はUSS Hornet。","Splashdown — Pacific Ocean","Apollo 12","有人月着陸船 · 飛行済み","2回目の有人月面着陸 — Surveyor 3から163 m以内の正確な着陸","Apollo 11が月に到達できることを証明したなら、Apollo 12は月の特定の地点に到達できることを証明した。打ち上げから36秒後、落雷がロケットを直撃し、宇宙船の計器をオフラインにした。若い管制官ジョン・アーロンが、記憶から「SCE to AUX」というあまり知られていない対処法を引き出し、飛行は続行された。その後、コンラッドとビーンは月着陸船を嵐の大洋に降ろした。2年前からそこにあった探査機からわずか数百フィートの場所で、二人は歩いてそこへ向かい、その部品を地球に持ち帰った。その精度こそが本当の成果だった――月はもはや目的地ではなく、ひとつの住所になったのだ。","2回目の有人月面着陸。Saturn Vは上昇中に落雷を2回受けた（T+36秒およびT+52秒）— ビーン飛行士がEECOMのジョン・アーロンからの有名な「SCE to AUX」呼び出しで宇宙船を復旧し、その後クルーが月軌道で慣性計測装置を再調整した。コンラッドとビーンは嵐の大洋でSurveyor 3（1967年4月に軟着陸）から163 m以内に正確な着陸を実行し、Surveyor 3に歩いて接近して、そのカメラと表面サンプルを取り外した — 長期月面露出の分析のために地球に持ち帰った部品である。彼らはALSEP（完全なApollo Lunar Surface Experiments Package — 最初のALSEP。Apollo 11のより簡単なEASEPと異なる）を展開し、8年間データを送信した。ミッションは暗色玄武岩を含む34 kgのサンプルを持ち帰った。",[560,561,562],{"met":119,"label":517,"description":518},{"met":406,"label":541,"description":542},{"met":545,"label":546,"description":547},[564,566,568,569,571,576,577,581,582],{"met":68,"label":507,"note":508,"type":565},"warning",{"met":76,"label":512,"note":513,"type":567},"nominal",{"met":203,"label":522,"note":523,"type":567},{"met":570,"label":527,"note":528,"type":567},4.607,{"met":572,"label":573,"note":574,"type":575},5.58,"SURVEYOR 3 訪問","コンラッド飛行士とビーン飛行士がSurveyor 3に歩いて接近（約163 m離れた場所）し、そのテレビカメラとサンプルを取り外して地球に持ち帰った — クルーが以前着陸したロボット宇宙船を訪問したのは初めて。","info",{"met":317,"label":532,"note":533,"type":567},{"met":578,"label":579,"note":580,"type":575},6.25,"LM衝突","Intrepid上昇段は意図的に月に衝突し、ALSEPの地震計を較正した — 有人ミッションの宇宙船段が意図的に月に衝突され、かつ表面地震計で記録されたのは初めて。",{"met":382,"label":537,"note":538,"type":567},{"met":494,"label":551,"note":552,"type":567},"/orrery/images/missions/apollo12/01.webp"],"uses":{"params":["id"]}}]}
