],10.5606,-21432,-2028,[466,467,76,468],10.6848,-17962,-3710,[470,471,76,472],10.8091,-15116,-4893,[474,475,76,476],10.9333,-12738,-5726,[478,479,76,480],11.0576,-10719,-6307,[482,483,76,484],11.1818,-8979,-6702,[486,487,76,488],11.3061,-7460,-6958,[490,491,76,492],11.4303,-6119,-7107,[494,495,76,496],11.5545,-4923,-7173,[498,499,76,500],11.6788,-3844,-7171,[502,503,76,504],11.803,-2864,-7115,[506,507,76,508],11.9273,-1966,-7013,[510,511,76,512],12.0515,-1137,-6872,[514,515,76,516],12.3,356,-6488,[518,515,76,516],12.3001,{"entry_velocity_km_s":520,"edl_system":521,"edl_duration_s":522,"touchdown_velocity_ms":523},1.695,"powered",718,2.07,[525,530,535,540,542,547,552,557,562,567],{"met_days":76,"type":526,"label":527,"description":528,"label_en":529},"launch","打ち上げ","Saturn V（AS-510）、ケネディ宇宙センター LC-39Aより1971-07-26 13:34 UTC 打上げ。","Launch — Saturn V",{"met_days":79,"type":531,"label":532,"description":533,"label_en":534},"tli_or_tmi","TLI","月遷移軌道投入。","Trans-lunar injection",{"met_days":114,"type":536,"label":537,"description":538,"label_en":539},"tcm","中間軌道修正","GET 28:40:22（1971-07-27 18:14 UTC）のSPS エンジン噴射、0.8秒、5.3 ft/s（1.6 m/s）。SPS エンジンの試験も兼ねた。","Midcourse correction",{"met_days":174,"type":536,"label":537,"description":541,"label_en":539},"GET 73:31:15（1971-07-29 15:05 UTC）のSPS エンジン噴射、0.9秒、5.4 ft/s（1.6 m/s）。月周回軌道投入前の最後の月遷移中の修正。",{"met_days":178,"type":543,"label":544,"description":545,"label_en":546},"loi","LOI","月周回軌道投入。SPSのデルタV ~0.91 km/s。","Lunar orbit insertion",{"met_days":222,"type":548,"label":549,"description":550,"label_en":551},"descent_start","着陸","Falconは1971-07-30 22:16 UTCにHadley-Apenninesに着陸 — Hadley谷のそば、Apennine山脈のふもとへの着陸。","LM Falcon powered descent",{"met_days":337,"type":553,"label":554,"description":555,"label_en":556},"ascent","上昇","Falconが表面での66時間55分の滞在後に打ち上げ。77 kgのサンプルと、月面ローバー搭載カメラからのテレビ中継による初の上昇映像（ヒューストンから遠隔操作）。","LM Falcon ascent",{"met_days":422,"type":558,"label":559,"description":560,"label_en":561},"tei","TEI","地球帰還軌道投入。SPSのデルタVは約1.0 km/s。","Trans-earth injection",{"met_days":563,"type":536,"label":564,"description":565,"label_en":566},12.164,"地球帰還中の中間軌道修正","GET 291:56:50（1971-08-07 17:30 UTC）に22.3秒のRCS修正、5.6 ft/s。再突入の3時間前。","Trans-earth midcourse correction",{"met_days":514,"type":568,"label":569,"description":570,"label_en":571},"earth_return","着水","司令船が北太平洋に着水、1971年8月7日20:46 UTC。3つのメインパラシュートのうち1つが完全に展開せず、硬着水したが無事。USS Okinawaにより回収。","Splashdown — Pacific Ocean","Apollo 15","有人月着陸機 · 飛行済み","初のJ-ミッション — 長期滞在、初の月面ローバー、「Genesis Rock」","Apollo 15の頃には競争はとうに終わっており、科学がハンドルを握った — 文字どおりに。これは月面ローバーを初めて搭載した飛行で、歩いて行ける範囲2マイルを、18マイルに及ぶ本格的な野外調査の範囲へと広げた。着陸したのも安全な平原ではなく、山脈と曲がりくねった峡谷の間の谷だった。スコットとアーウィンは、月の原始地殻の約40億年前の破片「Genesis Rock」を持ち帰り、月がどう形成されたかを裏づけた。Apolloは月を訪れるだけの計画から月を研究する計画へと変わり、中止されるその時まで、その点で上達し続けた。","初の「J-ミッション」——新型の月面車（Lunar Roving Vehicle）を備えた、長期滞在型の科学探査Apolloである。LRVによりスコットとアーウィンは27.9 kmの走行範囲を得た（歩行のみだったApollo 14の3.5 kmに対して）。これにより、4.5 km級の山脈のふもと、蛇行するハドリー谷の縁という劇的なHadley-Apennine地域での探査が可能になった。EVAは3回で合計18時間35分、持ち帰った試料は77 kg。その中には有名な「Genesis Rock」（試料15415）が含まれる。41億年前の斜長岩で、月の高地地殻がマグマオーシャンから生まれたことを裏づけた。スコットがテレビ中継で行った「ハンマーと羽根の落下実験」は、ガリレオが唱えた重力の法則を生中継で検証した。月軌道上のWordenは、遠隔計測機器（マッピングカメラ、ガンマ線・X線・アルファ粒子分光計）で満たされたSIMベイを操作し、帰路には初の深宇宙EVA（地球から約317,000 kmの地点で約39分、フィルムカニスターの回収）を行った。Apollo 15の回収では、3つのパラシュートのうち1つが開かず、司令船は強い衝撃で着水したが、乗員は無事だった。",[578,579,580],{"met":114,"label":537,"description":538},{"met":174,"label":537,"description":541},{"met":563,"label":564,"description":565},[582,584,585,586,588,593,597,601,602,603,607],{"met":76,"label":527,"note":528,"type":583},"nominal",{"met":79,"label":532,"note":533,"type":583},{"met":178,"label":544,"note":545,"type":583},{"met":587,"label":549,"note":550,"type":583},4.363,{"met":589,"label":590,"note":591,"type":592},5,"初の月面ローバー走行","EVA-1: 初のLunar Roving Vehicle（月面車）の展開と、エルボー・クレーターおよびハドリー谷の縁までの10.3 km走行。","info",{"met":594,"label":595,"note":596,"type":592},5.5,"ジェネシス・ロック","EVA-2: Spur Crater でスコット ＋アーウィンがサンプル15415を回収 — 月の原始地殻から採取された41億年前の斜長岩。",{"met":598,"label":599,"note":600,"type":592},6.1,"ハンマーと羽毛の落下実験","EVA-3 / 上昇前: スコットがハンマーと羽毛を一緒に落とす様子をテレビ放映。両者が同時にレゴリスに到達し、ガリレオの1589年の予言をライブで検証。",{"met":337,"label":554,"note":555,"type":583},{"met":422,"label":559,"note":560,"type":583},{"met":604,"label":605,"note":606,"type":592},9.5,"深宇宙EVA","ウォーデンが、SIMベイのフィルム缶を回収するため、地球・月間空間で史上初のEVAを実施（地球から約317,000 km、約39分）。",{"met":514,"label":569,"note":570,"type":608},"warning","/orrery/images/missions/apollo15/02.webp"],"uses":{"params":["id"]}}]}
