,204494,1682,324623,[456,457,458,459],4.5588,203996,761,323833,[461,462,463,464],4.6053,203952,-548,323763,{"vehicle_stage":466,"departure":467},"探査機側の月遷移投入モジュール（Star-37）","kick-stage",[469,474,479,483,486],{"met_days":64,"type":470,"label":471,"description":472,"label_en":473},"launch","打上げ","Athena II、ケープ・カナベラルSLC-46から1998-01-07 02:28 UTCに打上げ。","Launch — Athena II",{"met_days":67,"type":475,"label":476,"description":477,"label_en":478},"tli_or_tmi","月遷移注入","月遷移軌道注入。","Trans-lunar injection (nominal)",{"met_days":93,"type":480,"label":481,"description":482,"label_en":481},"tcm","TCM-1","1998-01-07 11:55 GMT、TLIの約8.5時間後。50.2 m/sの修正を軸方向と接線方向のスラスタ噴射に分け、12:27 GMTに完了。",{"met_days":169,"type":480,"label":484,"description":485,"label_en":484},"TCM-2","1998-01-08 08:25 GMT。7.4 m/sの微調整で月到着を精密化。計画されていた3回目の修正は不要となった。",{"met_days":437,"type":487,"label":488,"description":489,"label_en":490},"edl_or_oi","月軌道投入","月軌道投入1998年1月11日 — 周期11.6時間の軌道に捕捉、1月16日に高度100 kmの極観測軌道へ下げた。","LOI-1 — lunar capture","Lunar Prospector","ロボット軌道衛星 · 飛行済み","中性子分光計による月の両極での水素の検出","NASAのDiscoveryクラスの3番目のミッションであり、Apollo時代以降で初めてNASAが管理した月周回専用探査機。1998-01-07にケープ・カナベラルからAthena IIで打ち上げられたLunar Prospectorは、1998-01-11に周期11.6時間の月周回軌道に捕捉され、1月16日に高度100 kmの極観測軌道へ下げられた。自転する質量296 kgの探査機は5つの観測機器を搭載していた。全球の地殻組成を調べるガンマ線分光計、極域での水素・水氷を検出する中性子分光計、ラドンガス（間接的な火山活動の検出）を調べるアルファ粒子分光計、地殻磁気を調べる磁力計と電子反射計、そしてドップラー重力実験である。Feldmanチームによる中性子データの解析（Feldman ら、Science 281 + 284）で、月の両極上空に鋭い中性子束の欠損が見つかった。これは、永久に影になっている極域のクレーターに、1000万～3億トンの水氷（1998年の推定）があることと整合する。ミッションは1999-07-31に、検出可能な水蒸気プルームの放出を期待してシューメーカー・クレーターへ意図的に衝突させて終了したが、プルームは確認されなかった。この水素の発見は、2009年にLCROSSとChandrayaan-1/M3が独立の確証を示すまで、そのままの形で残っていた。",[496,497],{"met":93,"label":481,"description":482},{"met":169,"label":484,"description":485},[499,501,502,503,508],{"met":64,"label":471,"note":472,"type":500},"nominal",{"met":67,"label":476,"note":477,"type":500},{"met":437,"label":488,"note":489,"type":500},{"met":504,"label":505,"note":506,"type":507},60,"極域水素検出","中性子分光計が月の両極上で鋭い中性子束欠損を検出 — 強い水素信号で、極域水氷と矛盾しない。","info",{"met":509,"label":510,"note":511,"type":500},569,"シューメーカー衝突","1999-07-31 09:52 UTC、シューメーカー・クレーターに意図的に衝突。地球からは水蒸気プルームは検出されなかった。","/orrery/images/missions/lunar-prospector/01.webp"],"uses":{"params":["id"]}}]}
