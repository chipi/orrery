[311,222,53,223],415.833,[313,222,53,223],421.311,[315,222,53,223],426.789,[317,222,53,223],432.267,[319,222,53,223],437.745,[321,222,53,223],443.223,[323,222,53,223],448.701,[325,222,53,223],454.178,[327,222,53,223],459.656,[329,222,53,223],465.134,[331,222,53,223],470.612,[333,222,53,223],476.09,[335,222,53,223],481.568,[337,222,53,223],487.046,[339,222,53,223],492.523,[341,222,53,223],498.001,[343,222,53,223],503.479,[345,222,53,223],508.957,[84,222,53,223],[348,222,53,223],519.9015,[350,222,53,223],525.3636,[352,222,53,223],530.8258,[354,222,53,223],536.2879,[356,222,53,223],541.75,"Mariner 9","軌道周回機 · 飛行済み","別の惑星を周回した最初の宇宙船","Mariner 9は、その後に続くあらゆる周回機を可能にした。1971-11-14、15分間のMOI噴射で火星周回軌道に入ったとき、眼下の惑星は見分けがつかなかった。火星全域を覆うダストストームが、タルシスの火山4つの山頂を除くすべてを隠していたのだ。JPLは嵐が収まるのを待った。1972年1月にかけて塵が落ち着き、Mariner 9は火星表面の約85%をカバーする7,329枚の画像を送ってきた。そこに写っていたのは、オリンポス山（太陽系最大の火山）、マリネリス峡谷（その名を冠した峡谷系）、太古に液体の水があった時代を示唆する干上がった河床、そしてフォボスとダイモスの初のクローズアップである。ミッションは、姿勢制御用のガスが尽きた1972-10-27に終了した。探査機は数十年は軌道にとどまると見込まれていたが、すでに大気圏に再突入したかどうかはわかっていない。",[362,364,365,366,368,372],{"met":53,"label":58,"note":59,"type":363},"nominal",{"met":66,"label":68,"note":69,"type":363},{"met":71,"label":72,"note":73,"type":363},{"met":12,"label":76,"note":77,"type":367},"info",{"met":369,"label":370,"note":371,"type":367},200.092,"塵が消滅","地球規模の嵐が沈静化、撮像開始。",{"met":84,"label":86,"note":87,"type":373},"warning","/orrery/images/missions/mariner9/01.webp"],"uses":{"params":["id"]}}]}
