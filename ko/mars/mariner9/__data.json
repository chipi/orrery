{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":29,"story":35,"illustration":35,"mission":35},{"id":3,"marker":4,"kind":5,"agency":6,"nation":7,"year":8,"altitude_km":9,"inclination_deg":10,"eccentricity":11,"status":12,"surface_status":13,"data_quality":14,"credit":15,"links":16,"fleet_refs":25},"mariner9","lander","orbiter","NASA","USA",1971,1394,64.4,0.6,"ENDED","completed","good","© NASA/JPL — first spacecraft to orbit another planet; 7,329 images returned in 1971-72.",[17,21],{"l":18,"u":19,"t":20},"Mariner 9 — Wikipedia","https://en.wikipedia.org/wiki/Mariner_9","intro",{"l":22,"u":23,"t":24},"Mariner 9 — NASA NSSDCA","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1971-051A","core",[26],{"id":27,"role":28},"mariner-9","spacecraft",{"name":30,"mission_type":31,"site_name":32,"fact":33,"capability":34},"Mariner 9","활동 궤도선 · 1972년 종료","화성 궤도, ~1,400 × 17,900 km","다른 행성을 공전한 최초의 우주선. 행성 전체 먼지 폭풍 중에 화성에 도착했으며 대기가 맑아질 때까지 대기. 화성 표면의 85%를 포함하는 7,329장의 이미지를 반환했으며 — 지구 외 행성의 최초 지구본 모자이크. 올림푸스산, 매리너 계곡, 극지 층상 지형을 발견.","다른 행성의 최초 궤도 정찰 — 이후 모든 궤도 과학 임무의 템플릿을 정의함.",null],"uses":{"params":["id"]}}]}
