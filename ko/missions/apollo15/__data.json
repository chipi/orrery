64],10.5606,-21432,-2028,[466,467,76,468],10.6848,-17962,-3710,[470,471,76,472],10.8091,-15116,-4893,[474,475,76,476],10.9333,-12738,-5726,[478,479,76,480],11.0576,-10719,-6307,[482,483,76,484],11.1818,-8979,-6702,[486,487,76,488],11.3061,-7460,-6958,[490,491,76,492],11.4303,-6119,-7107,[494,495,76,496],11.5545,-4923,-7173,[498,499,76,500],11.6788,-3844,-7171,[502,503,76,504],11.803,-2864,-7115,[506,507,76,508],11.9273,-1966,-7013,[510,511,76,512],12.0515,-1137,-6872,[514,515,76,516],12.3,356,-6488,[518,515,76,516],12.3001,{"entry_velocity_km_s":520,"edl_system":521,"edl_duration_s":522,"touchdown_velocity_ms":523},1.695,"powered",718,2.07,[525,530,535,540,542,547,552,557,562,567],{"met_days":76,"type":526,"label":527,"description":528,"label_en":529},"launch","발사","Saturn V(AS-510), 케네디 우주 센터 LC-39A에서 1971-07-26 13:34 UTC.","Launch — Saturn V",{"met_days":79,"type":531,"label":532,"description":533,"label_en":534},"tli_or_tmi","TLI","달 이동 주입.","Trans-lunar injection",{"met_days":114,"type":536,"label":537,"description":538,"label_en":539},"tcm","중간 궤도 수정","GET 28:40:22(1971-07-27 18:14 UTC) SPS 엔진 분사, 0.8초, 5.3 ft/s(1.6 m/s)로 SPS 엔진 시험을 겸했다.","Midcourse correction",{"met_days":174,"type":536,"label":537,"description":541,"label_en":539},"GET 73:31:15(1971-07-29 15:05 UTC) SPS 엔진 분사, 0.9초, 5.4 ft/s(1.6 m/s)로 달 궤도 진입 전 마지막 달 전이 중 수정.",{"met_days":178,"type":543,"label":544,"description":545,"label_en":546},"loi","LOI","달 궤도 진입. SPS ∆v ≈ 0.91 km/s.","Lunar orbit insertion",{"met_days":222,"type":548,"label":549,"description":550,"label_en":551},"descent_start","착륙","Falcon이 Hadley-Apennine에 착륙 1971-07-30 22:16 UTC — Hadley 열구 옆, Apennine 산맥 기슭에서의 착륙.","LM Falcon powered descent",{"met_days":337,"type":553,"label":554,"description":555,"label_en":556},"ascent","상승","Falcon이 표면에서 66 h 55 m 후 이륙. 77 kg 샘플 + LRV 장착 카메라의 첫 상승 텔레시(휴스턴이 원격 조작).","LM Falcon ascent",{"met_days":422,"type":558,"label":559,"description":560,"label_en":561},"tei","TEI","지구 이동 주입. SPS ∆v ≈ 1.0 km/s.","Trans-earth injection",{"met_days":563,"type":536,"label":564,"description":565,"label_en":566},12.164,"지구 귀환 중간 궤도 수정","GET 291:56:50(1971-08-07 17:30 UTC)에 22.3초 RCS 수정, 5.6 ft/s, 재진입 3시간 전.","Trans-earth midcourse correction",{"met_days":514,"type":568,"label":569,"description":570,"label_en":571},"earth_return","착수","CM이 북태평양에 착수 1971-08-07 20:46 UTC. 3개 주 낙하산 중 하나가 완전히 펴지지 않음; 거칠게 착수했지만 안전. USS Okinawa에 의해 회수.","Splashdown — Pacific Ocean","Apollo 15","유인 착륙선 · 비행 완료","첫 J-임무 — 장기 체류, 첫 월면차, '창세기 암석'","Apollo 15에 이르러 경쟁은 이미 오래전에 끝났고, 과학이 운전대를 잡았습니다 — 말 그대로입니다. 이 비행은 월면차를 처음 실었는데, 월면차는 걸어서 2마일이던 활동 반경을 제대로 된 18마일 규모의 현장 탐사로 넓혔고, 안전한 평원이 아니라 산맥과 구불구불한 협곡 사이의 계곡에 내렸습니다. 스콧과 어윈은 40억 년 된 달 원시 지각의 조각 '창세기 암석'을 가지고 돌아왔고, 이는 달이 어떻게 형성되었는지를 확인해 주었습니다. Apollo는 달을 찾아가는 일을 멈추고 달을 연구하기 시작했으며, 중단되는 순간까지 그 일을 갈수록 더 잘 해냈습니다.","첫 'J-임무' — 새 월면차(LRV)를 갖춘 장기 체류 과학 Apollo. LRV 덕에 스콧과 어윈은 27.9 km의 주행 범위(걸어서만 다닌 Apollo 14는 3.5 km)를 얻었고, 높이 4.5 km 산맥 기슭이자 구불구불한 해들리 열구 가장자리에 있는 극적인 해들리-아펜니노 지역이 열렸다. 세 차례 EVA는 총 18시간 35분이었고, 시료 77 kg을 가져왔다. 그중에는 유명한 '창세기 암석'(시료 15415)이 있었는데, 달 고지 지각이 마그마 바다에서 생겼음을 확인해 주는 41억 년 된 회장암이다. 스콧이 텔레비전으로 생중계한 '망치-깃털 낙하'는 갈릴레오의 낙하 법칙을 생생히 입증했다. 달 궤도의 워든은 원격 탐사 장비(지도 제작 카메라, 감마선·X선·알파 입자 분광계)가 가득한 SIM 베이를 운용했고, 귀환길에 최초의 심우주 EVA를 수행했다(지구에서 약 317,000 km 떨어진 곳에서 약 39분간 필름 통 회수). Apollo 15의 귀환은 낙하산 3개 중 하나가 펴지지 않아 순탄치 않았다 — 사령선은 거칠게 착수했지만 승무원은 무사했다.",[578,579,580],{"met":114,"label":537,"description":538},{"met":174,"label":537,"description":541},{"met":563,"label":564,"description":565},[582,584,585,586,588,593,597,601,602,603,607],{"met":76,"label":527,"note":528,"type":583},"nominal",{"met":79,"label":532,"note":533,"type":583},{"met":178,"label":544,"note":545,"type":583},{"met":587,"label":549,"note":550,"type":583},4.363,{"met":589,"label":590,"note":591,"type":592},5,"첫 LRV 주행","EVA-1: Lunar Roving Vehicle 최초 배치 + Elbow Crater까지 10.3 km 주행 + 해들리 열구 경계","info",{"met":594,"label":595,"note":596,"type":592},5.5,"창세기 바위","EVA-2: Spur Crater에서 스콧과 어윈이 샘플 15415 — 원래 달 지각에서 나온 41억 년 된 정장암을 회수.",{"met":598,"label":599,"note":600,"type":592},6.1,"망치-깃털 낙하","EVA-3 / 상승 전: 스콧이 망치와 깃털을 함께 떨어뜨리는 장면을 중계했고, 둘은 동시에 레골리스에 닿아 갈릴레오의 1589년 예측을 생방송으로 검증했다.",{"met":337,"label":554,"note":555,"type":583},{"met":422,"label":559,"note":560,"type":583},{"met":604,"label":605,"note":606,"type":592},9.5,"심우주 EVA","워든이 지구-달 공간에서 처음으로 EVA를 수행(지구로부터 약 317,000 km에서 약 39분)하여 SIM-베이 필름 카니스터를 회수.",{"met":514,"label":569,"note":570,"type":608},"warning","/orrery/images/missions/apollo15/02.webp"],"uses":{"params":["id"]}}]}
