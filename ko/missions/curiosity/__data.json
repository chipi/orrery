.85,-0.741918,-1.318716,[465,466,65,467],251.352,-0.713505,-1.336802,[469,470,65,471],251.853,-0.684638,-1.354038,[473,474,65,475],252.354,-0.655339,-1.370421,[477,478,65,479],252.855,-0.625667,-1.386023,[481,482,65,483],253.357,-0.595586,-1.400719,[101,485,65,486],-0.556402,-1.418434,[488,489,65,490],255.9293,-0.549975,-1.420939,[492,489,65,490],258.6233,[494,489,65,490],261.3173,[496,489,65,490],264.0113,[498,489,65,490],266.7053,"Curiosity","로버 · 운용 중","첫 번째 원자력 화성 로버; 첫 번째 스카이 크레인 착륙","Curiosity는 소형차만 한 원자력 실험실이며, 어려운 부분은 그것을 화성 표면에 내려놓는 일이었다. 에어백을 쓰기에는 너무 무거워서 2012년 로켓으로 움직이는 스카이 크레인에 매달려 화성에 내려졌는데, 계획자들이 '공포의 7분'이라 부를 만큼 위험한 순서였고 — 첫 시도에 성공했다. 이후 Curiosity는 게일 분화구를 가로지르며 시추했고, 자신이 던져진 질문에 답했다: 이 분화구는 한때 호수를 품고 있었고, 생명체가 쓸 수 있는 화학 조건을 갖추고 있었다. 화성은 거주 가능한 곳이었다. Curiosity는 지금도 주행 중이며, 행성 자체의 역사책처럼 읽히는 층층이 쌓인 암석의 산을 오르고 있다.","현대 화성 탐사를 규정한 기함급 임무. Curiosity는 자동차만 한 크기에 플루토늄을 동력원으로 쓰며, 2012년 착륙 이후 게일 분화구에서 36 km 넘게 주행했다. 탑재 장비들은 화성에 한때 흐르는 물, 복잡한 유기물, 생명이 필요로 하는 화학 조건 같은 거주 가능한 환경이 있었음을 확인했다. 케이블로 로버를 내려놓는 스카이 크레인으로 끝나는 '공포의 7분' 진입·하강·착륙(EDL) 순서는 이제 대형 탑재체를 화성 표면에 보내는 NASA의 표준이 되었다.",[505,507,508,509,510,511,512],{"met":65,"label":67,"note":68,"type":506},"nominal",{"met":71,"label":73,"note":74,"type":506},{"met":77,"label":79,"note":80,"type":506},{"met":87,"label":88,"note":89,"type":506},{"met":15,"label":97,"note":98,"type":506},{"met":101,"label":103,"note":104,"type":506},{"met":513,"label":514,"note":515,"type":516},254.01,"첫 번째 이미지","Hazcam이 표면의 첫 저해상도 이미지를 반환한다.","info",[518,519],{"met":83,"label":84,"description":85},{"met":91,"label":92,"description":93},"/orrery/images/missions/curiosity/01.webp"],"uses":{"params":["id"]}}]}
