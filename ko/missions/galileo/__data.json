,230,59,231],0.11898,1.265746,[233,234,59,235],761.261,0.084965,1.28475,[237,238,59,239],785.05,0.043862,1.306729,[241,242,59,243],808.839,0.00173,1.328408,[245,246,59,247],832.629,-0.042167,1.349556,[249,250,59,251],856.418,-0.087474,1.370257,[253,254,59,255],880.208,-0.133932,1.390586,[257,258,59,259],903.997,-0.182228,1.410303,[261,262,59,263],927.786,-0.232225,1.42942,[265,266,59,267],951.576,-0.28351,1.448071,[269,270,59,271],975.365,-0.336703,1.46601,[273,274,59,275],999.155,-0.391934,1.483144,[277,278,59,279],1022.944,-0.448607,1.499687,[281,282,59,283],1046.733,-0.50725,1.515402,[285,286,59,287],1070.523,-0.568319,1.530031,[289,290,59,291],1094.312,-0.630998,1.543908,[293,294,59,295],1118.102,-0.695694,1.556824,[81,297,59,298],-0.777852,1.570697,[300,301,59,302],1165.68,-0.832609,1.578774,[304,305,59,306],1189.47,-0.904,1.588158,[308,309,59,310],1213.259,-0.978745,1.595581,[312,313,59,314],1237.049,-1.055463,1.601776,[316,317,59,318],1260.838,-1.134209,1.606698,[320,321,59,322],1284.627,-1.216826,1.608999,[324,325,59,326],1308.417,-1.301589,1.609735,[328,329,59,330],1332.206,-1.388503,1.608884,[332,333,59,334],1355.996,-1.479444,1.604838,[336,337,59,338],1379.785,-1.572848,1.59866,[86,340,59,341],-1.695461,1.587235,[343,344,59,345],1427.364,-1.768207,1.578501,[347,348,59,349],1451.153,-1.870658,1.563619,[351,352,59,353],1474.942,-1.975457,1.546196,[355,356,59,357],1498.732,-2.084024,1.524373,[359,360,59,361],1522.521,-2.195564,1.498631,[363,364,59,365],1546.311,-2.309379,1.469725,[367,368,59,369],1570.1,-2.426535,1.43577,[371,372,59,373],1593.889,-2.546597,1.396663,[375,376,59,377],1617.679,-2.668643,1.353684,[379,380,59,381],1641.468,-2.793319,1.305042,[383,384,59,385],1665.258,-2.920387,1.249804,[387,388,59,389],1689.047,-3.048824,1.18995,[391,392,59,393],1712.836,-3.178839,1.123939,[395,396,59,397],1736.626,-3.31003,1.049776,[399,400,59,401],1760.415,-3.441527,0.970312,[403,404,59,405],1784.205,-3.573178,0.884433,[407,408,59,409],1807.994,-3.703794,0.788948,[411,412,59,413],1831.783,-3.833096,0.687698,[415,416,59,417],1855.573,-3.960792,0.580151,[419,420,59,421],1879.362,-4.083984,0.462015,[423,424,59,425],1903.152,-4.203647,0.338101,[427,428,59,429],1926.941,-4.319662,0.208419,[431,432,59,433],1950.73,-4.426521,0.068358,[435,436,59,437],1974.52,-4.527072,-0.076882,[439,440,59,441],1998.309,-4.621261,-0.227133,[443,444,59,445],2022.099,-4.70205,-0.385267,[447,448,59,449],2045.888,-4.772881,-0.547414,[451,452,59,453],2069.677,-4.834557,-0.712897,[455,456,59,457],2093.467,-4.879359,-0.882557,[459,460,59,461],2117.1,-4.910487,-1.053731,[463,464,59,465],2140.73,-4.930196,-1.225675,[467,468,59,469],2164.359,-4.931183,-1.39734,[471,472,59,473],2187.989,-4.915626,-1.566771,[475,476,59,477],2211.619,-4.887577,-1.73386,[12,479,59,480],-4.828447,-1.939345,[482,479,59,480],2258.9924,[484,479,59,480],2282.7818,[486,479,59,480],2306.5712,[488,479,59,480],2330.3606,[490,479,59,480],2354.15,{"vehicle_stage":492,"departure":493},"관성 상단 Inertial Upper Stage (IUS)","kick-stage","Galileo","궤도선 · 비행 완료","목성을 최초로 공전한 우주선; 목성 구름으로 대기 탐사선 투입","Galileo는 도착하기도 전에 무력해졌어도 이상하지 않았다. 주 안테나가 목성으로 가는 도중 반쯤 열린 채 걸려 데이터 전송 속도가 간신히 흐르는 수준으로 떨어졌지만, 지구의 엔지니어들이 소프트웨어를 다시 짜서 과학 데이터를 작은 예비 안테나로 쥐어짜 보내게 한 덕에 임무는 그래도 성공했다. Galileo는 목성을 공전한 최초의 우주선이 되었고, 거대 행성의 구름 속으로 탐사선을 떨어뜨렸으며, 8년 동안 위성들을 돌아보았다. 가장 큰 발견은 그 끈기에서 서서히 나왔다. 목성의 자기장이 유로파 주위에서 휘어지는 방식은 얼음 아래의 짠 바다로만 설명할 수 있었고, 이는 목성의 위성이 액체 물과 생명을 품고 있을지 모른다는 가장 강력한 근거였다. 임무의 끝에서는 유로파에 떨어져 오염시키는 일이 결코 없도록 일부러 목성으로 날려 보냈다.","Space Shuttle Atlantis에서 발사된 Galileo는 Challenger 참사 이후의 긴 중단기를 지나 내부 소행성대를 헤치고 나아가, 궤도에서 목성과 그 위성들을 처음으로 장기간 연구했다. 유로파의 유도 자기장 — 지하 바다의 강력한 증거 — 을 발견했고, 슈메이커-레비 9 혜성이 목성에 충돌하는 장면을 지켜보았다. 임무는 2003년 목성으로의 통제된 추락으로 끝났는데, 생명에 적합한 조건을 품었을지 모를 얼음 위성들을 오염시키지 않기 위해서였다.",[500,502],{"met":59,"label":61,"note":62,"type":501},"nominal",{"met":12,"label":98,"note":99,"type":501},[504,505,506,507,508,509],{"met":65,"label":67,"description":68},{"met":71,"label":72,"description":73},{"met":76,"label":77,"description":78},{"met":81,"label":82,"description":83},{"met":86,"label":87,"description":88},{"met":91,"label":93,"description":94},"/orrery/images/missions/galileo/01.webp"],"uses":{"params":["id"]}}]}
