귀환이 가능함을 증명했습니다.",[370,372,374,375,377,378,379],{"met":48,"label":56,"note":57,"type":371},"nominal",{"met":64,"label":66,"note":67,"type":373},"info",{"met":12,"label":71,"note":72,"type":373},{"met":75,"label":77,"note":78,"type":376},"warning",{"met":81,"label":83,"note":84,"type":376},{"met":87,"label":89,"note":90,"type":373},{"met":93,"label":95,"note":96,"type":373},"/orrery/images/missions/hayabusa1/01.webp"],"uses":{"params":["id"]}}]}
