{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":585},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"round_trip":13,"vehicle":14,"payload":15,"delta_v":16,"data_quality":17,"credit":18,"links":19,"flight_data_quality":27,"fleet_refs":28,"flight":43,"name":555,"type":556,"first":557,"dispatch":558,"description":559,"events":560,"vehicle_stage":45},"apollo17","NASA","National Aeronautics and Space Administration / Manned Spacecraft Center","gov","MOON","#0B3D91",1972,"FLOWN","1972-12-07","1972-12-11",4,true,"Saturn V (AS-512)","48609 kg launched (CSM America + LM Challenger)","~6 km/s (round trip)","good","© NASA — Apollo 17 mission report. Public domain. Last crewed lunar landing of the 20th century. Touchdown at Taurus-Littrow Valley 1972-12-11 19:54 UTC.",[20,24],{"l":21,"u":22,"t":23},"Apollo 17 — Wikipedia","https://en.wikipedia.org/wiki/Apollo_17","intro",{"l":25,"u":26,"t":23},"Apollo 17 mission overview (NASA)","https://www.nasa.gov/mission/apollo-17/","measured",[29,32,35,37,40],{"id":30,"role":31},"saturn-v","launcher",{"id":33,"role":34},"apollo-csm-block-ii","spacecraft",{"id":36,"role":34},"apollo-lm",{"id":38,"role":39},"lrv-apollo","payload",{"id":41,"role":42},"lc-39a","launch-site",{"launch":44,"cruise":48,"arrival":50,"totals":59,"events":63,"cislunar_profile":109},{"vehicle_stage":45,"mass_at_tli_kg":46,"source":47},"Saturn V S-IVB (third stage)",48609,"Apollo 17 Mission Report (NASA JSC-07904, 1973)",{"tcm_count":49,"source":47},2,{"v_infinity_km_s":51,"periapsis_km":52,"inclination_deg":53,"orbit_insertion_dv_km_s":54,"source":47,"entry_velocity_km_s":55,"edl_system":56,"edl_duration_s":57,"touchdown_velocity_ms":58},0.86,110,28.5,0.91,1.695,"powered",730,0.9,{"total_dv_km_s":60,"tli_or_tmi_dv_km_s":61,"source":62},7.3,3.18,"Apollo 17 Mission Report ∆v ledger; CSM + LM combined",[64,69,74,79,83,88,93,98,104],{"met_days":65,"type":66,"label":67,"description":68},0,"launch","Launch — Saturn V (only night Apollo launch)","Kennedy Space Center LC-39A, 1972-12-07 05:33 UTC. The first and only night-time Saturn V launch + the last crewed Moon mission. Crew: Cernan + Evans + Schmitt (the first scientist-astronaut, geologist). Bound for Taurus-Littrow valley to investigate explosive volcanic activity in a mountain-fringed lowland.",{"met_days":70,"type":71,"label":72,"description":73},0.13,"tli_or_tmi","Trans-lunar injection","S-IVB third-stage burn at 3h 13m sends the Apollo 17 stack on its translunar coast.",{"met_days":75,"type":76,"label":77,"description":78},1.27,"tcm","MCC-2","First mid-course correction.",{"met_days":80,"type":76,"label":81,"description":82},1.5,"MCC-3","Approach-phase refinement before lunar orbit insertion.",{"met_days":84,"type":85,"label":86,"description":87,"dv_km_s":54},3.7,"loi","Lunar orbit insertion","1972-12-10. 387-second SPS burn captures America (CSM) + Challenger (LM) into a 110 × 314 km lunar orbit.",{"met_days":89,"type":90,"label":91,"description":92},4.6,"descent_start","LM Challenger powered descent","1972-12-11. Cernan + Schmitt landed at Taurus-Littrow (20.16°N, 30.77°E). Logged 22 hours of EVA over 3 moonwalks — the most of any Apollo mission. Drove the Lunar Roving Vehicle 35.7 km total.",{"met_days":94,"type":95,"label":96,"description":97},7.8,"ascent","LM Challenger ascent — last humans on the Moon","1972-12-14. Cernan was the last person to step off the Moon — his footprint at the LM ladder remains the most recent human surface activity on another world. The ascent stage rendezvoused with America in orbit.",{"met_days":99,"type":100,"label":101,"description":102,"dv_km_s":103},9.75,"tei","Trans-Earth injection","1972-12-16. SPS burn sends Apollo 17 home after 75 hours in lunar orbit + the 3-day surface stay.",1.05,{"met_days":105,"type":106,"label":107,"description":108},12.6,"earth_return","Splashdown — Pacific Ocean","1972-12-19 19:25 UTC. Apollo 17 splashed down 6.4 km from USS Ticonderoga, ending the Apollo program. The 110-kg sample haul (still the largest single Moon-rock collection) became the cornerstone of subsequent decades of lunar science.",{"source_tier":110,"parking_orbit":111,"tli":113,"translunar":115,"lunar_arrival":117,"return":119,"waypoints_km":121},"tier_1_5_hybrid",{"altitude_km":112,"inclination_deg":53,"revs":49},170,{"dv_kms":61,"c3_km2_s2":114},-1.7,{"type":116},"free_return",{"type":118,"altitude_km":52,"inclination_deg":53,"periselene_km":52},"orbit",{"type":120,"dv_kms":103},"tei_direct",[122,124,129,130,134,138,142,146,150,154,158,161,165,168,172,176,180,184,188,192,196,200,204,208,212,216,220,224,228,232,235,240,245,250,255,260,265,269,274,279,284,289,294,299,304,309,313,318,323,328,333,338,343,348,353,358,363,368,373,378,383,388,392,397,402,407,412,417,422,427,432,437,442,447,452,457,462,467,470,474,478,482,486,490,494,498,502,506,510,514,518,522,526,530,534,538,542,546,550,553],[65,123,65,65],6548,[125,126,127,128],0.0001,6544,-30,55,[70,123,65,65],[131,132,65,133],0.3818,7468,449,[135,136,65,137],0.5091,8002,725,[139,140,65,141],0.6364,8594,1042,[143,144,65,145],0.7636,9251,1408,[147,148,65,149],0.8909,9984,1831,[151,152,65,153],1.0182,10806,2323,[155,156,65,157],1.1455,11734,2897,[75,159,65,160],12761,3555,[162,163,65,164],1.4,13986,4368,[80,166,65,167],15054,5098,[169,170,65,171],1.6545,16965,6451,[173,174,65,175],1.7818,18835,7824,[177,178,65,179],1.9091,21040,9498,[181,182,65,183],2.0364,23668,11561,[185,186,65,187],2.1636,26835,14133,[189,190,65,191],2.2909,30702,17378,[193,194,65,195],2.4182,35487,21533,[197,198,65,199],2.5455,41505,26940,[201,202,65,203],2.6727,49200,34100,[205,206,65,207],2.8,59210,43755,[209,210,65,211],2.9273,72461,57026,[213,214,65,215],3.0545,90264,75580,[217,218,65,219],3.1818,114337,101789,[221,222,65,223],3.3091,146417,138530,[225,226,65,227],3.4364,186501,187504,[229,230,65,231],3.5636,228160,243749,[84,233,65,234],254658,290407,[236,237,238,239