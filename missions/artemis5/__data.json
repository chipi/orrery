",[538,542,545,548,552,555,558],{"met":62,"label":539,"note":540,"type":541},"SLS LAUNCH","Orion launches from KSC LC-39B with crew of 4.","nominal",{"met":67,"label":543,"note":544,"type":541},"TLI","Trans-lunar injection.",{"met":12,"label":546,"note":547,"type":541},"NRHO ARRIVAL","Orion arrives in a high lunar orbit and meets the waiting lander.",{"met":85,"label":549,"note":550,"type":551},"DESCENT","2 crew transfer to the lander; powered descent to the lunar south pole.","info",{"met":90,"label":553,"note":554,"type":541},"ASCENT","The lander returns to lunar orbit after the surface stay.",{"met":95,"label":556,"note":557,"type":541},"TEI","Trans-Earth injection.",{"met":100,"label":559,"note":560,"type":551},"SPLASHDOWN","Orion splashes down in the Pacific Ocean.","/orrery/images/missions/artemis5/01.webp"],"uses":{"params":["id"]}}]}
