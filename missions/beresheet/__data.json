{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":610},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"vehicle":13,"payload":14,"delta_v":15,"data_quality":16,"credit":17,"links":18,"flight_data_quality":34,"fleet_refs":35,"flight":41,"name":581,"type":582,"first":583,"description":584,"events":585,"vehicle_stage":43},"beresheet","SpaceIL","SpaceIL (Israeli non-profit) + Israel Aerospace Industries","private","MOON","#0038B8",2019,"FLOWN","2019-02-22","2019-04-11",48,"Falcon 9 Block 5 (rideshare with Nusantara Satu)","585 kg launch mass; first private spacecraft to reach lunar orbit; lost during powered descent ~150 m above the surface","~6 km/s (highly elliptical phasing orbits, not direct TLI)","good","© SpaceIL / Israel Aerospace Industries. First private mission to reach lunar orbit; crashed on landing approach due to inertial measurement unit reset chain. \"Crashing on the Moon\" still counted as historic.",[19,23,27,31],{"l":20,"u":21,"t":22},"Beresheet — Wikipedia","https://en.wikipedia.org/wiki/Beresheet","intro",{"l":24,"u":25,"t":26},"Beresheet (NASA NSSDCA)","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=BRSHEET","core",{"l":28,"u":29,"t":30},"Beresheet crash analysis (IAI report 2019)","https://www.iai.co.il/p/beresheet-crash-analysis","deep",{"l":32,"u":33,"t":22},"LRO imaging of Beresheet impact site","https://www.nasa.gov/missions/beresheet-impact-site-spotted/","sparse",[36,39],{"id":37,"role":38},"falcon-9","launcher",{"id":2,"role":40},"spacecraft",{"launch":42,"cruise":46,"arrival":49,"totals":58,"events":61,"cislunar_profile":94},{"vehicle_stage":43,"mass_at_tli_kg":44,"source":45,"departure":40},"Falcon 9 second stage to GTO (rideshare)",585,"SpaceIL mission archive; SpaceX manifest 2019-02-22",{"tcm_count":47,"source":48},2,"SpaceIL flight ops; six progressive perigee-raise maneuvers from GTO to translunar injection over 6 weeks",{"v_infinity_km_s":50,"periapsis_km":51,"inclination_deg":52,"source":53,"entry_velocity_km_s":54,"edl_system":55,"edl_duration_s":56,"touchdown_velocity_ms":57},2.5,200,20,"SpaceIL flight ops; lunar-orbit capture 2019-04-04",0.15,"powered",18,152.68,{"total_dv_km_s":59,"tli_or_tmi_dv_km_s":47,"source":60},6,"Cumulative ∆v including 6 progressive Earth phasing burns + LOI + descent (failed)",[62,67,72,77,80,85,89],{"met_days":63,"type":64,"label":65,"description":66},0,"launch","Launch — Falcon 9 (rideshare)","Cape Canaveral, 2019-02-22. Israel's SpaceIL Beresheet (\"Genesis\") — the first private/non-governmental lunar mission, launched as a SpaceX rideshare. Funded mostly by Israeli entrepreneur Morris Kahn (~$100M total) after the Google Lunar X PRIZE — for which Beresheet had been a contender — was cancelled.",{"met_days":68,"type":69,"label":70,"description":71},0.01,"phasing","GTO insertion + phasing orbit","Released into a geostationary transfer orbit. The mission used 6 successive perigee-raise burns over 6 weeks (instead of a single direct TLI) to gradually raise apogee until lunar capture geometry.",{"met_days":73,"type":74,"label":75,"description":76},10,"tcm","Perigee raise burn 1","First of 6 progressive perigee maneuvers.",{"met_days":52,"type":74,"label":78,"description":79},"Perigee raise burn 4","Mid-sequence orbit raise.",{"met_days":81,"type":82,"label":83,"description":84},41,"tli_or_tmi","Lunar capture","2019-04-04. Final maneuver captured Beresheet into a 200 × 10,000 km lunar orbit — Israel becomes the 7th country to reach the Moon (after USSR, USA, Japan, ESA, China, India).",{"met_days":12,"type":86,"label":87,"description":88},"edl_or_oi","Lunar powered descent — Mare Serenitatis","2019-04-11. Powered descent toward Mare Serenitatis began nominally.",{"met_days":90,"type":91,"label":92,"description":93},48.01,"anomaly","Engine shutdown — surface impact","An IMU failure 14 km above the surface caused the main engine to shut down. The backup engine could not be restarted. Beresheet impacted the surface at ~134 m/s. Despite the failure, the mission achieved lunar orbit and partial descent — the first privately-funded vehicle to do so.",{"source_tier":95,"parking_orbit":96,"tli":98,"translunar":99,"lunar_arrival":101,"return":103,"waypoints_km":105},"tier_1_5_hybrid",{"altitude_km":51,"inclination_deg":97,"revs":59},27,{"dv_kms":47},{"type":100},"direct",{"type":102,"altitude_km":51,"inclination_deg":52,"periselene_km":51},"orbit_and_land",{"type":104},"none",[106,108,112,117,122,127,132,137,142,147,152,157,162,167,172,177,182,187,192,197,202,206,211,216,221,226,231,236,241,246,251,256,261,266,271,276,281,286,291,296,300,305,310,315,320,325,330,335,340,345,350,355,360,365,370,375,380,385,390,395,400,405,410,415,420,425,430,435,440,444,449,454,459,464,469,474,479,484,489,494,499,504,505,509,513,517,521,525,529,533,537,541,545,549,553,557,562,567,572,577],[63,107,63,63],6578,[68,109,110,111],6566,-27,53,[113,114,115,116],1.0184,3831,-2361,4633,[118,119,120,121],1.5276,1065,-2890,5672,[123,124,125,126],2.0368,-1936,-2812,5518,[128,129,130,131],2.546,-4569,-2137,4194,[133,134,135,136],3.0552,-6154,-967,1898,[138,139,140,141],3.5644,-6405,395,-776,[143,144,145,146],4.0736,-5310,1664,-3266,[148,149,150,151],4.5828,-3093,2585,-5072,[153,154,155,156],5.092,-195,2969,-5827,[158,159,160,161],5.6012,2763,2685,-5269,[163,164,165,166],6.1104,5089,1814,-3560,[168,169,170,171],6.6196,6328,572,-1123,[173,174,175,176],7.1288,6232,-791,1552,[178,179,180,181],7.638,4817,-1999,3924,[183,184,185,186],8.1472,2325,-2776,5449,[188,189,190,191],8.6563,-676,-2925,5741,[193,194,195,196],9.1655,-3501,-2461,4830,[198,199,200,201],9.6747,-5583,-1479,2903,[73,203,204,205],-6285,-669,1313,[207,208,209,210],10.6931,-6024,1179,-2314,[212,213,214,215],11.2023,-4161,2261,-4437,[217,218,219,220],11.7115,-1455,2855,-5603,[222,223,224,225],12.2207,1547,2847,-5587,[227,228,229,230],12.7299,4239,2237,-4390,[232,233,234,235],13.239