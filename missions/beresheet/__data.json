6464,260,-511,[475,476,477,478],38.1898,-5479,1550,-3042,[480,481,482,483],38.699,-3345,2508,-4922,[485,486,487,488],39.2082,-492,2942,-5774,[490,491,492,493],39.7174,2509,2760,-5416,[495,496,497,498],40.2266,4921,1929,-3785,[500,501,502,503],40.7358,6268,707,-1388,[81,107,63,63],[506,507,63,508],41.7542,7820,-1299,[510,511,63,512],42.2633,8814,-2494,[514,515,63,516],42.7725,9975,-4064,[518,519,63,520],43.2817,11355,-6174,[522,523,63,524],43.7909,13033,-9093,[526,527,63,528],44.3001,15121,-13270,[530,531,63,532],44.8093,17796,-19515,[534,535,63,536],45.3185,21334,-29370,[538,539,63,540],45.8277,26175,-46028,[542,543,63,544],46.3369,32950,-76664,[546,547,63,548],46.8461,41937,-138119,[550,551,63,552],47.3553,48312,-260090,[90,554,555,556],16617,25,-385979,[558,559,560,561],48.3737,16608,910,-385753,[563,564,565,566],48.8829,16568,1771,-384824,[568,569,570,571],49.3921,16513,1874,-383563,[573,574,575,576],49.9013,16468,1176,-382508,[578,579,110,580],50.4105,16451,-382110,"Beresheet","PRIVATE LANDER · CRASHED","First privately-funded mission to reach the Moon; first Israeli lunar mission","SpaceIL's Beresheet (Hebrew: 'In the beginning') launched as a shared-ride passenger on a Falcon 9 in February 2019. Instead of a direct trans-lunar injection, the small lander performed weeks of perigee-raising phasing burns to climb from a parking orbit out to the Moon — a fuel-saving trajectory pioneered for low-budget missions. After successful lunar orbit insertion on 4 April 2019, an inertial measurement unit reset during descent caused the main engine to shut down. Beresheet crashed in Mare Serenitatis. SpaceIL committed to a successor (Beresheet 2) within days.",[586,590,594,597,600,603,606],{"met":63,"label":587,"note":588,"type":589},"LAUNCH","Falcon 9 rideshare from Cape Canaveral 2019-02-22.","nominal",{"met":68,"label":591,"note":592,"type":593},"PHASING BURN","First of seven perigee raises to climb from LEO to lunar approach.","info",{"met":73,"label":595,"note":596,"type":593},"TCM 1","Trajectory correction during multi-orbit climb.",{"met":52,"label":598,"note":599,"type":593},"TCM 2","Second TCM. Apogee approaching lunar capture distance.",{"met":81,"label":601,"note":602,"type":589},"LUNAR APPROACH","Final translunar burn — Beresheet on direct lunar trajectory.",{"met":81,"label":604,"note":605,"type":589},"LUNAR ORBIT INSERTION","Capture into elliptical lunar orbit 2019-04-04.",{"met":90,"label":607,"note":608,"type":609},"DESCENT ANOMALY","IMU reset during powered descent → engine shutdown → crash in Mare Serenitatis 2019-04-11.","warning","/orrery/images/missions/beresheet/01.webp"],"uses":{"params":["id"]}}]}
