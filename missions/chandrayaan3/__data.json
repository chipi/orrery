{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":748},{"id":2,"videos":3,"agency":6,"agency_full":7,"sector":8,"dest":9,"color":10,"year":11,"status":12,"departure_date":13,"arrival_date":14,"transit_days":15,"vehicle":16,"payload":17,"delta_v":18,"data_quality":19,"credit":20,"links":21,"flight_data_quality":33,"fleet_refs":34,"flight":47,"name":721,"type":722,"first":723,"description":724,"events":725,"vehicle_stage":49},"chandrayaan3",[4],{"id":5},"vid-654cc435c4dd","ISRO","Indian Space Research Organisation","gov","MOON","#FF9933",2023,"FLOWN","2023-07-14","2023-08-23",40,"LVM3 M4 (formerly GSLV Mk III)","3900 kg launch mass; 1726 kg lander+rover","~3.5 km/s","good","© ISRO — Chandrayaan-3 mission. First soft-landing near the lunar south pole — region with permanently shadowed craters and water ice deposits. Followed Chandrayaan-2's lander failure in 2019.",[22,26,29],{"l":23,"u":24,"t":25},"Chandrayaan-3 — Wikipedia","https://en.wikipedia.org/wiki/Chandrayaan-3","intro",{"l":27,"u":28,"t":25},"Chandrayaan-3 — ISRO","https://www.isro.gov.in/Chandrayaan3_Details.html",{"l":30,"u":31,"t":32},"चंद्रयान-3 — हिन्दी विकिपीडिया","https://hi.wikipedia.org/wiki/%E0%A4%9A%E0%A4%82%E0%A4%A6%E0%A5%8D%E0%A4%B0%E0%A4%AF%E0%A4%BE%E0%A4%A8-3","core","measured",[35,38,41,44],{"id":36,"role":37},"lvm3","launcher",{"id":39,"role":40},"vikram-cy3","spacecraft",{"id":42,"role":43},"pragyan","payload",{"id":45,"role":46},"sriharikota-slp","launch-site",{"launch":48,"cruise":52,"arrival":55,"totals":65,"events":68,"cislunar_profile":117},{"vehicle_stage":49,"mass_at_tli_kg":50,"source":51,"departure":40},"LVM3 C25 cryogenic upper stage",3900,"ISRO Chandrayaan-3 Mission Report (2023); used multi-burn Earth-orbit raising",{"tcm_count":53,"source":54},0,"ISRO mission updates, 2023-07/08: no trajectory corrections reported between TLI (1 Aug) and lunar orbit insertion (5 Aug); the lunar-bound burns are listed as events.",{"v_infinity_km_s":56,"periapsis_km":57,"inclination_deg":58,"orbit_insertion_dv_km_s":59,"source":60,"entry_velocity_km_s":61,"edl_system":62,"edl_duration_s":63,"touchdown_velocity_ms":64},0.85,100,90,0.84,"ISRO Chandrayaan-3 LOI Report (2023-08)",1.683,"powered",1111,1,{"total_dv_km_s":66,"source":67},3.5,"ISRO Chandrayaan-3 Mission Report (2023)",[69,73,78,83,88,92,96,100,105,109,113],{"met_days":53,"type":70,"label":71,"description":72},"launch","Launch — LVM3 (GSLV Mk III)","Sriharikota, India, 2023-07-14. Chandrayaan-3 — ISRO's follow-up to the failed 2019 Chandrayaan-2 lander. Carries the Vikram lander + Pragyan rover. Targets a south-polar landing site where Chandrayaan-2's Vikram had crashed.",{"met_days":74,"type":75,"label":76,"description":77},17.8,"tli_or_tmi","Trans-lunar injection","Final perigee burn after 18 days of progressive Earth-orbit raising — the same lower-cost lunar transfer ISRO has used since Chandrayaan-1.",{"met_days":79,"type":80,"label":81,"description":82},22.2,"arrival","Lunar orbit insertion","2023-08-05. Captured into 164 × 18,074 km lunar orbit. ISRO spent 18 days lowering perilune to 25 km for the descent.",{"met_days":84,"type":85,"label":86,"description":87},23.35,"phasing","Lunar orbit reduction 1","2023-08-06. First lunar-bound burn after capture: the orbit drops to 170 × 4,313 km.",{"met_days":89,"type":85,"label":90,"description":91},26.2,"Lunar orbit reduction 2","2023-08-09. Second burn lowering the orbit towards a near-circular one.",{"met_days":93,"type":85,"label":94,"description":95},31.2,"Lunar orbit reduction 3","2023-08-14. Third reduction burn.",{"met_days":97,"type":85,"label":98,"description":99},33.1,"Lunar orbit reduction 4","2023-08-16. Final reduction burn: a near-circular 153 × 163 km orbit.",{"met_days":101,"type":102,"label":103,"description":104},34,"separation","Lander module separation","2023-08-17. The Vikram lander module, with the Pragyan rover inside, separates from the propulsion module.",{"met_days":106,"type":85,"label":107,"description":108},35,"Lander deboost 1","2023-08-18. Vikram's first deboost lowers its orbit to 113 × 157 km.",{"met_days":110,"type":85,"label":111,"description":112},36.5,"Lander deboost 2","Second deboost puts Vikram into the low descent orbit, ready for the landing attempt.",{"met_days":15,"type":114,"label":115,"description":116},"edl_or_oi","Lunar powered descent + landing — Shiv Shakti Point","2023-08-23. Powered descent + soft landing near the lunar south pole (69.37°S, 32.32°E) — making India the 4th country to soft-land on the Moon (after USSR, USA, China) and the FIRST to land near the south pole. Site later named Shiv Shakti Point. Pragyan rover rolled off + drove ~100 m before going into hibernation for the lunar night (with no recovery on the second day).",{"source_tier":118,"parking_orbit":119,"tli":123,"translunar":125,"lunar_arrival":127,"return":129,"waypoints_km":131,"waypoints_source":681,"orbit_raising":682,"lunar_orbits":700},"tier_1_5_hybrid",{"altitude_km":120,"inclination_deg":121,"revs":122},170,21.3,5,{"dv_kms":124},1.4,{"type":126},"spiral",{"type":128,"altitude_km":57,"inclination_deg":58,"periselene_km":57},"orbit_and_land",{"type":130},"none",[132,135,139,143,147,151,155,157,159,161,163,165,167,170,174,178,182,186,190,192,194,196,198,200,202,204,206,208,210,212,214,216,218,220,222,224,226,230,234,238,242,246,250,251,253,255,257,259,261,265,269,273,277,281,285,287,289,291,292,294,296,298,300,302,304,306,308,312,316,320,324,328,332,334,336,338,340,342,344,346,348,350,352,354,356,358,360,362,364,366,368,370,372,374,376,378,380,384,388,392,396,400,404,406,408,410,412,414,416,418,420,422,424,426,428,429,433,437,441,445,449,453,457,461,465,469,473,477,481,484,488,492,496,499,503,507,511,515,519,523,527,530,534,538,542,546,550,554,558,562,566,570,574,578,582,585,589,593,597,601,604,608,612,616,620,623,627,631,635,638,642,646,650,654,658,662,666,670,674,678],[53,133,53,134],-2507,6049,[136,137,53,138],0.0327,-11181,-10922,[140,141,53,142],0.116,-1718,-337