1,1002,[302,303,55,304],7.3542,7239,1624,[306,307,55,308],7.4984,7292,2276,[310,311,55,312],7.6426,7320,2961,[314,311,55,315],7.7868,3683,[317,318,55,319],7.931,7287,4447,[321,322,55,323],8.0752,7219,5260,[325,326,55,327],8.2194,7108,6128,[329,330,55,331],8.3636,6950,7060,[333,334,55,335],8.5078,6735,8066,[337,338,55,339],8.652,6454,9157,[341,342,55,343],8.7962,6093,10348,[345,346,55,347],8.9404,5635,11655,[349,350,55,351],9.0846,5060,13101,[353,354,55,355],9.2288,4338,14711,[357,358,55,359],9.373,3434,16518,[361,362,55,363],9.5172,2299,18563,[365,366,55,367],9.6614,867,20900,[369,370,55,371],9.8056,-954,23601,[373,374,55,375],9.9498,-3286,26756,[377,378,55,379],10.094,-6307,30487,[381,382,55,383],10.2382,-10273,34963,[385,386,55,387],10.3824,-15561,40414,[389,390,55,391],10.5266,-22742,47166,[393,394,55,395],10.6708,-32712,55683,[397,398,55,399],10.815,-46849,66607,[401,402,55,403],10.9592,-67353,80814,[405,406,55,407],11.1034,-97615,99354,[409,410,55,411],11.2476,-142316,122948,[413,414,55,415],11.3918,-205516,150083,[417,418,55,419],11.536,-281834,172373,[421,422,55,423],11.715,-348298,167168,[425,426,427,428],11.8244,-348092,913,167069,[430,431,432,433],11.9686,-347283,1757,166681,[435,436,437,438],12.1128,-346180,1892,166151,[440,441,442,443],12.257,-345227,1260,165694,[445,446,447,448],12.4012,-344810,120,165494,[450,451,452,453],12.5454,-345096,-1070,165631,[455,456,457,458],12.719,-346194,-1895,166158,[460,461,462,463],12.8338,-347082,-1845,166584,[465,466,467,468],12.978,-347977,-1117,167014,[470,471,472,473],13.1222,-348295,63,167166,[475,476,477,478],13.2664,-347910,1217,166981,[480,481,482,483],13.4106,-346973,1878,166532,[485,486,487,488],13.596,-345583,1612,165865,[490,491,492,493],13.699,-345038,963,165603,[495,496,55,497],13.8432,-344805,165491,[499,496,55,497],13.9874,[501,496,55,497],14.1316,[503,496,55,497],14.2758,{"vehicle_stage":505,"departure":34},"Long March 3A third stage (H-18)",[507,511,515,519,522],{"met_days":55,"type":508,"label":509,"description":510},"launch","Launch — Long March 3A","Xichang, 2007-10-24 10:05 UT (18:05 Beijing time). The orbiter is released at 10:29 UT into a 205 x 51,000 km Earth orbit.",{"met_days":292,"type":512,"label":513,"description":514},"tli_or_tmi","Trans-lunar injection","2007-10-31 09:15 UT. After three perigee burns raised the orbit, a 13-minute burn raises the speed to 10.9 km/s and starts the transfer to the Moon.",{"met_days":421,"type":516,"label":517,"description":518},"edl_or_oi","LOI-1 — lunar capture","2007-11-05 03:15 UT. A 22-minute braking burn captures Chang'e 1 into a 12-hour, 200 x 8,600 km near-polar lunar orbit.",{"met_days":455,"type":516,"label":520,"description":521},"LOI-2 — lunar orbit lowered","2007-11-06 03:21 UT. A 14-minute second braking burn (to 03:35 UT) lowers the orbit to 3.5 hours, 213 x 1,700 km.",{"met_days":485,"type":516,"label":523,"description":524},"LOI-3 — 200 km lunar science orbit reached","2007-11-07 00:24 UT. A final 10-minute burn (to 00:34 UT) slows the probe to 1.59 km/s and into the circular 200 km, 127-minute, high-inclination science orbit.","Chang'e 1","ROBOTIC ORBITER · FLOWN","China's first lunar mission and first Chinese spacecraft to reach the Moon","The first phase of China's Lunar Exploration Program (CLEP) and CNSA's first mission beyond Earth. Launched 2007-10-24 from Xichang Satellite Launch Center on a Long March 3A, Chang'e 1 (named after the Moon goddess of Chinese folklore) entered a 200-km circular polar lunar orbit on 2007-11-07. Carried 8 instruments — a CCD stereo camera, a laser altimeter, an imaging spectrometer, gamma-ray and X-ray spectrometers, a microwave radiometer, a solar wind detector, and a high-energy particle detector. Produced China's first full lunar global topographic map at 120-200 m resolution and elemental abundance maps of Th, K, U, O, Si, Mg, Al, Ca, Ti, Fe. Mission deliberately ended 2009-03-01 with a controlled impact at 1.50° S, 52.36° E in Mare Fecunditatis — China's first object on the lunar surface, paving the way for Chang'e 3 (2013 surface landing) and Chang'e 5 (2020 sample return). Operated 16 months — 4 months past nominal.",[530,534,537,540,544],{"met":55,"label":531,"note":532,"type":533},"LAUNCH","Long March 3A from Xichang LC-3 2007-10-24 10:05 UTC.","nominal",{"met":292,"label":535,"note":536,"type":533},"TLI","Trans-lunar injection via Earth parking-orbit + phasing orbits.",{"met":421,"label":538,"note":539,"type":533},"LOI","Lunar orbit insertion 2007-11-05 — first Chinese spacecraft at the Moon.",{"met":49,"label":541,"note":542,"type":543},"GLOBAL TOPO MAP","Stereo CCD + laser altimeter produce China's first full lunar global topographic map at 120-200 m resolution.","info",{"met":545,"label":546,"note":547,"type":533},494,"MARE FECUNDITATIS IMPACT","Controlled impact at 1.50° S, 52.36° E on 2009-03-01 — China's first object on the lunar surface.","/orrery/images/missions/change1/01.webp"],"uses":{"params":["id"]}}]}
