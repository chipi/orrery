{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":420},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"vehicle":13,"payload":14,"delta_v":15,"data_quality":16,"credit":17,"links":18,"flight_data_quality":30,"fleet_refs":31,"flight":40,"name":402,"type":403,"first":404,"description":405,"events":406,"vehicle_stage":42},"change3","CNSA","China National Space Administration","gov","MOON","#DE2910",2013,"FLOWN","2013-12-01","2013-12-14",13,"Long March 3B / E","3780 kg launch mass; 1200 kg lander; 140 kg Yutu rover","~3.8 km/s","good","© China National Space Administration. First successful uncrewed lunar landing for 37 years (since Luna 24, 1976). Mare Imbrium site; Yutu rover operated through 31 lunar days despite locomotion failure on day 42.",[19,23,27],{"l":20,"u":21,"t":22},"Chang'e 3 — Wikipedia","https://en.wikipedia.org/wiki/Chang%27e_3","intro",{"l":24,"u":25,"t":26},"嫦娥三号 — 中文维基百科","https://zh.wikipedia.org/wiki/%E5%AB%A6%E5%A8%A5%E4%B8%89%E5%8F%B7","core",{"l":28,"u":29,"t":26},"Chang'e 3 (NASA NSSDCA)","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=2013-070A","sparse",[32,35,38],{"id":33,"role":34},"long-march-3b","launcher",{"id":36,"role":37},"change-3","spacecraft",{"id":39,"role":37},"yutu",{"launch":41,"cruise":45,"arrival":48,"totals":57,"events":61,"cislunar_profile":85},{"vehicle_stage":42,"mass_at_tli_kg":43,"source":44},"Long March 3B/E with YZ-1 upper stage",3780,"CNSA mission archive; Xinhua News official release 2013-12-02",{"tcm_count":46,"source":47},0,"CNSA mission archive; first TCM 36 hours after launch, second TCM at lunar orbit insertion",{"v_infinity_km_s":49,"periapsis_km":50,"inclination_deg":51,"source":52,"entry_velocity_km_s":53,"edl_system":54,"edl_duration_s":55,"touchdown_velocity_ms":56},2.4,100,90,"CNSA mission archive; lunar-orbit insertion 2013-12-06, landing 2013-12-14",1.692,"powered",719,1,{"to