6919,1900,350497,[465,466,467,468],17.1919,156800,1815,350232,[470,471,472,473],17.4242,156688,1690,349981,[475,476,477,478],17.6566,156585,1522,349751,[480,481,482,483],17.8889,156494,1316,349549,[485,486,487,488],18.1212,156417,1080,349376,[490,491,492,493],18.3535,156357,816,349242,[495,496,497,498],18.5859,156313,533,349145,[500,501,502,503],18.8182,156289,236,349090,[107,505,65,506],156282,349075,[508,509,65,510],19.2828,-38535,-241246,[512,513,65,514],19.5152,-857,-135808,[516,517,65,518],19.7475,11726,-79841,[520,521,65,522],19.9798,15399,-50150,[524,525,65,526],20.2121,15980,-33087,[528,529,65,530],20.4444,15443,-22477,[532,533,65,534],20.6768,14503,-15442,[536,537,65,538],20.9091,13437,-10530,[540,541,65,542],21.1414,12357,-6954,[544,545,65,546],21.3737,11305,-4262,[548,549,65,550],21.6061,10295,-2178,[552,553,65,554],21.8384,9328,-527,[556,557,65,558],22.0707,8401,806,[560,561,65,562],22.303,7508,1898,[564,565,65,566],22.5354,6640,2805,[113,568,65,569],4954,4205,[571,568,65,569],23.0001,"Chang'e 5","SAMPLE RETURN · FLOWN","First lunar sample return in 44 years (since Luna 24, 1976)","Chang'e 5 was the first sample return from the Moon since the Soviet Union's Luna 24 in 1976 — a 44-year gap. The architecture: orbiter + lander + ascent vehicle + sample-return capsule, all in one launch. The lander touched down at Mons Rümker, drilled and scooped 1.731 kg of regolith, lifted off, rendezvoused and docked with the orbiter (the first robotic lunar rendezvous), and the capsule returned to Earth. The samples are from a region only 2 billion years old — much younger than any Apollo or Luna sample, rewriting models of lunar volcanism.",[577,581,584,587,592,595,599],{"met":65,"label":578,"note":579,"type":580},"LAUNCH","Long March 5 from Wenchang.","nominal",{"met":48,"label":582,"note":583,"type":580},"LOI","Lunar orbit insertion.",{"met":12,"label":585,"note":586,"type":580},"TOUCHDOWN","Lander descends to Mons Rümker (Oceanus Procellarum) 2020-12-01.",{"met":588,"label":589,"note":590,"type":591},8.5,"SAMPLING","1.731 kg collected via scoop and drill.","info",{"met":102,"label":593,"note":594,"type":580},"ASCENT","Ascent vehicle lifts off lunar surface.",{"met":596,"label":597,"note":598,"type":591},13,"RENDEZVOUS","First robotic lunar rendezvous; sample container transferred to orbiter.",{"met":113,"label":600,"note":601,"type":591},"EARTH RETURN","Sample capsule lands in Inner Mongolia 2020-12-16.","/orrery/images/missions/change5/01.webp"],"uses":{"params":["id"]}}]}
