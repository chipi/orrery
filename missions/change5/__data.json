{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":602},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"round_trip":13,"vehicle":14,"payload":15,"delta_v":16,"data_quality":17,"credit":18,"links":19,"flight_data_quality":31,"fleet_refs":32,"flight":42,"name":572,"type":573,"first":574,"description":575,"events":576,"vehicle_stage":44},"change5","CNSA","China National Space Administration / China Academy of Space Technology","gov","MOON","#DE2910",2020,"FLOWN","2020-11-23","2020-12-01",8,true,"Long March 5","8200 kg launch mass; 1.731 kg sample returned","~5 km/s","good","© CNSA. First lunar sample return in 44 years — ending a gap since Luna 24 (1976). Returned 1.731 kg from Mons Rümker, a geologically young (2 Ga) volcanic region.",[20,24,27],{"l":21,"u":22,"t":23},"Chang'e 5 — Wikipedia","https://en.wikipedia.org/wiki/Chang%27e_5","intro",{"l":25,"u":26,"t":23},"中国探月与深空探测网 (CLEP)","http://www.clep.org.cn/",{"l":28,"u":29,"t":30},"嫦娥五号 — 中文维基百科","https://zh.wikipedia.org/wiki/%E5%AB%A6%E5%A8%A5%E4%BA%94%E5%8F%B7","core","measured",[33,36,39],{"id":34,"role":35},"long-march-5","launcher",{"id":37,"role":38},"change-5","spacecraft",{"id":40,"role":41},"wenchang-lc-101","launch-site",{"launch":43,"cruise":47,"arrival":50,"totals":60,"events":63,"cislunar_profile":117},{"vehicle_stage":44,"mass_at_tli_kg":45,"source":46},"Long March 5 YZ-1 upper stage",8200,"CNSA Chang'e 5 Mission Report (2021)",{"tcm_count":48,"source":49},5,"CNSA Chang'e 5 Mission Operations Report",{"v_infinity_km_s":51,"periapsis_km":52,"inclination_deg":53,"orbit_insertion_dv_km_s":54,"source":55,"entry_velocity_km_s":56,"edl_system":57,"edl_duration_s":58,"touchdown_velocity_ms":59},0.85,200,88,0.8,"CNSA Chang'e 5 LOI Report (2020-11)",1.7,"powered",817,1.99,{"total_dv_km_s":48,"tli_or_tmi_dv_km_s":61,"source":62},3.15,"CNSA Chang'e 5 Mission Report (2021); sample-return round trip",[64,69,74,79,83,86,89,93,97,101,106,112],{"met_days":65,"type":66,"label":67,"description":68},0,"launch","Launch — Long March 5","Wenchang, China, 2020-11-23. Chang'e 5 — first sample return from the Moon since Soviet Luna 24 (1976), 44 years. CNSA's first multi-component robotic mission: orbiter + ascender + lander + Earth-return capsule, all stacked for one launch.",{"met_days":70,"type":71,"label":72,"description":73},0.05,"tli_or_tmi","Trans-lunar injection","Long March 5 upper stage burn sends Chang'e 5 directly on translunar trajectory.",{"met_days":75,"type":76,"label":77,"description":78},1.04,"tcm","MCC-1","First post-TLI cleanup.",{"met_days":80,"type":76,"label":81,"description":82},1.78,"MCC-2","Mid-cruise refinement.",{"met_days":84,"type":76,"label":85,"description":82},2.52,"MCC-3",{"met_days":87,"type":76,"label":88,"description":82},3,"MCC-4",{"met_days":90,"type":76,"label":91,"description":92},3.27,"MCC-5 — final pre-LOI","Final approach targeting.",{"met_days":48,"type":94,"label":95,"description":96,"dv_km_s":54},"loi","Lunar orbit insertion","2020-11-28. Captured into 200-km circular lunar orbit.",{"met_days":12,"type":98,"label":99,"description":100},"descent_start","Powered descent — Mons Rümker","2020-12-01. Lander descended to Mons Rümker (43.06°N, 51.92°W) in Oceanus Procellarum — one of the youngest large lava-flow regions on the Moon. Drilled to ~1 m + scooped surface regolith, collecting 1,731 g.",{"met_days":102,"type":103,"label":104,"description":105},10,"ascent","Ascent + lunar rendezvous","2020-12-03. Ascender lifted off the surface, rendezvoused + docked with the orbiter — China's first robotic rendezvous + docking around another body.",{"met_days":107,"type":108,"label":109,"description":110,"dv_km_s":111},19,"tei","Trans-Earth injection","2020-12-12. Orbiter departed lunar orbit on return trajectory.",0.9,{"met_days":113,"type":114,"label":115,"description":116},23,"earth_return","Sample return capsule landing — Inner Mongolia"