{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":613},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"round_trip":13,"vehicle":14,"payload":15,"delta_v":16,"data_quality":17,"credit":18,"links":19,"flight_data_quality":31,"fleet_refs":32,"flight":39,"name":587,"type":588,"first":589,"description":590,"events":591,"vehicle_stage":41},"change6","CNSA","China National Space Administration / China Academy of Space Technology","gov","MOON","#DE2910",2024,"FLOWN","2024-05-03","2024-06-01",30,true,"Long March 5","8200 kg launch mass; 1.935 kg sample returned","~5 km/s","good","© CNSA. First sample return from the lunar far side — possibly the most scientifically significant lunar mission since Apollo. Required Queqiao-2 relay satellite for far-side operations. Samples returned to Earth 2024-06-25.",[20,24,27],{"l":21,"u":22,"t":23},"Chang'e 6 — Wikipedia","https://en.wikipedia.org/wiki/Chang%27e_6","intro",{"l":25,"u":26,"t":23},"中国探月与深空探测网 (CLEP)","http://www.clep.org.cn/",{"l":28,"u":29,"t":30},"嫦娥六号 — 中文维基百科","https://zh.wikipedia.org/wiki/%E5%AB%A6%E5%A8%A5%E5%85%AD%E5%8F%B7","core","measured",[33,36],{"id":34,"role":35},"long-march-5","launcher",{"id":37,"role":38},"wenchang-lc-101","launch-site",{"launch":40,"cruise":44,"arrival":47,"totals":57,"events":60,"cislunar_profile":115},{"vehicle_stage":41,"mass_at_tli_kg":42,"source":43},"Long March 5 YZ-1 upper stage",8200,"CNSA Chang'e 6 Mission Report (2024)",{"tcm_count":45,"source":46},5,"CNSA Chang'e 6 Mission Operations Report",{"v_infinity_km_s":48,"periapsis_km":49,"inclination_deg":50,"orbit_insertion_dv_km_s":51,"source":52,"entry_velocity_km_s":53,"edl_system":54,"edl_duration_s":55,"touchdown_velocity_ms":56},0.85,200,90,0.82,"CNSA Chang'e 6 LOI Report (2024-05); far-side sample return required Queqiao-2 relay",1.7,"powered",899,1,{"total_dv_km_s":45,"tli_or_tmi_dv_km_s":58,"source":59},3.15,"CNSA Chang'e 6 Mission Report (2024); sample-return round trip",[61,66,71,76,80,83,86,90,94,99,104,110],{"met_days":62,"type":63,"label":64,"description":65},0,"launch","Launch — Long March 5","Wenchang, China, 2024-05-03. Chang'e 6 — first sample return from the lunar far side. Uses the same multi-component architecture as Chang'e 5 plus the Queqiao-2 relay satellite (launched 2024-03) in an elliptical frozen orbit around the Moon for far-side comms.",{"met_days":67,"type":68,"label":69,"description":70},0.05,"tli_or_tmi","Trans-lunar injection","Long March 5 upper stage burn places Chang'e 6 on translunar trajectory.",{"met_days":72,"type":73,"label":74,"description":75},1.04,"tcm","MCC-1","First post-TLI cleanup.",{"met_days":77,"type":73,"label":78,"description":79},1.78,"MCC-2","Mid-cruise refinement.",{"met_days":81,"type":73,"label":82,"description":79},2.52,"MCC-3",{"met_days":84,"type":73,"label":85,"description":79},3,"MCC-4",{"met_days":87,"type":73,"label":88,"description":89},3.27,"MCC-5 — final pre-LOI","Final approach targeting.",{"met_days":45,"type":91,"label":92,"description":93,"dv_km_s":51},"loi","Lunar orbit insertion","2024-05-08. Captured into 200-km circular lunar orbit. CNSA spent ~25 days adjusting orbit + waiting for far-side sunlight conditions at the landing site.",{"met_days":95,"type":96,"label":97,"description":98},29.54,"descent_start","Far-side powered descent — Apollo crater","2024-06-01. Lander descended to Apollo crater (41.64°S, 153.99°W) inside the South Pole-Aitken basin — the largest, deepest, oldest impact basin on the Moon. Communicated via the Queqiao-2 relay; drilled + scooped 1,935 g of far-side regolith.",{"met_days":100,"type":101,"label":102,"description":103},31.59,"ascent","Far-side ascent — first ever","2024-06-03. Ascender lifted off the lunar far side — the first launch from the Moon's far side in history. Rendezvoused with the orbiter for sample transfer.",{"met_days":105,"type":106,"label":107,"description":108,"