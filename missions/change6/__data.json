607,610],{"met":62,"label":593,"note":594,"type":595},"LAUNCH","Long March 5 from Wenchang.","nominal",{"met":45,"label":597,"note":598,"type":595},"LOI","Lunar orbit insertion.",{"met":95,"label":600,"note":601,"type":595},"TOUCHDOWN","Lander descends to Apollo Crater (far side) 2024-06-01 (UTC). All comms via Queqiao-2 relay.",{"met":603,"label":604,"note":605,"type":606},29.6,"SAMPLING","1.935 kg collected from far-side regolith.","info",{"met":100,"label":608,"note":609,"type":595},"ASCENT","Ascent vehicle lifts off; rendezvous with orbiter.",{"met":111,"label":611,"note":612,"type":606},"EARTH RETURN","Capsule lands in Inner Mongolia 2024-06-25 with the first far-side samples ever recovered.","/orrery/images/missions/change6/01.webp"],"uses":{"params":["id"]}}]}
