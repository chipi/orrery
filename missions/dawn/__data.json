piral highway.","nominal",{"met":12,"label":490,"note":491,"type":488},"CERES CAPTURE","Ion engines brake Dawn into orbit around Ceres; mapping campaign begins.","/orrery/images/missions/dawn/01.webp"],"uses":{"params":["id"]}}]}
