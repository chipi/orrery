{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":477},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"vehicle":13,"payload":14,"delta_v":15,"data_quality":16,"credit":17,"links":18,"flight_data_quality":30,"fleet_refs":31,"flight":35,"name":473,"type":474,"first":475,"description":476,"vehicle_stage":37},"hera","ESA","European Space Agency","gov","DIDYMOS","#003247",2024,"ACTIVE","2024-10-07","2026-11-28",782,"Falcon 9 Block 5","Hera orbiter + Juventas & Milani cubesats","~1.1 km/s (deep-space maneuvers; Mars gravity assist)","partial","© ESA — Hera. ESA's half of the international Asteroid Impact & Deflection Assessment (AIDA): a detailed post-impact survey of the Didymos binary asteroid, measuring the crater and momentum transfer left by NASA's DART kinetic impactor (2022). Launched on a Falcon 9 (2024-10-07) with a 2025 Mars gravity assist; arrives at Didymos late 2026. Carries the Juventas + Milani CubeSats.",[19,23,26],{"l":20,"u":21,"t":22},"Hera — ESA","https://www.esa.int/Space_Safety/Hera","intro",{"l":24,"u":25,"t":22},"Hera (space mission) — Wikipedia","https://en.wikipedia.org/wiki/Hera_(space_mission)",{"l":27,"u":28,"t":29},"Planetary defence — ESA","https://www.esa.int/Space_Safety/Planetary_Defence","deep","sparse",[32],{"id":33,"role":34},"falcon-9","launcher",{"launch":36,"cruise":40,"arrival":43,"totals":49,"events":52,"interplanetary_profile":80},{"vehicle_stage":37,"mass_at_tli_kg":38,"source":39},"Falcon 9 second stage",1128,"ESA Hera mission profile (launch mass ~1128 kg incl. CubeSats)",{"tcm_count":41,"source":42},2,"ESA Hera cruise plan (deep-space maneuvers + 2025 Mars gravity assist)",{"v_infinity_km_s":44,"periapsis_km":45,"inclination_deg":46,"orbit_insertion_dv_km_s":47,"source":48},1,30,0,0.1,"ESA Hera Didymos rendezvous (approximate low-velocity approach + proximity ops)",{"total_dv_km_s":50,"tli_or_tmi_dv_km_s":46,"so