98,[326,327,59,328],1.8804,35421,16313,[330,331,59,332],1.9123,37081,17409,[334,335,59,336],1.9441,38859,18593,[338,339,59,340],1.976,40768,19876,[342,343,59,344],2.0079,42820,21268,[346,347,59,348],2.0398,45028,22779,[350,351,59,352],2.0716,47408,24423,[354,355,59,356],2.1035,49977,26214,[358,359,59,360],2.1354,52755,28168,[362,363,59,364],2.1672,55764,30303,[366,367,59,368],2.1991,59027,32641,[370,371,59,372],2.231,62572,35205,[374,375,59,376],2.2629,66430,38022,[378,379,59,380],2.2947,70633,41120,[382,383,59,384],2.3266,75221,44535,[386,387,59,388],2.3585,80235,48304,[390,391,59,392],2.3903,85721,52470,[394,395,59,396],2.4222,91731,57079,[398,399,59,400],2.4541,98318,62186,[402,403,59,404],2.486,105542,67846,[406,407,59,408],2.5178,113464,74123,[410,411,59,412],2.5497,122147,81083,[414,415,59,416],2.5816,131652,88794,[418,419,59,420],2.6134,142032,97321,[422,423,59,424],2.6453,153329,106726,[426,427,59,428],2.6772,165562,117056,[430,431,59,432],2.7091,178719,128341,[434,435,59,436],2.7409,192729,140562,[438,439,59,440],2.7728,207446,153647,[442,443,59,444],2.8047,222635,167448,[446,447,59,448],2.8365,237949,181722,[450,451,59,452],2.8684,252913,196111,[454,455,59,456],2.9003,266925,210137,[458,459,59,460],2.9322,279286,223213,[462,463,59,464],2.964,289252,234684,[78,466,59,467],297546,246107,[469,466,59,467],3.0278,[471,466,59,467],3.0596,[473,466,59,467],3.0915,[475,466,59,467],3.1234,[477,466,59,467],3.1553,"Luna 9","UNCREWED LANDER · FLOWN","First soft-landing on the Moon; first photographs from the lunar surface","After 11 Soviet failures and 5 American Ranger missions designed only to crash, Luna 9 became the first spacecraft to soft-land on another world. Nine images — including five panoramas — returned across seven radio sessions (8 h 5 min in total) over three days settled a long-running scientific debate: the Moon's surface was solid, not a sea of dust deep enough to swallow a lander. The mission lasted 3 days before battery depletion. Within months, every Moon-bound mission afterwards used soft-landing as the baseline.",[483,487,490,495],{"met":59,"label":484,"note":485,"type":486},"LAUNCH","Molniya-M from Baikonur 1966-01-31.","nominal",{"met":12,"label":488,"note":489,"type":486},"TOUCHDOWN","Soft-landing at Oceanus Procellarum 1966-02-03 18:45 UTC. First soft-landing on another world.",{"met":491,"label":492,"note":493,"type":494},3.01,"FIRST IMAGES","Nine images including five panoramas, returned in seven transmission sessions (8 h 5 min in total) over three days.","info",{"met":496,"label":497,"note":498,"type":499},6,"SIGNAL LOSS","Battery depleted; final transmission 1966-02-06.","warning","/orrery/images/missions/luna9/01.webp"],"uses":{"params":["id"]}}]}
