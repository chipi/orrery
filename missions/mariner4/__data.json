,[328,329,51,330],153.002,-1.265148,-0.491409,[332,333,51,334],155.431,-1.259306,-0.525343,[336,337,51,338],157.86,-1.252552,-0.558897,[340,341,51,342],160.289,-1.244965,-0.592079,[344,345,51,346],162.718,-1.236612,-0.624897,[348,349,51,350],165.147,-1.227373,-0.657268,[352,353,51,354],167.577,-1.217384,-0.689236,[356,357,51,358],170.006,-1.206665,-0.720792,[360,361,51,362],172.435,-1.195114,-0.751851,[364,365,51,366],174.864,-1.182879,-0.782479,[368,369,51,370],177.293,-1.169936,-0.81264,[372,373,51,374],179.723,-1.156244,-0.84228,[376,377,51,378],182.152,-1.141917,-0.871457,[380,381,51,382],184.581,-1.126905,-0.900112,[384,385,51,386],187.01,-1.111225,-0.928233,[388,389,51,390],189.439,-1.094955,-0.955862,[392,393,51,394],191.868,-1.078028,-0.982917,[396,397,51,398],194.297,-1.060506,-1.009429,[400,401,51,402],196.727,-1.042439,-1.035424,[404,405,51,406],199.156,-1.023744,-1.060794,[408,409,51,410],201.585,-1.004524,-1.085621,[412,413,51,414],204.014,-0.984793,-1.109895,[416,417,51,418],206.443,-0.964486,-1.13352,[420,421,51,422],208.873,-0.943708,-1.156591,[424,425,51,426],211.302,-0.922444,-1.179067,[428,429,51,430],213.731,-0.900673,-1.200895,[432,433,51,434],216.16,-0.878473,-1.222152,[436,437,51,438],218.589,-0.855814,-1.242769,[440,441,51,442],221.018,-0.832714,-1.262745,[444,445,51,446],223.448,-0.809225,-1.282133,[448,449,51,450],225.877,-0.785307,-1.300841,[66,452,51,453],-0.754021,-1.324006,[455,456,51,457],230.7273,-0.747958,-1.327441,[459,456,51,457],233.1455,[461,456,51,457],235.5636,[463,456,51,457],237.9818,[465,456,51,457],240.4,"Mariner 4","FLYBY · FLOWN","First spacecraft to reach Mars and return close-up images of another planet","The mission that ended dreams of a habitable Mars. Mariner 4's 22 grainy images, taken during a 25-minute closest approach at 9,846 km altitude, showed a cratered surface resembling the Moon — no canals, no vegetation, no obvious life. The atmosphere was about 15 times thinner than expected. The discovery reshaped Mars in the public imagination from sister-Earth to dead world. Tracking the spacecraft also produced a measurement of the solar wind's structure between planets.",[471,475,477,480],{"met":51,"label":472,"note":473,"type":474},"LAUNCH","Atlas LV-3 Agena-D lifts off from Cape Canaveral LC-12.","nominal",{"met":61,"label":63,"note":476,"type":474},"First mid-course correction completed; trajectory locked.",{"met":66,"label":478,"note":479,"type":474},"MARS FLYBY","Closest approach 9,846 km. 22 images returned over about three weeks of data playback.",{"met":481,"label":482,"note":483,"type":484},229.5,"FIRST IMAGES","First close-up images of another planet ever returned to Earth.","info","/orrery/images/missions/mariner4/02.webp"],"uses":{"params":["id"]}}]}
