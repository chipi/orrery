{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":507},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"vehicle":13,"payload":14,"delta_v":15,"data_quality":16,"credit":17,"links":18,"flight_data_quality":26,"fleet_refs":27,"flight":33,"name":485,"type":486,"first":487,"description":488,"events":489,"vehicle_stage":35},"mars-express","ESA","European Space Agency","gov","MARS","#003247",2003,"ACTIVE","2003-06-02","2003-12-25",206,"Soyuz-FG / Fregat","1223 kg at launch, including the 60 kg Beagle 2 lander","~4.5 km/s","good","© ESA. Beagle 2 lander reached the surface but never deployed solar panels fully, lost. Orbiter remains active 20+ years — Europe's first mission to another planet and longest-running non-NASA Mars mission.",[19,23],{"l":20,"u":21,"t":22},"Mars Express — Wikipedia","https://en.wikipedia.org/wiki/Mars_Express","intro",{"l":24,"u":25,"t":22},"Mars Express (ESA)","https://www.esa.int/Science_Exploration/Space_Science/Mars_Express","measured",[28,31],{"id":29,"role":30},"soyuz-fg","launcher",{"id":2,"role":32},"spacecraft",{"launch":34,"cruise":39,"arrival":42,"totals":52,"events":56,"interplanetary_profile":92},{"vehicle_stage":35,"c3_km2_s2":36,"mass_at_tli_kg":37,"source":38},"Fregat upper stage",10.5,1223,"ESA Mars Express Press Kit (2003-06); Soyuz-Fregat User's Manual",{"tcm_count":40,"source":41},4,"ESA Mars Express Mission Operations Report",{"v_infinity_km_s":43,"periapsis_km":44,"inclination_deg":45,"orbit_insertion_dv_km_s":46,"source":47,"entry_velocity_km_s":48,"edl_system":49,"edl_duration_s":50,"touchdown_velocity_ms":51},2.9,250,86.3,0.81,"ESA Mars Express MOI Report (2003-12)",5.5,"airbag",426,19.8,{"total_dv_km_s":53,"tli_or_tmi_dv_km_s":54,"source":55},4.5,3.6,"ESA Mars Express Press Kit (2003-06)",[57,62,67,72,76,79,83,87],{"met_days":58,"type":59,"label":60,"description":61},0,"launch","Launch — Soyuz-FG / Fregat","Baikonur Cosmodrome, 2003-06-02. ESA's first Mars mission, launched on a Russian Soyuz under a cooperative contract. Carried the Beagle 2 lander, designed by the UK's Beagle Project. Mars Express is still operational, one of the longest-running Mars orbiters (after Mars Odyssey).",{"met_days":63,"type":64,"label":65,"description":66},0.064,"tli_or_tmi","Trans-Mars injection","Fregat upper stage burn at T+90 minutes sends Mars Express on a 6.5-month Hohmann-like transfer.",{"met_days":68,"type":69,"label":70,"description":71},2,"tcm","TCM-1","First post-TMI cleanup.",{"met_days":73,"type":69,"label":74,"description":75},47.38,"TCM-2","Mid-cruise refinement.",{"met_days":77,"type":69,"label":78,"description":75},110,"TCM-3",{"met_days":80,"type":69,"label":81,"description":82},200,"TCM-4","Final approach targeting.",{"met_days":12,"type":84,"label":85,"description":86},"arrival","Mars approach + Beagle 2 release","2003-12-19. Beagle 2 lander separated for independent EDL toward Isidis Planitia. Mars Express continued to MOI alone.",{"met_days":88,"type":89,"label":90,"description":91},206.01,"edl_or_oi","Mars orbit insertion","2003-12-25 — Christmas Day. 37-minute main engine burn captured Mars Express into an initial ~250 × 150,000 km orbit, later trimmed to the operational ~298 × 10,107 km near-polar science orbit. Beagle 2 had separated 6 days earlier and landed the same day (2003-12-25) but failed to fully deploy its solar panels — only discovered in 2015 from MRO HiRISE imagery. Mars Express's MARSIS radar later mapped subsurface ice and in 2018 found a bright radar reflector under the south polar cap, read as a subglacial lake — an interpretation still disputed.",{"source_tier":93,"reference_frame":94,"departure_body":95,"arrival_body":96,"transfer_type":97,"tcm_count":40,"waypoints_helio_au":98},"tier_1_5_hybrid","heliocentric_ecliptic_J2000","earth","mars","type1_lambert",[99,102,106,110,114,118,122,126,130,134,138,142,145,149,153,157,161,165,169,173,177,181,18