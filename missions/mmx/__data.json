76,424,57,425],-1.159931,-0.969186,[427,428,57,429],251.7755,-1.146722,-0.986915,[431,432,57,433],254.8089,-1.123534,-1.016669,[435,436,57,437],257.8423,-1.099376,-1.045545,[439,440,57,441],260.8758,-1.074422,-1.073662,[443,444,57,445],263.9092,-1.048638,-1.100951,[447,448,57,449],266.9427,-1.021991,-1.127334,[451,452,57,453],269.9761,-0.99461,-1.152906,[455,456,57,457],273.0095,-0.966436,-1.177561,[79,459,57,460],-0.947561,-1.193269,[462,463,57,464],279.0764,-0.907895,-1.224153,[466,467,57,468],282.1099,-0.87754,-1.246011,[87,470,57,471],-0.83757,-1.272798,[473,474,57,475],288.1767,-0.831857,-1.27654,[477,474,57,475],291.2102,[479,474,57,475],294.2436,[481,474,57,475],297.2771,[483,474,57,475],300.3105,"MMX","PHOBOS SAMPLE RETURN · ACTIVE","First sample return from a Martian moon","Martian Moons eXploration is JAXA's plan to land on Phobos, scoop ~10 g of regolith, and bring it home. The samples may settle a long-debated question: are Phobos and Deimos captured asteroids, or fragments from an ancient impact on Mars itself? The mission also includes a German-French rover for Phobos surface mobility — a wholly different operations model from anything the Hayabusa missions did at Itokawa or Ryugu. Launch slipped from 2024 to 2026 with the delays of JAXA's H3 rocket; MMX lifted off on 19 October 2026 and is due to enter Mars orbit in August 2027.",[489,493,496,501,505],{"met":57,"label":490,"note":491,"type":492},"LAUNCH","H3 flight 10 from Tanegashima, 19 October 2026 — the first H3 to send a spacecraft to another planet.","nominal",{"met":12,"label":494,"note":495,"type":492},"MARS ORBIT INSERTION","Capture into Mars orbit; transfer to Phobos quasi-orbit over following months.",{"met":497,"label":498,"note":499,"type":500},986,"ROVER DEPLOY","DLR/CNES rover (~25 kg) released onto Phobos surface for in-situ studies.","info",{"met":502,"label":503,"note":504,"type":500},1351,"PHOBOS SAMPLE","MMX touches down on Phobos; ~10 g of regolith collected.",{"met":506,"label":507,"note":508,"type":500},1716,"EARTH RETURN","Sample re-entry capsule arrives at Earth ~2031.","/orrery/images/missions/mmx/01.webp"],"uses":{"params":["id"]}}]}
