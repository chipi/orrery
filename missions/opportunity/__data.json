ll,"JPL MER-B EDL Reconstruction (2004); direct atmospheric entry","airbag",330,21.01,{"total_dv_km_s":56,"tli_or_tmi_dv_km_s":57,"source":58},5.5,3.8,"NASA MER Press Kit (2003-06)",[60,65,70,75,79,83,87,91],{"met_days":61,"type":62,"label":63,"description":64},0,"launch","Launch — Delta II 7925H","Cape Canaveral LC-17B, 2003-07-07. Second of the twin Mars Exploration Rovers. Flew on the heavier Delta II 7925H (Heavy) variant to compensate for the slightly later launch and a higher-energy injection requirement. Designed for 90 sols. Would operate for 5,111 sols.",{"met_days":66,"type":67,"label":68,"description":69},0.005,"tli_or_tmi","Trans-Mars injection","PAM-D solid upper-stage burn sends Opportunity on a 6.6-month Type-I transfer, three weeks behind its twin Spirit.",{"met_days":71,"type":72,"label":73,"description":74},12,"tcm","TCM-1","First mid-course correction.",{"met_days":76,"type":72,"label":77,"description":78},70,"TCM-2","Mid-cruise refinement.",{"met_days":80,"type":72,"label":81,"description":82},160,"TCM-3","Approach trim toward Meridiani Planum target ellipse.",{"met_days":84,"type":72,"label":85,"description":86},195,"TCM-4 — final pre-EDL","Final trim before the atmospheric entry interface.",{"met_days":12,"type":88,"label":89,"description":90},"arrival","Mars approach + cruise-stage separation","2004-01-25. Cruise stage jettisoned; backshell + heat shield + lander entered the atmosphere at 5.5 km/s.",{"met_days":92,"type":93,"label":94,"description":95},202.005,"edl_or_oi","Mars EDL — airbag landing in Meridiani Planum","Bounced 26 times across the hematite-rich plains of Meridiani Planum and rolled into a 22-m diameter crater — Eagle Crater — by sheer luck. The first close-up images showed bedrock exposing in the crater walls, geology a rover could read without driving anywhere. Found jarosite and \"blueberry\" hematite concretions, the strongest mineral evidence to that point of standing liquid water on early Mars. Traversed 45.16 km over 14+ years — a record until Perseverance passed it in October 2026. Final transmission 2018-06-10 during a planet-wide dust storm; NASA declared end-of-mission 2019-02-13.",{"source_tier":97,"reference_frame":98,"departure_body":99,"arrival_body":100,"transfer_type":101,"tcm_count":45,"waypoints_helio_au":102},"tier_1_5_hybrid","heliocentric_ecliptic_J2000","earth","mars","type1_lambert",[103,106,110,114,118,122,126,129,133,137,141,145,149,153,157,161,165,169,173,177,181,185,189,193,197,201,205,209,213,217,221,225,229,233,236,240,244,248,252,256,260,264,268,272,276,280,284,288,292,296,300,304,308,312,316,320,324,328,332,336,340,344,348,352,356,360,364,368,372,376,380,384,388,392,396,400,403,407,411,415,419,423,427,431,435,439,443,447,451,455,459,463,466,470,474,477,481,483,485,487],[61,104,61,105],0.253101,-0.96744,[107,108,61,109],2.1425,0.292831,-0.962027,[111,112,61,113],4.285,0.332204,-0.955431,[115,116,61,117],6.4274,0.371157,-0.947618,[119,120,61,121],8.5699,0.40959,-0.93848,[123,124,61,125],10.7124,0.447541,-0.928238,[71,127,61,128],0.470066,-0.921489,[130,131,61,132],14.9973,0.521706,-0.904261,[134,135,61,136],17.1398,0.5579,-0.890684,[138,139,61,140],19.2823,0.59341,-0.876014,[142,143,61,144],21.4248,0.628236,-0.860334,[146,147,61,148],23.5673,0.662405,-0.843754,[150,151,61,152],25.7097,0.695782,-0.826163,[154,155,61,156],27.8522,0.728433,-0.807712,[158,159,61,160],29.9947,0.760367,-0.788463,[162,163,61,164],32.1372,0.79142,-0.768301,[166,167,61,168],34.2796,0.821727,-0.747416,[170,171,61,172],36.4221,0.851242,-0.72581,[174,175,61,176],38.5646,0.879864,-0.703441,[178,179,61,180],40.7071,0.907708,-0.680451,[182,183,61,184],42.8495,0.934697,-0.65682,[186,187,61,188],44.992,0.960798,-0.632565,[190,191,61,192],47.1345,0.986102,-0.607784,[194,195,61,196],49.277,1.010499,-0.582444,[198,199,61,200],51.4195,1.034028,-0.556605,[202,203,61,204],53.5619,1.056751,-0.53033,[206,207,61,208],55.7044,1.078525,-0.503579,[210,211,61,212],57.8469,1.099463,-0.476438,[214,215,61,21