65,-1.236033,[362,363,54,364],148.6613,0.627121,-1.227753,[366,367,54,368],150.9842,0.65837,-1.218676,[370,371,54,372],153.307,0.689227,-1.208873,[374,375,54,376],155.6298,0.719704,-1.198404,[378,379,54,380],157.9527,0.749717,-1.187162,[382,383,54,384],160.2755,0.779319,-1.175268,[386,387,54,388],162.5983,0.808499,-1.162739,[390,391,54,392],164.9212,0.837177,-1.149487,[394,395,54,396],167.244,0.865423,-1.135642,[398,399,54,400],169.5668,0.893199,-1.12118,[402,403,54,404],171.8897,0.920459,-1.10607,[406,407,54,408],174.2125,0.947259,-1.090409,[410,411,54,412],176.5353,0.973544,-1.074154,[414,415,54,416],178.8582,0.999305,-1.057321,[418,419,54,420],181.181,1.024584,-1.039977,[422,423,54,424],183.5038,1.049301,-1.022063,[426,427,54,428],185.8267,1.073492,-1.003637,[430,431,54,432],188.1495,1.097181,-0.984741,[434,435,54,436],190.4723,1.120265,-0.965301,[438,439,54,440],192.7952,1.142824,-0.94541,[442,443,54,444],195.118,1.16485,-0.925078,[446,447,54,448],197.4408,1.186253,-0.904251,[450,451,54,452],199.7637,1.207125,-0.88302,[454,455,54,456],202.0865,1.227426,-0.86137,[458,459,54,460],204.4093,1.247109,-0.839286,[462,463,54,464],206.7322,1.266246,-0.816836,[466,467,54,468],209.055,1.284774,-0.793992,[470,471,54,472],211.3778,1.302692,-0.770772,[474,475,54,476],213.7007,1.320053,-0.747221,[88,478,54,479],1.340113,-0.718353,[97,481,54,482],1.35741,-0.692082,[484,485,54,486],220.6692,1.360498,-0.685991,[488,485,54,486],222.992,[490,485,54,486],225.3148,[492,485,54,486],227.6377,[494,485,54,486],229.9605,"Schiaparelli EDM","ENTRY/DESCENT/LANDING DEMONSTRATOR · CRASHED","ESA's first own Mars lander attempt; intended to demonstrate EDL ahead of ExoMars Rosalind Franklin","Schiaparelli was the entry-descent-landing demonstrator carried piggyback on the ExoMars Trace Gas Orbiter (TGO). Named for the Italian astronomer Giovanni Schiaparelli, the craft was built to prove the EDL stack ESA intended to scale up for the Rosalind Franklin rover. Schiaparelli separated from TGO on 16 October 2016 and entered the Martian atmosphere three days later. The descent profile collapsed: a saturated inertial measurement unit caused the navigation software to think the craft had already landed at altitude — the parachute jettisoned early and the braking thrusters cut off after firing for only 3 seconds. Schiaparelli struck the surface at ~150 m/s. TGO itself completed orbit insertion successfully and continues operating.",[500,504,507,511,514,517,520,523],{"met":54,"label":501,"note":502,"type":503},"LAUNCH","Proton-M from Baikonur 2016-03-14. TGO + Schiaparelli stack.","nominal",{"met":70,"label":505,"note":506,"type":503},"TMI","Trans-Mars injection on the Briz-M upper stage.",{"met":75,"label":508,"note":509,"type":510},"TCM 1","First mid-course correction during 7-month cruise.","info",{"met":80,"label":512,"note":513,"type":510},"TCM 2","Mid-cruise correction.",{"met":84,"label":515,"note":516,"type":510},"TCM 3","Final approach correction before TGO/Schiaparelli separation.",{"met":88,"label":518,"note":519,"type":503},"SEPARATION","Schiaparelli separated from TGO 2016-10-16, three days before atmospheric entry.",{"met":12,"label":521,"note":522,"type":503},"ENTRY","Atmospheric entry 2016-10-19.",{"met":97,"label":524,"note":525,"type":526},"DESCENT ANOMALY","IMU saturation → premature parachute jettison + thruster cutoff at altitude → impact ~150 m/s in Meridiani Planum.","warning","/orrery/images/missions/schiaparelli/06.webp"],"uses":{"params":["id"]}}]}
