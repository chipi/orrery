,1612.3903,0.702201,0.19926,[410,411,53,412],1633.8889,0.695778,0.220155,[414,415,53,416],1655.3874,0.688858,0.240836,[418,419,53,420],1676.886,0.681365,0.261267,[422,423,53,424],1698.3845,0.67301,0.281309,[426,427,53,428],1719.883,0.664164,0.301122,[430,431,53,432],1741.3816,0.654803,0.320695,[434,435,53,436],1762.8801,0.644543,0.339831,[438,439,53,440],1784.3786,0.633801,0.358725,[442,443,53,444],1805.8772,0.622577,0.377376,[446,447,53,448],1827.3757,0.610473,0.395568,[450,451,53,452],1848.8743,0.597875,0.413491,[454,455,53,456],1870.3728,0.584808,0.431158,[458,459,53,460],1891.8713,0.570932,0.448366,[462,463,53,464],1913.3699,0.556531,0.465263,[466,467,53,468],1934.8684,0.541676,0.481889,[470,471,53,472],1956.3669,0.526088,0.498058,[474,475,53,476],1977.8655,0.509951,0.51387,[478,479,53,480],1999.364,0.493382,0.529393,[100,482,53,483],0.47116,0.548829,[485,486,53,487],2042.3611,0.463519,0.555298,[489,486,53,487],2063.8596,[491,486,53,487],2085.3582,[493,486,53,487],2106.8567,[495,486,53,487],2128.3553,"Akatsuki","ORBITER · GEVLOGEN","Herstelde na vijf jaar in een baan om de Zon en bereikte Venus bij een reservepoging; de enige actieve Venus-orbiter in de laatste jaren van zijn operaties","Akatsuki — “dageraad” — was Japans eerste Venusmissie. Gelanceerd op 2010-05-20 vanaf Tanegashima met een H-IIA 202, samen met de zonnezeildemonstrator IKAROS. De geplande baaninsertie rond Venus op 2010-12-07 mislukte toen zoutafzetting een terugslagklep tussen de heliumdruktank en de brandstoftank blokkeerde; de motor, verstoken van brandstof, draaide oxidatorrijk en raakte oververhit, en de sonde ging ongeveer 152 seconden na het begin van de motorbrand in veilige modus. JAXA hield de sonde vijf jaar in leven in een baan om de Zon, met twaalf correctiemanoeuvres, tot het volgende Venus-ontmoetingsvenster. Op 2015-12-07 plaatste een motorbrand van 1228 seconden met vier standregelingsstuwers — nooit ontworpen voor baaninsertie — Akatsuki in een sterk elliptische baan van 400 × 440.000 km met 3° inclinatie. Een van de spectaculairste missieredingen in de geschiedenis van de ruimtevaart. Het contact ging in 2024 verloren; JAXA verklaarde de operaties op 2025-09-18 voltooid.",[501,503,504,506,508,509],{"met":53,"label":58,"note":59,"type":502},"nominal",{"met":66,"label":68,"note":69,"type":502},{"met":80,"label":82,"note":83,"type":505},"warning",{"met":90,"label":92,"note":93,"type":507},"info",{"met":12,"label":96,"note":97,"type":507},{"met":510,"label":511,"note":512,"type":507},2200,"WETENSCHAPPELIJKE OPERATIES","UV/IR-volgen van wolkenstructuren; onderzoek naar superrotatie; boogvormige zwaartekrachtgolven boven Aphrodite Terra. Contact verloren in 2024; operaties op 2025-09-18 voltooid verklaard.",[514,515],{"met":71,"label":72,"description":73},{"met":75,"label":76,"description":77},"/orrery/images/missions/akatsuki/01.webp"],"uses":{"params":["id"]}}]}
