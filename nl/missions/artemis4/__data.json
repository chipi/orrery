7273,231872,304436,[435,436,437,438],12.9091,231432,4052,303858,[440,441,240,442],13.0909,231035,303336,[444,445,235,446],13.2727,230691,302885,[448,449,230,450],13.4545,230416,302523,[452,453,225,454],13.6364,230213,302257,[456,457,220,458],13.8182,230087,302092,[107,460,69,461],230042,302033,[463,464,69,465],14.1818,-302855,-63286,[467,468,69,469],14.3636,-188900,-63636,[471,472,69,473],14.5455,-114116,-54284,[475,476,69,477],14.7273,-71184,-44933,[479,480,69,481],14.9091,-46058,-37397,[483,484,69,485],15.0909,-30557,-31527,[487,488,69,489],15.2727,-20494,-26918,[491,492,69,493],15.4545,-13667,-23233,[495,496,69,497],15.6364,-8856,-20223,[499,500,69,501],15.8182,-5358,-17714,[503,504,69,505],16,-2750,-15584,[507,508,69,509],16.1818,-767,-13746,[511,512,69,513],16.3636,769,-12137,[515,516,69,517],16.5455,1974,-10708,[519,520,69,521],16.7273,2928,-9423,[523,524,69,525],16.9091,3690,-8256,[527,528,69,529],17.0909,4299,-7184,[531,532,69,533],17.2727,4787,-6190,[535,536,69,537],17.4545,5175,-5260,[539,540,69,541],17.6364,5481,-4382,[113,543,69,544],5889,-2747,[546,543,69,544],18.0001,"Artemis IV","BEMANDE LANDER · GEPLAND","Eerste bemande maanlanding sinds Apollo 17 (1972)","Sinds NASA's planwijziging van februari 2026 is Artemis IV de missie die mensen terugbrengt naar het maanoppervlak — de eerste bemande landing sinds Apollo 17 in 1972, en de eerste bemande landing bij de zuidpool. De SLS, op zijn laatste vlucht met de tijdelijke bovenste trap, lanceert Orion met vier bemanningsleden naar de Maan. In een baan om de Maan ontmoeten ze een commerciële lander — SpaceX' Starship of Blue Origins Blue Moon, te kiezen na de koppelingstests van Artemis III — en dalen twee astronauten af naar het zuidpoolgebied voor ongeveer een week werk aan het oppervlak, terwijl twee aan boord van Orion blijven. De zuidpool is het doel omdat de permanent beschaduwde kraters waterijs bevatten, dat toekomstige missies kunnen omzetten in drinkwater, zuurstof en raketbrandstof. NASA heeft negen kandidaat-landingsgebieden aangewezen. Gepland voor begin 2028; de bemanning is nog niet bekendgemaakt.",[552,554,555,556,558,559,560],{"met":69,"label":71,"note":72,"type":553},"nominal",{"met":75,"label":77,"note":78,"type":553},{"met":12,"label":91,"note":92,"type":553},{"met":95,"label":97,"note":98,"type":557},"info",{"met":101,"label":103,"note":104,"type":553},{"met":107,"label":109,"note":110,"type":553},{"met":113,"label":115,"note":116,"type":557},[562,563],{"met":81,"label":83,"description":84},{"met":86,"label":87,"description":88},"/orrery/images/missions/artemis4/01.webp"],"uses":{"params":["id"]}}]}
