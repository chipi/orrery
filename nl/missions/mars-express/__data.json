iten NASA","ESA's eerste missie naar een andere planeet dan de Aarde. De orbiter heeft het langste continue record van Mars' atmosfeer geproduceerd, met kartering van waterijsdepots, methaanpluimen en het driedimensionale weer van de planeet. Beagle 2, de Britse lander die het droeg, bereikte het oppervlak maar ontvouwde nooit volledig zijn zonnepanelen — verklaard verloren in 2004, intact gevonden door NASA's Mars Reconnaissance Orbiter in 2015. De orbiter is in zijn derde decennium van werking.",[492,494,495,496,497],{"met":58,"label":60,"note":61,"type":493},"nominal",{"met":69,"label":71,"note":72,"type":493},{"met":81,"label":82,"note":83,"type":493},{"met":12,"label":87,"note":88,"type":493},{"met":498,"label":499,"note":500,"type":501},212,"BEAGLE 2 STIL","Verwacht eerste signaal niet ontvangen; lander verklaard verloren.","warning",[503,504],{"met":74,"label":75,"description":76},{"met":78,"label":79,"description":76},"/orrery/images/missions/mars-express/03.webp"],"uses":{"params":["id"]}}]}
