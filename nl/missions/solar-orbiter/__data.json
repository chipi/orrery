54,133],1151.247,[225,132,54,133],1180.976,[227,132,54,133],1210.703,[229,132,54,133],1240.432,[231,132,54,133],1270.161,[233,132,54,133],1299.889,[235,132,54,133],1329.618,[237,132,54,133],1359.345,[239,132,54,133],1389.074,[241,132,54,133],1418.802,[243,132,54,133],1448.531,[245,132,54,133],1478.26,[247,132,54,133],1507.987,[249,132,54,133],1537.716,[251,132,54,133],1567.445,[253,132,54,133],1597.173,[255,132,54,133],1626.902,[257,132,54,133],1656.629,[259,132,54,133],1686.358,[261,132,54,133],1716.087,[263,132,54,133],1745.815,[265,132,54,133],1775.543,[267,132,54,133],1805.271,[93,132,54,133],[270,132,54,133],1853.926,[272,132,54,133],1872.852,[274,132,54,133],1891.778,[276,132,54,133],1910.704,[278,132,54,133],1929.63,[280,132,54,133],1948.556,[282,132,54,133],1967.481,[284,132,54,133],1986.407,[286,132,54,133],2005.333,[288,132,54,133],2024.259,[290,132,54,133],2043.185,[292,132,54,133],2062.111,[294,132,54,133],2081.037,[296,132,54,133],2099.963,[298,132,54,133],2118.889,[300,132,54,133],2137.815,[302,132,54,133],2156.741,[304,132,54,133],2175.667,[98,132,54,133],[307,132,54,133],2216.6667,[309,132,54,133],2240,[311,132,54,133],2263.3333,[313,132,54,133],2286.6667,[315,132,54,133],2310,"Solar Orbiter","ZONNEVERKENNER · ACTIEF","Eerste missie die is ontworpen om de poolgebieden van de zon in detail af te beelden; vult de metingen van Parker Solar Probe in de corona aan met waarnemingen op afstand op hoge breedtegraden.","Door ESA geleide missie met een NASA-lancering en bijdrage van twee instrumenten (SoloHI en de Heavy Ion Sensor). Waar Parker Solar Probe dichterbij komt dan wie dan ook ooit is geweest, gaat Solar Orbiter hoger — door middel van herhaalde Venus-zwaartekrachtassisties gedurende een decennium om uit de ecliptica te klimmen naar ~33° heliografische inclinatie. Vanaf dat uitkijkpunt fotografeert zijn instrumentenpakket (PHI, EUI, SPICE, STIX, METIS, SoloHI + vier in-situ pakketten) de magnetische velden van de poolgebieden van de zon, volgt zonnewindversnelling in real-time, en verbindt remote en in-situ metingen gelijktijdig. Eerste perihelium 2020-06-15 op 0,51 AE. Perihelium P5 op 2022-10-12 op 0,29 AE (binnen het perihelium van Mercurius).",[321,323,324,326,327,328],{"met":54,"label":63,"note":64,"type":322},"nominal",{"met":71,"label":73,"note":74,"type":322},{"met":12,"label":77,"note":78,"type":325},"info",{"met":81,"label":83,"note":84,"type":325},{"met":87,"label":89,"note":90,"type":325},{"met":98,"label":99,"note":100,"type":325},[330],{"met":93,"label":94,"description":95},"/orrery/images/missions/solar-orbiter/01.webp"],"uses":{"params":["id"]}}]}
