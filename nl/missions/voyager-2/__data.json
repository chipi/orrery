.493254,[381,382,56,383],3443.915,-2.453167,0.418086,[385,386,56,387],3490.455,-2.679404,0.328891,[389,390,56,391],3536.994,-2.940979,0.215327,[393,394,56,395],3583.533,-3.22833,0.083143,[397,398,56,399],3630.073,-3.547074,-0.071994,[401,402,56,403],3676.612,-3.926801,-0.274531,[405,406,56,407],3723.152,-4.350273,-0.513057,[409,410,56,411],3769.691,-4.82138,-0.791075,[413,414,56,415],3816.23,-5.402291,-1.166664,[417,418,56,419],3862.77,-6.060693,-1.616368,[421,422,56,423],3909.309,-6.798822,-2.14301,[425,426,56,427],3955.849,-7.72804,-2.869738,[429,430,56,431],4002.388,-8.797881,-3.760313,[433,434,56,435],4048.927,-10.006035,-4.816555,[437,438,56,439],4095.467,-11.49922,-6.256547,[441,442,56,443],4142.006,-13.187332,-8.029885,[445,446,56,447],4188.546,-15.025515,-10.098914,[449,450,56,451],4235.085,-17.018517,-12.685256,[453,454,56,455],4281.624,-18.81917,-15.490989,[457,458,56,459],4328.164,-20.313362,-18.318176,[12,461,56,462],-21.077358,-21.444984,[464,465,56,466],4421.2424,-21.076238,-21.446084,[468,465,56,466],4467.7818,[470,465,56,466],4514.3212,[472,465,56,466],4560.8606,[474,465,56,466],4607.4,{"vehicle_stage":476,"departure":477},"Centaur + TE-364-4 (Star-37E)","stage-then-kick","Voyager 2","VOORBIJVLUCHT · GEVLOGEN","Enige ruimtevaartuig dat Uranus en Neptunus bezocht; Grand Tour van vier reuzenplaneten","Voyager 2 vloog de tour die misschien nooit meer gevlogen zal worden. Gelanceerd zestien dagen vóór zijn tweelingbroer op een langzamere, langere boog, is het het enige ruimtevaartuig ooit dat Uranus en Neptunus heeft bezocht — twee werelden die tientallen jaren later nog steeds bijna volledig bekend zijn uit de paar uur waarin het langs elk van beide raasde. Het vond een planeet die op zijn kant lag, de snelste winden van het zonnestelsel en een bevroren maan die geisers de ruimte in spoot, en daarna stak ook Voyager 2 de grens over naar de interstellaire ruimte, in 2018. Elk serieus plan om terug te keren naar de ijsreuzen steunt nog steeds op wat dit ene ruimtevaartuig zag op zijn weg naar buiten.","De tweeling die bleef doorgaan toen de budgetten krapper werden, Voyager 2 droeg de Grand Tour van Jupiter en Saturnus uit naar Uranus en Neptunus — nog steeds de enige close-up beelden die we hebben van de ijsreuzen. Zijn Neptunus-ontmoeting in 1989 onthulde de Great Dark Spot en Tritons geisers. Vandaag de dag zeilen beide Voyagers in de interstellaire ruimte met een gouden plaat als visitekaartje van de mensheid. Orrery vermeldt Neptunus als de catalogus-bestemming; het echte pad steunde op meerdere zwaartekrachtassists.",[484,486],{"met":56,"label":58,"note":59,"type":485},"nominal",{"met":12,"label":78,"note":79,"type":485},[488,489,490],{"met":62,"label":64,"description":65},{"met":68,"label":69,"description":70},{"met":73,"label":74,"description":75},"/orrery/images/missions/voyager-2/01.webp"],"uses":{"params":["id"]}}]}
