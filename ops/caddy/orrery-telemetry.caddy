# Public GlitchTip **ingest-only** vhost — ROUTING OWNED BY THIS REPO.
#
# The shared Caddy edge engine is owned by podcast_scraper (ADR-114); this file is a
# tenant vhost dropped into /etc/caddy/sites/orrery-telemetry.caddy by
# ops/deploy_caddy_vhosts.sh (`caddy adapt`-gated, then `sudo -n systemctl restart caddy`).
#
# WHY: browser-side error SDKs (orrery's client JS, and the podcast viewer bundle) POST
# from the *end user's* browser, which can only reach public endpoints — never the
# tailnet-only GlitchTip on homelab:8090. This vhost exposes ONLY the Sentry/GlitchTip
# ingest paths through the public edge so those browsers can ship errors, while the
# GlitchTip dashboard/login/API stays tailnet-only. A browser DSN's key is public by
# design (it ships in the JS bundle), so exposing ingest leaks nothing; the risk is
# flood/abuse, handled by the fail2ban caddy-access jail (T-11) + GlitchTip's own
# per-project event quotas.
#
# UPSTREAM (cross-repo dependency — consumed, not owned): GlitchTip runs on **homelab**
# (tailnet), NOT on this box — on the box 127.0.0.1:8090 is orrery's nginx. So we proxy
# to the homelab tailnet endpoint via the caddy service env var GLITCHTIP_UPSTREAM,
# which podcast_scraper's apply-edge.sh injects into the caddy systemd env (it owns the
# engine + its env, ADR-114):
#     GLITCHTIP_UPSTREAM="$(tailscale ip -4 homelab | head -1):8090"
# A box migration is a one-line change there, never here.
#
# Rollback: `rm /etc/caddy/sites/orrery-telemetry.caddy && sudo systemctl restart caddy`
# — frees the vhost, nothing shared changes, the box stays up.
telemetry.orrerylearn.com {
	import hardened

	# Ingest surface only: /api/<project_id>/{envelope,store,security}/ — the
	# transports the browser SDK uses (envelope = modern, store = legacy, security
	# = CSP reports). GlitchTip sets its own CORS headers on these, so the SDK's
	# cross-origin POST + OPTIONS preflight work without extra Caddy config.
	@ingest path_regexp ^/api/[0-9]+/(envelope|store|security)/?$
	handle @ingest {
		reverse_proxy {$GLITCHTIP_UPSTREAM}
	}

	# Everything else (dashboard, login, admin, the rest of the API) is NOT public.
	# Refuse without revealing GlitchTip — the admin plane stays tailnet-only.
	handle {
		respond "Not Found" 404
	}
}
