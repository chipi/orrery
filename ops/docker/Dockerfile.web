# Web tier image (GH #273 / W3 — brotli serving + baked nginx.conf).
#
# Why FROM alpine and not nginx:alpine:
#   The nginx:alpine image installs nginx from nginx.org's own apk
#   repository, NOT from Alpine's main repo. Alpine's
#   nginx-mod-http-brotli package is built against Alpine's nginx
#   binary and pins itself to a matching `nginx=1.28.3-r2` exactly —
#   apk can never resolve that constraint against nginx.org's binary.
#   Earlier attempt to layer the mod on top of nginx:alpine failed in
#   docker-e2e with `breaks: nginx-mod-http-brotli-1.28.3-r2[nginx=
#   1.28.3-r2]`. Solution: install BOTH nginx and the brotli mod from
#   Alpine's repo in one apk transaction — version-matched by
#   construction.
#
# What we lose vs nginx:alpine: the docker-entrypoint.sh chain
# (envsubst, config-dump on start). We don't use envsubst anywhere
# and explicit `nginx -g 'daemon off;'` is the standard pattern.
#
# Config path note: Alpine's nginx looks for site configs under
# /etc/nginx/http.d/*.conf (not /etc/nginx/conf.d/ like nginx.org's
# image). Both this COPY and the bind-mount in docker-compose.yml use
# the http.d/ path.

FROM alpine:3.22

RUN apk add --no-cache nginx nginx-mod-http-brotli

# Bake the site config into the image — single source of truth for
# both local docker (which bind-mounts and shadows this for dev
# iteration) and prod (which does NOT bind-mount, so this is what
# actually runs). Without this COPY the CSP + security-header
# changes from 656cb02e6 never reach prod.
COPY ops/docker/nginx.conf /etc/nginx/http.d/default.conf

EXPOSE 80

# Alpine's nginx package leaves /run/nginx/ missing on first start;
# create it so the master process can write its pid file.
RUN mkdir -p /run/nginx

CMD ["nginx", "-g", "daemon off;"]
