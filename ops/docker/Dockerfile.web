# Web tier image (GH #273 / W3).
#
# Original W3 plan layered `nginx-mod-http-brotli` from Alpine's apk
# on top of nginx:alpine. That fails because nginx:alpine installs
# nginx from nginx.org's own repository, not from Alpine's main repo,
# so the apk package's `breaks: nginx=1.28.3-r2` constraint never
# resolves (apk sees a different nginx binary in the image). Brotli
# serving therefore deferred to a follow-up — proper fix needs either
# a community brotli-enabled nginx image (e.g. fholzer/nginx-brotli)
# or a multi-stage build that compiles ngx_brotli against the same
# nginx source. Tracked separately.
#
# What this image still does:
#   • Bakes ops/docker/nginx.conf into /etc/nginx/conf.d/default.conf.
#     Without this COPY, the previously-shipped CSP + security-header
#     changes (656cb02e6) never reach prod — compose/docker-compose
#     .prod.yml never bind-mounted that file. The local
#     docker-compose.yml DOES bind-mount, so its mount shadows the
#     COPY for dev iteration without rebuild.
#
# gzip_static (already enabled in nginx.conf) serves the .gz siblings
# vite-plugin-compression2 emits. brotli .br files are generated too
# but go unused until the proper brotli wiring lands.

FROM nginx:alpine

COPY ops/docker/nginx.conf /etc/nginx/conf.d/default.conf
