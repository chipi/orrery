{
  "uid": "orrery-web-access",
  "title": "Orrery — Web Access",
  "tags": ["orrery", "web", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "local-dev,staging,production-vps",
        "current": { "selected": false, "text": "production-vps", "value": "production-vps" },
        "options": [
          { "selected": false, "text": "local-dev", "value": "local-dev" },
          { "selected": false, "text": "staging", "value": "staging" },
          { "selected": true, "text": "production-vps", "value": "production-vps" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Web container — log lines / min",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stream) (count_over_time({app=\"orrery\", env=\"$env\", container=\"orrery-web\"}[1m]))",
          "legendFormat": "{{stream}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "lines", "custom": { "drawStyle": "line", "lineWidth": 2 } }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Web container — log lines (last 6h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 7 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"orrery\", env=\"$env\", container=\"orrery-web\"}[6h]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "stderr lines (last 6h) — investigate if > 0",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 7 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"orrery\", env=\"$env\", container=\"orrery-web\", stream=\"stderr\"}[6h]))",
          "queryType": "instant"
        }
      ],
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Web container — recent log lines",
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"orrery\", env=\"$env\", container=\"orrery-web\"}",
          "queryType": "range"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ],
  "annotations": { "list": [] }
}
