{
  "uid": "orrery-web",
  "title": "Orrery \u2014 Web",
  "tags": ["orrery", "web"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "dev,staging,prod",
        "current": {
          "selected": true,
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "selected": true,
            "text": "dev",
            "value": "dev"
          },
          {
            "selected": false,
            "text": "staging",
            "value": "staging"
          },
          {
            "selected": false,
            "text": "prod",
            "value": "prod"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests \u00b7 6h",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | stats count() reqs",
          "queryType": "stats"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "4xx \u00b7 6h",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | extract \"\\\"<method> <path> HTTP/<_>\\\" <status> <bytes> \\\"\" | filter status:~\"4..\" | stats count() reqs",
          "queryType": "stats"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx \u00b7 6h",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | extract \"\\\"<method> <path> HTTP/<_>\\\" <status> <bytes> \\\"\" | filter status:~\"5..\" | stats count() reqs",
          "queryType": "stats"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bytes served \u00b7 6h",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | extract \"\\\"<method> <path> HTTP/<_>\\\" <status> <bytes> \\\"\" | stats sum(bytes) bytes",
          "queryType": "stats"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "stderr \u00b7 6h",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND container:orrery-web AND stream:stderr | stats count() lines",
          "queryType": "stats"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests / min by status",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | extract \"\\\"<method> <path> HTTP/<_>\\\" <status> <bytes> \\\"\" | stats by (status) count() reqs",
          "queryType": "statsRange",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bytes / min",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | extract \"\\\"<method> <path> HTTP/<_>\\\" <status> <bytes> \\\"\" | stats sum(bytes) bytes",
          "queryType": "statsRange",
          "legendFormat": "{{__auto}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top paths \u00b7 6h",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | extract \"\\\"<method> <path> HTTP/<_>\\\" <status> <bytes> \\\"\" | stats by (path) count() reqs | sort by (reqs desc) | limit 20",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "4xx / 5xx requests (recent)",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:orrery AND env:$env AND surface:web AND _msg:~\"HTTP/1\" | extract \"\\\"<method> <path> HTTP/<_>\\\" <status> <bytes> \\\"\" | filter status:~\"[45]..\"",
          "queryType": "instant"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
