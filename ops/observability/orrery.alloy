// orrery.alloy — Orrery's log rules for the shared node Alloy (ADR-121, podcast
// infra issue #1268). Dropped into the box's /etc/alloy/config.d/ on deploy and
// hot-reloaded (`docker kill -s HUP alloy`). Replaces the retired per-app
// orrery-grafana-agent (grafana/agent v0.43, EOL), whose leaky docker_sd
// keep-filter mislabelled podcast infra logs as app=orrery.
//
// References shared components defined in base.alloy:
//   - discovery.docker "app"   — the Docker-socket container discovery
//   - loki.write "logs_sink"   — the VictoriaLogs sink (sets instance/cluster;
//                                app + per-stream labels are set HERE)
// Do NOT touch base.alloy or the podcast sources.

// ---------- Orrery containers: web + mcp + lab-api + ephemeral pipeline-runner ----------
// Keep ONLY orrery's own containers (the leak the old agent had was a too-broad
// keep). surface=web|mcp|lab-api|pipeline mirrors the podcast split. mcp + lab-api
// added with the v0.9 backend deploy (#464) — env=prod tagging is inherited from
// the shared node's loki.write sink, same as orrery-web.
discovery.relabel "orrery" {
	targets = discovery.docker.app.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(orrery-web|orrery-mcp|orrery-lab-api|orrery-pipeline-runner-.*)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/orrery-web"
		target_label  = "surface"
		replacement   = "web"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/orrery-mcp"
		target_label  = "surface"
		replacement   = "mcp"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/orrery-lab-api"
		target_label  = "surface"
		replacement   = "lab-api"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/orrery-pipeline-runner-.*"
		target_label  = "surface"
		replacement   = "pipeline"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
		regex         = "/(.*)"
		replacement   = "$1"
	}
}

loki.source.docker "orrery" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.orrery.output
	forward_to = [loki.process.orrery_std.receiver]
	labels     = {app = "orrery"}
}

// ---------- On-VPS launch-data refresh log (RFC-035) ----------
// Host file the 6h refresh cron appends to; Alloy sees the host root at /rootfs.
// Carries the decisive `[refresh-prod-data] … ok — … bytes` / `FETCH FAILED`
// lines that drive the orrery-launch-data-stale alert. MUST carry app=orrery so
// the alert query `app:orrery job:orrery-data-refresh` matches (logs_sink no
// longer sets app globally). file_match watches the path even before it exists.
local.file_match "orrery_data_refresh" {
	path_targets = [
		{
			__path__ = "/rootfs/srv/orrery/data-refresh.log",
			app      = "orrery",
			surface  = "pipeline",
			job      = "orrery-data-refresh",
		},
	]
}

loki.source.file "orrery_data_refresh" {
	targets    = local.file_match.orrery_data_refresh.targets
	forward_to = [loki.process.orrery_std.receiver]
}

// ---------- homelab log standard: trace_id -> structured_metadata ----------
// See agentic-ai-homelab/infra/observability/LOG-STANDARD.md. Extracts the 32-hex
// trace id into structured_metadata (a queryable field, NOT a high-cardinality stream
// label). The expression is the standard's, verbatim: `trace_id=` (the lab-api / mcp
// access log, ADR-094), `trace=`, W3C `00-<id>-…` and `sentry-trace`; a labelled
// prefix is required, so bare hashes never match. Inlined here (rather than
// referencing base's homelab_std) so this drop-in deploys independently of a
// base.alloy rollout. Both orrery sources route through it.
loki.process "orrery_std" {
	stage.regex {
		expression = "(?:trace_id[=\":\\s]+|trace=|00-|sentry-trace[=\":\\s]+)(?P<trace_id>[a-f0-9]{32})"
	}
	stage.structured_metadata {
		values = {trace_id = ""}
	}
	forward_to = [loki.relabel.orrery_naming.receiver]
}

// service = <app>-<surface> (orrery-web, orrery-pipeline, orrery-lab-api — the OTel
// service.name convention), the key logs share with traces and metrics (homelab
// LOG-STANDARD). Inlined, like orrery_std, so this drop-in deploys independently of base;
// environment comes from base's sink. After the sources, never on their targets: the
// docker/file sources key read positions by target labels, and a new target label
// re-reads every log from the start.
loki.relabel "orrery_naming" {
	rule {
		source_labels = ["app", "surface"]
		separator     = "-"
		regex         = "(.+-.+)"
		target_label  = "service"
	}
	forward_to = [loki.write.logs_sink.receiver]
}

// ---------- METRICS: lab-api + mcp /metrics (ADR-094) -> VictoriaMetrics ----------
// Each serves /metrics on METRICS_PORT 9464, NOT published to the host (Caddy can
// never reach it). Alloy is host-network, so it scrapes the container's bridge IP,
// found through the Docker socket — the pattern base.alloy uses for the podcast
// apis (survives the IP change on recreate). `service` matches the OTel
// service.name and the logs' service label, so a trace, its logs and its request
// metrics join on one value. Deploy the images before this file, or `up` reads 0
// until the new images serve /metrics.
discovery.relabel "orrery_metrics" {
	targets = discovery.docker.app.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(orrery-lab-api|orrery-mcp)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_network_ip"]
		regex         = "(.+)"
		target_label  = "__address__"
		replacement   = "${1}:9464"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "service"
		replacement   = "${1}"
	}

	rule {
		target_label = "app"
		replacement  = "orrery"
	}

	rule {
		target_label = "instance"
		replacement  = "prod-podcast"
	}

	rule {
		target_label = "environment"
		replacement  = "prod"
	}
}

prometheus.scrape "orrery" {
	targets         = discovery.relabel.orrery_metrics.output
	forward_to      = [prometheus.remote_write.sink.receiver]
	job_name        = "orrery"
	metrics_path    = "/metrics"
	scrape_interval = "60s"
}
