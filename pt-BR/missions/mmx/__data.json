46011,[89,471,57,472],-0.83757,-1.272798,[474,475,57,476],288.1767,-0.831857,-1.27654,[478,475,57,476],291.2102,[480,475,57,476],294.2436,[482,475,57,476],297.2771,[484,475,57,476],300.3105,"MMX","RETORNO DA AMOSTRA DE FOBOS · ATIVA","Primeira amostra retornada de uma lua marciana","Martian Moons eXploration é o plano de JAXA para pousar em Fobos, coletar cerca de 10 g de regolito e trazê-lo para casa. As amostras podem resolver uma questão há muito debatida: Fobos e Deimos são asteroides capturados ou fragmentos de um impacto antigo no próprio Marte? A missão também inclui um rover germano-francês para mobilidade de superfície em Fobos – um modelo de operações totalmente diferente de tudo o que as missões Hayabusa fizeram em Itokawa ou Ryugu. Os atrasos do foguete H3 da JAXA empurraram o lançamento de 2024 para 2026; a MMX decolou em 19 de outubro de 2026 e deve entrar em órbita de Marte em agosto de 2027.",[490,492,493,498,502],{"met":57,"label":59,"note":60,"type":491},"nominal",{"met":12,"label":85,"note":86,"type":491},{"met":494,"label":495,"note":496,"type":497},986,"LIBERAÇÃO DO ROVER","Rover DLR/CNES (~25 kg) liberado na superfície de Fobos para estudos in situ.","info",{"met":499,"label":500,"note":501,"type":497},1351,"AMOSTRA DE FOBOS","MMX pousa em Fobos; ~10 g de regolito coletados.",{"met":503,"label":504,"note":505,"type":497},1716,"RETORNO À TERRA","Cápsula de reentrada de amostra chega à Terra em ~2031.",[507,508,509,510],{"met":67,"label":69,"description":70},{"met":72,"label":73,"description":74},{"met":76,"label":77,"description":74},{"met":79,"label":80,"description":81},"/orrery/images/missions/mmx/01.webp"],"uses":{"params":["id"]}}]}
