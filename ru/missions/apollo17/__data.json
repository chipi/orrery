3,304,305],5.3455,252420,1009,287856,[307,308,309,310],5.4727,252309,685,287729,[312,313,314,315],5.6,252243,334,287653,[317,318,134,319],5.7273,252223,287631,[321,322,323,324],5.8545,252251,-393,287662,[326,327,328,329],5.9818,252325,-741,287747,[331,332,333,334],6.1091,252443,-1059,287882,[336,337,338,339],6.2364,252600,-1336,288061,[341,342,343,344],6.3636,252790,-1561,288278,[346,347,348,349],6.4909,253006,-1724,288523,[351,352,353,354],6.6182,253238,-1820,288789,[356,357,358,359],6.7455,253479,-1845,289063,[361,362,363,364],6.8727,253717,-1797,289335,[366,367,368,369],7,253945,-1679,289595,[371,372,373,374],7.1273,254153,-1495,289832,[376,377,378,379],7.2545,254333,-1252,290037,[381,382,383,384],7.3818,254478,-961,290203,[386,387,388,389],7.5091,254583,-632,290322,[391,392,393,394],7.6364,254642,-278,290390,[98,396,397,398],254651,191,290400,[400,401,402,403],7.8909,254620,448,290364,[405,406,407,408],8.0182,254539,792,290271,[410,411,412,413],8.1455,254414,1105,290130,[415,416,417,418],8.2727,254252,1374,289944,[420,421,422,423],8.4,254057,1590,289722,[425,426,427,428],8.5273,253839,1743,289473,[430,431,432,433],8.6545,253604,1828,289206,[435,436,437,438],8.7818,253364,1842,288932,[440,441,442,443],8.9091,253126,1783,288661,[445,446,447,448],9.0364,252901,1654,288404,[450,451,452,453],9.1636,252696,1461,288171,[455,456,457,458],9.2909,252521,1210,287971,[460,461,462,463],9.4182,252382,912,287812,[465,466,467,468],9.5455,252284,578,287700,[470,471,472,473],9.6727,252232,222,287641,[104,475,65,476],252222,287629,[478,479,65,480],9.9273,-196650,176638,[482,483,65,484],10.0545,-137670,97263,[486,487,65,488],10.1818,-96074,52240,[490,491,65,492],10.3091,-69438,27831,[494,495,65,496],10.4364,-52034,14079,[498,499,65,500],10.5636,-40175,5961,[502,503,65,504],10.6909,-31738,966,[506,507,65,508],10.8182,-25493,-2212,[510,511,65,512],10.9455,-20720,-4274,[514,515,65,516],11.0727,-16962,-5628,[518,519,65,520],11.2,-13934,-6514,[522,523,65,524],11.3273,-11440,-7080,[526,527,65,528],11.4545,-9349,-7424,[530,531,65,532],11.5818,-7567,-7607,[534,535,65,536],11.7091,-6026,-7672,[538,539,65,540],11.8364,-4678,-7648,[542,543,65,544],11.9636,-3483,-7555,[546,547,65,548],12.0909,-2414,-7407,[550,551,65,552],12.2182,-1449,-7214,[554,555,65,556],12.3455,-569,-6983,[111,558,65,559],987,-6423,[561,558,65,559],12.6001,"Apollo 17","Apollo 17 стал завершением, хотя почти никто из наблюдавших в декабре 1972 года не верил, что так и будет. Это был также, с запозданием, полёт, в ходе которого на Луну впервые ступил настоящий учёный — геолог Харрисон Шмитт, чей глаз заметил оранжевое вулканическое стекло в кратере Шорти, что изменило представления о том, из чего состоит Луна. Сернан и Шмитт пробыли три дня, проехали двадцать две мили, и затем Сернан в последний раз, когда это кому-либо доводилось делать, поднялся по трапу, сказав, что они уходят «такими, какими пришли, и, с Божьей помощью, мы вернёмся». Спустя более полувека никто не вернулся — и каждый серьёзный довод в пользу возвращения до сих пор начинается с того факта, что когда-то мы могли это сделать.","ПИЛОТИРУЕМЫЙ ПОСАДОЧНЫЙ МОДУЛЬ · РОВЕР · ВЫПОЛНЕНА","Последняя пилотируемая миссия на Луну (и единственный Apollo с профессиональным геологом)","Последний раз люди бывали на другом мире — более полувека назад. Сернан и Шмитт провели на поверхности 75 часов, проехали на LRV 35,7 км и привезли 110,5 кг образцов. Шмитт — единственный профессиональный учёный-геолог на Луне; его находки, особенно оранжевое вулканическое стекло у кратера Шорти, изменили лунную геологию. Последние слова Сернан перед лестницей: «Мы уходим так же, как пришли, и, дай Бог, вернёмся». Теперь это обещание должна сдержать Artemis IV.",[568,570,571,572,573,578,579],{"met":65,"label":67,"note":68,"type":569},"nominal",{"met":71,"label":73,"note":74,"type":569},{"met":86,"label":88,"note":89,"type":569},{"met":92,"label":94,"note":95,"type":569},{"met":574,"label":575,"note":576,"type":577},4.76,"ПЕРВЫЙ ВЫХОД","Сернан и Шмитт начинают первый из трёх выходов (всего 22 ч 4 мин).","info",{"met":98,"label":100,"note":101,"type":569},{"met":111,"label":113,"note":114,"type":569},[581,582,583],{"met":77,"label":79,"description":80},{"met":82,"label":83,"description":84},{"met":104,"label":106,"description":107},"/orrery/images/missions/apollo17/01.webp"],"uses":{"params":["id"]}}]}
