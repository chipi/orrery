,524,63,525],43.2817,11355,-6174,[527,528,63,529],43.7909,13033,-9093,[531,532,63,533],44.3001,15121,-13270,[535,536,63,537],44.8093,17796,-19515,[539,540,63,541],45.3185,21334,-29370,[543,544,63,545],45.8277,26175,-46028,[547,548,63,549],46.3369,32950,-76664,[551,552,63,553],46.8461,41937,-138119,[555,556,63,557],47.3553,48312,-260090,[96,559,560,561],16617,25,-385979,[563,564,565,566],48.3737,16608,910,-385753,[568,569,570,571],48.8829,16568,1771,-384824,[573,574,575,576],49.3921,16513,1874,-383563,[578,579,580,581],49.9013,16468,1176,-382508,[583,584,115,585],50.4105,16451,-382110,"Beresheet","ЧАСТНЫЙ ПОСАДОЧНЫЙ МОДУЛЬ · CRASHED","Первая финансируемая частным образом миссия, достигшая Луны; первая израильская лунная миссия","Beresheet компании SpaceIL (иврит: «В начале») стартовала в феврале 2019 года как попутный груз на Falcon 9. Вместо прямого трансселенного маневра малый лунный модуль выполнил серию многонедельных манёвров поднятия перигея для подъёма с парковочной орбиты к Луне — траектория, сокращающая расход топлива и впервые применённая для низкобюджетных миссий. После успешного выхода на лунную орбиту 4 апреля 2019 года при снижении произошёл сброс показаний инерциального измерительного блока, в результате чего главный двигатель отключился. Beresheet упала в Море Ясности. Компания SpaceIL в течение нескольких дней объявила о разработке преемника (Beresheet 2).",[591,593,595,596,597,598,601],{"met":63,"label":65,"note":66,"type":592},"nominal",{"met":69,"label":71,"note":72,"type":594},"info",{"met":75,"label":77,"note":78,"type":594},{"met":52,"label":81,"note":82,"type":594},{"met":85,"label":87,"note":88,"type":592},{"met":85,"label":599,"note":600,"type":592},"ВЫХОД НА ОКОЛОЛУННУЮ ОРБИТУ","Захват на эллиптическую лунную орбиту 4 апреля 2019 года.",{"met":96,"label":92,"note":93,"type":602},"warning","/orrery/images/missions/beresheet/01.webp"],"uses":{"params":["id"]}}]}
