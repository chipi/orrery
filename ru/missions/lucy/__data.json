21],2820.3636,[349,320,44,321],2864.4318,[351,320,44,321],2908.5,[353,320,44,321],2952.5682,[355,320,44,321],2996.6364,[357,320,44,321],3040.7045,[359,320,44,321],3084.7727,[361,320,44,321],3128.8409,[363,320,44,321],3172.9091,[365,320,44,321],3216.9773,[367,320,44,321],3261.0455,[369,320,44,321],3305.1136,[108,320,44,321],[372,320,44,321],3393.25,[374,320,44,321],3437.3182,[376,320,44,321],3481.3864,[378,320,44,321],3525.4545,[380,320,44,321],3569.5227,[382,320,44,321],3613.5909,[384,320,44,321],3657.6591,[386,320,44,321],3701.7273,[388,320,44,321],3745.7955,[390,320,44,321],3789.8636,[392,320,44,321],3833.9318,[394,320,44,321],3878,[396,320,44,321],3922.0682,[398,320,44,321],3966.1364,[400,320,44,321],4010.2045,[402,320,44,321],4054.2727,[404,320,44,321],4098.3409,[113,320,44,321],[407,320,44,321],4186.4773,[409,320,44,321],4230.5455,[411,320,44,321],4274.6136,[413,320,44,321],4318.6818,[415,320,44,321],4362.75,"Lucy","МНОЖЕСТВЕННЫЙ ПРОЛЁТ · АКТИВНА","Первая миссия к троянцам Юпитера; посещает 11 тел — 8 астероидов и их спутники — на единой 12-летней траектории: рекордное число объектов на отдельных орбитах вокруг Солнца","Lucy направляется к облакам Лагранжа L4 и L5 — скоплениям первичных астероидов, ведущих и следующих за Юпитером на 60°, которые, как полагают, сохраняют материал из внешнего протопланетного диска. Три гравитационных маневра у Земли (2022, 2024, 2030) формируют единую траекторию, посещающую семь троянских астероидов плюс дополнительные объекты главного пояса. Первое сближение с астероидом: 152830 Динкинеш (2023-11-01, ~790 м), при съёмке которого была обнаружена контактная двойная луна Selam. Дополнительный объект главного пояса: Дональдджохансон 2025-04. Рой L4: Эврибат и луна Queta (2027-08), Полимела (2027-09), Левк (2028-04), Ор (2028-11). После EGA-3 (2030-12), рой L5 позади: двойная система Патрокл — Менетий (2033-03) — крупнейшая известная троянская двойная система, достойный финал миссии, названной в честь Lucy — ископаемого гоминида и персонажей Патрокл-Менетий, которые упали вместе в «Илиаде».",[421,423,425,426,427,428,429,430,431,432],{"met":44,"label":56,"note":57,"type":422},"nominal",{"met":64,"label":66,"note":67,"type":424},"info",{"met":70,"label":71,"note":72,"type":424},{"met":80,"label":81,"note":82,"type":424},{"met":90,"label":86,"note":87,"type":424},{"met":93,"label":94,"note":95,"type":424},{"met":98,"label":99,"note":100,"type":424},{"met":103,"label":104,"note":105,"type":424},{"met":108,"label":109,"note":110,"type":424},{"met":113,"label":115,"note":116,"type":424},[434],{"met":75,"label":76,"description":77},"/orrery/images/missions/lucy/03.webp"],"uses":{"params":["id"]}}]}
