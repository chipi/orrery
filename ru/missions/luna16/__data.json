ёз 22 кг образцов, собранных человеком в 1969 году, «Луна-16» вернула 101 грамм реголита из Моря Изобилия год спустя — доля от полезной нагрузки Apollo, но убедительное доказательство концепции альтернативной архитектуры. Миссия использовала ракету-носитель «Протон-К» и профиль прямого возврата: спуск на поверхность, буровое ядро, запуск ступени подъёма, баллистический спускаемый аппарат в Казахстан. Эта методика была повторена для «Луна-20» и «Луна-24».",[521,523,524,526,527],{"met":64,"label":66,"note":67,"type":522},"nominal",{"met":70,"label":72,"note":73,"type":522},{"met":76,"label":78,"note":79,"type":525},"info",{"met":12,"label":83,"note":84,"type":522},{"met":87,"label":89,"note":90,"type":522},"/orrery/images/missions/luna16/05.webp"],"uses":{"params":["id"]}}]}
