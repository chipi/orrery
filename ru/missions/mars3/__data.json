.4906,1.443211,0.37273,[452,453,64,454],173.4847,1.440858,0.398406,[456,457,64,458],175.4788,1.437966,0.423934,[460,461,64,462],177.4729,1.434608,0.449323,[464,465,64,466],179.467,1.430735,0.474552,[468,469,64,470],181.461,1.426361,0.499615,[472,473,64,474],183.4551,1.421534,0.524519,[476,477,64,478],185.4492,1.41619,0.549232,[94,480,64,481],1.408636,0.58076,[483,484,64,485],189.4373,1.406036,0.587029,[487,484,64,485],191.4314,[489,484,64,485],193.4255,[491,484,64,485],195.4196,[493,484,64,485],197.4137,"Марс-3","ОРБИТАЛЬНЫЙ АППАРАТ · ПОСАДОЧНЫЙ МОДУЛЬ · ВЫПОЛНЕНА","Первый космический аппарат, совершивший мягкую посадку на Марс","Смелая двойная миссия Советского Союза на Марс в 1971 году — «Марс-2» и «Марс-3» были запущены с интервалом в 9 дней. Посадочный модуль «Марс-2» разбился; посадочный модуль «Марс-3» совершил первую мягкую посадку на Марс, но потерял связь ~110 секунд после приземления — продолжительность передачи составила только ~14,5 секунды — возможно, из-за глобальной пыльной бури, бушевавшей в то время. Орбитальный аппарат работал в течение 8 месяцев, вернув десятки снимков и данные об атмосфере. Несмотря на кратковременность миссии на поверхности, «Марс-3» продемонстрировала, что проблема спуска и посадки на Марс была разрешима.",[499,501,502,506,507],{"met":64,"label":66,"note":67,"type":500},"nominal",{"met":12,"label":84,"note":85,"type":500},{"met":503,"label":504,"note":505,"type":500},188.005,"РАЗДЕЛЕНИЕ","Посадочный модуль отделяется и начинает вход в атмосферу.",{"met":88,"label":90,"note":91,"type":500},{"met":94,"label":96,"note":97,"type":508},"warning",[510,511],{"met":74,"label":76,"description":77},{"met":79,"label":80,"description":81},"/orrery/images/missions/mars3/05.webp"],"uses":{"params":["id"]}}]}
