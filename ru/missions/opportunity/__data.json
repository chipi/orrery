.926745,1.205792,[468,469,61,470],197.1079,0.906815,1.222136,[472,473,61,474],199.2504,0.886187,1.238248,[94,476,61,477],0.859187,1.258307,[479,480,61,481],203.5353,0.853481,1.262185,[483,480,61,481],205.6778,[485,480,61,481],207.8203,[487,480,61,481],209.9628,[489,480,61,481],212.1053,"Opportunity","РОВЕР · ВЫПОЛНЕНА","Держал рекорд пробега по Марсу (45,16 км), пока Perseverance не превзошёл его в октябре 2026 года; 14-летний период работы на поверхности против расчётных 90 марсианских суток","Opportunity (MER-B) выиграл планетарный джекпот — его приземлённый модуль в подушках безопасности совершил 26 отскоков по плато Меридиана и по чистой случайности скатился в кратер Eagle диаметром 22 м, окружённый открытыми выходами пород, которые марсоход мог изучать без передвижения. Первые снимки показали жаразит и конкреции гематита-«голубики» — сильнейшее на то время минеральное свидетельство наличия жидкой воды на древнем Марсе. За 14 лет 138 дней (5111 марсианских суток) Opportunity преодолел 45,16 км — рекорд для марсоходов, державшийся до октября 2026 года, когда его превзошёл Perseverance — посетив кратеры Endurance, Victoria и Endeavour. Планетарная пылевая буря в июне 2018 г. перекрыла солнечный свет от его солнечных батарей; последняя передача была 2018-06-10, и NASA объявило об окончании миссии 2019-02-13.","Opportunity проехал марафон по чужой планете. Близнец Spirit, севший на Марс в 2004 году для девяностодневной миссии, проработал четырнадцать лет и преодолел более сорока пяти километров — наибольшее расстояние, пройденное любым аппаратом на любом мире, пока в октябре 2026 года его не превзошёл Perseverance. Ему повезло: он опустился в небольшой кратер, стены которого обнажали именно те отложенные водой породы, ради которых его и отправили, а затем просто продолжал путь — от кратера к кратеру, читая древнюю водную историю Марса километр за километром. Глобальная пылевая буря окончательно заставила его замолчать в 2018 году.",[496,498,499,500,502,506,511],{"met":61,"label":63,"note":64,"type":497},"nominal",{"met":71,"label":73,"note":74,"type":497},{"met":84,"label":85,"note":86,"type":497},{"met":12,"label":90,"note":91,"type":501},"info",{"met":503,"label":504,"note":505,"type":501},202.01,"ПРИЗЕМЛЕНИЕ — В КРАТЕР EAGLE","Совершил 26 отскоков. По случайности скатился в кратер диаметром 22 м, окружённый открытыми выходами пород.",{"met":507,"label":508,"note":509,"type":510},5452,"ПОСЛЕДНЯЯ ПЕРЕДАЧА","2018-06-10. Глобальная пылевая буря сокращает выработку солнечной энергии.","warning",{"met":512,"label":513,"note":514,"type":510},5700,"ОКОНЧАНИЕ МИССИИ","NASA объявило об окончании миссии 2019-02-13. Преодолено 45,16 км.",[516,517],{"met":76,"label":77,"description":78},{"met":80,"label":81,"description":82},"/orrery/images/missions/opportunity/06.webp"],"uses":{"params":["id"]}}]}
