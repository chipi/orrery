  {
    "rel": "orbit-regimes-explore/GIANTS.json",
    "at": "story",
    "decision": "retranslate",
    "grade": "MINOR",
    "kind": "grammar",
    "new": "Het buitenste planetaire domein — 5 tot 30 AE. Twee gasreuzen (Jupiter, Saturnus) met waterstof-heliumenveloppen van duizenden kilometers dik boven kleine rotsachtige kernen; twee ijsreuzen (Uranus, Neptunus) met mantels van water, ammoniak en methaan onder dunnere gaslagen. Samen bevatten ze 99% van alle planetaire massa in het zonnestelsel. Elk heeft zijn eigen maansysteem dat zich leest als een zonnestelsel in het klein — Jupiter alleen al heeft 95 bekende manen, waaronder vier die groter zijn dan Pluto.",
    "note": "compound words split without hyphen/joining"
  },
