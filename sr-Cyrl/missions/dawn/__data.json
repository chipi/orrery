ents":54,"interplanetary_profile":89,"launch":483},[55,61,67,73,79,83],{"met_days":56,"type":57,"label":58,"description":59,"label_en":60},0,"launch","ЛАНСИРАЊЕ","Delta II подиже Dawn ка Вести и Церери на спиралном аутопуту малог потиска.","Launch — Delta II 7925H",{"met_days":62,"type":63,"label":64,"description":65,"label_en":66},510,"flyby","Марс — гравитациони маневар","Најмање растојање од 542 km, 2009-02-18. Маневар код Марса додао је око 2,6 km/s — довољно да летелица после још две године спиралног кретања на јонски погон стигне до астероида Веста. Без њега би Dawn требало двоструко више горива или двоструко дуже крстарење.","Mars — gravity assist",{"met_days":68,"type":69,"label":70,"description":71,"label_en":72},1388,"arrival","Улазак у орбиту око Весте","Захват у орбиту око Весте 2011-07-16 непрекидним јонским потиском — хемијско паљење за улазак у орбиту није било потребно, јер је јонски потисак обавио постепени прилаз. Летелица је 14 месеци провела у орбити око Весте, картирала ову диференцирану протопланету пречника 530 km и потврдила да је ударни басен Реасилвија на јужном полу извор HED метеорита који падају на Земљу.","Vesta orbit insertion",{"met_days":74,"type":75,"label":76,"description":77,"label_en":78},1805,"tli_or_tmi","Одлазак са Весте — јонска спирала ка Цереси","Одлазак са Весте 2012-09-05. Јонски мотори су 2,5 године ширили спиралу ка споља, према Цереси — први међупланетни прелаз између два тела изведен уз непрекидан мали потисак. Путања је потрошила око 112 kg ксенона.","Vesta departure — ion-thrust spiral to Ceres",{"met_days":12,"type":69,"label":80,"description":81,"label_en":82},"ХВАТАЊЕ ЦЕРЕРЕ","Јонски мотори успоравају Dawn и убацују је у орбиту око Церере; почиње кампања картографисања.","Ceres approach",{"met_days":84,"type":85,"label":86,"description":87,"label_en":88},2717.53,"edl_or_oi","Улазак у орбиту око Церере","Захват у орбиту око Церере 2015-03-06 — прва летелица у орбити око патуљасте планете и прва која је кружила око два ванземаљска тела. До 2018. се спирално спустила у ниску картографску орбиту на 35 km. Хидразин за управљање положајем потрошен је 2018-10-31; летелица остаје у стабилној орбити око Церере, као дугорочно заштићени планетарни споменик по правилима планетарне заштите.","Ceres orbit insertion",{"source_tier":90,"reference_frame":91,"departure_body":92,"arrival_body":93,"transfer_type":94,"waypoints_helio_au":95},"tier_1_5_hybrid","heliocentric_ecliptic_J2000","earth","ceres","type1_lambert",[96,99,103,107,111,115,119,123,127,131,135,139,143,147,151,155,159,163,167,170,174,178,182,186,190,194,198,202,206,210,214,218,222,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290,294,298,302,306,310,314,318,322,326,330,334,338,342,346,349,353,357,361,365,369,373,377,381,385,389,393,397,401,405,409,413,417,421,425,429,433,437,441,445,449,453,457,461,465,469,473,475,477,479,481],[56,97,56,98],0.995467,0.095107,[100,101,56,102],28.941,0.884619,0.132962,[104,105,56,106],57.881,0.784464,0.164316,[108,109,56,110],86.822,0.694768,0.18937,[112,113,56,114],115.763,0.620175,0.206249,[116,117,56,118],144.704,0.552908,0.219575,[120,121,56,122],173.645,0.491994,0.229871,[124,125,56,126],202.585,0.439957,0.23629,[128,129,56,130],231.526,0.392982,0.240715,[132,133,56,134],260.467,0.349942,0.24363,[136,137,56,138],289.408,0.312247,0.244644,[140,141,56,142],318.348,0.278138,0.244506,[144,145,56,146],347.289,0.246557,0.243586,[148,149,56,150],376.23,0.218293,0.241706,[152,153,56,154],405.171,0.192643,0.239143,[156,157,56,158],434.111,0.168679,0.236159,[160,161,56,162],463.052,0.146835,0.232677,[164,165,56,166],491.993,0.126949,0.22878,[62,168,56,169],0.11488,0.22629,[171,172,56,173],549.628,0.090898,0.22025,[175,176,56,177],578.39,0.075072,0.21559,[179,180,56,181],607.151,0.060078,0.210794,[183,184,56,185],635.913,0.046015,0.205849,[187,188,56,189],664.675,0.033134,0.200729,[191,192,56,193],693.437,0.020865,0.195523,[195,196,56,197],722.198,0.009229,0.190228,[199,200,56,201],7