,457,44,458],1824.818,-4.724142,1.800448,[460,461,44,462],1879.66,-4.8182,1.693219,[464,465,44,466],1934.502,-4.905469,1.581481,[82,468,44,469],-5.003155,1.429474,[471,472,44,473],2020.1944,-5.00418,1.425882,[475,472,44,473],2041.4596,[477,472,44,473],2062.7248,[479,472,44,473],2083.99,[481,472,44,473],2105.2553,"Europa Clipper","ОРБИТЕР + МУЛТИ-ПРЕЛЕТ · АКТИВНА","Прва мисија посвећена одређивању насељивости једног леденог месеца; највећа летелица коју је NASA икада лансирала за планетарну мисију (6065 kg, соларни панели површине 100 m²)","Europa Clipper путује до Јупитера да би проучио Европу — залеђени месец пречника 3.121 km, за који се верује да испод леденог омотача дебљине 15–25 km крије глобални океан течне воде, и то је најприступачније потенцијално насељиво окружење у Сунчевом систему. Лансиран је 2024-10-14 ракетом Falcon Heavy при C3 41,7. Гравитациони маневар поред Марса у марту 2025. скренуо је путању ка Земљи; гравитациони маневар поред Земље 2026-12 даје завршни замах ка спољашњем делу система; до Јупитера стиже 2030-04-11, када следи убацивање у орбиту. Орбитална турнеја обухвата 49 блиских прелета поред Европе током четири године — на најближим пролазима летелица прелази на мање од 25 km од површине Европе. Турнеја је осмишљена тако да се мапира цео месец, а да се при том ограничи доза зрачења коју летелица прими у Јупитеровим суровим радијационим појасевима. Инструменти: радар REASON који продире кроз лед, масени спектрометар MASPEX (узоркује материјал из млаза, ако га има), термални снимач E-THEMIS (проналази активне гејзире), а магнетометар и плазма-инструменти потврђују дубину океана на основу индукованог магнетног одзива.","Europa Clipper креће према Јупитеру да проучи Европу — луну од 3.121 km прекривену ледом, за коју се верује да садржи глобални океан течне воде испод ледене љуске дебљине 15–25 km, најприступачније потенцијално становање окружење у Сунчевом систему. Лансирана је 2024-10-14 са Falcon Heavy при C3 од 41,7. Гравитациони маневар око Марса у марту 2025. савио је трајекторију према Земљи; гравитациони маневар око Земље 2026-12 даје финални импулс ка споља; стиже на Јупитер 2030-04-11 за уласк у орбиту.",[488,490,492,493,494],{"met":44,"label":58,"note":59,"type":489},"nominal",{"met":66,"label":68,"note":69,"type":491},"info",{"met":72,"label":73,"note":74,"type":491},{"met":12,"label":78,"note":79,"type":491},{"met":82,"label":84,"note":85,"type":491},"/orrery/images/missions/europa-clipper/01.webp"],"uses":{"params":["id"]}}]}
