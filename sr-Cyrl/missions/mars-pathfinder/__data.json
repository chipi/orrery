],-0.760092,-1.32053,[478,479,61,480],213.6111,-0.754106,-1.323958,[482,479,61,480],215.8596,[484,479,61,480],218.1082,[486,479,61,480],220.3567,[488,479,61,480],222.6053,"Mars Pathfinder","ЛЕНДЕР · РОВЕР · ОБАВЉЕНА","Први точкови на Марсу; демонстрирано слетање помоћу ваздушних јастука","Mars Pathfinder је био доказ агенције NASA да слетање на Марс не мора да кошта читаво богатство. Уместо лебдења на млазу ретроракета, какво су користиле летелице Vikings, ушао је у атмосферу заштићен топлотним штитом, отворио падобран, надуо кокон од ваздушних јастука и око петнаест пута одскочио од површине, па се зауставио и отворио као цвет. Из њега је изашао Sojourner — ровер величине микроталасне пећнице, први точкови који су се икада окренули на другој планети. Наука је била скромна; поента је била у методу. Слетање помоћу ваздушних јастука и приступ „брже, јефтиније, боље“, који је тиме потврђен, постали су узор за далеко амбициозније ровере — Spirit и Opportunity — који су уследили.","Мисија која је доказала да јефтине међупланетарне мисије могу успети. Pathfinder је користио нови систем слетања помоћу ваздушних јастука — око петнаест пута је одскочио од површине пре него што се зауставио — и испоручио Sojourner, прво возило које је радило на другој планети. Sojourner је прешао 100 m, испитао десетак стена и радио далеко дуже од предвиђеног века трајања од 8 сола. Pathfinder је радио скоро три месеца (85 дана); успех мисије оживео је међупланетарни програм агенције NASA након неуспеха из деведесетих година 20. века.",[495,497,498,499,503],{"met":61,"label":63,"note":64,"type":496},"nominal",{"met":71,"label":73,"note":74,"type":496},{"met":12,"label":89,"note":90,"type":496},{"met":500,"label":501,"note":502,"type":496},212.01,"СЛЕТАЊЕ","Лендер одскочи 15 пута преко долине Арес, а затим се заустави.",{"met":504,"label":505,"note":506,"type":507},213,"SOJOURNER ИЗВЕДЕН","Први точкови на другој планети.","info",[509,510,511],{"met":76,"label":77,"description":78},{"met":80,"l