94,[329,330,62,331],123.9155,380193,64913,[333,334,62,335],124.2634,379053,65109,[337,338,62,339],124.6113,377959,64734,[341,342,62,343],124.9592,377178,63881,[345,346,62,347],125.307,376902,62758,[349,350,62,351],125.6549,377198,61640,[353,354,62,355],126.0028,377994,60801,[357,358,62,359],126.3507,379094,60446,[361,362,62,363],126.6986,380230,60662,[365,366,62,367],127.0465,381124,61397,[369,370,62,371],127.3944,381556,62469,[373,374,62,375],127.7423,381420,63618,[377,378,62,379],128.0901,380751,64561,[381,382,62,383],128.438,379711,65068,[385,386,62,387],128.7859,378556,65014,[389,390,62,391],129.1338,377568,64413,[393,394,62,395],129.4817,376989,63412,[397,398,62,399],129.8296,376961,62256,[401,402,62,403],130.1775,377490,61228,[405,406,62,407],130.5254,378448,60579,[409,410,62,411],130.8732,379600,60469,[413,414,62,415],131.2211,380663,60925,[417,418,62,419],131.569,381377,61834,[421,422,62,423],131.9169,381568,62975,[425,426,62,427],132.2648,381189,64068,[429,430,62,431],132.6127,380332,64845,[433,434,62,435],132.9606,379208,65116,[437,438,62,439],133.3085,378091,64815,[441,442,62,443],133.6563,377256,64015,[445,446,62,447],134.0042,376905,62913,[449,450,62,451],134.3521,377127,61778,[453,454,62,455],134.7,378182,61325,[457,458,62,459],134.85,378671,61110,[12,461,62,462],379190,61042,"JAXA SLIM milestones (en.wikipedia.org/wiki/Smart_Lander_for_Investigating_Moon): launch 2023-09-06, lunar orbit insertion 2023-12-25, landing 2024-01-19; no orbit table found, so one schematic transfer ellipse from a 250 km perigee (parking_orbit) to the Moon between those dates, then the 600 km lunar orbit.",[465],[89,110,110],"SLIM","ПРЕЦИЗНИ ЛАНДЕР · ОБАВЉЕНА","Прво прецизно слетање на другом свету, на мање од 100 m од циља","До мисије SLIM, лунарна слетања имала су тачност гађања на нивоу километара. Smart Lander агенције JAXA показао је тачност од 100 m — прецизност потребну да би посаде могле да се споје са унапред постављеним теретом, да би узлетни модули за повратак узорака пронашли своје партнере у орбити и да би се остварила свака будућа архитектура која зависи од слетања на одређена, научно вредна места. SLIM је уједно користио нискоенергетски балистички трансфер до Месеца (пионир је била Hiten 1991. године): до циља је путовао 135 дана, али је трошио мање погонског горива него директне путање. То је показатељ стрпљења које себи могу да приуште међупланетарне мисије када рок није одлучујуће ограничење.",[471,473,477,478,479,484],{"met":62,"label":64,"note":65,"type":472},"nominal",{"met":51,"label":474,"note":475,"type":476},"БАЛИСТИЧКИ ПРЕЛАЗ","Путања балистичког захвата ниске енергије је у току.","info",{"met":89,"label":91,"note":92,"type":472},{"met":12,"label":96,"note":97,"type":472},{"met":480,"label":481,"note":482,"type":483},135.01,"ИСКОШЕНО СЛЕТАЊЕ","Лендер је остао да мирује нагнут прамцем наниже због квара на мотору током завршног спуштања. Соларни панели су у почетку били у сенци.","warning",{"met":485,"label":486,"note":487,"type":476},144,"НАПАЈАЊЕ ОБНОВЉЕНО","Упадни угао Сунчеве светлости се променио; соларни панели производе струју; лендер је преживео три лунарне ноћи, уз везу до априла 2024.",[489,490,491,492],{"met":72,"label":74,"description":75},{"met":77,"label":78,"description":79},{"met":81,"label":82,"description":79},{"met":84,"label":85,"description":86},"/orrery/images/missions/slim/01.webp"],"uses":{"params":["id"]}}]}
