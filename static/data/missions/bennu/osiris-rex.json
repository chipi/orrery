    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Atlas V 411",
        "description": "Cape Canaveral SLC-41, 2016-09-08. OSIRIS-REx (Origins, Spectral Interpretation, Resource Identification, Security — Regolith Explorer) was the first US asteroid sample-return mission. Designed to study a primordial carbonaceous asteroid that may preserve material from the early solar system."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-asteroid injection",
        "description": "Centaur upper stage burn places OSIRIS-REx on a heliocentric trajectory pre-tuned to use an Earth gravity assist 1 year later for the energy required to match Bennu's inclination."
      },
      {
        "met_days": 379,
        "type": "flyby",
        "label": "Earth gravity assist",
        "description": "2017-09-22. Closest approach 17,237 km over Antarctica. The 8.2°-inclination kick rotated OSIRIS-REx's orbital plane to match Bennu's 6° inclination — the assist did the heavy lifting that propellant alone couldn't have."
      },
      {
        "met_days": 700,
        "type": "tcm",
        "label": "Approach maneuver",
        "description": "First approach-phase burn. Slows OSIRIS-REx to match Bennu's heliocentric velocity for rendezvous."
      },
      {
        "met_days": 816,
        "type": "arrival",
        "label": "Bennu approach",
        "description": "2018-12-03. OSIRIS-REx arrives at 492-m-diameter Bennu — a carbonaceous near-Earth asteroid. Stationkeeping at 19 km, then orbital characterization."
      },
      {
        "met_days": 816.005,
        "type": "edl_or_oi",
        "label": "Bennu orbit insertion",
        "description": "Sequence of approach burns place OSIRIS-REx into a 1.4-km circumnavigation — the closest-ever spacecraft orbit around a celestial body. Surveyed Bennu for about two and a half years, mapping the boulder-strewn surface in unprecedented detail. Discovered active particle ejections from the asteroid — a previously unknown class of behaviour."
      },
      {
        "met_days": 1503,
        "type": "edl_or_oi",
        "label": "TAG — Touch-and-Go sample collection",
        "description": "2020-10-20. OSIRIS-REx descended to the Nightingale site, fired a burst of N₂ gas into the surface from its sample-collection arm, and grabbed a sample-rich plume — then immediately backed away. The asteroid surface turned out to be 'rubble-pile fluid' — the spacecraft sank ~50 cm into the surface in the few seconds it was in contact. Sample mass returned: 121.6 g, the largest asteroid sample ever."
      },
      {
        "met_days": 1705,
        "type": "tli_or_tmi",
        "label": "Bennu departure",
        "description": "2021-05-10. Departure burn places OSIRIS-REx onto a 2.5-year heliocentric trajectory back toward Earth for sample drop."
      },
      {
        "met_days": 2572,
        "type": "earth_return",
        "label": "Earth sample-return capsule delivery",
        "description": "2023-09-24. Sample Return Capsule (SRC) released at 102,000 km, entered the atmosphere at 12.4 km/s, parachuted into the Utah Test and Training Range. The spacecraft itself was immediately redesignated OSIRIS-APEX and rerouted toward asteroid Apophis, which passes about 32,000 km from Earth on 2029-04-13; OSIRIS-APEX arrives later that month."
      }
    ],
