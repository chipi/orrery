    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Falcon Heavy",
        "description": "Kennedy Space Center LC-39A, 2024-10-14. The largest planetary mission spacecraft ever launched — 6065 kg with 100-m² solar arrays (the largest interplanetary photovoltaic system at the time). Europa Clipper is the first mission dedicated specifically to characterising the habitability of one of Jupiter's icy moons."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Earth departure",
        "description": "Falcon Heavy second stage delivers Clipper at C3 41.7 km²/s² onto a Mars-gravity-assist trajectory."
      },
      {
        "met_days": 504,
        "type": "flyby",
        "label": "Mars gravity assist",
        "description": "2025-03-01. Mars MGA bends the trajectory toward an Earth re-encounter, adding the energy chemical propulsion alone couldn't deliver economically."
      },
      {
        "met_days": 1530,
        "type": "flyby",
        "label": "Earth gravity assist",
        "description": "2026-12-03. EGA accelerates Clipper outbound to Jupiter, closing the 5.5-year cruise."
      },
      {
        "met_days": 2005,
        "type": "arrival",
        "label": "Jupiter approach",
        "description": "2030-04-11. Clipper begins the final approach to Jupiter for orbital insertion."
      },
      {
        "met_days": 2005.005,
        "type": "edl_or_oi",
        "label": "Jupiter orbit insertion",
        "description": "Multi-engine 760-m/s burn places Clipper into a highly elliptical Jupiter orbit, with apoapsis carefully timed to keep the spacecraft outside the worst of Jupiter's radiation belts. The orbital tour will execute 49 close Europa flybys over four years — passing within 25 km of Europa's surface on the closest passes. Each flyby strips Europa's ice-shell secrets one swath at a time: REASON ice-penetrating radar profiles the shell, MASPEX mass spectrometer samples plume material if any, E-THEMIS thermal imager finds active geysers."
      }
    ],
