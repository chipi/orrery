    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Atlas V 401",
        "description": "Vandenberg, 2018-05-05 — first interplanetary mission launched from the US West Coast. InSight (Interior Exploration using Seismic Investigations) carried twin CubeSats MarCO-A + MarCO-B for real-time EDL telemetry relay — the first cubesats to leave Earth orbit."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "Centaur upper stage burn places InSight + MarCO on a 6.5-month Mars transfer."
      },
      {
        "met_days": 22,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First post-TMI dispersion cleanup."
      },
      {
        "met_days": 47.15,
        "type": "tcm",
        "label": "TCM-2",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 80,
        "type": "tcm",
        "label": "TCM-3",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 200,
        "type": "tcm",
        "label": "TCM-4 — final pre-EDL burn",
        "description": "Tightens approach targeting for Elysium Planitia EDL site."
      },
      {
        "met_days": 205,
        "type": "arrival",
        "label": "Mars approach + cruise-stage separation",
        "description": "2018-11-26. The MarCO cubesats arrived independently and relayed live EDL telemetry back to Earth via 1.6-W radios — proof-of-concept for cubesat deep-space mission support."
      },
      {
        "met_days": 205.005,
        "type": "edl_or_oi",
        "label": "Lander touchdown — Elysium Planitia",
        "description": "Heritage Phoenix EDL architecture (parachute + retrorockets, no sky crane) — InSight is a stationary lander, not a rover, so it could use the simpler legacy approach. Landed 2018-11-26 at 4.5°N, 135.6°E. Deployed SEIS seismometer (made the first Marsquake observations) and HP³ heat-flow probe (which jammed and never reached target depth). Mission ended 2022-12-21 when dust accumulation on the solar arrays cut power below operational threshold."
      }
    ],
