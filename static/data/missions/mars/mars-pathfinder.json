    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Delta II 7925",
        "description": "Cape Canaveral, 1996-12-04. Mars Pathfinder carried the first rover to operate on Mars — Sojourner, a 10.5-kg microwave-oven-sized vehicle. The mission also demonstrated airbag-cushioned EDL — a radical lower-cost alternative to the heritage Viking propulsive landing."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "Delta II second stage burn sends Pathfinder on a 7-month Mars transfer."
      },
      {
        "met_days": 30,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First post-TMI cleanup burn."
      },
      {
