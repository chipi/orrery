        "description": "Approach-phase refinement."
      },
      {
        "met_days": 188,
        "type": "arrival",
        "label": "Mars orbit insertion + lander release",
        "description": "1971-12-02. Orbiter captured into a 1500 × 211,000 km Mars orbit. The lander separated for an independent descent toward the Ptolemaeus crater region in Mars's southern hemisphere."
      },
      {
        "met_days": 188.01,
        "type": "edl_or_oi",
        "label": "Mars 3 lander — first soft Mars landing",
        "description": "Landed during a planet-encircling dust storm, 1971-12-02. The first human-made object to soft-land on Mars and survive its initial seconds — beating Viking 1 by 5 years."
      },
      {
        "met_days": 188.013,
        "type": "anomaly",
        "label": "Lander fails after 14.5 seconds",
        "description": "Returned a partial low-resolution scan + the first signal from the Martian surface, then went silent — likely a victim of the dust-storm winds + sand-bombardment shorting the lander's surface instruments. The orbiter continued operating for another 8 months."
      }
