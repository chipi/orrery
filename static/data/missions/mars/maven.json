        "description": "Mid-cruise adjustment."
      },
      {
        "met_days": 100,
        "type": "tcm",
        "label": "TCM-4",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 134.2,
        "type": "tcm",
        "label": "TCM-5",
        "description": "Approach-phase adjustment."
      },
      {
        "met_days": 200,
        "type": "tcm",
        "label": "TCM-6 — final pre-MOI burn",
        "description": "Tightens approach targeting for Mars orbit insertion."
      },
      {
        "met_days": 308,
        "type": "arrival",
        "label": "Mars approach",
        "description": "Pre-MOI checkout phase. 2014-09-22 arrival — India's Mangalyaan arrived 2 days later on 2014-09-24."
      },
      {
        "met_days": 308.005,
        "type": "edl_or_oi",
        "label": "Mars orbit insertion",
        "description": "33-minute main-engine burn captured MAVEN into a 35-hour elliptical orbit. The orbit was later trimmed to a 4.5-hour science orbit between 150 and 6,200 km. MAVEN remains operational, recently extended through 2030+, also serving as a relay for the Perseverance + Curiosity rovers."
      }
