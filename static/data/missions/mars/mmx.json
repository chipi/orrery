    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — H3 (planned)",
        "description": "Tanegashima, Japan, planned 2026. MMX (Martian Moons eXploration) — JAXA's flagship return-sample mission to Phobos, the larger and inner of Mars's two moons. Lineage from Hayabusa 1 + 2 — same agency, same return-sample architecture, scaled to Mars system."
      },
      {
        "met_days": 0.005,
