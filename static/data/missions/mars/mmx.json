    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — H3 flight 10",
        "description": "Tanegashima, Japan, 19 October 2026 at 19:41 UTC (20 October, 04:41 JST) — the first H3 to send a spacecraft to another planet. MMX (Martian Moons eXploration) is JAXA's sample-return mission to Phobos, the larger and inner of Mars's two moons, in the line of Hayabusa 1 and 2."
      },
      {
        "met_days": 0.0494,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "The H3 upper stage put MMX on its Mars transfer; JAXA confirmed separation 71 minutes 13 seconds after liftoff."
      },
      {
        "met_days": 30,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First post-TMI cleanup burn."
      },
      {
        "met_days": 150,
        "type": "tcm",
        "label": "TCM-2",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 250,
        "type": "tcm",
        "label": "TCM-3",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 275,
        "type": "tcm",
        "label": "TCM-4 — final pre-MOI",
        "description": "Final approach targeting."
      },
      {
        "met_days": 286,
        "type": "arrival",
        "label": "Mars orbit insertion",
        "description": "Planned August 2027. Captures into Mars orbit, then moves to a quasi-satellite orbit around Phobos about a month later — a Mars-relative path that keeps MMX close to Phobos without orbiting it directly (Phobos's gravity is too weak for a stable orbit)."
      },
      {
        "met_days": 286.01,
        "type": "edl_or_oi",
        "label": "Phobos sample collection",
        "description": "Planned 2030, after the Idefix rover lands in 2029. MMX will descend to Phobos's surface, collect ≥10 g of regolith with its coring and pneumatic samplers, and lift off again. The samples return to Earth in 2031 — the first material from a moon of Mars, expected to help settle whether Phobos is a captured asteroid or debris from a giant impact on Mars."
      }
    ],
