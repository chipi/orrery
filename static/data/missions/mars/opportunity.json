      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Delta II 7925H",
        "description": "Cape Canaveral LC-17B, 2003-07-07. Second of the twin Mars Exploration Rovers. Flew on the heavier Delta II 7925H (Heavy) variant to compensate for the slightly later launch and a higher-energy injection requirement. Designed for 90 sols. Would operate for 5,111 sols."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "PAM-D solid upper-stage burn sends Opportunity on a 6.6-month Type-I transfer, three weeks behind its twin Spirit."
      },
      {
        "met_days": 12,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First mid-course correction."
      },
