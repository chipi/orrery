    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Delta II 7925",
        "description": "Cape Canaveral LC-17A, 2007-08-04. Phoenix was salvaged from the cancelled Mars Surveyor 2001 lander program — flight hardware put in storage for six years, reassembled, retargeted to the Martian north polar plains. The name was chosen literally."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Mars injection",
        "description": "PAM-D solid upper-stage burn places Phoenix on a 295-day Type-II transfer to Mars."
      },
      {
        "met_days": 7,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First post-TMI cleanup burn."
      },
      {
        "met_days": 65,
