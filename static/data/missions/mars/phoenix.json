        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 287,
        "type": "tcm",
        "label": "TCM-5",
        "description": "Approach trim toward the Vastitas Borealis target ellipse."
      },
      {
        "met_days": 294,
        "type": "tcm",
        "label": "TCM-6 — final pre-EDL",
        "description": "Last trim 21 hours before atmospheric entry."
      },
      {
        "met_days": 295,
        "type": "arrival",
        "label": "Mars approach + cruise-stage separation",
        "description": "2008-05-25. Cruise stage jettisoned 7 minutes before entry; backshell + heat shield + lander entered the atmosphere at 5.59 km/s — the first soft propulsive landing on Mars since Viking 2 in 1976."
      },
      {
        "met_days": 295.005,
        "type": "edl_or_oi",
        "label": "Mars EDL — propulsive landing on Vastitas Borealis",
        "description": "Heritage Viking-style EDL: aeroshell, supersonic parachute, then twelve hydrazine retrorockets that throttled the lander down to 2.4 m/s touchdown velocity at 68.22°N, 234.25°E — further north than any prior Mars surface mission. Within days the robotic arm scraped through topsoil and exposed bright white ice that visibly sublimated on camera over four sols — the first direct confirmation of water ice in the Martian arctic regolith. Mission ended 2008-11-02 as solar power fell below operational threshold at the onset of Mars winter; the lander was never expected to survive the polar night."
      }
