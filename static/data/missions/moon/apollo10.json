    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Saturn V",
        "description": "Kennedy Space Center pad 39B, 1969-05-18 16:49:00 UTC (11:49 a.m. EST). Saturn V puts Stafford, Young and Cernan into a 102.6 x 99.6 nmi Earth orbit for the dress rehearsal of the first landing."
      },
      {
        "met_days": 0.107,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "S-IVB reignition at GET 2:33:28 (1969-05-18 19:22 UTC), 342.9-second burn. Injection was so precise that the planned ~12-hour correction was not needed."
      },
      {
        "met_days": 1.106,
        "type": "tcm",
        "label": "Midcourse correction",
        "description": "The only translunar correction, SPS burn at GET 26:32:57 (1969-05-19 19:21 UTC): 7.1 s, 49.2 ft/s (15.0 m/s), aligning the path with the July landing trajectory."
      },
      {
        "met_days": 3.164,
        "type": "loi",
        "label": "Lunar orbit insertion",
        "description": "1969-05-21 20:44 UTC, GET 75:55:54. A 356-second SPS burn captures the spacecraft into a 60 x 171 nmi lunar orbit; circularization at GET 80:25:08 follows."
      },
      {
        "met_days": 4.157,
        "type": "descent_start",
        "label": "LM Snoopy descent orbit insertion",
        "description": "1969-05-22 20:35 UTC, GET 99:46:02. After undocking at 98:11:57, a 27.4-second descent-engine burn drops Stafford and Cernan's LM toward the Apollo 11 landing site; no landing was attempted."
      },
      {
        "met_days": 4.196,
        "type": "flyby",
        "label": "LM low pass over the lunar surface — 14.4 km",
        "description": "1969-05-22 21:30 UTC, GET 100:41:40. The LM's landing radar measures its lowest altitude, 47,400 ft (14.4 km), over the Sea of Tranquility; a 39.95-second DPS phasing burn follows at GET 100:58:26."
      },
      {
        "met_days": 4.288,
        "type": "ascent",
        "label": "LM ascent-stage insertion burn",
        "description": "1969-05-22 23:44 UTC, GET 102:55:02. After descent-stage jettison at 102:45:17, a 15.55-second ascent-engine burn simulates a lunar-surface liftoff; rendezvous and docking follow at GET 106:22:02."
      },
      {
        "met_days": 5.734,
        "type": "tei",
        "label": "Trans-earth injection",
        "description": "1969-05-24 10:25 UTC, GET 137:36:29. A 164.8-second SPS burn sends Apollo 10 home after 61.7 h in lunar orbit."
      },
      {
        "met_days": 7.868,
        "type": "tcm",
        "label": "Trans-earth midcourse correction",
        "description": "Correction at GET 188:49:58 (1969-05-26 13:38 UTC) to set the entry corridor, three hours before command module separation."
      },
      {
        "met_days": 8.002,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "1969-05-26 16:52 UTC, GET 192:03:23. Apollo 10 lands about 3 nmi from its aim point after an 8-day mission."
      }
    ]
  }
