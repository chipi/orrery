    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Saturn V",
        "description": "Kennedy Space Center, 1969-11-14 16:22:00 UTC (11:22 a.m. EST). Saturn V lifts Conrad, Gordon and Bean on the second lunar landing mission, aimed at the Surveyor 3 site."
      },
      {
        "met_days": 0.116,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "S-IVB second burn at GET 2:47:23 (1969-11-14 19:09 UTC) injects Apollo 12 toward the Moon from Earth parking orbit."
      },
      {
        "met_days": 1.287,
        "type": "tcm",
        "label": "MCC-2 — midcourse correction",
        "description": "SPS burn at GET 30:52:44 (1969-11-15 23:14 UTC), 61.8 ft/s (18.8 m/s), moving Apollo 12 from free return onto the hybrid non-free-return path needed for the precision landing."
      },
      {
        "met_days": 3.476,
        "type": "loi",
        "label": "Lunar orbit insertion",
        "description": "1969-11-18 03:47 UTC, GET 83:25:23. About 5 min 52 s of SPS firing captures the spacecraft into a 170.0 x 61.8 mile orbit; circularization follows at GET 87:48:48."
      },
      {
        "met_days": 4.598,
        "type": "descent_start",
        "label": "LM Intrepid powered descent",
        "description": "1969-11-19 06:42 UTC, GET 110:20:38. Conrad and Bean begin powered descent and land at GET 110:32:36, within 535 ft (163 m) of Surveyor 3 in the Ocean of Storms."
      },
      {
        "met_days": 5.919,
        "type": "ascent",
        "label": "LM Intrepid ascent",
        "description": "1969-11-20 14:25 UTC, GET 142:03:48. After two moonwalks the ascent stage lifts off and docks with Yankee Clipper at GET 145:36:20."
      },
      {
        "met_days": 7.186,
        "type": "tei",
        "label": "Trans-earth injection",
        "description": "1969-11-21 20:49 UTC, GET 172:27:17. SPS burn sends Apollo 12 home."
      },
      {
        "met_days": 7.852,
        "type": "tcm",
        "label": "Trans-earth midcourse correction 1",
        "description": "Small correction at GET 188:27:16 (1969-11-22 12:49 UTC); a second follows at GET 241:22:00."
      },
      {
        "met_days": 10.057,
        "type": "tcm",
        "label": "Trans-earth midcourse correction 2",
        "description": "Final entry-corridor trim at GET 241:22:00 (1969-11-24 17:44 UTC), about 3 h before command module separation."
      },
      {
        "met_days": 10.192,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "1969-11-24 20:58 UTC, GET 244:36:25. Apollo 12 splashes down after 10 days 4 h 36 min."
      }
    ]
