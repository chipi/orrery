    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Saturn V",
        "description": "Kennedy Space Center, 1971-01-31 21:03:02 UTC (4:03 p.m. EST), 40 minutes after the planned time. Saturn V lifts Shepard, Roosa and Mitchell on the Fra Mauro mission."
      },
      {
        "met_days": 0.103,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "S-IVB second burn at GET 2:28:32 (1971-01-31 23:31 UTC), 350.8 seconds, sends Apollo 14 toward the Moon."
      },
      {
        "met_days": 1.275,
        "type": "tcm",
        "label": "MCC-2 — midcourse correction",
        "description": "SPS burn at GET 30:36:08 (1971-02-02 03:39 UTC), 10.1 seconds, moving the spacecraft to the hybrid trajectory aimed at Fra Mauro."
      },
      {
        "met_days": 3.207,
        "type": "tcm",
        "label": "MCC-4 — midcourse correction",
        "description": "A minimum-impulse 0.65-second burn at GET 76:58:12 (1971-02-04 02:01 UTC), about 5 h before lunar orbit insertion."
      },
      {
        "met_days": 3.414,
        "type": "loi",
        "label": "Lunar orbit insertion",
        "description": "1971-02-04 06:59 UTC, GET 81:56:41. A 370.8-second SPS burn captures Kitty Hawk and Antares into lunar orbit; descent orbit insertion follows at GET 86:10:53."
      },
      {
        "met_days": 4.502,
        "type": "descent_start",
        "label": "LM Antares powered descent",
        "description": "1971-02-05 09:05 UTC, GET 108:02:27. A 764.6-second descent burn ends at GET 108:15:09 (1971-02-05 09:18 UTC) on the Fra Mauro formation."
      },
      {
        "met_days": 5.907,
        "type": "ascent",
        "label": "LM Antares ascent",
        "description": "1971-02-06 18:48 UTC, GET 141:45:40. A 432.1-second ascent burn after two EVAs; docking with Kitty Hawk follows at GET 143:32:51."
      },
      {
        "met_days": 6.192,
        "type": "tei",
        "label": "Trans-earth injection",
        "description": "1971-02-07 01:39 UTC, GET 148:36:02. A 149.2-second SPS burn sends Apollo 14 home."
      },
      {
        "met_days": 6.899,
        "type": "tcm",
        "label": "MCC-5 — trans-earth midcourse correction",
        "description": "A 3.0-second correction at GET 165:34:57 (1971-02-07 18:37 UTC) trims the entry path; MCC-5 is the AFJ designation (Day 7, part 1)."
      },
      {
        "met_days": 9.001,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "1971-02-09 21:05 UTC, GET 216:01:58. Apollo 14 splashes down after 9 days and 2 minutes."
      }
    ]
