      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Saturn V",
        "description": "Kennedy Space Center pad 39A, 1971-07-26 13:34:00 UTC (9:34 a.m. EDT). Saturn V lifts Scott, Worden and Irwin on the first J-mission, bound for Hadley-Apennine."
      },
      {
        "met_days": 0.118,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "S-IVB burn at GET 2:50:03 (1971-07-26 16:24 UTC), 350.8 seconds, 10,414.7 ft/s (3,174 m/s) of delta-v."
      },
      {
        "met_days": 1.195,
        "type": "tcm",
        "label": "Midcourse correction",
        "description": "SPS burn at GET 28:40:22 (1971-07-27 18:14 UTC), 0.8 s and 5.3 ft/s (1.6 m/s), doubling as an SPS engine test."
      },
      {
        "met_days": 3.063,
        "type": "tcm",
        "label": "Midcourse correction",
        "description": "SPS burn at GET 73:31:15 (1971-07-29 15:05 UTC), 0.9 s and 5.4 ft/s (1.6 m/s), the last translunar correction before lunar orbit insertion."
      },
      {
        "met_days": 3.272,
        "type": "loi",
        "label": "Lunar orbit insertion",
        "description": "1971-07-29 20:05 UTC, GET 78:31:47. A ~398-second SPS burn, 3,000 ft/s (914 m/s), captures Endeavour and Falcon into a 170.1 x 57.7 mile orbit."
      },
      {
        "met_days": 4.354,
        "type": "descent_start",
        "label": "LM Falcon powered descent",
        "description": "1971-07-30 22:04 UTC, GET 104:30:09. A 739.2-second descent burn ends at GET 104:42:29 (1971-07-30 22:16 UTC) at Hadley Rille, the first Apollo J-mission landing."
      },
      {
        "met_days": 7.151,
        "type": "ascent",
        "label": "LM Falcon ascent",
        "description": "1971-08-02 17:11 UTC, GET 171:37:23. A 431-second ascent burn after three moonwalks and the first lunar rover drives; docking at GET 173:36:26."
      },
      {
        "met_days": 9.326,
        "type": "tei",
        "label": "Trans-earth injection",
        "description": "1971-08-04 21:22 UTC, GET 223:48:46. A 141-second SPS burn, 3,046.8 ft/s (929 m/s), follows the subsatellite launch at GET 222:39:29."
      },
      {
        "met_days": 12.164,
        "type": "tcm",
        "label": "Trans-earth midcourse correction",
        "description": "22.3-second RCS correction at GET 291:56:50 (1971-08-07 17:30 UTC), 5.6 ft/s, three hours before entry."
      },
      {
        "met_days": 12.3,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "1971-08-07 20:45 UTC, GET 295:11:53. Apollo 15 lands after 12 days 7 h 12 min."
      }
    ]
