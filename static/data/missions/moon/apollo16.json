      },
      {
        "met_days": 1.277,
        "type": "tcm",
        "label": "Midcourse correction",
        "description": "SPS burn at GET 30:39:01 (1972-04-18 00:33 UTC), 2.0 s and 12.5 ft/s (3.8 m/s), the only translunar correction."
      },
      {
        "met_days": 3.103,
        "type": "loi",
        "label": "Lunar orbit insertion",
        "description": "1972-04-19 20:22 UTC, GET 74:28:28. A 374.9-second SPS burn, 2,802 ft/s (854 m/s), captures Casper and Orion into a 170.3 x 58.1 mile orbit; descent orbit insertion follows at GET 78:33:45."
      },
      {
        "met_days": 4.345,
        "type": "descent_start",
        "label": "LM Orion powered descent",
        "description": "1972-04-21 02:11 UTC, GET 104:17:25. A 734-second descent burn ends at GET 104:29:35 in the Descartes highlands."
      },
      {
        "met_days": 7.314,
        "type": "ascent",
        "label": "LM Orion ascent",
        "description": "1972-04-24 01:25 UTC, GET 175:31:48. A 427.7-second ascent burn after three EVAs; docking with Casper at GET 177:41:18."
      },
      {
        "met_days": 8.348,
        "type": "tei",
        "label": "Trans-earth injection",
        "description": "1972-04-25 02:15 UTC, GET 200:21:33. A 162.3-second SPS burn, 3,370.9 ft/s (1,027 m/s), follows the subsatellite launch at GET 196:02:09."
      },
      {
        "met_days": 8.941,
        "type": "tcm",
        "label": "Trans-earth midcourse correction",
        "description": "8.0-second RCS correction at GET 214:35:03 (1972-04-25 16:29 UTC), 3.4 ft/s; a second 3.2-second trim follows at GET 262:37:21."
      },
      {
        "met_days": 10.943,
        "type": "tcm",
        "label": "Trans-earth midcourse correction",
        "description": "Final entry-corridor trim at GET 262:37:21 (1972-04-27 16:31 UTC), 1.4 ft/s."
      },
      {
        "met_days": 11.077,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "1972-04-27 19:45 UTC, GET 265:51:05. Apollo 16 lands after 11 days 1 h 51 min."
