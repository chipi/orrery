    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — SLS Block 1 / Orion",
        "description": "Kennedy Space Center LC-39B, 1 April 2026, 22:35 UTC. Artemis II — first crewed lunar mission since Apollo 17 (1972). Crew: Reid Wiseman (NASA, cmdr), Victor Glover (NASA), Christina Koch (NASA, first woman on a lunar mission), Jeremy Hansen (CSA, first non-American to fly to the Moon)."
      },
      {
        "met_days": 0.05,
        "type": "parking_orbit_exit",
        "label": "Earth-orbit checkout complete",
        "description": "Orion + ICPS finished post-launch checkout in high Earth orbit. The crew flew Orion around the spent ICPS for the manual proximity-operations demo unique to this mission."
      },
      {
        "met_days": 0.13,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "The burn placed Orion + crew on a five-day free-return path to the Moon. The trajectory is designed so the Moon's gravity bends Orion straight back to Earth even if the engine fails — no LOI burn needed.",
        "dv_km_s": 3.05
      },
      {
        "met_days": 1.5,
        "type": "tcm",
        "label": "MCC-1 — first midcourse correction",
        "description": "Refines the free-return trajectory toward the Moon."
      },
      {
        "met_days": 5.02,
        "type": "flyby",
        "label": "Moon — free-return flyby",
        "description": "6 April 2026: closest approach ~6,545 km (4,067 mi) above the lunar far side, and 406,771 km from Earth — farther than any humans had travelled, beating Apollo 13's 1970 record. No lunar orbit: Artemis II was a flyby test of Orion's life support and comms over a 9-day deep-space flight, ahead of the first landing, now planned for Artemis IV."
      },
      {
        "met_days": 6,
        "type": "tcm",
        "label": "MCC-2 — return-leg correction",
        "description": "Targets the Pacific splashdown ellipse off San Diego."
      },
      {
        "met_days": 9.06,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "10 April 2026 (11 April UTC). Orion re-entered at about 11 km/s (lunar return velocity) on a shorter entry path than Artemis I's skip entry — chosen after Artemis I's heat-shield char loss — and splashed down in the Pacific off San Diego. First crewed deep-space mission of the 21st century."
      }
    ],
