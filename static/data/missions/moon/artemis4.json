    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — SLS Block 1 / Orion (planned)",
        "description": "Kennedy Space Center LC-39B, planned for early 2028. Artemis IV is planned as the first crewed lunar landing since Apollo 17 (1972) and the first crewed landing near the south pole. SLS Block 1 flies for the last time with the ICPS upper stage, carrying Orion and four crew."
      },
      {
        "met_days": 0.13,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "The ICPS burn sends Orion and its crew on a 4-day coast to Near-Rectilinear Halo Orbit, where the commercial lander — Starship HLS or Blue Moon, not yet chosen — waits."
      },
      {
        "met_days": 1.48,
        "type": "tcm",
        "label": "MCC-1",
        "description": "First mid-course correction."
      },
      {
        "met_days": 1.5,
        "type": "tcm",
        "label": "MCC-2",
        "description": "Approach-phase refinement."
      },
      {
        "met_days": 4,
        "type": "loi",
        "label": "NRHO insertion + lander rendezvous",
        "description": "Orion captures into Near-Rectilinear Halo Orbit — an elongated lunar orbit with a 3,000 km perilune and a 70,000 km apolune, much cheaper to reach than Apollo's circular low lunar orbit (~0.45 km/s against Apollo's 0.89 km/s). The crew docks with the waiting lander.",
        "dv_km_s": 0.45
      },
      {
        "met_days": 5,
        "type": "descent_start",
        "label": "Lander powered descent — lunar south pole",
        "description": "Two crew descend in the lander while two remain in Orion. The target is the south polar region, where NASA has named nine candidate landing regions. A surface stay of about a week is planned — more than twice Apollo's longest, about 3 days on Apollo 17."
      },
      {
        "met_days": 12,
        "type": "ascent",
        "label": "Lander ascent + return to NRHO",
        "description": "The lander lifts off and carries the two surface crew back to NRHO, where they transfer to Orion."
      },
      {
        "met_days": 14,
        "type": "tei",
        "label": "Trans-Earth injection",
        "description": "Orion leaves NRHO on its return trajectory, about ten days after arriving.",
        "dv_km_s": 0.45
      },
      {
        "met_days": 18,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "Planned for early 2028. Orion re-enters Earth's atmosphere at lunar-return velocity (~11 km/s) and splashes down in the Pacific."
      }
