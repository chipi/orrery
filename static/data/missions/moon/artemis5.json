    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — SLS Block 1 / Orion (planned)",
        "description": "Kennedy Space Center LC-39B, planned for late 2028. Artemis V is planned as the second crewed landing of the Artemis era, the start of work towards a base near the lunar south pole. SLS Block 1 launches Orion with four crew; the upper stage is still to be confirmed."
      },
      {
        "met_days": 0.13,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "The upper-stage burn sends Orion and its crew on a 4-day coast to Near-Rectilinear Halo Orbit, where the commercial lander waits."
      },
      {
        "met_days": 1.48,
        "type": "tcm",
        "label": "MCC-1",
        "description": "First mid-course correction."
      },
      {
        "met_days": 1.5,
        "type": "tcm",
        "label": "MCC-2",
        "description": "Approach-phase refinement."
      },
      {
        "met_days": 4,
        "type": "loi",
        "label": "NRHO insertion + lander rendezvous",
        "description": "Orion captures into Near-Rectilinear Halo Orbit — an elongated lunar orbit with a 3,000 km perilune and a 70,000 km apolune, much cheaper to reach than Apollo's circular low lunar orbit (~0.45 km/s against Apollo's 0.89 km/s). The crew docks with the waiting lander.",
        "dv_km_s": 0.45
      },
      {
        "met_days": 5,
        "type": "descent_start",
        "label": "Lander powered descent — lunar south pole",
        "description": "Two crew descend in the lander while two remain in Orion. Crew, lander and landing site are not yet chosen; the aim is to begin longer stays and the groundwork for a surface base."
      },
      {
        "met_days": 12,
        "type": "ascent",
        "label": "Lander ascent + return to NRHO",
        "description": "The lander lifts off after the surface stay and carries the two surface crew back to NRHO, where they transfer to Orion."
      },
      {
        "met_days": 14,
        "type": "tei",
        "label": "Trans-Earth injection",
        "description": "Orion leaves NRHO on its return trajectory, about ten days after arriving.",
        "dv_km_s": 0.45
      },
      {
        "met_days": 18,
        "type": "earth_return",
        "label": "Splashdown — Pacific Ocean",
        "description": "Planned for late 2028. Orion re-enters Earth's atmosphere at lunar-return velocity (~11 km/s) and splashes down in the Pacific."
      }
