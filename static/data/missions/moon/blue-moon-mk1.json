      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — New Glenn (planned)",
        "description": "Cape Canaveral LC-36, NET early 2027 (slipped from 2025 after a New Glenn hotfire anomaly in May 2026). Blue Origin's Blue Moon Mk1 cargo lander (named Endurance) — first uncrewed surface mission of Blue Origin's two-class lunar landing architecture. Mk1 carries ~3 metric tons of payload; the larger Mk2 is the human-rated lander NASA contracted for crewed Artemis landings."
      },
      {
        "met_days": 0.2,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "New Glenn leaves Mk1 in low Earth orbit; after three to four orbits the lander's own BE-7 raises it to an elliptical orbit, then burns for the Moon — a 4-day translunar coast."
      },
      {
        "met_days": 1.5,
        "type": "tcm",
        "label": "MCC-1 — first midcourse correction",
        "description": "Refines the trajectory after TLI dispersion."
      },
      {
        "met_days": 4,
        "type": "arrival",
        "label": "Lunar orbit insertion",
        "description": "Lander captures into a 100-km circular lunar orbit before descent."
      },
      {
        "met_days": 4.1,
        "type": "edl_or_oi",
        "label": "Lunar powered descent — south polar region",
        "description": "Blue Moon's single BE-7 hydrogen/oxygen engine (the first hydrogen-fuelled lunar lander engine) executes the powered descent. Targets a south polar landing site near future Artemis crewed sites."
      }
