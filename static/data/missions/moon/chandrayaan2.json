      {
        "met_days": 22.49,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "2019-08-13 20:51 UTC. After a series of apogee-raising burns the orbiter's engine sends the stack toward the Moon from an Earth orbit of 142,975 x 276 km."
      },
      {
        "met_days": 28.76,
        "type": "arrival",
        "label": "Lunar orbit insertion",
        "description": "2019-08-20 03:32 UTC. Captured into an 18,072 x 114 km lunar orbit; four lowering burns follow, reaching a near-circular orbit of about 127 x 119 km on 2019-09-01."
      },
      {
        "met_days": 41.94,
        "type": "separation",
        "label": "Vikram separation",
        "description": "2019-09-02 07:45 UTC. The Vikram lander, with the Pragyan rover inside, separates from the orbiter."
      },
      {
        "met_days": 46.45,
        "type": "edl_or_oi",
        "label": "Lunar powered descent — Vikram lost",
        "description": "2019-09-06 about 20:08 UTC. Vikram begins its powered descent toward the south polar region; signal is lost at about 2.1 km altitude and the lander crashes. The orbiter continues its mission."
      }
