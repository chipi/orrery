    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — LVM3 (GSLV Mk III)",
        "description": "Sriharikota, India, 2023-07-14. Chandrayaan-3 — ISRO's follow-up to the failed 2019 Chandrayaan-2 lander. Carries the Vikram lander + Pragyan rover. Targets a south-polar landing site where Chandrayaan-2's Vikram had crashed."
      },
      {
        "met_days": 17.8,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "Final perigee burn after 18 days of progressive Earth-orbit raising — the same lower-cost lunar transfer ISRO has used since Chandrayaan-1."
      },
      {
        "met_days": 22.2,
        "type": "arrival",
        "label": "Lunar orbit insertion",
        "description": "2023-08-05. Captured into 164 × 18,074 km lunar orbit. ISRO spent 18 days lowering perilune to 25 km for the descent."
      },
      {
        "met_days": 23.35,
        "type": "phasing",
        "label": "Lunar orbit reduction 1",
        "description": "2023-08-06. First lunar-bound burn after capture: the orbit drops to 170 × 4,313 km."
      },
      {
        "met_days": 26.2,
        "type": "phasing",
        "label": "Lunar orbit reduction 2",
        "description": "2023-08-09. Second burn lowering the orbit towards a near-circular one."
      },
      {
        "met_days": 31.2,
        "type": "phasing",
        "label": "Lunar orbit reduction 3",
        "description": "2023-08-14. Third reduction burn."
      },
      {
        "met_days": 33.1,
        "type": "phasing",
        "label": "Lunar orbit reduction 4",
        "description": "2023-08-16. Final reduction burn: a near-circular 153 × 163 km orbit."
      },
      {
        "met_days": 34,
        "type": "separation",
        "label": "Lander module separation",
        "description": "2023-08-17. The Vikram lander module, with the Pragyan rover inside, separates from the propulsion module."
      },
      {
        "met_days": 35,
        "type": "phasing",
        "label": "Lander deboost 1",
        "description": "2023-08-18. Vikram's first deboost lowers its orbit to 113 × 157 km."
      },
      {
        "met_days": 36.5,
        "type": "phasing",
        "label": "Lander deboost 2",
        "description": "Second deboost puts Vikram into the low descent orbit, ready for the landing attempt."
      },
      {
        "met_days": 40,
        "type": "edl_or_oi",
        "label": "Lunar powered descent + landing — Shiv Shakti Point",
        "description": "2023-08-23. Powered descent + soft landing near the lunar south pole (69.37°S, 32.32°E) — making India the 4th country to soft-land on the Moon (after USSR, USA, China) and the FIRST to land near the south pole. Site later named Shiv Shakti Point. Pragyan rover rolled off + drove ~100 m before going into hibernation for the lunar night (with no recovery on the second day)."
      }
    ],
