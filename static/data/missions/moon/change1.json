    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Long March 3A",
        "description": "Xichang, 2007-10-24 10:05 UT (18:05 Beijing time). The orbiter is released at 10:29 UT into a 205 x 51,000 km Earth orbit."
      },
      {
        "met_days": 6.965,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "2007-10-31 09:15 UT. After three perigee burns raised the orbit, a 13-minute burn raises the speed to 10.9 km/s and starts the transfer to the Moon."
      },
      {
        "met_days": 11.715,
        "type": "edl_or_oi",
        "label": "LOI-1 — lunar capture",
        "description": "2007-11-05 03:15 UT. A 22-minute braking burn captures Chang'e 1 into a 12-hour, 200 x 8,600 km near-polar lunar orbit."
      },
      {
        "met_days": 12.719,
        "type": "edl_or_oi",
        "label": "LOI-2 — lunar orbit lowered",
        "description": "2007-11-06 03:21 UT. A 14-minute second braking burn (to 03:35 UT) lowers the orbit to 3.5 hours, 213 x 1,700 km."
      },
      {
        "met_days": 13.596,
        "type": "edl_or_oi",
        "label": "LOI-3 — 200 km lunar science orbit reached",
        "description": "2007-11-07 00:24 UT. A final 10-minute burn (to 00:34 UT) slows the probe to 1.59 km/s and into the circular 200 km, 127-minute, high-inclination science orbit."
      }
    ]
