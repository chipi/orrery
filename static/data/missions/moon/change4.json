      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Long March 3B/E",
        "description": "Xichang, China, 2018-12-07. Chang'e 4 — the first spacecraft to soft-land on the lunar far side. Carries the Yutu-2 rover. Required prior deployment of the Queqiao relay satellite at the Earth-Moon L2 point (2018-05) since the far side has no direct line-of-sight to Earth."
      },
      {
        "met_days": 0.05,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "Long March 3B/E third-stage burn places Chang'e 4 on a direct translunar trajectory."
      },
      {
        "met_days": 1.19,
        "type": "tcm",
        "label": "MCC-1",
