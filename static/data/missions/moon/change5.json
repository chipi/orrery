    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Long March 5",
        "description": "Wenchang, China, 2020-11-23. Chang'e 5 — first sample return from the Moon since Soviet Luna 24 (1976), 44 years. CNSA's first multi-component robotic mission: orbiter + ascender + lander + Earth-return capsule, all stacked for one launch."
      },
      {
        "met_days": 0.05,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
        "description": "Long March 5 upper stage burn sends Chang'e 5 directly on translunar trajectory."
      },
      {
        "met_days": 1.04,
        "type": "tcm",
        "label": "MCC-1",
        "description": "First post-TLI cleanup."
      },
      {
        "met_days": 1.78,
        "type": "tcm",
        "label": "MCC-2",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 2.52,
        "type": "tcm",
