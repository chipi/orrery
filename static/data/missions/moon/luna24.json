      },
      {
        "met_days": 9,
        "type": "descent_start",
        "label": "Powered descent + sample collection — Mare Crisium",
        "description": "1976-08-18. Soft landing in the Sea of Crises (12.71°N, 62.21°E). Deep drill collected 170 g of regolith from 2 m depth — much deeper than Luna 16's 35 cm."
      },
      {
        "met_days": 10,
        "type": "ascent",
        "label": "Ascent — sample capsule liftoff",
        "description": "1976-08-19. Ascender lifted off with the sample capsule, heading back to Earth on a direct trajectory."
      },
      {
        "met_days": 10.02,
        "type": "tei",
        "label": "Trans-Earth injection",
        "description": "Direct return trajectory — no return rendezvous needed.",
        "dv_km_s": 2.7
      },
      {
        "met_days": 13,
        "type": "earth_return",
        "label": "Sample capsule landing — Western Siberia",
        "description": "1976-08-22. Capsule re-entered Earth's atmosphere, parachuted to landing in western Siberia. The 170 g sample was analysed at the Vernadsky Institute; later partially exchanged with the United States for Apollo samples. The Soviet lunar program closed with Luna 24."
