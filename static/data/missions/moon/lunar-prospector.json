      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Athena II",
        "description": "Cape Canaveral, 1998-01-07 02:28:44 UT (6 January 21:28 EST). The new Athena II places the 296-kg probe and its Star 37 injection stage in a parking orbit after a 13-minute flight."
      },
      {
        "met_days": 0.039,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection (nominal)",
        "description": "Nominal design: Star 37 firing about 56 minutes after launch (~03:25 UT), a 64-second, 3,142 m/s burn that starts a 105-hour cruise. Actual burn time not found; the figure is the planned value."
      },
      {
        "met_days": 0.394,
        "type": "tcm",
        "label": "TCM-1",
        "description": "1998-01-07 11:55 GMT, about 8.5 hours after TLI. A 50.2 m/s correction split into axial and tangential thruster burns, finished by 12:27 GMT."
      },
      {
        "met_days": 1.248,
        "type": "tcm",
        "label": "TCM-2",
        "description": "1998-01-08 08:25 GMT. A 7.4 m/s trim refining the lunar arrival; the planned third correction was not needed."
      },
      {
        "met_days": 4.386,
        "type": "edl_or_oi",
        "label": "LOI-1 — lunar capture",
        "description": "1998-01-11 11:44 GMT. First of three insertion burns (about 32 minutes, to 12:17 GMT; planned 354 m/s) captures Lunar Prospector into an 11.6-hour lunar orbit."
      }
