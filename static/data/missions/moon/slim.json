        "met_days": 64.92,
        "type": "tcm",
        "label": "TCM-4 — final pre-LOI",
        "description": "Final approach targeting before lunar orbit insertion."
      },
      {
        "met_days": 110,
        "type": "arrival",
        "label": "Lunar orbit insertion",
        "description": "2023-12-25. Captured into a 600 × 4,000 km polar orbit. JAXA spent ~30 days lowering perilune to ~15 km for the descent."
      },
      {
        "met_days": 135,
        "type": "edl_or_oi",
        "label": "Pinpoint landing — Shioli crater",
        "description": "2024-01-19. SLIM landed within 55 m of its target point inside Shioli crater (13.3°S, 25.2°E) — the most precise lunar landing of any mission ever. Japan becomes the 5th nation to soft-land on the Moon. The landing posture was off-nominal (a thrust-vector anomaly tipped the lander on its side), but the solar panels later caught sunlight 9 days into the lunar day and the mission returned surface science."
      }
