      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — H-IIA",
        "description": "Tanegashima, Japan, 2023-09-07. SLIM (Smart Lander for Investigating Moon) — JAXA's first lunar landing attempt. Designed to demonstrate \"pinpoint\" landing — better than 100-m accuracy versus the kilometres of dispersion in earlier Moon landings."
      },
      {
        "met_days": 0.05,
        "type": "tli_or_tmi",
        "label": "Trans-lunar injection",
