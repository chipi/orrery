    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — Ariane 5",
        "description": "Kourou, 2003-09-27 23:14 UT, as an auxiliary passenger on Ariane 5. SMART-1 is released into a ~742 x 36,016 km geostationary transfer orbit, inclined 7 degrees, and begins its ion-engine spiral to the Moon."
      },
      {
        "met_days": 378.531,
        "type": "tli_or_tmi",
        "label": "Final continuous-thrust arc",
        "description": "After lunar resonance manoeuvres in August, September and October 2004, a final 100-hour continuous ion-engine thrust arc (10-14 October 2004) lifts the apogee to the Moon's distance."
      },
      {
        "met_days": 412.531,
        "type": "arrival",
        "label": "Lunar capture",
        "description": "2004-11-13. The Moon's gravity captures SMART-1 at about 60,000 km from the lunar surface, after the spacecraft passed the Earth-Moon L1 region."
      },
      {
        "met_days": 414.256,
        "type": "tcm",
        "label": "Ion engine fires to lower lunar orbit",
        "description": "2004-11-15 05:24 UT. The ion engine starts a 4.5-day thrust period to lower the orbit from the initial 4,962 x 51,477 km, 81-degree capture orbit toward a 300 x 3,000 km polar orbit."
      },
      {
        "met_days": 414.773,
        "type": "edl_or_oi",
        "label": "First perilune — in lunar orbit",
        "description": "2004-11-15 17:48 UT. SMART-1 passes its first perilune about 5,000 km above the surface; ESA marks 15 November 2004 as arrival in lunar orbit, 415 days after launch."
      }
    ]
