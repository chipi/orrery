    },
    "events": [
      {
        "met_days": 0,
        "type": "launch",
        "label": "Launch — H-IIA 202",
        "description": "Tanegashima Space Center, 2010-05-20. Shared a launch with the IKAROS solar-sail demonstrator (the first interplanetary solar sail) and three university CubeSats. Akatsuki — \"dawn\" in Japanese — was Japan's first Venus mission, designed for a 30-month primary mission to study Venus atmospheric super-rotation."
      },
      {
        "met_days": 0.005,
        "type": "tli_or_tmi",
        "label": "Trans-Venus injection",
        "description": "H-IIA second stage delivers Akatsuki onto a direct 6-month transfer to Venus. The Orbit Maneuvering Engine (OME) was reserved for the planned VOI."
      },
      {
        "met_days": 30,
        "type": "tcm",
        "label": "TCM-1",
        "description": "First mid-course correction during the nominal 2010 cruise."
      },
      {
        "met_days": 120,
        "type": "tcm",
        "label": "TCM-2",
        "description": "Mid-cruise refinement."
      },
      {
        "met_days": 195,
        "type": "tcm",
        "label": "TCM-3 — final pre-VOI",
        "description": "Final pre-arrival trim."
      },
      {
        "met_days": 201,
        "type": "arrival",
        "label": "Venus approach (first attempt)",
        "description": "2010-12-07. Akatsuki arrives at Venus and begins the planned VOI burn."
      },
      {
        "met_days": 201.005,
        "type": "anomaly",
        "label": "VOI-1 failure — clogged oxidiser check valve",
        "description": "Approximately 152 seconds into the planned 720-second VOI burn, the Orbit Maneuvering Engine throttled off when salt crystal buildup in an oxidiser check valve disrupted the propellant mix and caused asymmetric thrust + attitude tumble. Akatsuki sailed past Venus into solar orbit. Recovery plan: keep the spacecraft alive in solar orbit until the next Venus encounter window (2015 or 2016), then attempt VOI again using the attitude-control thrusters."
      },
      {
        "met_days": 1000,
        "type": "phasing",
        "label": "Solar-orbit hold maneuvers",
        "description": "Twelve correction maneuvers during the 5-year solar-orbit hold to re-phase the heliocentric trajectory for a 2015 Venus re-encounter. The main OME was tested in 2011 and found permanently damaged; planning shifted entirely to RCS-thruster-based VOI."
      },
      {
        "met_days": 2027,
        "type": "arrival",
        "label": "Venus approach (second attempt)",
        "description": "2015-12-07 — five years and one day after the first attempt. Akatsuki arrives at Venus again."
      },
      {
        "met_days": 2027.005,
        "type": "edl_or_oi",
        "label": "Venus orbit insertion — RCS recovery",
        "description": "1228-second burn using four attitude-control thrusters (originally rated for ~50 m/s ∆v; ran 244 m/s) placed Akatsuki into a highly elliptical 400 × 440,000 km, 3°-inclination prograde orbit. JAXA confirmed VOI-R2 success the following day. The recovery is one of the most dramatic mission-saves in spaceflight history. Akatsuki mapped Venus's UV/IR cloud features, confirmed bow-shaped gravity waves above Aphrodite Terra, and provided continuous super-rotation tracking until contact was lost in 2024. JAXA declared operations complete on 2025-09-18."
      }
    ],
