{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "audio-provenance.schema.json",
  "title": "Audio provenance manifest (PRD-016 / RFC-019 §5.4)",
  "description": "Per-audio-asset attribution: provider, voice ID, generation timestamp, char count. Generated by scripts/audio/generate.ts (S3) and consumed by validate-data + /credits. Parallel to image-provenance.json (ADR-047) for the audio corpus.",
  "type": "object",
  "required": ["schema_version", "generated_at", "script_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "script_version": { "type": "string", "description": "build-audio-provenance@semver" },
    "commit_sha": { "type": ["string", "null"] },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "episode_id",
        "locale",
        "persona",
        "provider",
        "voice_id",
        "tts_model",
        "path_mp3",
        "path_vtt",
        "path_txt",
        "chars",
        "generated_at",
        "text_authorship"
      ],
      "additionalProperties": false,
      "properties": {
        "episode_id": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "persona": { "type": "string", "enum": ["curator", "guide", "enthusiast"] },
        "provider": {
          "type": "string",
          "enum": ["google", "elevenlabs", "openai", "azure", "coqui-local"]
        },
        "voice_id": { "type": "string", "minLength": 1 },
        "tts_model": {
          "type": "string",
          "minLength": 1,
          "description": "Provider-specific model identifier (e.g. neural2, eleven_multilingual_v2). Always written by the pipeline; surfaced on /credits."
        },
        "route": {
          "type": "string",
          "pattern": "^/[a-z-]*$",
          "description": "Orrery route this episode anchors to (e.g. /, /mars, /moon). Used by AudioOverlay to filter 'for this screen' inventory."
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "description": "Optional sub-context within the route (e.g. 'curiosity', 'apollo-17', 'tour-open')."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable episode title, displayed in the AudioOverlay header + inventory."
        },
        "duration_target_sec": {
          "type": "integer",
          "minimum": 30,
          "description": "Authoring-time target duration in seconds. Useful for cost projections + inventory layout."
        },
        "path_mp3": { "type": "string", "pattern": "^/audio/.+\\.mp3$" },
        "path_vtt": { "type": "string", "pattern": "^/audio/.+\\.vtt$" },
        "path_txt": { "type": "string", "pattern": "^/audio/.+\\.txt$" },
        "chars": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "text_authorship": {
          "type": "string",
          "enum": [
            "claude-drafted",
            "claude-translated",
            "human-authored",
            "human-edited-claude-draft"
          ],
          "description": "Origin of the text being voiced. Surfaced on /credits + in the AudioOverlay footer — AI involvement is disclosed by default."
        },
        "text_author_model": {
          "type": "string",
          "minLength": 1,
          "description": "Optional model identifier when text_authorship references an LLM (e.g. claude-opus-4-7)."
        }
      }
    }
  }
}
