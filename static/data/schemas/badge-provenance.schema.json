{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badge-provenance.schema.json",
  "title": "Badge provenance (one record per shipped badge asset)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "path",
      "source_type",
      "title",
      "agency",
      "artifact",
      "image_url",
      "source_url",
      "author",
      "license_short",
      "license_url"
    ],
    "additionalProperties": true,
    "properties": {
      "path": {
        "type": "string",
        "pattern": "^/images/badges/.+\\.webp$"
      },
      "source_type": {
        "type": "string",
        "description": "Where the badge was fetched: Wikimedia Commons, or the agency's own site when Commons has no (or no longer has a) copy (e.g. MMX, 2026-11-02).",
        "enum": ["wikimedia-commons", "agency-site"]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "agency": {
        "type": "string",
        "minLength": 1
      },
      "artifact": {
        "type": "string",
        "const": "badge"
      },
      "image_url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "source_url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "author": {
        "type": "string",
        "minLength": 1
      },
      "license_short": {
        "type": "string",
        "minLength": 1
      },
      "license_url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      }
    }
  }
}
