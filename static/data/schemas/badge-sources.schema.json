{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badge-sources.schema.json",
  "title": "Badge sources (mission-patch / program-logo source list)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "kind",
      "id",
      "name",
      "image_url",
      "source_url",
      "author",
      "license_short",
      "license_url"
    ],
    "additionalProperties": true,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "program",
          "mission",
          "fleet"
        ]
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "image_url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "source_url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "author": {
        "type": "string",
        "minLength": 1
      },
      "license_short": {
        "type": "string",
        "minLength": 1
      },
      "license_url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      }
    }
  }
}
