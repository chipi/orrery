{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hero-overrides.schema.json",
  "title": "Hero-image override manifest",
  "description": "Shared by fleet-/mars-sites-/missions-/moon-sites-/planets-/satellites-/small-bodies-hero-overrides.json. Maps an entity id to the gallery slot promoted as its hero image, with the reason and approval date. generated_at only exists on the audit-generated files (fleet, mars-sites, missions, moon-sites); overrides may be empty.",
  "type": "object",
  "required": [
    "version",
    "source_audit",
    "overrides"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_audit": {
      "type": "string",
      "minLength": 1
    },
    "overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/override"
      }
    }
  },
  "$defs": {
    "override": {
      "type": "object",
      "required": [
        "slot",
        "reason",
        "approved_at"
      ],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.jpg$",
          "description": "Gallery slot filename, e.g. 03.jpg"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
