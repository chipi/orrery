{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lab-illustration-provenance.schema.json",
  "title": "Provenance for generated Lab illustrations",
  "type": "object",
  "required": [
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "goalId",
          "model",
          "tool",
          "generated",
          "operator_approved"
        ],
        "additionalProperties": false,
        "properties": {
          "goalId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "generated": {
            "type": "string",
            "format": "date"
          },
          "operator_approved": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
