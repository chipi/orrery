{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lab-illustrations.schema.json",
  "title": "Physics Lab goal illustrations manifest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "goalId",
      "file",
      "altKey",
      "model",
      "generated"
    ],
    "additionalProperties": false,
    "properties": {
      "goalId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "file": {
        "type": "string",
        "pattern": "^images/lab/goals/.+\\.webp$"
      },
      "altKey": {
        "type": "string",
        "pattern": "^lab\\.illustration\\.alt\\..+$"
      },
      "model": {
        "type": "string",
        "minLength": 1
      },
      "generated": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
