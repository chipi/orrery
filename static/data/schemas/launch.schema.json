{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orrery.local/schemas/launch.schema.json",
  "title": "Launches manifest (PRD-020 / RFC-023)",
  "description": "Manifest of upcoming OR historic launches with multi-source provenance chain. Generated by scripts/fetch-launches.ts from agency-direct sources (priority 10-16), GCAT (priority 20), and LL2 fallback (priority 90). Keyed by stable Orrery-internal id: {YYYY-MM-DD}-{rocket-family-slug}-{mission-slug}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "sources_active", "entries"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generated_at": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "sources_active": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "gcat_release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gcat_data_update": { "type": "string", "format": "date" },
    "entries": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*-[a-z0-9][a-z0-9-]*(-[0-9]+)?$": {
          "$ref": "#/definitions/LaunchEntry"
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "LaunchEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "net",
        "net_precision",
        "status",
        "name",
        "agency_name",
        "rocket_config_name",
        "rocket_family",
        "tier",
        "tier_reason",
        "provenance_chain",
        "fetched_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*-[a-z0-9][a-z0-9-]*(-[0-9]+)?$"
        },
        "net": { "type": "string", "format": "date-time" },
        "net_precision": {
          "type": "string",
          "enum": ["second", "minute", "hour", "day", "month", "year"]
        },
        "window_start": { "type": "string", "format": "date-time" },
        "window_end": { "type": "string", "format": "date-time" },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "label"],
          "properties": {
            "code": {
              "type": "string",
              "enum": ["GO", "TBD", "SUCCESS", "FAILURE", "PARTIAL", "HOLD", "IN_FLIGHT"]
            },
            "label": { "type": "string", "minLength": 1 }
          }
        },
        "name": { "type": "string", "minLength": 1 },
        "mission_name": { "type": "string" },
        "mission_type": { "type": "string" },
        "orbit_abbrev": { "type": "string" },
        "orbit_name": { "type": "string" },
        "agency_id": { "type": "string" },
        "agency_name": { "type": "string", "minLength": 1 },
        "agency_type": {
          "type": "string",
          "enum": ["Government", "Commercial", "Educational", "Multinational", "Unknown"]
        },
        "country": { "type": "string" },
        "rocket_config_id": { "type": "string" },
        "rocket_config_name": { "type": "string", "minLength": 1 },
        "rocket_family": { "type": "string", "minLength": 1 },
        "orrery_launcher_ref": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "orrery_mission_ref": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
          "description": "Best-effort backlink to one of the 37 hand-curated catalogue missions in static/data/missions/index.json. Set by the orchestrator when the launch entry's name + mission_name normalises to contain a catalog id AND the year matches exactly. False-positives must NOT happen — heuristic is intentionally narrow (PRD-020 M17)."
        },
        "pad_name": { "type": "string" },
        "pad_location": { "type": "string" },
        "image_url": { "type": "string" },
        "image_credit": { "type": "string" },
        "tier": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] },
        "tier_reason": {
          "type": "string",
          "enum": [
            "featured-override",
            "demoted-override",
            "crewed",
            "interplanetary",
            "lunar",
            "cislunar",
            "heliocentric",
            "mars",
            "venus",
            "moon",
            "first-flight-vehicle",
            "first-flight-pad",
            "reusable-milestone",
            "agency-debut",
            "routine-constellation",
            "standard"
          ]
        },
        "editorial_note": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "webcast_live": { "type": "boolean" },
        "provenance_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "role", "fetched_at"],
            "properties": {
              "source": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "source_url": { "type": "string", "format": "uri" },
              "fetched_at": { "type": "string", "format": "date-time" },
              "role": {
                "type": "string",
                "enum": ["primary", "confirmed-via", "augmented-with", "fallback-primary"]
              }
            }
          }
        },
        "fetched_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
