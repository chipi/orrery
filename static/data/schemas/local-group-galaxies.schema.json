{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "local-group-galaxies.schema.json",
  "title": "Local Group galaxies (/explore celestial-sphere sprites)",
  "type": "object",
  "required": [
    "version",
    "description",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ra",
          "dec",
          "distance_kpc",
          "type",
          "group",
          "science_section",
          "wikidata"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ra": {
            "type": "number",
            "minimum": 0,
            "maximum": 360,
            "description": "J2000 right ascension, decimal degrees"
          },
          "dec": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "J2000 declination, decimal degrees"
          },
          "distance_kpc": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "spiral",
              "irregular",
              "dwarf-spheroidal"
            ]
          },
          "group": {
            "type": "string",
            "enum": [
              "andromeda-subgroup",
              "milky-way-subgroup",
              "free"
            ]
          },
          "science_section": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "wikidata": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          }
        }
      }
    }
  }
}
