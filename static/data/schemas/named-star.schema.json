{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "named-star.schema.json",
  "title": "Curated named-star catalog (PRD-030 / RFC-032, Slice 1)",
  "description": "The ~60 notable stars that get a marker + label + Panel in /explore v2. Base record resolved from HYG by IAU proper name; per-locale editorial overlays live under i18n-src/<locale>/universe/named-stars/<id>.json.",
  "type": "object",
  "required": ["schema_version", "generated_at", "script_version", "catalog", "count", "stars"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "script_version": { "type": "string", "minLength": 1 },
    "catalog": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 1 },
    "stars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "hip", "proper", "con", "spect", "dist_pc", "mag", "absmag", "bv", "x", "y", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "hip": { "type": ["integer", "null"] },
          "proper": { "type": "string", "minLength": 1 },
          "con": { "type": ["string", "null"], "minLength": 2 },
          "spect": { "type": ["string", "null"] },
          "dist_pc": { "type": "number", "exclusiveMinimum": 0 },
          "mag": { "type": "number" },
          "absmag": { "type": "number" },
          "bv": { "type": ["number", "null"] },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        }
      }
    }
  }
}
