{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "observatory-overlay.schema.json",
  "title": "ObservatoryOverlay",
  "description": "Per-locale text for one observatory (PRD-028): name, place, a short description, highlights, and a film line when the base lists films.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "place", "description", "highlights"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "place": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "film": { "type": "string", "minLength": 1 }
  }
}
