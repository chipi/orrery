{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "observatory.schema.json",
  "title": "Observatories",
  "description": "Observatories on Earth (PRD-028): radio and optical observatories, Deep Space Network complexes and SETI sites, shown as pins on /earth and linked from /science. Text per locale lives in i18n-src/{locale}/observatories/{id}.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "country", "lat", "lon", "website", "kind", "status", "science", "evidence"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
      "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "lat": { "type": "number", "minimum": -90, "maximum": 90 },
      "lon": { "type": "number", "minimum": -180, "maximum": 180 },
      "website": { "type": "string", "pattern": "^https://" },
      "kind": { "type": "string", "enum": ["radio", "optical", "deep-space", "seti"] },
      "status": { "type": "string", "enum": ["active", "historic", "building"] },
      "since": { "type": "string", "pattern": "^[0-9]{4}$" },
      "science": {
        "type": "array",
        "items": { "type": "string", "pattern": "^/science/[a-z0-9-]+/[a-z0-9-]+$" }
      },
      "films": {
        "type": "array",
        "items": { "type": "string", "enum": ["contact", "the-dish"] }
      },
      "evidence": { "type": "string", "pattern": "^https://" }
    }
  }
}
