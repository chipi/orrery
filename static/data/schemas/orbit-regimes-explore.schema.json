{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orbit-regimes-explore.schema.json",
  "title": "Solar-system distance bands for /explore",
  "description": "distance_au is either a single distance or a [low, high] band; 0 is the Sun.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "distance_au",
      "color"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      },
      "distance_au": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            },
            "description": "[low, high] band"
          }
        ]
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    }
  },
  "uniqueItems": true
}
