{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "site-illustrations.schema.json",
  "title": "Illustrated site maps (surface-site block dioramas)",
  "type": "object",
  "required": ["illustrations"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "illustrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["siteId", "body", "title", "file", "model", "tool", "generated", "made_from"],
        "additionalProperties": false,
        "properties": {
          "siteId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "body": { "enum": ["moon", "mars"] },
          "title": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^images/illustrations/sites/[a-z0-9-]+\\.webp$" },
          "model": { "type": "string", "minLength": 1 },
          "tool": { "type": "string", "minLength": 1 },
          "generated": { "type": "string", "format": "date" },
          "made_from": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
