{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "site-stories-index.schema.json",
  "title": "Site stories index",
  "type": "object",
  "required": [
    "ids"
  ],
  "additionalProperties": false,
  "properties": {
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    }
  }
}
