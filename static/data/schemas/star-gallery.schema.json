{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "star-gallery.schema.json",
  "title": "Second and further images of a named star (B3, UXD-023)",
  "description": "Language-neutral list per star id. The first image of a star stays the overlay's photo (the hero); these follow it in the panel's GALLERY tab, which shows only when the star has at least two images in all. Empty at ship: no star has a second image yet.",
  "type": "object",
  "required": ["schema_version", "stars"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "stars": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["src", "kind"],
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string", "pattern": "^/images/stars/.+\\.webp$" },
            "kind": { "enum": ["real", "artist"] }
          }
        }
      }
    }
  }
}
