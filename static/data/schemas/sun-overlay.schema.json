{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sun-overlay.schema.json",
  "title": "SunOverlay",
  "description": "Editorial overlay for the Sun per locale (ADR-017). One file at data/i18n/[locale]/sun.json. Merged with sun.json at fetch time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "type",
    "fact",
    "bio"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "One-line classification (e.g., \"STAR · G-type main sequence\")."
    },
    "fact": {
      "type": "string",
      "minLength": 1,
      "description": "One-paragraph editorial summary surfaced in the OVERVIEW tab."
    },
    "bio": {
      "type": "string",
      "minLength": 1,
      "description": "Editorial paragraph contextualising the astrophysical figures shown in the TECHNICAL tab."
    },
    "links": {
      "type": "array",
      "description": "Tiered learn-more links for the LEARN tab (v0.1.10). Same shape as mission.links — intro / core / deep tiers.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "l",
          "u",
          "t"
        ],
        "properties": {
          "l": {
            "type": "string",
            "minLength": 1
          },
          "u": {
            "type": "string",
            "format": "uri"
          },
          "t": {
            "enum": [
              "intro",
              "core",
              "deep"
            ]
          }
        }
      }
    },
    "science_sections": {
      "type": "array",
      "description": "Per-body curated science-card selection rendered in the OVERVIEW tab. Each entry points to /science/<tab>/<section> with an optional one-line per-body why prefix translated per locale.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tab",
          "section"
        ],
        "properties": {
          "tab": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
