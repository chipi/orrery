{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "traverse-route-patches.schema.json",
  "title": "Rover traverse HiRISE/LROC route patches (<rover>.route-patches.json)",
  "type": "object",
  "required": [
    "rover_id",
    "patches"
  ],
  "additionalProperties": false,
  "properties": {
    "rover_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lat",
          "lon",
          "kind",
          "image",
          "product_id",
          "resolution_m_per_px",
          "ground_m"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "kind": {
            "type": "string",
            "enum": [
              "drill",
              "feature",
              "panorama",
              "route",
              "helicopter",
              "sample"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "pattern": "^/images/hotspots/.+"
          },
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "resolution_m_per_px": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ground_m": {
            "type": "integer",
            "minimum": 1
          },
          "instrument": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
