{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "traverse-route-photos.schema.json",
  "title": "Rover photos pinned on the traverse (<rover>.route-photos.json, #641)",
  "type": "object",
  "required": ["rover_id", "photos"],
  "additionalProperties": false,
  "properties": {
    "rover_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "photos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sol", "lat", "lon", "image", "thumb"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "sol": { "type": "integer", "minimum": 0 },
          "sol_approx": { "type": "boolean" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "image": { "type": "string", "pattern": "^/images/.+\\.webp$" },
          "thumb": { "type": "string", "pattern": "^/images/.+\\.webp$" }
        }
      }
    }
  }
}
