{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "traverse.schema.json",
  "title": "Rover traverse polyline (mars-traverses/ + moon-traverses/)",
  "description": "points are [lat, lon] pairs. stops is optional (absent on rovers without curated stops).",
  "type": "object",
  "required": [
    "rover_id",
    "agency",
    "status",
    "snapshot_date",
    "credit",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "rover_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "agency": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "ENDED"
      ]
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "credit": {
      "type": "string",
      "minLength": 1
    },
    "has_route_patches": {
      "type": "boolean"
    },
    "has_route_photos": {
      "description": "A <rover>.route-photos.json sidecar exists (#641).",
      "type": "boolean"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": [
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        ],
        "additionalItems": false
      }
    },
    "point_sols": {
      "description": "The sol each point was reached on, one per point (#641).",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "length_km": {
      "description": "Distance driven, the mission's own figure (#641).",
      "type": "number",
      "minimum": 0
    },
    "last_sol": {
      "description": "Last sol with contact (ended) or of the latest drive (active).",
      "type": "integer",
      "minimum": 0
    },
    "landing_sol": {
      "description": "The sol number of landing day: 1 for MER, 0 for MSL / M2020.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "point_elev_m": {
      "description": "Elevation (m above the areoid) at each point (#641).",
      "type": "array",
      "items": { "type": "number" }
    },
    "elev_source": {
      "description": "Where point_elev_m comes from (rover waypoints or a DEM).",
      "type": "string"
    },
    "point_sols_approx": {
      "description": "True when point_sols are interpolated, not recorded.",
      "type": "boolean"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "lat",
          "lon"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "drill",
              "feature",
              "panorama",
              "helicopter",
              "sample"
            ]
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "sol": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
