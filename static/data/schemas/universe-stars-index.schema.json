{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "universe-stars-index.schema.json",
  "title": "Universe star-field shell index (PRD-030 / RFC-032, Slice 0)",
  "description": "Manifest for the tiled HYG star field under static/data/universe/stars/. Generated by scripts/build-universe-stars.ts; consumed by the /explore v2 PointField loader and validate-universe-stars.",
  "type": "object",
  "required": ["schema_version", "generated_at", "script_version", "catalog", "star_count", "shells"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "script_version": { "type": "string", "minLength": 1 },
    "catalog": { "type": "string", "minLength": 1 },
    "star_count": { "type": "integer", "minimum": 0 },
    "shells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shell", "r_min_pc", "r_max_pc", "count", "file"],
        "additionalProperties": false,
        "properties": {
          "shell": { "type": "integer", "minimum": 0 },
          "r_min_pc": { "type": "number", "minimum": 0 },
          "r_max_pc": { "type": ["number", "null"], "minimum": 0 },
          "count": { "type": "integer", "minimum": 0 },
          "file": { "type": "string", "pattern": "^shell-\\d{3}\\.json$" }
        }
      }
    }
  }
}
