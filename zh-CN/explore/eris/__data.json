{"type":"data","nodes":[null,{"type":"data","data":[{"body":1,"facts":22,"science":40},{"id":2,"kind":3,"name":4,"type":-1,"fact":-1,"text":5,"visits":6,"stats":7,"science":14},"eris","small-body","阋神星","已知质量最大的矮行星——半径略小于冥王星，质量却大出约27%。2005年的发现促使国际天文学联合会在2006年正式确立“矮行星”这一类别，同时将冥王星降级。它位于离散盘，轨道倾角大、偏心率高，远日点超过97 AU。",[],{"semiMajorAxisAu":8,"eccentricity":9,"inclinationDeg":10,"periodDays":11,"radiusKm":12,"discovered":13},67.78,0.4407,44.04,203830,1163,"2005",[15,19],{"tab":16,"section":17,"why":18},"orbits","inclination","厄里斯44°的轨道倾角是已编目大天体中最高的之一——其散射盘起源使其远离黄道面。",{"tab":16,"section":20,"why":21},"apsides","冥王星外天体厄里斯在近日点处距太阳 38 AU，在远日点处距太阳 97 AU——平均轨道约 68 AU（半长轴）。它在 1977 年前后通过远日点，目前正缓慢向太阳靠近。",[23,26,29,32,35,38],{"label":24,"value":25},"半长轴","67.780 AU",{"label":27,"value":28},"离心率","0.4407",{"label":30,"value":31},"轨道倾角","44.04°",{"label":33,"value":34},"轨道周期","203,830 天",{"label":36,"value":37},"半径","1,163 km",{"label":39,"value":13},"发现时间",[41,44],{"href":42,"title":30,"intro":43,"why":18},"/science/orbits/inclination","轨道平面相对于参考平面的倾斜角度——通常以黄道面或地球赤道面为参考。",{"href":45,"title":46,"intro":47,"why":21},"/science/orbits/apsides","拱点 — 近日点、远日点、近地点、远地点","椭圆轨道上的两个极值点：最近距离和最远距离。"],"uses":{"params":["id"]}}]}
