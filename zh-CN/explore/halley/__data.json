{"type":"data","nodes":[null,{"type":"data","data":[{"body":1,"facts":22,"science":40},{"id":2,"kind":3,"name":4,"type":-1,"fact":-1,"text":5,"visits":6,"stats":7,"science":14},"halley","small-body","哈雷彗星","最著名的短周期彗星，约每76年从地球上可见一次。埃德蒙·哈雷根据牛顿的引力理论，正确预言了它在1759年的回归，这是历史上第一次此类预报。ESA的Giotto于1986年飞到距彗核600 km以内，传回了首张彗核的近距离图像。下次回归在2061年。",[],{"semiMajorAxisAu":8,"eccentricity":9,"inclinationDeg":10,"periodDays":11,"radiusKm":12,"discovered":13},17.834,0.967,162.3,27520,5.5,"Antiquity (named 1705)",[15,19],{"tab":16,"section":17,"why":18},"orbits","eccentricity","哈雷彗星的偏心率0.967是典型的短周期彗星轨道——近似抛物线，近日点0.59 AU，远日点35 AU。",{"tab":16,"section":20,"why":21},"apsides","哈雷彗星巨大的近日点-远日点变化（35至0.59 AU）驱动表面冰升华，在近日点附近产生剧烈喷发、形成彗发和彗尾。下次近日点：2061年。",[23,26,29,32,35,38],{"label":24,"value":25},"半长轴","17.834 AU",{"label":27,"value":28},"离心率","0.9670",{"label":30,"value":31},"轨道倾角","162.30°",{"label":33,"value":34},"轨道周期","27,520 天",{"label":36,"value":37},"半径","6 km",{"label":39,"value":13},"发现时间",[41,44],{"href":42,"title":27,"intro":43,"why":18},"/science/orbits/eccentricity","轨道被拉伸的程度——零是完美的圆形，一是抛物线逃逸。",{"href":45,"title":46,"intro":47,"why":21},"/science/orbits/apsides","拱点 — 近日点、远日点、近地点、远地点","椭圆轨道上的两个极值点：最近距离和最远距离。"],"uses":{"params":["id"]}}]}
