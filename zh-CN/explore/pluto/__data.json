{"type":"data","nodes":[null,{"type":"data","data":[{"body":1,"facts":16,"science":32},{"id":2,"kind":3,"name":4,"type":5,"fact":6,"text":7,"visits":8,"stats":9,"science":15},"pluto","planet","冥王星","矮行星 · 柯伊伯带","已知最大的柯伊伯带天体,也是海王星轨道外第一个被发现的天体(1930年)。2006年被IAU从行星重新分类为矮行星。","冥王星的248年轨道具有高度偏心率(e = 0.249),且相对黄道面倾斜17°——因此其轨道在每个周期中有20年会进入海王星轨道内侧,并大幅升至行星平面上方。表面温度变化幅度极大,使得稀薄的氮气大气层在近日点附近增厚,而在远日点附近冻结回到表面。与冥卫一的相互潮汐锁定使这对天体成为真正的双星系统。",[],{"semiMajorAxisAu":10,"eccentricity":11,"inclinationDeg":12,"periodDays":13,"axialTiltDeg":14},39.482,0.2488,17.16,90560,122.53,[],[17,20,23,26,29],{"label":18,"value":19},"半长轴","39.482 AU",{"label":21,"value":22},"离心率","0.2488",{"label":24,"value":25},"轨道倾角","17.16°",{"label":27,"value":28},"轨道周期","90,560 天",{"label":30,"value":31},"自转轴倾角","122.53°",[]],"uses":{"params":["id"]}}]}
