{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":27,"alongside":28,"kin":29,"engines":54,"usedOn":55,"sites":60,"crewed":61,"museums":62,"hero":63},"https://www.orrerylearn.com/images/cards/fleet/ce-20.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"credit":19,"links":20,"tagline":25,"description":26},"ce-20","CE-20","engine","ISRO","India","ISRO (LPSC)","2017-06-05","ACTIVE","2011-now","commercial-era","印度首个自主研制的低温发动机——LVM3上面级的动力心脏",{"cycle":15,"propellant":16,"thrust_kn_vac":17,"isp_vac_s":18},"gas-generator","LOX / LH2",200,443,"Engine registry (PRD-032). Public-source nominal specs; ISRO imagery.",[21],{"l":22,"u":23,"t":24},"CE-20 — Wikipedia","https://en.wikipedia.org/wiki/CE-20","intro","印度首个自主研制的低温发动机，因形势所迫而诞生","20世纪90年代初，技术转让限制使印度无法获得低温发动机技术，ISRO的Liquid Propulsion Systems Centre因此从零开始自主研制。CE-20就是成果：采用燃气发生器循环，燃烧LOX和LH2，为印度最重的在役运载火箭LVM3的上面级提供动力。它于2017年6月5日在GSLV Mk III D1发展型飞行中首次升空，为历时二十年的研制计划画上句号——一道地缘政治的壁垒由此化为独立自主的能力。CE-20将把印度首次载人任务Gaganyaan送入轨道。",[],[],[30,34,38,42,46,50],{"id":31,"name":32,"tagline":33},"vikas","Vikas","印度的授权Viking——三十年为PSLV和GSLV提供动力",{"id":35,"name":36,"tagline":37},"yf-77","YF-77","中国首台大型液氢发动机——长征五号的基础",{"id":39,"name":40,"tagline":41},"yf-100","YF-100","中国分级燃烧液氧煤油发动机，为新一代火箭提供动力",{"id":43,"name":44,"tagline":45},"merlin-1d","Merlin 1D","九台引擎、一枚助推器，飞行并重复使用数十次",{"id":47,"name":48,"tagline":49},"le-9","LE-9","迄今为止最大的膨胀循环发动机——为H3火箭提供动力",{"id":51,"name":52,"tagline":53},"raptor","Raptor","全流量分级燃烧——最难的循环，终于升空",[],[56],{"id":57,"name":58,"tagline":59},"lvm3","LVM3 (GSLV Mk III)","Gaganyaan的机组级发射器",[],[],[],"/orrery/images/fleet-galleries/ce-20/01.webp"],"uses":{"params":["id"]}}]}
