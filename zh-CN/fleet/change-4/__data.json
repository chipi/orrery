{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":39,"kin":48,"engines":73,"usedOn":74,"sites":75,"crewed":80,"museums":81,"hero":82},null,{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":30,"tagline":13,"description":33},"change-4","嫦娥四号","lander","CNSA","China","CAST","2019-01-03","ACTIVE","2011-now","commercial-era","月球最远处第一次软着陆","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Chang'e 4 — Wikipedia","https://en.wikipedia.org/wiki/Chang%27e_4","intro",{"l":21,"u":22,"t":23},"嫦娥四号 — CNSA","https://www.cnsa.gov.cn/","core",{"l":25,"u":26,"t":27},"Chang'e 4 — NASA NSSDCA","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=2018-103A","deep",[29],"change4",[31],{"type":32,"site_id":29},"moon","首次在月球背面成功软着陆（2019年1月）。需要在地月L2点部署一颗中继卫星鹊桥来维持通信。此后，玉兔二号已在冯·卡门环形山的地形上巡视多年。",[35],{"id":29,"name":36,"first":37,"year":38},"嫦娥四号 / 玉兔二号","月球背面首次软着陆",2018,[40,44],{"id":41,"name":42,"tagline":43},"long-march-3b","长征三号B","中国的地球同步转移轨道主力火箭——嫦娥月球着陆器和大多数中国通信卫星",{"id":45,"name":46,"tagline":47},"yutu-2","玉兔二号","月球背面首个月球车；嫦娥四号",[49,53,57,61,65,69],{"id":50,"name":51,"tagline":52},"change-5","嫦娥五号","自1976年以来首次月球样本返回",{"id":54,"name":55,"tagline":56},"change6","嫦娥六号","首次月球背面采样返回。Apollo盆地着陆于2024-06-01（UTC）；1935克样品于2024-06-25返回内蒙古",{"id":58,"name":59,"tagline":60},"change-3","嫦娥三号","中国第一艘月球着陆器",{"id":62,"name":63,"tagline":64},"beresheet","Beresheet","首次私人月球着陆尝试",{"id":66,"name":67,"tagline":68},"vikram-cy2","Vikram (Chandrayaan-2)","印度Chandrayaan-2的着陆器；2019年坠毁，但轨道器继续运行",{"id":70,"name":71,"tagline":72},"insight","InSight","火星地震仪；已探测到1300多次火星地震",[],[],[76],{"type":32,"href":77,"name":36,"place":78,"text":79},"/moon/change4","冯·卡门环形山","首个成功在月球背面着陆的航天器——从技术和运营角度而言，这是迄今为止难度最高的月球着陆任务。由于月球背面无法与地球直接通信，需要在L2位置部署中继卫星（鹊桥）提供通信支持。玉兔二号漫游车行驶超过1.6 km后于2024年3月进入静止状态；遥测数据传输至少持续到2024年9月。月球背面从未被访问过。",[],[],"/orrery/images/fleet-galleries/change-4/01.webp"],"uses":{"params":["id"]}}]}
