{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":33,"alongside":38,"kin":43,"engines":68,"usedOn":69,"sites":70,"crewed":75,"museums":76,"hero":77},null,{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":29,"tagline":13,"description":32},"curiosity","Curiosity (MSL)","rover","NASA","USA","NASA JPL","2012-08-06","ACTIVE","2011-now","commercial-era","核动力火星科学实验室火星车","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Curiosity (rover) — Wikipedia","https://en.wikipedia.org/wiki/Curiosity_(rover)","intro",{"l":21,"u":22,"t":23},"Mars Science Laboratory — NASA JPL","https://mars.nasa.gov/msl/","core",{"l":25,"u":26,"t":27},"MSL Mission Profile (NASA NTRS)","https://mars.nasa.gov/internal_resources/788/","deep",[3],[30],{"type":31,"site_id":3},"mars","NASA的核动力火星科学实验室漫游车，自2012年8月起在火星上工作。发现了有机分子、古老的溪流床环境，以及火星盖尔撞击坑过去适宜居住的证据。十多年后仍在运作。",[34],{"id":3,"name":35,"first":36,"year":37},"Curiosity","首辆核动力火星车；首次采用天空起重机着陆",2011,[39],{"id":40,"name":41,"tagline":42},"atlas-v","Atlas V","United Launch Alliance的改进型Atlas",[44,48,52,56,60,64],{"id":45,"name":46,"tagline":47},"opportunity","Opportunity (MER-B)","Spirit的孪生探测器；在火星上运行近15年",{"id":49,"name":50,"tagline":51},"spirit","Spirit (MER-A)","火星探测漫游车;运作6年",{"id":53,"name":54,"tagline":55},"perseverance","Perseverance（Mars 2020）","携带Ingenuity直升机；火星样品封存",{"id":57,"name":58,"tagline":59},"sojourner","Sojourner","火星漫游车；Pathfinder任务",{"id":61,"name":62,"tagline":63},"lrv-apollo","月球车","首次载人月球车；Apollo 15、16、17",{"id":65,"name":66,"tagline":67},"promise","PROMISE","NASA 为月球南极拟议的月球车",[],[],[71],{"type":31,"href":72,"name":35,"place":73,"text":74},"/mars/curiosity","盖尔撞击坑（伊奥利亚山／夏普山）","火星科学实验室。由放射性同位素热电发电机供电（无需依赖太阳能），车身与汽车相当（899千克），着陆后十多年来仍在正常运行。已确认盖尔陨石坑在遥远的过去曾为宜居湖泊环境。正在攀登夏普山的地层序列——一个十亿年接着一个十亿年地读取火星的环境历史。",[],[],"/orrery/images/fleet-galleries/curiosity/01.webp"],"uses":{"params":["id"]}}]}
