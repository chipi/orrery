{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":32,"alongside":33,"kin":34,"engines":59,"usedOn":60,"sites":61,"crewed":65,"museums":66,"hero":67},"https://www.orrerylearn.com/images/cards/fleet/gaia.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_sites":28,"tagline":13,"description":31},"gaia","Gaia","observatory","ESA","Multi (Europe)","Airbus Defence and Space","2013-12-19","RETIRED","2011-now","commercial-era","三维恒星增18亿","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Gaia (spacecraft) — Wikipedia","https://en.wikipedia.org/wiki/Gaia_(spacecraft)","intro",{"l":21,"u":22,"t":23},"Gaia — ESA","https://www.esa.int/Science_Exploration/Space_Science/Gaia","core",{"l":25,"u":26,"t":27},"Gaia Mission Documentation (ESA)","https://gea.esac.esa.int/archive/documentation/","deep",[29],{"type":30,"site_id":3},"earth-object","ESA 的恒星测绘卫星，以前所未有的精度绘制银河系中近 20 亿颗恒星的位置、亮度和运动。运行于 2013–2025 年；由此产生的星表将在未来数十年支撑银河系天文学。",[],[],[35,39,43,47,51,55],{"id":36,"name":37,"tagline":38},"euclid","Euclid","跨越三分之一天空的暗能量巡天",{"id":40,"name":41,"tagline":42},"xmm-newton","XMM-Newton","ESA的旗舰X射线观测站",{"id":44,"name":45,"tagline":46},"hitomi","Hitomi (ASTRO-H)","在轨解体；其损失推动了XRISM的开发",{"id":48,"name":49,"tagline":50},"kepler","Kepler","发现了 2,700+ 颗系外行星",{"id":52,"name":53,"tagline":54},"tess","TESS","全天系外行星凌星巡天",{"id":56,"name":57,"tagline":58},"spektr-rg","Spektr-RG","俄德X射线全天巡天观测站",[],[],[62],{"type":30,"href":63,"name":4,"place":-1,"text":64},"/earth?id=gaia","ESA位于L2的恒星制图仪。绘制18亿颗恒星的地图——位置测量精度达到7微角秒。可精确测量距离30,000光年远处恒星的距离，精度相当于1,000 km外人类毛发的宽度。迄今最详细的银河系地图。",[],[],"/orrery/images/fleet-galleries/gaia/01.webp"],"uses":{"params":["id"]}}]}
