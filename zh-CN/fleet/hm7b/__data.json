{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":29,"alongside":30,"kin":31,"engines":56,"usedOn":57,"sites":66,"crewed":67,"museums":68,"hero":69},"https://www.orrerylearn.com/images/cards/fleet/hm7b.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"last_flight":10,"status":11,"era":12,"epoch":13,"best_known_for":14,"specs":15,"credit":21,"links":22,"tagline":27,"description":28},"hm7b","HM7B","engine","ESA","Europe","Snecma (Safran)","1986-05-31","2023-07-05","RETIRED","1981-2011","shuttle-and-mir","欧洲低温上面级发动机——Ariane的地月转移主力",{"cycle":16,"propellant":17,"thrust_kn_vac":18,"isp_vac_s":19,"mass_kg":20},"gas-generator","LOX / LH2",64.7,446,165,"Engine registry (PRD-032). Public-source nominal specs; ESA imagery.",[23],{"l":24,"u":25,"t":26},"HM7B — Wikipedia","https://en.wikipedia.org/wiki/HM7B","intro","阿丽亚娜火箭的低温上面级，服役三十余年","HM7B是以液氢为燃料的上面级发动机，在芯级关机后为Ariane火箭提供高能推进。该发动机采用燃气发生器循环，使用LOX和LH2，1986年5月首次在Ariane 2上飞行，一直服役到2023年7月Ariane 5运营结束。它体积小巧，却有很高的比冲，成为地球同步转移轨道入轨的主力发动机，三十多年间把商业卫星和科学有效载荷——包括Rosetta、Mars Express和Venus Express——送上出发轨道。",[],[],[32,36,40,44,48,52],{"id":33,"name":34,"tagline":35},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",{"id":37,"name":38,"tagline":39},"rs-25","RS-25 (SSME)","可重复使用、氢燃料驱动，仍在SLS上飞行",{"id":41,"name":42,"tagline":43},"vikas","Vikas","印度的授权Viking——三十年为PSLV和GSLV提供动力",{"id":45,"name":46,"tagline":47},"viking","Viking","法国引擎，印度的主力发动机",{"id":49,"name":50,"tagline":51},"rd-180","RD-180","俄罗斯富氧分级燃烧技术——美国无法复制",{"id":53,"name":54,"tagline":55},"le-5b","LE-5B","日本可重启的上面级，应用于H-IIA至H3运载火箭",[],[58,62],{"id":59,"name":60,"tagline":61},"ariane-5","Ariane 5","发射了Rosetta、JWST、Galileo卫星导航系统（ESA）",{"id":63,"name":64,"tagline":65},"ariane-1","Ariane 1","欧洲首枚独立轨道运载火箭 — 为 ESA 打开商用通信卫星时代，并将 Giotto 送往哈雷彗星",[],[],[],"/orrery/images/fleet-galleries/hm7b/01.webp"],"uses":{"params":["id"]}}]}
