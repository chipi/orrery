{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":33,"alongside":37,"kin":42,"engines":67,"usedOn":68,"sites":69,"crewed":74,"museums":75,"hero":76},null,{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":29,"tagline":13,"description":32},"insight","InSight","lander","NASA","USA","Lockheed Martin","2018-11-26","RETIRED","2011-now","commercial-era","火星地震仪；已探测到1300多次火星地震","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"InSight — Wikipedia","https://en.wikipedia.org/wiki/InSight","intro",{"l":21,"u":22,"t":23},"InSight — NASA Mars","https://mars.nasa.gov/insight/","core",{"l":25,"u":26,"t":27},"InSight final mission report (NASA)","https://mars.nasa.gov/insight/mission/overview/","deep",[3],[30],{"type":31,"site_id":3},"mars","NASA 2018 年至 2022 年的火星地震仪任务。探测到 1,300 多次火星地震，首次绘制出火星的内部构造图，并证实了一个大型熔融核心的存在。最终因太阳能电池板上的尘埃积累导致电力耗尽而结束任务。",[34],{"id":3,"name":4,"first":35,"year":36},"首次探测到火星地震；美国西海岸的首次行星际发射",2018,[38],{"id":39,"name":40,"tagline":41},"atlas-v","Atlas V","United Launch Alliance的改进型Atlas",[43,47,51,55,59,63],{"id":44,"name":45,"tagline":46},"phoenix","Phoenix","火星土壤中确认的水冰",{"id":48,"name":49,"tagline":50},"mars-polar-lander","Mars Polar Lander","1999年在着陆时失联；这次失败促使NASA重新审视“更快、更好、更省”方针",{"id":52,"name":53,"tagline":54},"viking-1","Viking 1","首次成功着陆火星的探测器；生物学实验",{"id":56,"name":57,"tagline":58},"viking2-lander","Viking 2 Lander","美国第二艘火星表面着陆器（乌托邦平原 1976-09-03）。Viking 1 着陆器的孪生姐妹；进行了生物学、土壤化学和气象学研究，一直工作到 1980 年",{"id":60,"name":61,"tagline":62},"surveyor-3","Surveyor 3","Apollo 12在2.5年后造访了它",{"id":64,"name":65,"tagline":66},"beresheet","Beresheet","首次私人月球着陆尝试",[],[],[70],{"type":31,"href":71,"name":4,"place":72,"text":73},"/mars/insight","埃律西昂平原","火星首部专用行星地震仪。探测到超过1,300次火星地震，包括2022年5月创纪录的4.7级地震（S1222a）。热流探针（HP³）未能穿透出人意料的粘聚性风化层。2022年12月，太阳能电池板上的尘埃积累导致功率降至运行阈值以下，任务结束。",[],[],"/orrery/images/fleet-galleries/insight/01.webp"],"uses":{"params":["id"]}}]}
