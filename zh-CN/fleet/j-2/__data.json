{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":31,"alongside":32,"kin":33,"engines":58,"usedOn":59,"sites":68,"crewed":69,"museums":70,"hero":71},"https://www.orrerylearn.com/images/cards/fleet/j-2.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"last_flight":10,"status":11,"era":12,"epoch":13,"best_known_for":14,"specs":15,"science":21,"credit":23,"links":24,"tagline":29,"description":30},"j-2","J-2","engine","NASA","USA","Rocketdyne","1966-02-26","1975-07-15","RETIRED","1957-1969","lunar-era","可重新点火的液氢上面级发动机，将Apollo送上奔月轨道",{"cycle":16,"propellant":17,"thrust_kn_vac":18,"isp_vac_s":19,"mass_kg":20},"gas-generator","LOX / LH2",1033,421,1788,[22],"propulsion/specific-impulse","Engine registry (PRD-032). Public-source nominal specs; NASA imagery.",[25],{"l":26,"u":27,"t":28},"J-2 — Wikipedia","https://en.wikipedia.org/wiki/Rocketdyne_J-2","intro","将Apollo送上月球两次的引擎","J-2燃烧液氢和液氧，并能在太空真空中重新点火——这一能力使Saturn V的地月转移入轨点火成为可能。Rocketdyne的燃气发生器设计用于Saturn V的第二级和第三级以及Saturn IB，兼具高性能与在太空中重启的能力，让运载火箭的末级成为真正的出发级。它于1966年2月首次飞行，最后一次飞行是在1975年7月的Apollo-Soyuz Test Project上。",[],[],[34,38,42,46,50,54],{"id":35,"name":36,"tagline":37},"f-1","F-1","迄今飞行过的最强力单室发动机",{"id":39,"name":40,"tagline":41},"rl10","RL10","氢上面级，六十年生涯还在继续",{"id":43,"name":44,"tagline":45},"h-1","H-1","八台发动机，八次任务——Saturn I的主力发动机",{"id":47,"name":48,"tagline":49},"rocketdyne-a7","Rocketdyne A-7","发射第一位美国人进入太空的火箭发动机",{"id":51,"name":52,"tagline":53},"lr87","LR87","双燃烧室自燃推进剂第一级发动机，送出了每一个Gemini乘组",{"id":55,"name":56,"tagline":57},"rs-25","RS-25 (SSME)","可重复使用、氢燃料驱动，仍在SLS上飞行",[],[60,64],{"id":61,"name":62,"tagline":63},"saturn-v","Saturn V","将人类送上了月球",{"id":65,"name":66,"tagline":67},"saturn-ib","Saturn IB","搭载Apollo 7、Skylab宇航员和ASTP",[],[],[],"/orrery/images/fleet-galleries/j-2/01.webp"],"uses":{"params":["id"]}}]}
