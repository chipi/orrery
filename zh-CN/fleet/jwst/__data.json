{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":32,"alongside":33,"kin":34,"engines":59,"usedOn":60,"sites":61,"crewed":65,"museums":66,"hero":67},"https://www.orrerylearn.com/images/cards/fleet/jwst.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_sites":28,"tagline":13,"description":31},"jwst","James Webb空间望远镜","observatory","NASA / ESA","USA / Multi (Europe)","Northrop Grumman / Goddard Space Flight Center","2021-12-25","ACTIVE","2011-now","commercial-era","最大的红外空间望远镜；L2轨道","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"James Webb Space Telescope — Wikipedia","https://en.wikipedia.org/wiki/James_Webb_Space_Telescope","intro",{"l":21,"u":22,"t":23},"Webb — NASA","https://webb.nasa.gov/","core",{"l":25,"u":26,"t":27},"JWST Mission Documentation (STScI)","https://www.stsci.edu/jwst/about-jwst","deep",[29],{"type":30,"site_id":3},"earth-object","有史以来建造的最大的红外空间望远镜。自 2022 年 1 月起驻留在日地 L2 点，配有 6.5 米分块镀金铍主镜，其后是网球场大小的遮阳罩。可回望大爆炸之后的第一批星系。",[],[],[35,39,43,47,51,55],{"id":36,"name":37,"tagline":38},"hubble","Hubble空间望远镜","标志性可见光/紫外线空间望远镜；5 次维修任务",{"id":40,"name":41,"tagline":42},"euclid","Euclid","跨越三分之一天空的暗能量巡天",{"id":44,"name":45,"tagline":46},"spektr-rg","Spektr-RG","俄德X射线全天巡天观测站",{"id":48,"name":49,"tagline":50},"tess","TESS","全天系外行星凌星巡天",{"id":52,"name":53,"tagline":54},"hitomi","Hitomi (ASTRO-H)","在轨解体；其损失推动了XRISM的开发",{"id":56,"name":57,"tagline":58},"gaia","Gaia","三维恒星增18亿",[],[],[62],{"type":30,"href":63,"name":4,"place":-1,"text":64},"/earth?id=jwst","位于日-地L2拉格朗日点——距地球150万公里。永不能维修。看到来自134亿年前的光线,来自大爆炸后最初的恒星和星系。耗时25年建造。有史以来部署的最复杂的科学仪器。它有效。",[],[],"/orrery/images/fleet-galleries/jwst/01.webp"],"uses":{"params":["id"]}}]}
