{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":29,"alongside":30,"kin":31,"engines":56,"usedOn":57,"sites":66,"crewed":67,"museums":68,"hero":69},"https://www.orrerylearn.com/images/cards/fleet/le-5b.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"science":19,"credit":21,"links":22,"tagline":27,"description":28},"le-5b","LE-5B","engine","JAXA","Japan","Mitsubishi Heavy Industries","2001-08-29","ACTIVE","1981-2011","iss-assembly","日本的可重启深冷上面级——应用于H-IIA至H3",{"cycle":15,"propellant":16,"thrust_kn_vac":17,"isp_vac_s":18},"expander-bleed","LOX / LH2",137,448,[20],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs; JAXA imagery.",[23],{"l":24,"u":25,"t":26},"LE-5 — Wikipedia","https://en.wikipedia.org/wiki/LE-5","intro","日本可重启的上面级，应用于H-IIA至H3运载火箭","LE-5B是连接日本两代运载火箭的低温上面级发动机。采用以LOX和LH2为推进剂的膨胀放气循环，可在飞行中重新点火——这是经过滑行段后将载荷精确送入轨道的必要条件。它于2001年8月首次搭乘H-IIA升空，之后升级为LE-5B-3，继续服役于H3，使日本的上面级从国际空间站建设时代到今天从未间断。可重启能力加上膨胀放气循环简洁清爽的特点，使它自然成为LE-7A和LE-9的上面级搭档。",[],[],[32,36,40,44,48,52],{"id":33,"name":34,"tagline":35},"le-7a","LE-7A","日本的分级燃烧氢发动机，在H-II上服役二十年",{"id":37,"name":38,"tagline":39},"le-9","LE-9","迄今为止最大的膨胀循环发动机——为H3火箭提供动力",{"id":41,"name":42,"tagline":43},"rd-180","RD-180","俄罗斯富氧分级燃烧技术——美国无法复制",{"id":45,"name":46,"tagline":47},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",{"id":49,"name":50,"tagline":51},"vikas","Vikas","印度的授权Viking——三十年为PSLV和GSLV提供动力",{"id":53,"name":54,"tagline":55},"merlin-1d","Merlin 1D","九台引擎、一枚助推器，飞行并重复使用数十次",[],[58,62],{"id":59,"name":60,"tagline":61},"h-iia","H-IIA","JAXA旗舰任务的主力运载火箭",{"id":63,"name":64,"tagline":65},"h3","H3","以较低费用取代H-IIA/H-IIB",[],[],[],"/orrery/images/fleet-galleries/le-5b/01.webp"],"uses":{"params":["id"]}}]}
