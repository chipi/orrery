{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":31,"alongside":32,"kin":33,"engines":58,"usedOn":59,"sites":64,"crewed":65,"museums":66,"hero":67},"https://www.orrerylearn.com/images/cards/fleet/le-7a.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"last_flight":10,"status":11,"era":12,"epoch":13,"best_known_for":14,"specs":15,"science":21,"credit":23,"links":24,"tagline":29,"description":30},"le-7a","LE-7A","engine","JAXA","Japan","Mitsubishi Heavy Industries","2001-08-29","2024-09-14","RETIRED","1981-2011","iss-assembly","日本的分级燃烧氢发动机——为H-IIA/H-IIB提供动力",{"cycle":16,"propellant":17,"thrust_kn_vac":18,"isp_vac_s":19,"mass_kg":20},"staged-combustion","LOX / LH2",1098,440,1800,[22],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs; JAXA imagery.",[25],{"l":26,"u":27,"t":28},"LE-7 — Wikipedia","https://en.wikipedia.org/wiki/LE-7","intro","日本的分级燃烧氢发动机，在H-II上服役二十年","LE-7A赋予日本完全自主的重型运载能力。它由Mitsubishi Heavy Industries为JAXA研制，采用以LOX和LH2为推进剂的分级燃烧循环——这种热力学方案能从氢推进剂中榨取最高效率——并于2001年8月首次在H-IIA上飞行，是初代LE-7的改进型。重新设计解决了曾导致早期H-II失败的涡轮泵问题，此后LE-7A成为H-IIA和H-IIB服役生涯的支柱，一直用到2024年，发射了日本的HTV货运飞船前往国际空间站，也发射了JAXA的ALOS对地观测卫星。",[],[],[34,38,42,46,50,54],{"id":35,"name":36,"tagline":37},"le-5b","LE-5B","日本可重启的上面级，应用于H-IIA至H3运载火箭",{"id":39,"name":40,"tagline":41},"le-9","LE-9","迄今为止最大的膨胀循环发动机——为H3火箭提供动力",{"id":43,"name":44,"tagline":45},"rd-180","RD-180","俄罗斯富氧分级燃烧技术——美国无法复制",{"id":47,"name":48,"tagline":49},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",{"id":51,"name":52,"tagline":53},"vikas","Vikas","印度的授权Viking——三十年为PSLV和GSLV提供动力",{"id":55,"name":56,"tagline":57},"merlin-1d","Merlin 1D","九台引擎、一枚助推器，飞行并重复使用数十次",[],[60],{"id":61,"name":62,"tagline":63},"h-iia","H-IIA","JAXA旗舰任务的主力运载火箭",[],[],[],"/orrery/images/fleet-galleries/le-7a/01.webp"],"uses":{"params":["id"]}}]}
