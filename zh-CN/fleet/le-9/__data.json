{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":29,"alongside":30,"kin":31,"engines":56,"usedOn":57,"sites":62,"crewed":63,"museums":64,"hero":65},"https://www.orrerylearn.com/images/cards/fleet/le-9.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"science":19,"credit":21,"links":22,"tagline":27,"description":28},"le-9","LE-9","engine","JAXA","Japan","Mitsubishi Heavy Industries","2023-03-07","ACTIVE","2011-now","commercial-era","迄今为止最大的膨胀循环发动机——H3火箭芯级",{"cycle":15,"propellant":16,"thrust_kn_vac":17,"isp_vac_s":18},"expander-bleed","LOX / LH2",1471,425,[20],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs; JAXA imagery.",[23],{"l":24,"u":25,"t":26},"LE-9 — Wikipedia","https://en.wikipedia.org/wiki/LE-9","intro","迄今为止最大的膨胀循环发动机——为H3火箭提供动力","LE-9是一个优雅胜于复杂性的有意选择。与分级燃烧的涡轮泵预燃烧装置不同，它采用膨胀循环：氢气由燃烧室和喷管壁加热，该气体的一部分被分流出来驱动涡轮泵，然后排出舱外。这种循环具有固有的较低燃烧室压力和更简洁的高温部件设计，在一定程度上牺牲性能以减少困扰早期日本发动机的机械故障模式。LE-9由Mitsubishi为JAXA的H3火箭开发，于2023年3月首次飞行，是达到运营服役的同类型最大发动机。",[],[],[32,36,40,44,48,52],{"id":33,"name":34,"tagline":35},"le-5b","LE-5B","日本可重启的上面级，应用于H-IIA至H3运载火箭",{"id":37,"name":38,"tagline":39},"le-7a","LE-7A","日本的分级燃烧氢发动机，在H-II上服役二十年",{"id":41,"name":42,"tagline":43},"raptor","Raptor","全流量分级燃烧——最难的循环，终于升空",{"id":45,"name":46,"tagline":47},"ce-20","CE-20","印度首个自主研制的低温发动机，因形势所迫而诞生",{"id":49,"name":50,"tagline":51},"yf-77","YF-77","中国首台大型液氢发动机——长征五号的基础",{"id":53,"name":54,"tagline":55},"yf-100","YF-100","中国分级燃烧液氧煤油发动机，为新一代火箭提供动力",[],[58],{"id":59,"name":60,"tagline":61},"h3","H3","以较低费用取代H-IIA/H-IIB",[],[],[],"/orrery/images/fleet-galleries/le-9/01.webp"],"uses":{"params":["id"]}}]}
