{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":28,"alongside":29,"kin":30,"engines":55,"usedOn":56,"sites":61,"crewed":62,"museums":63,"hero":69},"https://www.orrerylearn.com/images/cards/fleet/lr87.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"last_flight":10,"status":11,"era":12,"epoch":13,"best_known_for":14,"specs":15,"credit":20,"links":21,"tagline":26,"description":27},"lr87","LR87","engine","NASA","USA","Aerojet","1959-02-06","2005-10-19","RETIRED","1957-1969","space-race","在Titan II上发射Gemini乘组的双室第一级发动机",{"cycle":16,"propellant":17,"thrust_kn_sl":18,"isp_sl_s":19},"gas-generator","N2O4 / Aerozine-50",1900,258,"Engine registry (PRD-032). Public-source nominal specs; NASA imagery.",[22],{"l":23,"u":24,"t":25},"LR87 — Wikipedia","https://en.wikipedia.org/wiki/LR87","intro","双燃烧室自燃推进剂第一级发动机，送出了每一个Gemini乘组","LR87是在Titan II上发射全部十次Gemini载人任务的发动机。Aerojet的设计把两个燃烧室装在同一套涡轮泵组件上，以燃气发生器循环燃烧Aerozine-50和四氧化二氮——这种自燃推进剂组合是当时美国洲际弹道导弹的标准配置。推进剂的选择对乘员安全有直接影响：与RP-1或氢不同，Aerozine-50和N2O4一接触就点燃，这种自燃的可靠性使Gemini在全部十次载人任务中都采用弹射座椅，而不是发射逃逸塔。LR87后来发展成更大的型号，在Titan III和Titan IV上执行商业和军事任务，一直飞到2005年10月。",[],[],[31,35,39,43,47,51],{"id":32,"name":33,"tagline":34},"h-1","H-1","八台发动机，八次任务——Saturn I的主力发动机",{"id":36,"name":37,"tagline":38},"rocketdyne-a7","Rocketdyne A-7","发射第一位美国人进入太空的火箭发动机",{"id":40,"name":41,"tagline":42},"rl10","RL10","氢上面级，六十年生涯还在继续",{"id":44,"name":45,"tagline":46},"j-2","J-2","将Apollo送上月球两次的引擎",{"id":48,"name":49,"tagline":50},"f-1","F-1","迄今飞行过的最强力单室发动机",{"id":52,"name":53,"tagline":54},"rs-25","RS-25 (SSME)","可重复使用、氢燃料驱动，仍在SLS上飞行",[],[57],{"id":58,"name":59,"tagline":60},"titan-ii-glv","Titan II GLV","Project Gemini的工作马队",[],[],[64],{"id":65,"name":66,"city":67,"item":68},"udvar-hazy","史蒂文·乌德沃尔哈齐中心","尚蒂伊，弗吉尼亚州","Titan I导弹的XLR-87发动机","/orrery/images/fleet-galleries/lr87/01.webp"],"uses":{"params":["id"]}}]}
