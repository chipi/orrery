{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":39,"kin":44,"engines":69,"usedOn":70,"sites":71,"crewed":76,"museums":77,"hero":78},"https://www.orrerylearn.com/images/cards/fleet/lunokhod-1.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":30,"tagline":13,"description":33},"lunokhod-1","Lunokhod 1","rover","Roscosmos","USSR","NPO Lavochkin","1970-11-17","RETIRED","1969-1981","lunar-era","首辆在另一个世界漫游的轮式车辆","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Луноход-1 — русская Википедия","https://ru.wikipedia.org/wiki/%D0%9B%D1%83%D0%BD%D0%BE%D1%85%D0%BE%D0%B4-1","intro",{"l":21,"u":22,"t":23},"Lunokhod 1 — Wikipedia","https://en.wikipedia.org/wiki/Lunokhod_1","core",{"l":25,"u":26,"t":27},"Lunokhod 1 mission (NASA NSSDCA)","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1970-095A","deep",[29],"luna17",[31],{"type":32,"site_id":29},"moon","首辆在另一个天体上行驶的轮式车辆。1970年11月至1971年9月，在月球雨海运行了十个月，由克里米亚的五人团队通过无线电链路驾驶。一个加压的“浴盆”，夜间靠钋加热器保温。",[35],{"id":29,"name":36,"first":37,"year":38},"Luna 17 / Lunokhod 1","首个在另一个星球上运行的遥操控月球车",1970,[40],{"id":41,"name":42,"tagline":43},"proton-k","Proton-K","1967–2012 年苏联/俄罗斯的重型运载主力——Salyut、Mir、Venera、Vega 与 Luna 采样返回",[45,49,53,57,61,65],{"id":46,"name":47,"tagline":48},"lunokhod-2","Lunokhod 2","在月球上行驶39 km——纪录保持到2014年",{"id":50,"name":51,"tagline":52},"lrv-apollo","月球车","首次载人月球车；Apollo 15、16、17",{"id":54,"name":55,"tagline":56},"sojourner","Sojourner","火星漫游车；Pathfinder任务",{"id":58,"name":59,"tagline":60},"opportunity","Opportunity (MER-B)","Spirit的孪生探测器；在火星上运行近15年",{"id":62,"name":63,"tagline":64},"spirit","Spirit (MER-A)","火星探测漫游车;运作6年",{"id":66,"name":67,"tagline":68},"curiosity","Curiosity (MSL)","核动力火星科学实验室火星车",[],[],[72],{"type":32,"href":73,"name":36,"place":74,"text":75},"/moon/luna17","雨海","首台在其他星体上运作的远程遥控漫游车。历时322天共行驶10.5 km，拍摄了超过20,000张图像。直到2010年才被重新发现，当时月球勘测轨道器从太空中发现了它——仍然静止在它停止的确切位置。",[],[],"/orrery/images/fleet-galleries/lunokhod-1/05.webp"],"uses":{"params":["id"]}}]}
