{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":39,"kin":44,"engines":69,"usedOn":70,"sites":71,"crewed":76,"museums":77,"hero":78},"https://www.orrerylearn.com/images/cards/fleet/lunokhod-2.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":30,"tagline":13,"description":33},"lunokhod-2","Lunokhod 2","rover","Roscosmos","USSR","NPO Lavochkin","1973-01-15","RETIRED","1969-1981","first-stations","在月球上行驶39 km——纪录保持到2014年","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Lunokhod 2 — Wikipedia","https://en.wikipedia.org/wiki/Lunokhod_2","intro",{"l":21,"u":22,"t":23},"Луноход — Роскосмос","https://www.roscosmos.ru/24187/","core",{"l":25,"u":26,"t":27},"Lunokhod 2 — NASA NSSDCA","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1973-001A","deep",[29],"luna21",[31],{"type":32,"site_id":29},"moon","Lunokhod 2是苏联NPO Lavochkin建造的行星漫游车。在月球上行驶39 km——纪录保持到2014年。任务于1973年结束。",[35],{"id":29,"name":36,"first":37,"year":38},"Luna 21 / Lunokhod 2","苏联第二辆月球车；超过40年来最长的地外行驶距离（约39 km）",1973,[40],{"id":41,"name":42,"tagline":43},"proton-k","Proton-K","1967–2012 年苏联/俄罗斯的重型运载主力——Salyut、Mir、Venera、Vega 与 Luna 采样返回",[45,49,53,57,61,65],{"id":46,"name":47,"tagline":48},"lunokhod-1","Lunokhod 1","首辆在另一个世界漫游的轮式车辆",{"id":50,"name":51,"tagline":52},"lrv-apollo","月球车","首次载人月球车；Apollo 15、16、17",{"id":54,"name":55,"tagline":56},"sojourner","Sojourner","火星漫游车；Pathfinder任务",{"id":58,"name":59,"tagline":60},"opportunity","Opportunity (MER-B)","Spirit的孪生探测器；在火星上运行近15年",{"id":62,"name":63,"tagline":64},"spirit","Spirit (MER-A)","火星探测漫游车;运作6年",{"id":66,"name":67,"tagline":68},"curiosity","Curiosity (MSL)","核动力火星科学实验室火星车",[],[],[72],{"type":32,"href":73,"name":36,"place":74,"text":75},"/moon/luna21","勒莫尼耶环形山（澄海）","Lunokhod 2 是苏联两台月球漫游车中的第二台（1973年）。由在IKI控制中心轮班值班的5人地面小队驾驶。在4个月内，它行驶了约39 km——这个月面行驶距离记录保持了41年，直到2014年NASA的Opportunity火星漫游车超越它。携带的法国激光角反射器至今仍被用于地月测距。",[],[],"/orrery/images/fleet-galleries/lunokhod-2/03.webp"],"uses":{"params":["id"]}}]}
