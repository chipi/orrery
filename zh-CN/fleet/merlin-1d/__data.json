{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":35,"kin":36,"engines":61,"usedOn":62,"sites":71,"crewed":72,"museums":73,"hero":84},"https://www.orrerylearn.com/images/cards/fleet/merlin-1d.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":6,"first_flight":8,"status":9,"era":10,"epoch":11,"best_known_for":12,"specs":13,"science":20,"credit":22,"links":23,"tagline":32,"description":33},"merlin-1d","Merlin 1D","engine","SpaceX","USA","2013-09-29","ACTIVE","2011-now","commercial-era","可复用的主力——九台推动Falcon 9，飞行并重复使用数十次",{"cycle":14,"propellant":15,"thrust_kn_sl":16,"isp_vac_s":17,"isp_sl_s":18,"mass_kg":19},"gas-generator","LOX / RP-1",845,311,282,470,[21],"propulsion/thrust-and-twr","Engine registry (PRD-032). Public-source nominal specs.",[24,28],{"l":25,"u":26,"t":27},"Merlin — Wikipedia","https://en.wikipedia.org/wiki/SpaceX_Merlin","intro",{"l":29,"u":30,"t":31},"Falcon 9 (SpaceX)","https://www.spacex.com/vehicles/falcon-9/","core","九台引擎、一枚助推器，飞行并重复使用数十次","SpaceX的Merlin 1D是使可复用Falcon 9成为可能的发动机。九台Merlin 1D集束安装在Falcon 9第一级上，采用燃气发生器循环，推进剂为LOX和RP-1，其中中心发动机还用于返回和着陆点火。它于2013年9月首次飞行，逐步成长为高频次发射的主力：单台发动机已累计飞行二十多次，这一复用纪录改变了整个行业对经济上可行之事的认知。真空型Merlin 1D Vacuum采用更大的喷管，针对近真空环境优化，为Falcon 9上面级提供动力。",[],[],[37,41,45,49,53,57],{"id":38,"name":39,"tagline":40},"raptor","Raptor","全流量分级燃烧——最难的循环，终于升空",{"id":42,"name":43,"tagline":44},"yf-100","YF-100","中国分级燃烧液氧煤油发动机，为新一代火箭提供动力",{"id":46,"name":47,"tagline":48},"yf-77","YF-77","中国首台大型液氢发动机——长征五号的基础",{"id":50,"name":51,"tagline":52},"ce-20","CE-20","印度首个自主研制的低温发动机，因形势所迫而诞生",{"id":54,"name":55,"tagline":56},"le-9","LE-9","迄今为止最大的膨胀循环发动机——为H3火箭提供动力",{"id":58,"name":59,"tagline":60},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",[],[63,67],{"id":64,"name":65,"tagline":66},"falcon-9","Falcon 9 Block 5","可重复使用的助推器重塑了商业发射",{"id":68,"name":69,"tagline":70},"falcon-heavy","Falcon Heavy","三芯超重型可重复使用运载火箭",[],[],[74,79],{"id":75,"name":76,"city":77,"item":78},"nasm-wash