{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":33,"alongside":37,"kin":42,"engines":67,"usedOn":68,"sites":69,"crewed":75,"museums":76,"hero":77},null,{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":29,"tagline":13,"description":32},"phoenix","Phoenix","lander","NASA","USA","Lockheed Martin","2008-05-25","RETIRED","1981-2011","iss-assembly","火星土壤中确认的水冰","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Phoenix — Wikipedia","https://en.wikipedia.org/wiki/Phoenix_(spacecraft)","intro",{"l":21,"u":22,"t":23},"Phoenix Mars Mission — NASA","https://mars.nasa.gov/mars-exploration/missions/phoenix/","core",{"l":25,"u":26,"t":27},"Phoenix Mission Profile (NASA)","https://science.nasa.gov/mission/mars-phoenix/","deep",[3],[30],{"type":31,"site_id":3},"mars","Phoenix是美国Lockheed Martin建造的行星着陆器。确认了火星土壤中的水冰。任务于2008年结束。",[34],{"id":3,"name":4,"first":35,"year":36},"首次确认火星北极地区风化层中存在水冰；自Viking 2以来首次在火星上以反推发动机软着陆",2007,[38],{"id":39,"name":40,"tagline":41},"delta-ii","Delta II","NASA的中型行星科学主力火箭——1989-2018年共155次飞行",[43,47,51,55,59,63],{"id":44,"name":45,"tagline":46},"mars-polar-lander","Mars Polar Lander","1999年在着陆时失联；这次失败促使NASA重新审视“更快、更好、更省”方针",{"id":48,"name":49,"tagline":50},"insight","InSight","火星地震仪；已探测到1300多次火星地震",{"id":52,"name":53,"tagline":54},"viking-1","Viking 1","首次成功着陆火星的探测器；生物学实验",{"id":56,"name":57,"tagline":58},"viking2-lander","Viking 2 Lander","美国第二艘火星表面着陆器（乌托邦平原 1976-09-03）。Viking 1 着陆器的孪生姐妹；进行了生物学、土壤化学和气象学研究，一直工作到 1980 年",{"id":60,"name":61,"tagline":62},"surveyor-3","Surveyor 3","Apollo 12在2.5年后造访了它",{"id":64,"name":65,"tagline":66},"change-3","嫦娥三号","中国第一艘月球着陆器",[],[],[70],{"type":31,"href":71,"name":72,"place":73,"text":74},"/mars/phoenix","Phoenix 着陆器","北方荒原（北极平原）","首个直接接触火星水冰的航天器。Phoenix的机械臂铲起冰块，在相机前数小时内升华——直观证实了Mars Odyssey中子分光计从轨道推断出的地下冰。在北半球冬季冻结其太阳能电池板之前，该探测器运作了157个火星日。",[],[],"/orrery/images/fleet-galleries/phoenix/03.webp"],"uses":{"params":["id"]}}]}
