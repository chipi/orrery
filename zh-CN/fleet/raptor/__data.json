{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":35,"alongside":36,"kin":37,"engines":62,"usedOn":63,"sites":68,"crewed":69,"museums":70,"hero":71},"https://www.orrerylearn.com/images/cards/fleet/raptor.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":6,"first_flight":8,"status":9,"era":10,"epoch":11,"best_known_for":12,"specs":13,"science":20,"credit":23,"links":24,"tagline":33,"description":34},"raptor","Raptor","engine","SpaceX","USA","2023-04-20","ACTIVE","2011-now","mars-era","首台飞行的全流量分级燃烧发动机——33台推动Super Heavy",{"cycle":14,"propellant":15,"thrust_kn_sl":16,"isp_vac_s":17,"isp_sl_s":18,"mass_kg":19},"staged-combustion (full-flow)","LOX / liquid methane",2258,350,327,1600,[21,22],"propulsion/engine-types","propulsion/fuels-and-oxidizers","Engine registry (PRD-032). Public-source nominal specs.",[25,29],{"l":26,"u":27,"t":28},"Raptor — Wikipedia","https://en.wikipedia.org/wiki/SpaceX_Raptor","intro",{"l":30,"u":31,"t":32},"Starship (SpaceX)","https://www.spacex.com/vehicles/starship/","core","全流量分级燃烧——最难的循环，终于升空","Raptor是首台进入实际飞行的全流量分级燃烧发动机。在这一热力学循环中，两种推进剂——LOX和液态甲烷——都先经过预燃室再进入主燃烧室，从而榨取最大能量，几乎不留未燃烧的推进剂。工程师们研究这一概念已有数十年，结论是它复杂得不可行；SpaceX还是造出来了。Super Heavy第一级上有33台Raptor同时点火，真空优化型则为Starship上面级提供动力。首次搭载Raptor的Starship整体飞行于2023年4月20日升空。",[],[],[38,42,46,50,54,58],{"id":39,"name":40,"tagline":41},"merlin-1d","Merlin 1D","九台引擎、一枚助推器，飞行并重复使用数十次",{"id":43,"name":44,"tagline":45},"le-9","LE-9","迄今为止最大的膨胀循环发动机——为H3火箭提供动力",{"id":47,"name":48,"tagline":49},"ce-20","CE-20","印度首个自主研制的低温发动机，因形势所迫而诞生",{"id":51,"name":52,"tagline":53},"yf-77","YF-77","中国首台大型液氢发动机——长征五号的基础",{"id":55,"name":56,"tagline":57},"yf-100","YF-100","中国分级燃烧液氧煤油发动机，为新一代火箭提供动力",{"id":59,"name":60,"tagline":61},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",[],[64],{"id":65,"name":66,"tagline":67},"starship","Starship","完全可重复使用的超重型运载火箭",[],[],[],"/orrery/images/fleet-galleries/raptor/01.webp"],"uses":{"params":["id"]}}]}
