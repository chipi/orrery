{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":31,"alongside":32,"kin":33,"engines":58,"usedOn":59,"sites":64,"crewed":65,"museums":66,"hero":67},"https://www.orrerylearn.com/images/cards/fleet/rd-180.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"science":21,"credit":23,"links":24,"tagline":29,"description":30},"rd-180","RD-180","engine","Roscosmos","Russia","NPO Energomash","2000-05-24","RETIRED","1981-2011","iss-assembly","美国无法匹敌的富氧分级燃烧——曾用于Atlas V",{"cycle":15,"propellant":16,"thrust_kn_sl":17,"isp_vac_s":18,"isp_sl_s":19,"mass_kg":20},"staged-combustion (ox-rich)","LOX / RP-1",3830,338,311,5480,[22],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs.",[25],{"l":26,"u":27,"t":28},"RD-180 — Wikipedia","https://en.wikipedia.org/wiki/RD-180","intro","俄罗斯富氧分级燃烧技术——美国无法复制","RD-180发动机代表了美国在冷战期间实际上已放弃给苏联的推进技术分支。富氧分级燃烧技术——通过预燃烧器燃烧过量氧化剂来驱动涡轮泵——对材料和制造公差提出了美国工业当时未能掌握的要求。NPO Energomash设计的双室单涡轮泵方案自2000年5月起在Atlas V上服役，为第一级提供了当时任何美制煤油/液氧发动机都无法匹敌的推力与效率组合。该发动机于2023年随Atlas V退役。",[],[],[34,38,42,46,50,54],{"id":35,"name":36,"tagline":37},"rd-253","RD-253","六台自燃推进剂发动机，驱动每一枚Proton的第一级",{"id":39,"name":40,"tagline":41},"rd-107-108","RD-107 / RD-108","Sputnik的发动机——65年后仍在运送航天员",{"id":43,"name":44,"tagline":45},"le-5b","LE-5B","日本可重启的上面级，应用于H-IIA至H3运载火箭",{"id":47,"name":48,"tagline":49},"le-7a","LE-7A","日本的分级燃烧氢发动机，在H-II上服役二十年",{"id":51,"name":52,"tagline":53},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",{"id":55,"name":56,"tagline":57},"vikas","Vikas","印度的授权Viking——三十年为PSLV和GSLV提供动力",[],[60],{"id":61,"name":62,"tagline":63},"atlas-v","Atlas V","United Launch Alliance的改进型Atlas",[],[],[],"/orrery/images/fleet-galleries/rd-180/01.webp"],"uses":{"params":["id"]}}]}
