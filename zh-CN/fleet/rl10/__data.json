{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":30,"alongside":31,"kin":32,"engines":57,"usedOn":58,"sites":63,"crewed":64,"museums":65,"hero":66},"https://www.orrerylearn.com/images/cards/fleet/rl10.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"science":20,"credit":22,"links":23,"tagline":28,"description":29},"rl10","RL10","engine","NASA","USA","Aerojet Rocketdyne","1963-11-27","ACTIVE","1957-1969","space-race","航天飞行中服役最长的发动机——第一代氢上面级动力",{"cycle":15,"propellant":16,"thrust_kn_vac":17,"isp_vac_s":18,"mass_kg":19},"expander","LOX / LH2",110,450,301,[21],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs; NASA imagery.",[24],{"l":25,"u":26,"t":27},"RL10 — Wikipedia","https://en.wikipedia.org/wiki/RL10","intro","氢上面级，六十年生涯还在继续","RL10 将膨胀循环首次引入航天飞行：推进剂流经喷嘴和燃烧室壁，吸收热量，驱动涡轮泵——在进入燃烧室之前完成，无需独立的气体发生器。RL10 于 1963 年 11 月首次飞行（搭载 Centaur 上面级），之后该系列为 Atlas、Delta 和 Vulcan 任务的上面级提供动力。它的服役时间无人能及；没有任何其他火箭发动机系列能够实现如此长久的连续生产和飞行，通过分块升级演进，同时核心热力学概念保持不变。",[],[],[33,37,41,45,49,53],{"id":34,"name":35,"tagline":36},"h-1","H-1","八台发动机，八次任务——Saturn I的主力发动机",{"id":38,"name":39,"tagline":40},"rocketdyne-a7","Rocketdyne A-7","发射第一位美国人进入太空的火箭发动机",{"id":42,"name":43,"tagline":44},"j-2","J-2","将Apollo送上月球两次的引擎",{"id":46,"name":47,"tagline":48},"f-1","F-1","迄今飞行过的最强力单室发动机",{"id":50,"name":51,"tagline":52},"lr87","LR87","双燃烧室自燃推进剂第一级发动机，送出了每一个Gemini乘组",{"id":54,"name":55,"tagline":56},"rs-25","RS-25 (SSME)","可重复使用、氢燃料驱动，仍在SLS上飞行",[],[59],{"id":60,"name":61,"tagline":62},"atlas-v","Atlas V","United Launch Alliance的改进型Atlas",[],[],[],"/orrery/images/fleet-galleries/rl10/01.webp"],"uses":{"params":["id"]}}]}
