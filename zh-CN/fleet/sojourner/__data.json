{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":39,"kin":44,"engines":69,"usedOn":70,"sites":71,"crewed":77,"museums":78,"hero":84},"https://www.orrerylearn.com/images/cards/fleet/sojourner.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":30,"tagline":13,"description":33},"sojourner","Sojourner","rover","NASA","USA","NASA JPL","1997-07-04","RETIRED","1981-2011","shuttle-and-mir","火星漫游车；Pathfinder任务","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Sojourner (rover) — Wikipedia","https://en.wikipedia.org/wiki/Sojourner_(rover)","intro",{"l":21,"u":22,"t":23},"Mars Pathfinder — NASA JPL","https://mars.nasa.gov/MPF/","core",{"l":25,"u":26,"t":27},"Mars Pathfinder Project (NASA NTRS)","https://www.jpl.nasa.gov/missions/mars-pathfinder-sojourner-rover/","deep",[29],"mars-pathfinder",[31],{"type":32,"site_id":29},"mars","Sojourner是美国NASA JPL建造的行星漫游车。首辆火星漫游车；Pathfinder任务。任务于1997年结束。",[35],{"id":29,"name":36,"first":37,"year":38},"Mars Pathfinder","火星上的首批轮迹；展示了气囊着陆技术",1996,[40],{"id":41,"name":42,"tagline":43},"delta-ii","Delta II","NASA的中型行星科学主力火箭——1989-2018年共155次飞行",[45,49,53,57,61,65],{"id":46,"name":47,"tagline":48},"opportunity","Opportunity (MER-B)","Spirit的孪生探测器；在火星上运行近15年",{"id":50,"name":51,"tagline":52},"spirit","Spirit (MER-A)","火星探测漫游车;运作6年",{"id":54,"name":55,"tagline":56},"curiosity","Curiosity (MSL)","核动力火星科学实验室火星车",{"id":58,"name":59,"tagline":60},"perseverance","Perseverance（Mars 2020）","携带Ingenuity直升机；火星样品封存",{"id":62,"name":63,"tagline":64},"lrv-apollo","月球车","首次载人月球车；Apollo 15、16、17",{"id":66,"name":67,"tagline":68},"promise","PROMISE","NASA 为月球南极拟议的月球车",[],[],[72],{"type":32,"href":73,"name":74,"place":75,"text":76},"/mars/mars-pathfinder","Mars Pathfinder + Sojourner","阿瑞斯谷","首台火星漫游车（Sojourner，重11千克，体积如微波炉般大小）。展示了气囊缓冲进入、下降和着陆技术——这一模式后来被Spirit和Opportunity沿用。Sojourner漫游车行进约100米，分析了16个岩石和土壤目标，直至着陆器中继失效。Pathfinder任务的图像在互联网早期推广了火星的科学知识——这是首次有人类实时消费星际探测任务数据的行星际任务。",[],[79],{"id":80,"name":81,"city":82,"item":83},"nasm-washington","美国国家航空航天博物馆","华盛顿","Marie Curie，Sojourner 火星车的飞行备份","/orrery/images/fleet-galleries/sojourner/01.webp"],"uses":{"params":["id"]}}]}
