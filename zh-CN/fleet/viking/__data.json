{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":28,"alongside":29,"kin":30,"engines":55,"usedOn":56,"sites":61,"crewed":62,"museums":63,"hero":64},"https://www.orrerylearn.com/images/cards/fleet/viking.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"last_flight":10,"status":11,"era":12,"epoch":13,"best_known_for":14,"specs":15,"credit":20,"links":21,"tagline":26,"description":27},"viking","Viking","engine","CNES / ESA","France","SEP (Safran)","1979-12-24","2003-02-15","RETIRED","1969-1981","first-stations","法国发动机，后来以Vikas之名授权给印度——为Ariane 1–4提供动力",{"cycle":16,"propellant":17,"thrust_kn_sl":18,"isp_sl_s":19},"gas-generator","N2O4 / UH25",678,248,"Engine registry (PRD-032). Public-source nominal specs; ESA imagery.",[22],{"l":23,"u":24,"t":25},"Viking (rocket engine) — Wikipedia","https://en.wikipedia.org/wiki/Viking_(rocket_engine)","intro","法国引擎，印度的主力发动机","Viking发动机由法国SEP为CNES和ESA研制，自1979年12月24日Ariane 1首飞起，为Ariane系列第一至第四代火箭提供动力。它以四氧化二氮和UH25（一种氮肼混合燃料）为推进剂，采用燃气发生器循环——这种自燃推进剂组合以效率换取了常温可储存和点火简单的优势。Viking影响最深远的“第二春”出现在1970年代：ISRO从法国获得该设计的许可，并将其发展为Vikas发动机，至今仍在印度运载火箭上飞行。一款法国发动机设计，为两个国家打开了通向太空的大门。",[],[],[31,35,39,43,47,51],{"id":32,"name":33,"tagline":34},"rs-25","RS-25 (SSME)","可重复使用、氢燃料驱动，仍在SLS上飞行",{"id":36,"name":37,"tagline":38},"hm7b","HM7B","阿丽亚娜火箭的低温上面级，服役三十余年",{"id":40,"name":41,"tagline":42},"f-1","F-1","迄今飞行过的最强力单室发动机",{"id":44,"name":45,"tagline":46},"j-2","J-2","将Apollo送上月球两次的引擎",{"id":48,"name":49,"tagline":50},"rd-253","RD-253","六台自燃推进剂发动机，驱动每一枚Proton的第一级",{"id":52,"name":53,"tagline":54},"vikas","Vikas","印度的授权Viking——三十年为PSLV和GSLV提供动力",[],[57],{"id":58,"name":59,"tagline":60},"ariane-1","Ariane 1","欧洲首枚独立轨道运载火箭 — 为 ESA 打开商用通信卫星时代，并将 Giotto 送往哈雷彗星",[],[],[],"/orrery/images/fleet-galleries/viking/01.webp"],"uses":{"params":["id"]}}]}
