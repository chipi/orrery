{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":33,"alongside":38,"kin":51,"engines":76,"usedOn":77,"sites":78,"crewed":83,"museums":84,"hero":85},"https://www.orrerylearn.com/images/cards/fleet/vikram-cy3.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":6,"first_flight":8,"status":9,"era":10,"epoch":11,"best_known_for":12,"credit":13,"links":14,"linked_missions":27,"linked_sites":29,"tagline":12,"description":32},"vikram-cy3","Vikram (Chandrayaan-3)","lander","ISRO","India","2023-08-23","RETIRED","2011-now","commercial-era","首次登陆月球南极附近","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[15,19,23],{"l":16,"u":17,"t":18},"Chandrayaan-3 — Wikipedia","https://en.wikipedia.org/wiki/Chandrayaan-3","intro",{"l":20,"u":21,"t":22},"Chandrayaan-3 — ISRO","https://www.isro.gov.in/Chandrayaan3.html","core",{"l":24,"u":25,"t":26},"Chandrayaan-3 mission summary (ISRO)","https://www.isro.gov.in/Chandrayaan3_Details.html","deep",[28],"chandrayaan3",[30],{"type":31,"site_id":28},"moon","印度首个成功的月球着陆器（2023年8月），也是首个在月球南极附近着陆的航天器。在Vikram CY-2于同一地区坠毁四年之后，它为印度和ISRO带来了急需的“救赎”。",[34],{"id":28,"name":35,"first":36,"year":37},"Chandrayaan-3","首次在月球南极附近成功软着陆",2023,[39,43,47],{"id":40,"name":41,"tagline":42},"lvm3","LVM3 (GSLV Mk III)","Gaganyaan的机组级发射器",{"id":44,"name":45,"tagline":46},"pragyan","Pragyan","首辆月球南极漫游车；Chandrayaan-3",{"id":48,"name":49,"tagline":50},"sriharikota-slp","斯里赫里戈达 SLP","印度重型发射台——GSLV Mk III / LVM3，通向Chandrayaan-3，以及即将开始的Gaganyaan载人项目",[52,56,60,64,68,72],{"id":53,"name":54,"tagline":55},"vikram-cy2","Vikram (Chandrayaan-2)","印度Chandrayaan-2的着陆器；2019年坠毁，但轨道器继续运行",{"id":57,"name":58,"tagline":59},"hakuto-r","Hakuto-R计划","日本首批私人登月尝试；任务1（2023年）和任务2（2025年）均坠毁",{"id":61,"name":62,"tagline":63},"im-1-odysseus","IM-1 Odysseus","Apollo任务以来美国首次月球着陆；侧身降落",{"id":65,"name":66,"tagline":67},"slim","SLIM","精确月面着陆；翻覆但仍可运作",{"id":69,"name":70,"tagline":71},"change6","嫦娥六号","首次月球背面采样返回。Apollo盆地着陆于2024-06-01（UTC）；1935克样品于2024-06-25返回内蒙古",{"id":73,"name":74,"tagline":75},"blue-moon-mk1","Blue Moon Mk1","Blue Origin第一代月球货运着陆器——单级液氢/液氧运载器，约3吨至月面",[],[],[79],{"type":31,"href":80,"name":35,"place":81,"text":82},"/moon/chandrayaan3","Shiv Shakti Point（南极区域）","首个在如此靠近月球南极处着陆的航天器，约南纬69°——这是当前空间探索中最具竞争力的区域，永久阴影坑藏有水冰。Pragyan 使用其 LIBS 仪器首次在月球南极附近进行了就地硫元素探测。印度成为第四个在月球软着陆的国家。",[],[],"/orrery/images/fleet-galleries/vikram-cy3/01.webp"],"uses":{"params":["id"]}}]}
