{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":29,"alongside":30,"kin":31,"engines":56,"usedOn":57,"sites":62,"crewed":63,"museums":64,"hero":65},"https://www.orrerylearn.com/images/cards/fleet/vulcain-2.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"last_flight":10,"status":11,"era":12,"epoch":13,"best_known_for":14,"specs":15,"credit":21,"links":22,"tagline":27,"description":28},"vulcain-2","Vulcain 2","engine","ESA","Europe","Snecma (Safran)","2002-12-11","2023-07-05","RETIRED","1981-2011","iss-assembly","欧洲的氢燃料芯级发动机——为每一枚Ariane 5提供动力",{"cycle":16,"propellant":17,"thrust_kn_vac":18,"isp_vac_s":19,"mass_kg":20},"gas-generator","LOX / LH2",1359,429,2100,"Engine registry (PRD-032). Public-source nominal specs; ESA imagery.",[23],{"l":24,"u":25,"t":26},"Vulcain — Wikipedia","https://en.wikipedia.org/wiki/Vulcain","intro","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它","Vulcain 2是欧洲为实现独立进入地球静止轨道而研制的发动机。它由Snecma在ESA的Ariane 5计划下开发，以LOX和LH2为推进剂，采用燃气发生器循环，驱动低温芯级从点火一直工作到主发动机关机，而最初几分钟的主要推力由固体助推器承担。2002年12月的首次亮相因喷管冷却失效而失败，火箭被毁；经重新设计后，它自2005年起成功飞行，直到2023年7月Ariane 5末次飞行，一直是这型火箭可靠的核心，把卫星和行星际探测器——包括JWST——送上各自的轨道。",[],[],[32,36,40,44,48,52],{"id":33,"name":34,"tagline":35},"hm7b","HM7B","阿丽亚娜火箭的低温上面级，服役三十余年",{"id":37,"name":38,"tagline":39},"le-5b","LE-5B","日本可重启的上面级，应用于H-IIA至H3运载火箭",{"id":41,"name":42,"tagline":43},"le-7a","LE-7A","日本的分级燃烧氢发动机，在H-II上服役二十年",{"id":45,"name":46,"tagline":47},"rd-180","RD-180","俄罗斯富氧分级燃烧技术——美国无法复制",{"id":49,"name":50,"tagline":51},"vikas","Vikas","印度的授权Viking——三十年为PSLV和GSLV提供动力",{"id":53,"name":54,"tagline":55},"merlin-1d","Merlin 1D","九台引擎、一枚助推器，飞行并重复使用数十次",[],[58],{"id":59,"name":60,"tagline":61},"ariane-5","Ariane 5","发射了Rosetta、JWST、Galileo卫星导航系统（ESA）",[],[],[],"/orrery/images/fleet-galleries/vulcain-2/01.webp"],"uses":{"params":["id"]}}]}
