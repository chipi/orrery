{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":29,"alongside":30,"kin":31,"engines":56,"usedOn":57,"sites":62,"crewed":63,"museums":64,"hero":65},"https://www.orrerylearn.com/images/cards/fleet/yf-100.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"science":19,"credit":21,"links":22,"tagline":27,"description":28},"yf-100","YF-100","engine","CNSA","China","AALPT (Xi’an)","2015-09-20","ACTIVE","2011-now","commercial-era","中国现代分级燃烧液氧煤油发动机——长征五号/六号/七号",{"cycle":15,"propellant":16,"thrust_kn_sl":17,"isp_sl_s":18},"staged-combustion (ox-rich)","LOX / RP-1",1200,300,[20],"propulsion/engine-types","Engine registry (PRD-032). Public-source nominal specs.",[23],{"l":24,"u":25,"t":26},"YF-100 — Wikipedia","https://en.wikipedia.org/wiki/YF-100","intro","中国分级燃烧液氧煤油发动机，为新一代火箭提供动力","YF-100使中国的运载能力迈入了俄罗斯和美国占据数十年的性能档次。它由西安的AALPT研制，对液氧和RP-1采用富氧分级燃烧——一种能从煤油推进剂中榨取最多能量的热力循环——并于2015年9月20日首飞。两台YF-100为长征五号的芯级提供动力，长征五号是中国现役最重的运载火箭，其并联型号则飞行在长征六号和长征七号上。YF-100支撑着中国的月球计划、空间站补给，以及不断加快的商业发射节奏。",[],[],[32,36,40,44,48,52],{"id":33,"name":34,"tagline":35},"yf-77","YF-77","中国首台大型液氢发动机——长征五号的基础",{"id":37,"name":38,"tagline":39},"ce-20","CE-20","印度首个自主研制的低温发动机，因形势所迫而诞生",{"id":41,"name":42,"tagline":43},"merlin-1d","Merlin 1D","九台引擎、一枚助推器，飞行并重复使用数十次",{"id":45,"name":46,"tagline":47},"le-9","LE-9","迄今为止最大的膨胀循环发动机——为H3火箭提供动力",{"id":49,"name":50,"tagline":51},"raptor","Raptor","全流量分级燃烧——最难的循环，终于升空",{"id":53,"name":54,"tagline":55},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",[],[58],{"id":59,"name":60,"tagline":61},"long-march-5","长征五号 / 5B","中国航天计划的重型运载骨干",[],[],[],"/orrery/images/fleet-galleries/yf-100/01.webp"],"uses":{"params":["id"]}}]}
