{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":27,"alongside":28,"kin":29,"engines":54,"usedOn":55,"sites":60,"crewed":61,"museums":62,"hero":63},"https://www.orrerylearn.com/images/cards/fleet/yf-77.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"specs":14,"credit":19,"links":20,"tagline":25,"description":26},"yf-77","YF-77","engine","CNSA","China","AALPT","2016-11-03","ACTIVE","2011-now","commercial-era","中国首台大推力液氢发动机——长征五号芯级",{"cycle":15,"propellant":16,"thrust_kn_vac":17,"isp_vac_s":18},"gas-generator","LOX / LH2",700,428,"Engine registry (PRD-032). Public-source nominal specs.",[21],{"l":22,"u":23,"t":24},"YF-77 — Wikipedia","https://en.wikipedia.org/wiki/YF-77","intro","中国首台大型液氢发动机——长征五号的基础","YF-77是中国首台以LOX和LH2为推进剂的大型低温发动机，终结了芯级长达数十年依赖可储存自燃推进剂的局面。它由AALPT研制，采用燃气发生器循环，两台YF-77为长征五号的中央芯级提供动力，带来的效率提升使月球返回任务和空间站舱段任务无需一枚大得离谱的火箭即可实现。YF-77于2016年11月3日首飞，早期飞行并非一帆风顺——一次YF-77异常使长征五号停飞近三年，直到工程师查明并排除了这一故障模式。",[],[],[30,34,38,42,46,50],{"id":31,"name":32,"tagline":33},"yf-100","YF-100","中国分级燃烧液氧煤油发动机，为新一代火箭提供动力",{"id":35,"name":36,"tagline":37},"ce-20","CE-20","印度首个自主研制的低温发动机，因形势所迫而诞生",{"id":39,"name":40,"tagline":41},"merlin-1d","Merlin 1D","九台引擎、一枚助推器，飞行并重复使用数十次",{"id":43,"name":44,"tagline":45},"le-9","LE-9","迄今为止最大的膨胀循环发动机——为H3火箭提供动力",{"id":47,"name":48,"tagline":49},"raptor","Raptor","全流量分级燃烧——最难的循环，终于升空",{"id":51,"name":52,"tagline":53},"vulcain-2","Vulcain 2","欧洲的氢燃料芯级发动机——每一枚Ariane 5都离不开它",[],[56],{"id":57,"name":58,"tagline":59},"long-march-5","长征五号 / 5B","中国航天计划的重型运载骨干",[],[],[],"/orrery/images/fleet-galleries/yf-77/01.webp"],"uses":{"params":["id"]}}]}
