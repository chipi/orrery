{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":39,"kin":48,"engines":73,"usedOn":74,"sites":75,"crewed":80,"museums":81,"hero":82},"https://www.orrerylearn.com/images/cards/fleet/yutu-2.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_missions":28,"linked_sites":30,"tagline":13,"description":33},"yutu-2","玉兔二号","rover","CNSA","China","CAST","2019-01-03","ACTIVE","2011-now","commercial-era","月球背面首个月球车；嫦娥四号","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Yutu-2 — Wikipedia","https://en.wikipedia.org/wiki/Yutu-2","intro",{"l":21,"u":22,"t":23},"玉兔二号 — CNSA","https://www.cnsa.gov.cn/","core",{"l":25,"u":26,"t":27},"Chang'e 4 / Yutu-2 — NASA NSSDCA","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=2018-103A","deep",[29],"change4",[31],{"type":32,"site_id":29},"moon","中国嫦娥四号探测车，月球背面首辆运行的探测车。2019年1月在冯·卡门环形山着陆，运行超过六年，远超其三个月的设计寿命；自2024年初以来基本处于静止状态。",[35],{"id":29,"name":36,"first":37,"year":38},"嫦娥四号 / 玉兔二号","月球背面首次软着陆",2018,[40,44],{"id":41,"name":42,"tagline":43},"long-march-3b","长征三号B","中国的地球同步转移轨道主力火箭——嫦娥月球着陆器和大多数中国通信卫星",{"id":45,"name":46,"tagline":47},"change-4","嫦娥四号","月球最远处第一次软着陆",[49,53,57,61,65,69],{"id":50,"name":51,"tagline":52},"zhurong","祝融","中国第一火星漫游者; 天问一号",{"id":54,"name":55,"tagline":56},"yutu","玉兔号","首个中国月球车；嫦娥三号",{"id":58,"name":59,"tagline":60},"perseverance","Perseverance（Mars 2020）","携带Ingenuity直升机；火星样品封存",{"id":62,"name":63,"tagline":64},"pragyan","Pragyan","首辆月球南极漫游车；Chandrayaan-3",{"id":66,"name":67,"tagline":68},"curiosity","Curiosity (MSL)","核动力火星科学实验室火星车",{"id":70,"name":71,"tagline":72},"exomars-rosalind-franklin","Rosalind Franklin (ExoMars rover)","ESA 的 2028 年火星漫游车——2 米钻头，在欧克西亚高原寻找生物标志。因 2022 年 Roscosmos 退出而暂停，改由 NASA 发射",[],[],[76],{"type":32,"href":77,"name":36,"place":78,"text":79},"/moon/change4","冯·卡门环形山","首个成功在月球背面着陆的航天器——从技术和运营角度而言，这是迄今为止难度最高的月球着陆任务。由于月球背面无法与地球直接通信，需要在L2位置部署中继卫星（鹊桥）提供通信支持。玉兔二号漫游车行驶超过1.6 km后于2024年3月进入静止状态；遥测数据传输至少持续到2024年9月。月球背面从未被访问过。",[],[],"/orrery/images/fleet-galleries/yutu-2/01.webp"],"uses":{"params":["id"]}}]}
