{"type":"data","nodes":[null,{"type":"data","data":[{"card":1,"entry":2,"missions":34,"alongside":39,"kin":47,"engines":72,"usedOn":73,"sites":74,"crewed":80,"museums":81,"hero":82},"https://www.orrerylearn.com/images/cards/fleet/yutu.jpg",{"id":3,"name":4,"category":5,"agency":6,"country":7,"manufacturer":8,"first_flight":9,"status":10,"era":11,"epoch":12,"best_known_for":13,"credit":14,"links":15,"linked_sites":28,"linked_missions":32,"tagline":13,"description":33},"yutu","玉兔号","rover","CNSA","China","CAST","2013-12-14","RETIRED","2011-now","commercial-era","首个中国月球车；嫦娥三号","Skeleton entry for /fleet (PRD-012 v0.2 / Phase A scaffold). Builder + agency + first-flight per public sources. Specs and gallery TBD in later phases.",[16,20,24],{"l":17,"u":18,"t":19},"Yutu (rover) — Wikipedia","https://en.wikipedia.org/wiki/Yutu_(rover)","intro",{"l":21,"u":22,"t":23},"玉兔号月球车 — CNSA","https://www.cnsa.gov.cn/","core",{"l":25,"u":26,"t":27},"Chang'e 3 / Yutu — NASA NSSDCA","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=2013-070A","deep",[29],{"type":30,"site_id":31},"moon","change3",[31],"玉兔是中国空间技术研究院在中国建造的行星漫游车。中国首辆月球车；嫦娥三号。任务于2016年结束。",[35],{"id":31,"name":36,"first":37,"year":38},"嫦娥三号","中国首次月球软着陆；部署了中国首个月球车玉兔",2013,[40,44],{"id":41,"name":42,"tagline":43},"long-march-3b","长征三号B","中国的地球同步转移轨道主力火箭——嫦娥月球着陆器和大多数中国通信卫星",{"id":45,"name":36,"tagline":46},"change-3","中国第一艘月球着陆器",[48,52,56,60,64,68],{"id":49,"name":50,"tagline":51},"yutu-2","玉兔二号","月球背面首个月球车；嫦娥四号",{"id":53,"name":54,"tagline":55},"zhurong","祝融","中国第一火星漫游者; 天问一号",{"id":57,"name":58,"tagline":59},"curiosity","Curiosity (MSL)","核动力火星科学实验室火星车",{"id":61,"name":62,"tagline":63},"perseverance","Perseverance（Mars 2020）","携带Ingenuity直升机；火星样品封存",{"id":65,"name":66,"tagline":67},"opportunity","Opportunity (MER-B)","Spirit的孪生探测器；在火星上运行近15年",{"id":69,"name":70,"tagline":71},"spirit","Spirit (MER-A)","火星探测漫游车;运作6年",[],[],[75],{"type":30,"href":76,"name":77,"place":78,"text":79},"/moon/change3","嫦娥三号 / 玉兔","雨海","中国首次月球着陆——37年来首次在月球任何地点的软着陆。嫦娥三号着陆器仍然活跃，使其成为有史以来最长寿的月球着陆器。玉兔号月球车行进了 114 m，之后其驱动机制失效，但其仪器继续返回科学数据。",[],[],"/orrery/images/fleet-galleries/yutu/03.webp"],"uses":{"params":["id"]}}]}
