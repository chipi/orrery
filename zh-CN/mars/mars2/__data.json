{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":42,"story":48,"illustration":67,"mission":67},{"id":3,"marker":4,"kind":5,"agency":6,"nation":7,"year":8,"landing_date":9,"lat":10,"lon":11,"region_bounds":12,"region_kind":17,"crewed":18,"status":19,"surface_status":20,"samples_kg":21,"data_quality":22,"credit":23,"fleet_refs":24,"links":30},"mars2","soviet-petal","surface","ROSCOSMOS","USSR",1971,"1971-11-27",-45,313,{"lat_min":13,"lat_max":14,"lon_min":15,"lon_max":16},-45.5,-44.5,312.5,313.5,"landing_ellipse",false,"CRASHED","completed",0,"partial","© Soviet Academy of Sciences (historical) — landing site approximate, NSSDCA catalogue.",[25,28],{"id":26,"role":27},"mars-2","spacecraft",{"id":29,"role":27},"mars2-orbiter",[31,35,39],{"l":32,"u":33,"t":34},"Mars 2 — Wikipedia","https://en.wikipedia.org/wiki/Mars_2","intro",{"l":36,"u":37,"t":38},"Марс-2 — русская Википедия","https://ru.wikipedia.org/wiki/%D0%9C%D0%B0%D1%80%D1%81-2","core",{"l":40,"u":41,"t":38},"Mars 2 — NASA NSSDCA","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1971-045A",{"name":43,"mission_type":44,"site_name":45,"fact":46,"capability":47},"Mars 2 着陆器","无人着陆器 · 坠毁","约 45°S、313°E（希腊平原）","首个到达火星表面的人造物体——通过撞击。该着陆器的降落伞在1971年11月27日的进入/下降/着陆阶段失效；它在赫拉斯地区以高速坠毁。轨道器组件继续传回数据达八个月之久。Mars 2标志着苏联在1971年发射窗口期间试图超越美国抢先登陆火星表面的开始。","证明了在单个发射窗口内到达火星表面——即使是通过撞击——是可以实现的。",{"site":3,"intro":49,"essay":-1,"chapters":50},"1971 年 11 月 27 日,在 Mars 2 进入环火轨道前几小时,它的下降舱分离并飞向火星表面。下降系统出了故障——很可能是进入角过陡——降落伞没有打开,下降舱撞上地面:这是第一个到达火星表面的人造物体。舱内载有 PrOP-M,一台设计成拖着电缆、用滑橇行走的小型火星车。轨道器则一直工作到 1972 年。",[51,59],{"id":52,"title":53,"subtitle":54,"images":55},"arrival","抵达","1971 年 11 月 27 日 — 第一个到达火星的物体",[56],{"src":57,"caption":58},"/images/missions/mars2/02.webp","1972 年苏联为 Mars 2 自动行星际站发行的邮票:它携带的纪念旗于 1971 年 11 月 27 日到达火星。",{"id":60,"title":61,"subtitle":62,"images":63},"hardware","硬件","与 Mars 3 相同的下降舱",[64],{"src":65,"caption":66},"/images/missions/mars2/03.webp","Mars 3下降舱的博物馆模型——Mars 2携带的是同样的设计。五天后Mars 3软着陆，并发送信号14.5秒。",null],"uses":{"params":["id"]}}]}
