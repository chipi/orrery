,10.5606,-21432,-2028,[466,467,76,468],10.6848,-17962,-3710,[470,471,76,472],10.8091,-15116,-4893,[474,475,76,476],10.9333,-12738,-5726,[478,479,76,480],11.0576,-10719,-6307,[482,483,76,484],11.1818,-8979,-6702,[486,487,76,488],11.3061,-7460,-6958,[490,491,76,492],11.4303,-6119,-7107,[494,495,76,496],11.5545,-4923,-7173,[498,499,76,500],11.6788,-3844,-7171,[502,503,76,504],11.803,-2864,-7115,[506,507,76,508],11.9273,-1966,-7013,[510,511,76,512],12.0515,-1137,-6872,[514,515,76,516],12.3,356,-6488,[518,515,76,516],12.3001,{"entry_velocity_km_s":520,"edl_system":521,"edl_duration_s":522,"touchdown_velocity_ms":523},1.695,"powered",718,2.07,[525,530,535,540,542,547,552,557,562,567],{"met_days":76,"type":526,"label":527,"description":528,"label_en":529},"launch","发射","土星五号（AS-510）从肯尼迪航天中心 LC-39A发射台发射，1971年7月26日13:34 UTC。","Launch — Saturn V",{"met_days":79,"type":531,"label":532,"description":533,"label_en":534},"tli_or_tmi","TLI","月球转移注入。","Trans-lunar injection",{"met_days":114,"type":536,"label":537,"description":538,"label_en":539},"tcm","中途修正","GET 28:40:22（1971-07-27 18:14 UTC）SPS 发动机点火，0.8 秒、5.3 英尺/秒（1.6 米/秒），同时兼作 SPS 发动机测试。","Midcourse correction",{"met_days":174,"type":536,"label":537,"description":541,"label_en":539},"GET 73:31:15（1971-07-29 15:05 UTC）SPS 发动机点火，0.9 秒、5.4 英尺/秒（1.6 米/秒），月球轨道入轨前最后一次地月转移途中修正。",{"met_days":178,"type":543,"label":544,"description":545,"label_en":546},"loi","LOI","月球轨道插入。SPS ∆v ≈0.91 km/s。","Lunar orbit insertion",{"met_days":222,"type":548,"label":549,"description":550,"label_en":551},"descent_start","着陆","Falcon在Hadley-Apennine着陆，1971年7月30日22:16 UTC——在 Hadley 月溪旁、Apennine 山脉脚下着陆。","LM Falcon powered descent",{"met_days":337,"type":553,"label":554,"description":555,"label_en":556},"ascent","上升","Falcon在表面停留66小时55分钟后升空。携带77 kg样品，首次舱外活动上升由月球车安装的摄像机直播（由休斯顿远程操控）。","LM Falcon ascent",{"met_days":422,"type":558,"label":559,"description":560,"label_en":561},"tei","TEI","地月转移注入。SPS ∆v ≈1.0 km/s。","Trans-earth injection",{"met_days":563,"type":536,"label":564,"description":565,"label_en":566},12.164,"返回地球途中修正","GET 291:56:50（1971-08-07 17:30 UTC）22.3 秒 RCS 修正，5.6 英尺/秒，距再入三小时。","Trans-earth midcourse correction",{"met_days":514,"type":568,"label":569,"description":570,"label_en":571},"earth_return","溅落","指挥舱于1971年8月7日20:46 UTC在北太平洋溅落。三个主降落伞中的一个未能完全展开；着陆冲击力大但乘员安全。由USS Okinawa执行回收。","Splashdown — Pacific Ocean","Apollo 15","有人登月器 · 已飞行","首次J型任务——延长停留、首辆月球车、“创世纪岩”","到Apollo 15时，竞争早已结束，科学接过了方向盘——字面意义上的。这是首次搭载月球车的飞行，它把两英里的步行半径扩大为十八英里的正式野外考察，而且着陆点不是安全平坦的平原，而是山脉与蜿蜒峡谷之间的山谷。斯科特和艾尔文带回了“创世纪岩”，这块四十亿年前的月球原始地壳碎片证实了月壳是如何形成的。Apollo已不再只是造访月球，而是开始研究它——而且直到被取消，它在这方面一直越做越好。","首次“J型任务”——配有新型月球车、延长停留的科学型Apollo任务。月球车使斯科特和艾尔文的活动范围达到27.9 km（仅靠步行的Apollo 14为3.5 km），让他们得以进入壮观的哈德利—亚平宁着陆点：它位于一座4.5 km高的山脉脚下，紧邻蜿蜒的哈德利沟纹边缘。共进行三次舱外活动，总计18小时35分钟，带回77 kg样本，其中包括著名的“创世纪岩”（样本15415）——一块41亿年前的斜长岩，证实了月球高地地壳源自岩浆洋。斯科特电视直播中的“锤子与羽毛同时落下”实验，当场验证了伽利略的引力定律。沃尔登留在月球轨道上，操作装有遥感仪器的SIM舱（测绘相机、伽马射线谱仪、X射线谱仪、阿尔法粒子谱仪），并在返航途中进行了首次深空舱外活动（约39分钟，距地球约317 000 km），去取回胶片罐。Apollo 15的回收环节出了岔子：三具降落伞中有一具没有打开——指令舱重重溅落，但乘组安然无恙。",[578,579,580],{"met":114,"label":537,"description":538},{"met":174,"label":537,"description":541},{"met":563,"label":564,"description":565},[582,584,585,586,588,593,597,601,602,603,607],{"met":76,"label":527,"note":528,"type":583},"nominal",{"met":79,"label":532,"note":533,"type":583},{"met":178,"label":544,"note":545,"type":583},{"met":587,"label":549,"note":550,"type":583},4.363,{"met":589,"label":590,"note":591,"type":592},5,"首次月球车行走","EVA-1：首次月球车部署与10.3 km行走路线，目的地为肘部陨石坑和哈德利沟纹坑缘。","info",{"met":594,"label":595,"note":596,"type":592},5.5,"创世纪岩石","EVA-2：在支撑陨石坑处，斯科特和艾尔文回收样品15415——来自月球原始地壳的距今41亿年斜长岩。",{"met":598,"label":599,"note":600,"type":592},6.1,"锤羽毛坠落","EVA-3/上升前：斯科特在电视直播中将锤和羽毛一起放下；两者同时击中月壤，实时验证了伽利略 1589年的预言。",{"met":337,"label":554,"note":555,"type":583},{"met":422,"label":559,"note":560,"type":583},{"met":604,"label":605,"note":606,"type":592},9.5,"深空舱外活动","沃尔登执行有史以来首次地月空间舱外活动（约39分钟，距地球约317 000 km），回收SIM舱胶片筒。",{"met":514,"label":569,"note":570,"type":608},"warning","/orrery/images/missions/apollo15/02.webp"],"uses":{"params":["id"]}}]}
