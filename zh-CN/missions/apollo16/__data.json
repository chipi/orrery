,[476,477,72,478],10.07,-9998,-4638,[480,481,72,482],10.1819,-8627,-5192,[484,485,72,486],10.2938,-7395,-5611,[488,489,72,490],10.4057,-6278,-5924,[492,493,72,494],10.5176,-5255,-6150,[496,497,72,498],10.6294,-4312,-6306,[500,501,72,502],10.7413,-3434,-6401,[504,505,72,506],10.8532,-2612,-6446,[508,509,72,510],11.077,-1102,-6404,[512,509,72,510],11.0771,{"entry_velocity_km_s":514,"edl_system":515,"edl_duration_s":516,"touchdown_velocity_ms":517},1.695,"powered",742,0.46,[519,524,529,534,539,544,549,554,558,561],{"met_days":72,"type":520,"label":521,"description":522,"label_en":523},"launch","发射","Saturn V (AS-511) 从肯尼迪航天中心 LC-39A 发射，1972-04-16 17:54 UTC。","Launch — Saturn V",{"met_days":75,"type":525,"label":526,"description":527,"label_en":528},"tli_or_tmi","TLI","地月转移轨道射入。","Trans-lunar injection",{"met_days":114,"type":530,"label":531,"description":532,"label_en":533},"tcm","中途修正","GET 30:39:01（1972-04-18 00:33 UTC）SPS 发动机点火，2.0 秒、12.5 英尺/秒（3.8 米/秒），唯一一次地月转移途中修正。","Midcourse correction",{"met_days":182,"type":535,"label":536,"description":537,"label_en":538},"loi","LOI","月球轨道插入。SPS Δv ~0.91 km/s。","Lunar orbit insertion",{"met_days":236,"type":540,"label":541,"description":542,"label_en":543},"descent_start","触地","Orion于1972-04-21 02:23 UTC在笛卡尔高地着陆——首次高地（非月海）着陆。","LM Orion powered descent",{"met_days":366,"type":545,"label":546,"description":547,"label_en":548},"ascent","上升","Orion在表面停留71小时02分后升空。返回样品95.7 kg——迄今为止Apollo最重的收获。","LM Orion ascent",{"met_days":416,"type":550,"label":551,"description":552,"label_en":553},"tei","TEI","地心转移。SPS Δv ~1.0 km/s。","Trans-earth injection",{"met_days":436,"type":530,"label":555,"description":556,"label_en":557},"返回地球途中修正","GET 214:35:03（1972-04-25 16:29 UTC）8.0 秒 RCS 修正，3.4 英尺/秒；GET 262:37:21 还有一次 3.2 秒微调。","Trans-earth midcourse correction",{"met_days":559,"type":530,"label":555,"description":560,"label_en":557},10.943,"GET 262:37:21（1972-04-27 16:31 UTC）最终再入走廊微调，1.4 英尺/秒。",{"met_days":508,"type":562,"label":563,"description":564,"label_en":565},"earth_return","溅落","指挥舱于1972-04-27 19:45 UTC在中太平洋溅落。由USS Ticonderoga号完成回收。","Splashdown — Pacific Ocean","Apollo 16","Apollo 16前往月球高地采集远古火山的样本，结果发现那里从来没有过火山。地质学家们坚信苍白而崎岖的笛卡尔地区是火山成因；然而扬和杜克带回的几乎每一块岩石都是角砾岩——被撞击焊接在一起的碎石——没有一块是火山岩。出错本身就是收获：月球明亮的高地原来记录的是年轻太阳系遭受无休止轰击的历史，而不是火山喷发。这清楚地说明了探索究竟如何物有所值——你去是为了印证自以为已知的事，那个地方却告诉你更好的东西。","载人着陆器 · 已飞行","首次降落在月球高地——笛卡尔；约翰·扬的“月球大奖赛”","第五次载人登月，也是首次降落在非月海的高地地点。地质学家原本预计笛卡尔地区是火山成因；Apollo 16推翻了这一点——带回的岩石几乎全是角砾岩（被撞击震碎的碎屑），没有一块是火山岩，从而改变了人们对月球高地的认识：它是灾难性撞击的产物，而非远古火山活动的产物。扬和杜克完成三次借助月球车的舱外活动，总计20小时14分钟，行驶26.7 km，带回95.7 kg样本（当时Apollo任务中最重的一批）。扬的“月球大奖赛”——对月球车进行的电视直播速度测试——峰值约17 km/h。在第三次舱外活动结束时，杜克在尝试跳高时向后摔倒在其PLSS背包上。查理·杜克的家庭照片，与“Far-UV Camera/Spectrograph”——首座在另一个世界表面运行的天文台——都留在了着陆点。马丁利原本在Apollo 13的乘组中（因担心德国麻疹在发射前被换下），这次终于飞到了月球。",[572,573,574],{"met":114,"label":531,"description":532},{"met":436,"label":555,"description":556},{"met":559,"label":555,"description":560},[576,578,579,580,585,587,592,596,600,601,602],{"met":72,"label":521,"note":522,"type":577},"nominal",{"met":75,"label":526,"note":527,"type":577},{"met":182,"label":536,"note":537,"type":577},{"met":581,"label":582,"note":583,"type":584},4.174,"SPS 异常","下降前：备用SPS万向节振荡迫使进行了6小时的着陆对比中止工程评审，实时进行。最终批准着陆。","warning",{"met":586,"label":541,"note":542,"type":577},4.354,{"met":588,"label":589,"note":590,"type":591},5.5,"首次高地出舱","EVA-1：ALSEP部署+月球车部署+首次月球高地科学巡视。","info",{"met":593,"label":594,"note":595,"type":591},6.1,"月面大奖赛","EVA-2：扬的电视直播月球车速度测试（\"月球大奖赛\"）——峰值速度~17 km/h。地质巡视至石头山。",{"met":597,"label":598,"note":599,"type":591},6.7,"远紫外相机","EVA-3：首个在其他天体表面部署的天文观测台（NRL紫外线照相分光仪）。",{"met":366,"label":546,"note":547,"type":577},{"met":416,"label":551,"note":552,"type":577},{"met":508,"label":563,"note":564,"type":577},"/orrery/images/missions/apollo16/06.webp"],"uses":{"params":["id"]}}]}
