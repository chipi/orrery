bel_en":511},"launch","发射","长征三号A 从西昌 LC-3 于 2007-10-24 10:05 UTC 发射。","Launch — Long March 3A",{"met_days":292,"type":513,"label":514,"description":515,"label_en":516},"tli_or_tmi","月球转移注入","经地球停泊轨道和变轨轨道进行月球转移注入。","Trans-lunar injection",{"met_days":421,"type":518,"label":519,"description":520,"label_en":521},"edl_or_oi","月球轨道舱入轨","月球轨道舱入轨 2007年11月5日 ——首个到达月球的中国航天器。","LOI-1 — lunar capture",{"met_days":455,"type":518,"label":523,"description":524,"label_en":525},"LOI-2——降低月球轨道","2007-11-06 03:21 UT。第二次制动点火持续 14 分钟（至 03:35 UT），把轨道降至周期 3.5 小时、213 × 1,700 km。","LOI-2 — lunar orbit lowered",{"met_days":485,"type":518,"label":527,"description":528,"label_en":529},"LOI-3——到达 200 km月球科学轨道","2007-11-07 00:24 UT。最后一次 10 分钟点火（至 00:34 UT）把探测器减速至 1.59 km/s，进入圆形、200 km、127 分钟、大倾角的科学轨道。","LOI-3 — 200 km lunar science orbit reached","嫦娥一号","机器人轨道器 · 已飞行","中国首次月球任务，中国首个到达月球的航天器","中国探月工程（CLEP）的第一阶段，也是国家航天局首次飞出地球的任务。2007-10-24由长征三号甲从西昌卫星发射中心发射，嫦娥一号（得名于中国民间传说中的月亮女神）于2007-11-07进入200 km高度的圆形极月轨道。搭载8台仪器——CCD立体相机、激光高度计、成像光谱仪、伽马射线谱仪和X射线谱仪、微波辐射计、太阳风探测器和高能粒子探测器。制作了中国首幅全月球地形图，分辨率为120–200 m，以及Th、K、U、O、Si、Mg、Al、Ca、Ti、Fe的元素丰度图。任务于2009-03-01在丰富海的1.50°S、52.36°E以受控撞击告终——这是中国第一件抵达月面的物体，为嫦娥三号（2013年月面着陆）和嫦娥五号（2020年采样返回）铺平了道路。共运行16个月——比额定寿命多出4个月。",[535,536],{"met":455,"label":523,"description":524},{"met":485,"label":527,"description":528},[538,540,541,542,546],{"met":55,"label":509,"note":510,"type":539},"nominal",{"met":292,"label":514,"note":515,"type":539},{"met":421,"label":519,"note":520,"type":539},{"met":49,"label":543,"note":544,"type":545},"全月球地形图","CCD立体相机与激光高度计获得中国首幅全月球地形图，分辨率120-200米。","info",{"met":547,"label":548,"note":549,"type":539},494,"丰富海撞击","受控撞击地点为南纬1.50°、东经52.36°，时间2009年3月1日——中国首个到达月面的物体。","/orrery/images/missions/change1/01.webp"],"uses":{"params":["id"]}}]}
