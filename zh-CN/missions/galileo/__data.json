.52,-4.527072,-0.076882,[439,440,59,441],1998.309,-4.621261,-0.227133,[443,444,59,445],2022.099,-4.70205,-0.385267,[447,448,59,449],2045.888,-4.772881,-0.547414,[451,452,59,453],2069.677,-4.834557,-0.712897,[455,456,59,457],2093.467,-4.879359,-0.882557,[459,460,59,461],2117.1,-4.910487,-1.053731,[463,464,59,465],2140.73,-4.930196,-1.225675,[467,468,59,469],2164.359,-4.931183,-1.39734,[471,472,59,473],2187.989,-4.915626,-1.566771,[475,476,59,477],2211.619,-4.887577,-1.73386,[12,479,59,480],-4.828447,-1.939345,[482,479,59,480],2258.9924,[484,479,59,480],2282.7818,[486,479,59,480],2306.5712,[488,479,59,480],2330.3606,[490,479,59,480],2354.15,{"vehicle_stage":492,"departure":493},"惯性上面级 Inertial Upper Stage（IUS）","kick-stage","Galileo","轨道飞行器 · 已飞行","第一个绕木星轨道运行的航天器；向木星大气释放探测器","Galileo本该在抵达之前就已丧失大半能力。它的主天线在飞往木星途中只展开了一半，数据速率降到了涓涓细流——但任务依然成功，因为地球上的工程师重写了它的软件，让科学数据挤过一台小小的备用天线。它成为第一个绕木星运行的航天器，向这颗巨行星的云层投下探测器，并花了八年时间巡游各个卫星。它最伟大的发现正是从这种坚持中慢慢浮现的：木星磁场环绕木卫二的方式，只能用冰层之下的咸水海洋来解释——这是迄今最有力的证据，表明木星的一颗卫星可能含有液态水，甚至生命。最后，人们有意让它坠入木星，以确保它永远不会落到木卫二上并污染它。","Galileo在Challenger事故后的漫长停飞期结束后，由Space Shuttle Atlantis发射升空，闯过内侧小行星带，首次从轨道上对木星及其卫星展开长期研究。它发现了木卫二的感应磁场——存在地下海洋的有力证据——并目睹苏梅克－列维9号彗星撞向木星。任务于2003年以受控坠入木星告终，以免污染可能具备生命条件的冰质卫星。",[500,502],{"met":59,"label":61,"note":62,"type":501},"nominal",{"met":12,"label":98,"note":99,"type":501},[504,505,506,507,508,509],{"met":65,"label":67,"description":68},{"met":71,"label":72,"description":73},{"met":76,"label":77,"description":78},{"met":81,"label":82,"description":83},{"met":86,"label":87,"description":88},{"met":91,"label":93,"description":94},"/orrery/images/missions/galileo/01.webp"],"uses":{"params":["id"]}}]}
