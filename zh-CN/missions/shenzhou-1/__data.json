{"type":"data","nodes":[null,{"type":"data","data":[{"mission":1,"hero":65},{"id":2,"agency":3,"agency_full":4,"sector":5,"dest":6,"color":7,"year":8,"status":9,"departure_date":10,"arrival_date":11,"transit_days":12,"round_trip":13,"vehicle":14,"payload":15,"delta_v":16,"data_quality":17,"credit":18,"links":19,"flight_data_quality":32,"fleet_refs":33,"name":43,"type":44,"first":45,"description":46,"events":47},"shenzhou-1","CMSA","China National Space Administration / China Aerospace Science and Technology Corporation","gov","EARTH","#de2910",1999,"FLOWN","1999-11-19","1999-11-20",1,true,"长征二号F","发射质量 7600 kg；搭载模拟系统的无人神舟原型飞船","~9.4 km/s（近地轨道）","good","© CNSA mission report. Public domain / archive.",[20,24,28],{"l":21,"u":22,"t":23},"Shenzhou 1 — Wikipedia","https://en.wikipedia.org/wiki/Shenzhou_1","intro",{"l":25,"u":26,"t":27},"Long March 2F — Wikipedia","https://en.wikipedia.org/wiki/Long_March_2F","core",{"l":29,"u":30,"t":31},"Shenzhou programme overview (NASA NSSDCA)","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1999-061A","deep","reconstructed",[34,37,40],{"id":35,"role":36},"long-march-2f","launcher",{"id":38,"role":39},"shenzhou","spacecraft",{"id":41,"role":42},"jiuquan-slc-43","launch-site","神舟一号","载人航天器试验 · 无人 · 已飞行","中国首次神舟轨道试验——开启了中国独立载人航天的道路","神舟载人航天器计划的首次飞行。1999年11月19日22:30 UTC从酒泉发射，搭乘首飞的载人级长征二号F（CZ-2F）。返回舱在高度195 × 315 km、倾角42.6°的轨道上完成14圈，并于1999年11月20日19:41 UTC重新进入地球大气层，在内蒙古草原成功回收。搭载了一个模拟载荷和约100 kg暴露于太空环境的种子。标志着中国致力于继苏联和美国之后独立进行载人航天飞行；又经过三次无人试验，促成了2003年搭载杨利伟的神舟五号飞行。",[48,53,57,61],{"met":49,"label":50,"note":51,"type":52},0,"发射","长征二号F从酒泉LA-4发射台首次飞行，时间为1999年11月19日22:30（协调世界时）。","nominal",{"met":54,"label":55,"note":56,"type":52},0.001,"入轨","在195 × 315 km、倾角42.6°的轨道上完成14圈飞行。",{"met":58,"label":59,"note":60,"type":52},0.875,"变轨","服务舱在非洲上空进行变轨制动。",{"met":62,"label":63,"note":64,"type":52},0.882,"回收","返回舱降落到内蒙古多伦县，时间为1999年11月20日19:41 UTC。","/orrery/images/missions/shenzhou-1/01.webp"],"uses":{"params":["id"]}}]}
