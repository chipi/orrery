{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":27,"story":33,"illustration":33,"mission":34},{"id":3,"marker":4,"kind":4,"agency":5,"nation":6,"year":7,"altitude_km":8,"inclination_deg":9,"eccentricity":10,"status":11,"surface_status":12,"samples_kg":10,"data_quality":13,"credit":14,"mission_id":3,"links":15,"fleet_refs":24},"chandrayaan1","orbiter","ISRO","India",2008,100,90,0,"ENDED","completed","good","© ISRO — India's first lunar mission. Carried NASA's Moon Mineralogy Mapper, which directly confirmed water across the lunar surface in 2009.",[16,20],{"l":17,"u":18,"t":19},"Chandrayaan-1 — Wikipedia","https://en.wikipedia.org/wiki/Chandrayaan-1","intro",{"l":21,"u":22,"t":23},"Chandrayaan-1 — ISRO","https://www.isro.gov.in/Chandrayaan_1.html","core",[25],{"id":3,"role":26},"spacecraft",{"name":28,"mission_type":29,"site_name":30,"fact":31,"capability":32},"Chandrayaan-1","月球轨道器 · 2009年结束","月球极地轨道，100 km","印度首次登月任务。搭载了NASA的月球矿物测绘仪(M³)——该仪器在2009年首次通过轨道分光光度法确认了水(H₂O和OH)广泛分布在月球表面，而不仅仅在极地。任务在312天后因通信丧失而结束；M³的数据至今仍在被分析。","首次在全球范围内直接确认月球表面水的存在；改变了随后每一份月球资源利用路线图。",null,{"id":3,"name":28,"first":35,"hardware":36},"印度首次月球任务；确认月球上广泛存在水",[37,41],{"id":38,"name":39,"tagline":40},"pslv-xl","PSLV-XL","ISRO 的重型捆绑助推器版 PSLV——Chandrayaan-1 与 Mars Orbiter",{"id":42,"name":43,"tagline":44},"sriharikota-slp","斯里赫里戈达 SLP","印度重型发射台——GSLV Mk III / LVM3，通向Chandrayaan-3，以及即将开始的Gaganyaan载人项目"],"uses":{"params":["id"]}}]}
