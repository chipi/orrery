{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":41,"story":49,"illustration":86,"mission":86},{"id":3,"marker":4,"kind":5,"agency":6,"nation":7,"year":8,"landing_date":9,"lat":10,"lon":11,"region_bounds":12,"region_kind":17,"crewed":18,"status":19,"surface_status":20,"surface_duration_days":21,"samples_kg":22,"data_quality":23,"credit":24,"fleet_refs":25,"links":29},"change5","sample-return","surface","CNSA","China",2020,"2020-12-01",43.0576,-51.9161,{"lat_min":13,"lat_max":14,"lon_min":15,"lon_max":16},43.0376,43.0776,-51.9561,-51.8761,"landing_ellipse",false,"FLOWN","completed",2,1.731,"good","© CNSA. Sample mass 1.731 kg returned to Earth 2020-12-16; first lunar samples since Luna 24 (1976).",[26],{"id":27,"role":28},"change-5","spacecraft",[30,34,37],{"l":31,"u":32,"t":33},"Chang'e 5 — Wikipedia","https://en.wikipedia.org/wiki/Chang%27e_5","intro",{"l":35,"u":36,"t":33},"中国探月与深空探测网 (CLEP)","http://www.clep.org.cn/",{"l":38,"u":39,"t":40},"嫦娥五号 — 中文维基百科","https://zh.wikipedia.org/wiki/%E5%AB%A6%E5%A8%A5%E4%BA%94%E5%8F%B7","core",{"name":42,"mission_type":43,"site_name":44,"crew":45,"left":46,"fact":47,"capability":48},"嫦娥五号","无人样品返回","吕姆克山（风暴洋）",[],"下降段、钻探设备","44 年来首次月球样本返回——结束了自 Luna 24 (1976) 以来的空白。从一个地质年代较年轻的地区（20 亿年前，而 Apollo 样本为 30–40 亿年前）带回 1.731 公斤样本。改写了我们对月球火山作用的理解：月球的地质活动比预想的晚得多。","现代机器人样本返回架构——火星样本返回着陆器/上升器/轨道器链的直接先驱。",{"site":3,"intro":50,"essay":-1,"chapters":51},"嫦娥五号于2020年12月1日降落在吕姆克山——这是中国首次月球采样返回任务，也是自1976年Luna 24以来、时隔44年由任何国家实施的首次月球采样返回。任务从年轻的火山地貌带回1,731克样品（年龄约20亿年，而Apollo样品约为35亿年），证明月球火山活动持续的时间远比此前所知的晚得多。",[52,63,71,78],{"id":53,"title":54,"subtitle":55,"images":56},"hardware","硬件","着陆器＋上升器＋轨道器＋返回器",[57,60],{"src":58,"caption":59},"/images/missions/change5/01.webp","嫦娥五号组合体——四器一体：着陆器/上升器（月面）、轨道器（月球轨道交会）、返回器（返回地球）。",{"src":61,"caption":62},"/images/missions/change5/02.webp","钻取＋表取子系统——可从月表以及1米以上深度采集样品。",{"id":64,"title":65,"subtitle":66,"images":67},"launch","发射","2020年11月23日——长征五号自文昌发射",[68],{"src":69,"caption":70},"/images/missions/change5/03.webp","长征五号发射嫦娥五号——这是中国当时最具雄心的月球任务，全程自动化，往返共23天。",{"id":5,"title":72,"subtitle":73,"images":74},"月面","吕姆克山——2020年12月1日着陆",[75],{"src":76,"caption":77},"/images/missions/change5/04.webp","嫦娥五号在吕姆克山附近的月面上——上升级起飞前共工作19小时。",{"id":79,"title":80,"subtitle":81,"images":82},"science","科学成果","20亿年前的月球火山活动改写月球热演化史",[83],{"src":84,"caption":85},"/images/missions/change5/05.webp","样品返回器落在内蒙古的雪地上，2020年12月17日——1,731克年轻玄武岩回到地球。",null],"uses":{"params":["id"]}}]}
