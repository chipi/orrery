{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":42,"story":50,"illustration":84,"mission":84},{"id":3,"marker":4,"kind":5,"agency":6,"nation":7,"year":8,"landing_date":9,"lat":10,"lon":11,"region_bounds":12,"region_kind":17,"crewed":18,"status":19,"surface_status":20,"surface_duration_days":21,"samples_kg":22,"data_quality":23,"credit":24,"fleet_refs":25,"links":30},"change6","sample-return","surface","CNSA","China",2024,"2024-06-01",-41.6385,-153.9852,{"lat_min":13,"lat_max":14,"lon_min":15,"lon_max":16},-41.6885,-41.5885,-154.0352,-153.9352,"landing_ellipse",false,"FLOWN","completed",2,1.935,"good","© CNSA. First sample return from the lunar far side; samples returned to Earth 2024-06-25.",[26,29],{"id":27,"role":28},"change-5","spacecraft",{"id":3,"role":28},[31,35,38],{"l":32,"u":33,"t":34},"Chang'e 6 — Wikipedia","https://en.wikipedia.org/wiki/Chang%27e_6","intro",{"l":36,"u":37,"t":34},"中国探月与深空探测网 (CLEP)","http://www.clep.org.cn/",{"l":39,"u":40,"t":41},"嫦娥六号 — 中文维基百科","https://zh.wikipedia.org/wiki/%E5%AB%A6%E5%A8%A5%E5%85%AD%E5%8F%B7","core",{"name":43,"mission_type":44,"site_name":45,"crew":46,"left":47,"fact":48,"capability":49},"嫦娥六号","无人样品返回（背面）","阿波罗环形山（月球背面）",[],"下降级","首次从月球背面采样返回——可能是自Apollo以来最具科学意义的月球任务。月球背面物质（厚壳层、较古老的表面、不同的组成）此前完全未被研究过。这些样本可能最终能够解释为什么月球的两个半球如此根本上不同。","从中继站点采样返回——结合了经鹊桥中继卫星（嫦娥六号使用鹊桥二号）实现的月球背面中继通信，以及嫦娥五号的采样返回架构。具备火星样本返回在任何纬度所需的全套能力。",{"site":3,"intro":51,"essay":-1,"chapters":52},"嫦娥六号于2024年6月1日降落在南极—艾特肯盆地，这是人类首次从月球背面采样返回的任务；该盆地是内太阳系中最深、最古老、最大的撞击构造。2024年6月25日，嫦娥六号将1,935克月背物质带回地球——这些样品中可能含有来自42亿年前形成该盆地的那次撞击的月幔碎片。",[53,61,69,76],{"id":54,"title":55,"subtitle":56,"images":57},"hardware","硬件","在嫦娥五号基础上重新设计，用于月背采样返回",[58],{"src":59,"caption":60},"/images/missions/change6/01.webp","嫦娥六号组合体——新增鹊桥二号中继星以实现月背通信，其余基本沿用嫦娥五号的架构。",{"id":62,"title":63,"subtitle":64,"images":65},"launch","发射","2024年5月3日——长征五号，文昌发射场",[66],{"src":67,"caption":68},"/images/missions/change6/03.webp","长征五号发射嫦娥六号——往返月球背面共28天，其中包括等待合适中继通信窗口的14天。",{"id":5,"title":70,"subtitle":71,"images":72},"月面","Apollo撞击坑（位于南极—艾特肯盆地内）——2024年6月1日降落",[73],{"src":74,"caption":75},"/images/missions/change6/04.webp","嫦娥六号着陆器在月球背面——不依靠月球车的定点采样返回，由释放的微型巡视器拍摄。",{"id":77,"title":78,"subtitle":79,"images":80},"science","科学","1,935克南极—艾特肯盆地物质",[81],{"src":82,"caption":83},"/images/missions/change6/02.webp","嫦娥六号从月球背面带回的样品，在2024年米兰国际宇航大会上展出。",null],"uses":{"params":["id"]}}]}
