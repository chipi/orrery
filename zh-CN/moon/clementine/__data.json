{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":25,"story":31,"illustration":31,"mission":31},{"id":3,"marker":4,"kind":4,"agency":5,"nation":6,"year":7,"altitude_km":8,"inclination_deg":9,"eccentricity":10,"status":11,"surface_status":12,"samples_kg":13,"data_quality":14,"credit":15,"links":16},"clementine","orbiter","NASA","USA",1994,425,90,0.36,"ENDED","completed",0,"good","© NASA / DoD Strategic Defense Initiative — joint defence/civilian mission, 1994.",[17,21],{"l":18,"u":19,"t":20},"Clementine — Wikipedia","https://en.wikipedia.org/wiki/Clementine_(spacecraft)","intro",{"l":22,"u":23,"t":24},"Clementine — NASA NSSDCA","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1994-004A","core",{"name":26,"mission_type":27,"site_name":28,"fact":29,"capability":30},"Clementine","轨道器 · 1994年结束","月球极轨道","美国国防部与NASA联合的战略防御计划任务。耗时十周，以11个光谱波段绘制月球地图——首次进行系统的全球多光谱制图。在南极进行的双基雷达测量首次发现了极地水冰的迹象，后来被Lunar Prospector和Chandrayaan-1所证实。","月球极地水冰的首次发现——这一发现激励了随后的每一项南极任务，包括Artemis载人登月。",null],"uses":{"params":["id"]}}]}
