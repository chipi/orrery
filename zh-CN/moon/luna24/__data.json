{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":39,"story":47,"illustration":79,"mission":79},{"id":3,"marker":4,"kind":5,"agency":6,"nation":7,"year":8,"landing_date":9,"lat":10,"lon":11,"region_bounds":12,"region_kind":17,"crewed":18,"status":19,"surface_status":20,"surface_duration_days":21,"samples_kg":22,"data_quality":23,"credit":24,"fleet_refs":25,"links":30},"luna24","sample-return","surface","ROSCOSMOS","USSR",1976,"1976-08-18",12.7142,62.2129,{"lat_min":13,"lat_max":14,"lon_min":15,"lon_max":16},12.6942,12.7342,62.1929,62.2329,"landing_ellipse",false,"FLOWN","completed",1,0.17,"good","© Soviet Academy of Sciences (historical). Sample mass: 170 g of regolith returned to Earth 1976-08-22.",[26,29],{"id":27,"role":28},"luna-16","spacecraft",{"id":3,"role":28},[31,35],{"l":32,"u":33,"t":34},"Luna 24 — Wikipedia","https://en.wikipedia.org/wiki/Luna_24","intro",{"l":36,"u":37,"t":38},"Луна-24 — русская Википедия","https://ru.wikipedia.org/wiki/%D0%9B%D1%83%D0%BD%D0%B0-24","core",{"name":40,"mission_type":41,"site_name":42,"crew":43,"left":44,"fact":45,"capability":46},"Luna 24","无人样品返回","危海",[],"下降级、钻探装置","最后一次苏联月球任务——也是最后一次无人月球着陆，直到2013年中国的嫦娥三号：间隔37年。返回了170克样品，包括含水矿物，预示了后来发现的月球水冰。","展示了机器人样品返回——这是火星样品返回任务正在尝试进行的行星际规模的架构。",{"site":3,"intro":48,"essay":-1,"chapters":49},"Luna 24 于1976年8月18日降落在危海——这是20世纪苏联最后一次（也是最后一次无人）月球采样返回任务，并且直到2013年中国的嫦娥三号之前，它也是最后一个任何类型的月球着陆器。它向月壤钻探了2米，将170.1克样品带回地球，其中包含月球水冰的证据（数十年后被 SOFIA 与 LCROSS 再次证实）。苏联的月球计划就此画上句号。",[50,61,71],{"id":51,"title":52,"subtitle":53,"images":54},"hardware","硬件","苏联 E-8-5M 着陆器——改进型采样返回装置",[55,58],{"src":56,"caption":57},"/images/missions/luna24/01.webp","陈列于一家苏联航天博物馆的 Luna 24 探测器——下降级 + 上升器 + 返回舱。",{"src":59,"caption":60},"/images/missions/luna24/02.webp","钻取机构——钻入深度达2米，是 Luna 16 的35厘米的三倍。它带回了人类从另一个天体取得的最深样品。",{"id":5,"title":62,"subtitle":63,"images":64},"表面","危海——1976年8月18日着陆",[65,68],{"src":66,"caption":67},"/images/missions/luna24/03.webp","危海着陆点——Luna 24 降落在距 Luna 23 于1974年着陆失败处约2 km的同一区域。",{"src":69,"caption":70},"/images/missions/luna24/04.webp","1976年8月22日，返回舱落在西伯利亚——直到2020年代的 VKS 计划之前，这是苏联最后一次从地球轨道以外取回样品。",{"id":72,"title":73,"subtitle":74,"images":75},"science","科学","月壤中的水——早有印证",[76],{"src":77,"caption":78},"/images/missions/luna24/05.webp","1978年对 Luna 24 样品的重新分析显示含水量为0.1%——起初被忽视，2020年经 LCROSS 撞击与 SOFIA 证实。",null],"uses":{"params":["id"]}}]}
