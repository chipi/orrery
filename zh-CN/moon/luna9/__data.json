{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":41,"story":49,"illustration":81,"mission":81},{"id":3,"marker":4,"kind":5,"agency":6,"nation":7,"year":8,"landing_date":9,"lat":10,"lon":11,"region_bounds":12,"region_kind":17,"crewed":18,"status":19,"surface_status":20,"surface_duration_days":21,"samples_kg":22,"data_quality":23,"credit":24,"fleet_refs":25,"links":29},"luna9","lander","surface","ROSCOSMOS","USSR",1966,"1966-02-03",7.08,-64.37,{"lat_min":13,"lat_max":14,"lon_min":15,"lon_max":16},7.06,7.1,-64.39,-64.35,"landing_ellipse",false,"FLOWN","completed",3,0,"good","© Soviet Academy of Sciences (historical) — declassified materials. Position: Oceanus Procellarum, NASA's Lunar and Planetary Institute catalogue.",[26],{"id":27,"role":28},"luna-9","spacecraft",[30,34,38],{"l":31,"u":32,"t":33},"Luna 9 — Wikipedia","https://en.wikipedia.org/wiki/Luna_9","intro",{"l":35,"u":36,"t":37},"Луна-9 — русская Википедия","https://ru.wikipedia.org/wiki/%D0%9B%D1%83%D0%BD%D0%B0-9","core",{"l":39,"u":40,"t":37},"Luna 9 (NASA NSSDCA)","https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1966-006A",{"name":42,"mission_type":43,"site_name":44,"crew":45,"left":46,"fact":47,"capability":48},"Luna 9","无人软着陆器","风暴洋",[],"着陆器外壳、摄像机、电池","首个实现在月球软着陆并从月面传回照片的航天器。九幅全景图像终结了着陆器是否会陷入深厚月尘的争论。一个决定性时刻——月球可以到达。","首次软着陆——这是任何随后的月面操作之前的必要条件，也是自那以来每台火星着陆器的前置概念验证。",{"site":3,"intro":50,"essay":-1,"chapters":51},"Luna 9 于1966年2月3日降落在风暴洋,实现了人类在另一个天体上的首次软着陆。这个重99公斤的球形返回舱依靠展开的充气缓冲气囊,承受住了时速22 km的撞击;随后它展开花瓣状的舱瓣使自身扶正,并传回了第一批月球表面照片。它在电池耗尽前共工作了3天。",[52,63,71],{"id":53,"title":54,"subtitle":55,"images":56},"hardware","硬件","苏联E-6舱体,软着陆先驱",[57,60],{"src":58,"caption":59},"/images/missions/luna9/01.webp","Luna 9 舱体模型——重99公斤,呈球形,配有气囊保护的相机和四根花瓣状天线。",{"src":61,"caption":62},"/images/missions/luna9/02.webp","Luna 9 硬件剖视图——苏联工程师在NASA之前解决了软着陆难题。",{"id":64,"title":65,"subtitle":66,"images":67},"launch","发射","1966年1月31日——Molniya-M 从拜科努尔升空",[68],{"src":69,"caption":70},"/images/missions/luna9/03.webp","在拜科努尔准备中的Molniya-M火箭——Luna 9 的发射,正值苏美隔洋对决、争夺首次软着陆的竞赛之中。",{"id":5,"title":72,"subtitle":73,"images":74},"表面","风暴洋——1966年2月3日着陆",[75,78],{"src":76,"caption":77},"/images/missions/luna9/04.webp","首批月球表面图像——粗糙的低码率全景图,呈现出遍布岩石的月壤。曼彻斯特的卓瑞尔河岸射电望远镜截获了这次传输,并抢在苏联之前公布了图像。",{"src":79,"caption":80},"/images/missions/luna9/05.webp","Luna 9 全景拼接图——首次证明月球表面坚实得足以支撑着陆器,终结了多年来关于月面存在深厚尘埃堆积的猜测。",null],"uses":{"params":["id"]}}]}
