{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":27,"story":33,"illustration":33,"mission":33},{"id":3,"marker":4,"kind":4,"agency":5,"nation":6,"year":7,"altitude_km":8,"inclination_deg":9,"eccentricity":10,"status":11,"surface_status":12,"samples_kg":10,"data_quality":13,"credit":14,"links":15,"fleet_refs":24},"lunar-prospector","orbiter","NASA","USA",1998,100,90,0,"ENDED","completed","good","© NASA Ames Research Center — first NASA Discovery-class lunar mission, 1998-1999.",[16,20],{"l":17,"u":18,"t":19},"Lunar Prospector — Wikipedia","https://en.wikipedia.org/wiki/Lunar_Prospector","intro",{"l":21,"u":22,"t":23},"Lunar Prospector — NASA","https://science.nasa.gov/mission/lunar-prospector/","core",[25],{"id":3,"role":26},"spacecraft",{"name":28,"mission_type":29,"site_name":30,"fact":31,"capability":32},"Lunar Prospector","轨道器 · 1999年结束","月球极地轨道，100 km","中子能谱仪直接探测到月球两极的氢——月球永久阴影坑底存在水冰的有力证据。任务结束时故意撞击进Shoemaker撞击坑，希望撞击溅射物能够证实水的存在；基于地球的观测者未检测到明确的结果（随后的确认工作只由LCROSS在2009年完成）。","证实了Clementine的极地冰假说；确立了中子能谱法作为月球挥发物探测的主要工具。",null],"uses":{"params":["id"]}}]}
