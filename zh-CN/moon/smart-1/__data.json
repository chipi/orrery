{"type":"data","nodes":[null,{"type":"data","data":[{"entity":1},{"site":2,"text":28,"story":34,"illustration":34,"mission":34},{"id":3,"marker":4,"kind":4,"agency":5,"nation":6,"year":7,"altitude_km":8,"inclination_deg":9,"eccentricity":10,"status":11,"surface_status":12,"samples_kg":13,"data_quality":14,"credit":15,"links":16,"fleet_refs":25},"smart-1","orbiter","ESA","Europe",2003,470,90,0.55,"ENDED","completed",0,"good","© ESA — Small Missions for Advanced Research in Technology; first European lunar mission. Used solar-electric (ion) propulsion to spiral out from Earth orbit.",[17,21],{"l":18,"u":19,"t":20},"SMART-1 — Wikipedia","https://en.wikipedia.org/wiki/SMART-1","intro",{"l":22,"u":23,"t":24},"SMART-1 — ESA","https://www.esa.int/Science_Exploration/Space_Science/SMART-1","core",[26],{"id":3,"role":27},"spacecraft",{"name":29,"mission_type":30,"site_name":31,"fact":32,"capability":33},"SMART-1","轨道器 · 2006年结束","月球极地轨道，约470 km","ESA的首次月球任务。采用太阳能电力（离子）推进系统，从地球同步转移轨道逐步加速螺旋上升至月球捕获——这次为期14个月的燃料高效转移首次为ESA后续行星际任务的低推力轨迹奠定了基础。2006年故意撞击月球表面，作为一次观测性的任务生命末期实验。","首次在月球任务中实际运用离子推进——为ESA后续的BepiColombo和Hera深空任务奠定了模板。",null],"uses":{"params":["id"]}}]}
